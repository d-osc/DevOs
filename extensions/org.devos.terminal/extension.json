{
  "id": "org.devos.terminal",
  "name": "Terminal",
  "description": "Native terminal with the shared application header and VTE shell.",
  "version": "1.0.0",
  "apiVersion": 1,
  "kind": "ui",
  "system": true,
  "entry": "org.devos.terminal.js",
  "order": 26,
