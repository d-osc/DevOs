#!/usr/bin/env d
# Data worker of the native Display page (displays.ts / displays.backend.ts of the JS page). It runs `wlr-randr` with separate arguments:
# list the outputs, preview a change that reverts by itself unless it is kept, keep it, or revert it. A preview is a marker file in the user's
# runtime folder that holds the layout to go back to (one argument per line). A detached shell process restores that layout after the
# safety delay (30 s) even if Settings or this worker is gone; the page's own countdown (15 s) reverts through the `status` request.
# One JSON request per line:
#   {"action":"get"}   {"action":"status"}   {"action":"keep"}   {"action":"revert"}
#   {"action":"preview","name":"eDP-1","mode":"1920x1080@60Hz","scale":1.5,"transform":"normal","x":0,"y":0}
# Frame (records separated by ASCII 30, text never holds tabs or newlines):
#   V pending remainingSeconds          D name description enabled scale transform x y        M id width height refresh current preferred
#   E message                           (M records follow the D record of their output)
# Test hooks (only with DEVOS_SETTINGS_TEST=1): DEVOS_DISPLAY_RANDR (the wlr-randr program), DEVOS_DISPLAY_RUNTIME (marker folder),
# DEVOS_DISPLAY_COUNTDOWN and DEVOS_DISPLAY_SAFETY (seconds).
use "std/args"
use "std/io"
use "std/fs"
use "std/process"
use "std/json"
use "std/strings"
use "std/result"
use "std/encoding"
use "../../../lib/hw.dev" as hw
use "../../../lib/posix.dev" as posix
use "../../../lib/worker-kit.dev" as kit

fn text(value:json.Value, key:str):str { return json.has(value,key) && strings.equal(json.kind(json.get(value,key)),"string") ? json.string(json.get(value,key)) : "" }
fn bool(value:json.Value, key:str):bool { return json.has(value,key) && strings.equal(json.kind(json.get(value,key)),"bool") && json.bool(json.get(value,key)) }
fn num(value:json.Value, key:str, fallback:f64):f64 { return json.has(value,key) && strings.equal(json.kind(json.get(value,key)),"number") ? json.float(json.get(value,key)) : fallback }
fn testing():bool { return process.hasEnv("DEVOS_SETTINGS_TEST") }
fn setting(name:str, fallback:str):str { return testing() && process.hasEnv(name) ? process.getenv(name) : fallback }
fn seconds(name:str, fallback:i64):i64 { let n = 0; let v = setting(name,"${fallback}"); for b in encoding.encode(v,"utf8") { if b < 48 || b > 57 { return fallback }; n = n * 10 + ((b - 48) as i64) }; return n }
fn randr():str { return setting("DEVOS_DISPLAY_RANDR","wlr-randr") }
fn runtime():str { return setting("DEVOS_DISPLAY_RUNTIME",process.hasEnv("XDG_RUNTIME_DIR") ? process.getenv("XDG_RUNTIME_DIR") : "/tmp") }
fn marker():str { return runtime() + "/devos-display-preview" }
fn countdown():i64 { return seconds("DEVOS_DISPLAY_COUNTDOWN",15) }
fn safety():i64 { return seconds("DEVOS_DISPLAY_SAFETY",30) }

struct Mode { id: str, width: i64, height: i64, refresh: f64, current: bool, preferred: bool }
struct Output { name: str, description: str, enabled: bool, modes: Vec<Mode>, x: i64, y: i64, scale: f64, transform: str }
struct Loaded { error: str, outputs: Vec<Output> }
# A number with at most six decimals and no trailing zeros ("60", "59.999", "1.5").
fn fmt(value:f64):str {
    let micros = (value * 1000000.0 + 0.5) as i64
    let whole = micros / 1000000; let part = micros % 1000000
    if part == 0 { return "${whole}" }
    let digits = "${part + 1000000}"; let fraction = strings.substring(digits,1,7)
    while strings.endsWith(fraction,"0") { fraction = strings.substring(fraction,0,strings.charLength(fraction) - 1) }
    return "${whole}." + fraction
}
fn modeId(width:i64, height:i64, refresh:f64):str { return "${width}x${height}@" + fmt(refresh) + "Hz" }
fn printable(value:str):bool {
    for b in encoding.encode(value,"utf8") { if b < 32 || b == 127 { return false } }
    return true
}
fn load():Loaded {
    let none = Vec<Output>()
    let ran = hw.run(Vec<str>(randr(),"--json"),8000)
    if ran.code == 127 { return Loaded("Display controls are not installed. Install the DevOs wlr-randr package.",none) }
    if ran.code != 0 { return Loaded(strings.equal(strings.trim(ran.out),"") ? "The compositor did not answer." : strings.trim(ran.out),none) }
    let parsed = result.attempt(fn():json.Value { return json.parse(strings.trim(ran.out)) })
    if result.isErr(parsed) || !strings.equal(json.kind(result.unwrap(parsed)),"array") { return Loaded("Invalid display information from the compositor.",none) }
    let list = result.unwrap(parsed); let outputs = Vec<Output>()
    for i in 0..(json.len(list) as i64) {
        let o = json.at(list,i)
        if !strings.equal(json.kind(o),"object") || !printable(text(o,"name")) || strings.equal(text(o,"name"),"") { return Loaded("Invalid display information from the compositor.",none) }
        let modes = Vec<Mode>()
        if json.has(o,"modes") && strings.equal(json.kind(json.get(o,"modes")),"array") {
            let raw = json.get(o,"modes")
            for j in 0..(json.len(raw) as i64) {
                let m = json.at(raw,j)
                if !strings.equal(json.kind(m),"object") { continue }
                let w = num(m,"width",0.0) as i64; let h = num(m,"height",0.0) as i64; let r = num(m,"refresh",0.0)
                if w <= 0 || h <= 0 || r <= 0.0 { continue }
                modes.push(Mode(modeId(w,h,r),w,h,r,bool(m,"current"),bool(m,"preferred")))
            }
        }
        let position = json.has(o,"position") && strings.equal(json.kind(json.get(o,"position")),"object") ? json.get(o,"position") : json.object()
        let transform = text(o,"transform"); if strings.equal(transform,"") { transform = "normal" }
        let scale = num(o,"scale",1.0); if scale <= 0.0 { scale = 1.0 }
        outputs.push(Output(text(o,"name"),text(o,"description"),bool(o,"enabled"),modes,num(position,"x",0.0) as i64,num(position,"y",0.0) as i64,scale,transform))
    }
    return Loaded("",outputs)
}
fn transforms():Vec<str> { return Vec<str>("normal","90","180","270","flipped","flipped-90","flipped-180","flipped-270") }
fn known(list:Vec<str>, value:str):bool { for item in list { if strings.equal(item,value) { return true } }; return false }
fn current(o:Output):Mode { for m in o.modes { if m.current { return m } }; return Mode("",0,0,0.0,false,false) }
fn argsFor(o:Output, mode:str, scale:f64, transform:str, x:i64, y:i64):Vec<str> {
    return Vec<str>("--output",o.name,"--on","--mode",mode,"--scale",fmt(scale),"--transform",transform,"--pos","${x},${y}")
}
# The layout to go back to: every output as it is now. "" in the error when it cannot be restored safely.
struct Rollback { error: str, lines: Vec<str> }
fn rollback(outputs:Vec<Output>):Rollback {
    let lines = Vec<str>()
    for o in outputs {
        if !o.enabled { lines.push("--output"); lines.push(o.name); lines.push("--off"); continue }
        let m = current(o)
        if strings.equal(m.id,"") { return Rollback("Cannot safely restore the current display mode.",Vec<str>()) }
        for a in argsFor(o,m.id,o.scale,o.transform,o.x,o.y) { lines.push(a) }
    }
    return Rollback("",lines)
}

fn pending():bool { return fs.existsSync(marker()) }
# Seconds since the preview started (0 when unknown).
fn age():i64 {
    let stamp = hw.run(Vec<str>("stat","-c","%Y",marker()),5000); let now = hw.run(Vec<str>("date","+%s"),5000)
    if stamp.code != 0 || now.code != 0 { return 0 }
    let a = 0; for b in encoding.encode(strings.trim(stamp.out),"utf8") { if b < 48 || b > 57 { return 0 }; a = a * 10 + ((b - 48) as i64) }
    let c = 0; for b in encoding.encode(strings.trim(now.out),"utf8") { if b < 48 || b > 57 { return 0 }; c = c * 10 + ((b - 48) as i64) }
    return c > a ? c - a : 0
}
fn remaining():i64 { if !pending() { return 0 }; let left = countdown() - age(); return left > 0 ? left : 0 }
# Puts the saved layout back and removes the marker. "" on success.
fn restore():str {
    if !pending() { return "" }
    let lines = Vec<str>()
    for line in strings.split(fs.readFileSync(marker(),"utf8"),"\n") { if !strings.equal(line,"") { lines.push(line) } }
    fs.unlinkSync(marker())
    if lines.len() == 0 { return "" }
    let argv = Vec<str>(randr()); for l in lines { argv.push(l) }
    let ran = hw.run(argv,8000)
    return ran.code == 0 ? "" : (strings.equal(strings.trim(ran.out),"") ? "The compositor rejected the display configuration." : strings.trim(ran.out))
}

fn frame(loaded:Loaded):str {
    if !strings.equal(loaded.error,"") { return kit.failure(loaded.error) }
    let out = "V\t" + (pending() ? "1" : "0") + "\t${remaining()}"
    for o in loaded.outputs {
        out = out + kit.rs() + "D\t" + kit.clean(o.name) + "\t" + kit.clean(o.description) + "\t" + (o.enabled ? "1" : "0") + "\t" + fmt(o.scale) + "\t" + kit.clean(o.transform) + "\t${o.x}\t${o.y}"
        for m in o.modes { out = out + kit.rs() + "M\t" + m.id + "\t${m.width}\t${m.height}\t" + fmt(m.refresh) + "\t" + (m.current ? "1" : "0") + "\t" + (m.preferred ? "1" : "0") }
    }
    return out
}
fn read():str { return frame(load()) }
fn quoteOk(value:str):bool { return !strings.contains(value,"'") }
fn preview(r:json.Value):str {
    if pending() { return kit.failure("Keep or revert the current preview first.") }
    if !quoteOk(marker()) || !quoteOk(randr()) { return kit.failure("The runtime folder name is not supported.") }
    let loaded = load(); if !strings.equal(loaded.error,"") { return kit.failure(loaded.error) }
    let target = Output("","",false,Vec<Mode>(),0,0,1.0,"normal"); let found = false
    for o in loaded.outputs { if strings.equal(o.name,text(r,"name")) { target = o; found = true } }
    if !found || !target.enabled { return kit.failure("Select a connected display and one of its supported modes.") }
    let modeOk = false; for m in target.modes { if strings.equal(m.id,text(r,"mode")) { modeOk = true } }
    if !modeOk { return kit.failure("Select a connected display and one of its supported modes.") }
    let scale = num(r,"scale",0.0); let x = num(r,"x",1000000.0); let y = num(r,"y",1000000.0)
    let whole = fn(v:f64):bool { return v >= 0.0 - 32768.0 && v <= 32768.0 && (v as i64) as f64 == v }
    if scale < 0.5 || scale > 4.0 || !known(transforms(),text(r,"transform")) || !whole(x) || !whole(y) { return kit.failure("Invalid display scale, rotation or position.") }
    let back = rollback(loaded.outputs); if !strings.equal(back.error,"") { return kit.failure(back.error) }
    let change = argsFor(target,text(r,"mode"),scale,text(r,"transform"),x as i64,y as i64)
    let dry = Vec<str>(randr(),"--dryrun"); for a in change { dry.push(a) }
    let tried = hw.run(dry,8000)
    if tried.code != 0 { return kit.failure(strings.equal(strings.trim(tried.out),"") ? "The compositor rejected the display configuration." : strings.trim(tried.out)) }
    # The marker holds the layout to restore; the detached process restores it after the safety delay unless the marker is gone by then.
    fs.writeFileSync(marker(),strings.join(back.lines,"\n") + "\n")
    let timer = "( sleep ${safety()}; if test -f '" + marker() + "'; then xargs -d '\\n' '" + randr() + "' < '" + marker() + "'; rm -f '" + marker() + "'; fi ) >/dev/null 2>&1 &"
    posix.shell(timer)
    let apply = Vec<str>(randr()); for a in change { apply.push(a) }
    let ran = hw.run(apply,8000)
    if ran.code != 0 {
        let problem = restore()
        return kit.failure(strings.equal(strings.trim(ran.out),"") ? "The compositor rejected the display configuration." : strings.trim(ran.out) + (strings.equal(problem,"") ? "" : " " + problem))
    }
    return read()
}
fn handle(line:str):str {
    let parsed = result.attempt(fn():json.Value { return json.parse(line) })
    if result.isErr(parsed) { return kit.failure("Invalid service request") }
    let r = result.unwrap(parsed)
    if !strings.equal(json.kind(r),"object") { return kit.failure("Expected an object request") }
    let action = text(r,"action")
    if strings.equal(action,"get") { return read() }
    if strings.equal(action,"status") {
        # The page's countdown ran out: put the old layout back.
        if pending() && remaining() == 0 { let problem = restore(); if !strings.equal(problem,"") { return kit.failure(problem) } }
        return read()
    }
    if strings.equal(action,"preview") { return preview(r) }
    if strings.equal(action,"keep") {
        if !pending() { return kit.failure("The preview expired and was reverted. Refresh the display settings.") }
        fs.unlinkSync(marker()); return read()
    }
    if strings.equal(action,"revert") {
        let problem = restore()
        if !strings.equal(problem,"") { return kit.failure(problem) }
        return read()
    }
    return kit.failure("Unsupported action")
}
fn main():i32 {
    while true {
        let line = io.read_line(); if strings.equal(line,"") { break }
        print(handle(line))
    }
    return 0
}
return main()
