#!/usr/bin/env d
# Data worker of the native System pages (About, Storage, Power & battery, Date & time, Mouse, Keyboard input). It runs the
# existing DevLang helpers (bin/dev-os-system, bin/dev-os-time, bin/dev-os-input-settings) with separate arguments, hands them the JSON
# they already read on standard input, and turns their answers into tab-separated frames so the window never parses JSON. The helpers
# keep their own validation and polkit prompts. One JSON request per line on stdin:
#   {"action":"system"}                                  -> Y frame
#   {"action":"power","profile":"balanced"}              -> Y frame (after switching the power profile)
#   {"action":"time"}   {"action":"time-timezone","timezone":"Asia/Bangkok"}   {"action":"time-ntp","enabled":true}
#   {"action":"time-set","date":"2026-10-29","time":"12:30"}   {"action":"time-host"}          -> Z frame
#   {"action":"input","kind":"mouse","op":"get|save|reset","settings":{"speed":50,...}}      -> N frame
# Frames (records inside a frame are separated by ASCII 30):
#   Y hostManaged hostname os kernel architecture cpu processors memory session hostSettings powerAvailable powerActive profiles degraded powerError version
#     then B name status percent health cycles minutes | D path total used free | H key value
#   Z available hostManaged timezone ntp canNtp synchronized error localDate localTime   then Q zone
#   N kind applied speed natural leftHanded repeat delay rate devices          E message
# Test hook: DEVOS_SETTINGS_HELPERS names the directory with the three helpers.
use "std/args"
use "std/fs"
use "std/io"
use "std/process"
use "std/json"
use "std/strings"
use "std/result"
use "std/encoding"
use "../../../lib/hw.dev" as hw
use "./worker-kit.dev" as kit

fn text(value:json.Value, key:str):str { return json.has(value,key) && strings.equal(json.kind(json.get(value,key)),"string") ? json.string(json.get(value,key)) : "" }
fn flag(value:json.Value, key:str):str { return json.has(value,key) && strings.equal(json.kind(json.get(value,key)),"bool") && json.bool(json.get(value,key)) ? "1" : "0" }
# Numbers print as written ("" when missing or null).
fn number(value:json.Value, key:str):str { return json.has(value,key) && strings.equal(json.kind(json.get(value,key)),"number") ? json.stringify(json.get(value,key)) : "" }
struct Answer { error: str, value: json.Value }
# Runs bin/<helper> with `payload` on its standard input; the helper answers {"ok":true,...} or {"ok":false,"error":...}.
fn ask(root:str, helper:str, payload:json.Value, seconds:i64):Answer {
    let directory = process.hasEnv("DEVOS_SETTINGS_HELPERS") ? process.getenv("DEVOS_SETTINGS_HELPERS") : root + "/bin"
    let ran = hw.runInput(Vec<str>("d",directory + "/" + helper),json.stringify(payload),seconds * 1000)
    let parsed = result.attempt(fn():json.Value { return json.parse(strings.trim(ran.out)) })
    if result.isErr(parsed) || !strings.equal(json.kind(result.unwrap(parsed)),"object") { return Answer("The " + helper + " helper did not answer.",json.null_value()) }
    let value = result.unwrap(parsed)
    let ok = json.has(value,"ok") && strings.equal(json.kind(json.get(value,"ok")),"bool") && json.bool(json.get(value,"ok"))
    if !ok { return Answer(text(value,"error") == "" ? "The " + helper + " helper failed." : text(value,"error"),json.null_value()) }
    return Answer("",value)
}
fn version(root:str):str {
    let file = root + "/package.json"
    if !fs.existsSync(file) { return "" }
    let parsed = result.attempt(fn():json.Value { return json.parse(fs.readFileSync(file,"utf8")) })
    return result.isErr(parsed) ? "" : text(result.unwrap(parsed),"version")
}
fn systemFrame(root:str, state:json.Value):str {
    let power = json.has(state,"power") ? json.get(state,"power") : json.object()
    let profiles = Vec<str>(); let list = json.has(power,"profiles") ? json.get(power,"profiles") : json.array()
    for i in 0..(json.len(list) as i64) { if strings.equal(json.kind(json.at(list,i)),"string") { profiles.push(json.string(json.at(list,i))) } }
    let out = "Y\t" + flag(state,"hostManaged") + "\t" + kit.clean(text(state,"hostname")) + "\t" + kit.clean(text(state,"os")) + "\t" + kit.clean(text(state,"kernel")) + "\t" + kit.clean(text(state,"architecture")) + "\t" + kit.clean(text(state,"cpu")) + "\t" + number(state,"processors") + "\t" + number(state,"memory") + "\t" + kit.clean(text(state,"session")) + "\t" + flag(state,"hostSettings")
    out = out + "\t" + flag(power,"available") + "\t" + kit.clean(text(power,"active")) + "\t" + strings.join(profiles,",") + "\t" + kit.clean(text(power,"degraded")) + "\t" + kit.clean(text(power,"error")) + "\t" + kit.clean(version(root))
    let batteries = json.has(state,"batteries") ? json.get(state,"batteries") : json.array()
    for i in 0..(json.len(batteries) as i64) {
        let b = json.at(batteries,i)
        out = out + kit.rs() + "B\t" + kit.clean(text(b,"name")) + "\t" + kit.clean(text(b,"status")) + "\t" + number(b,"percent") + "\t" + number(b,"health") + "\t" + number(b,"cycles") + "\t" + number(b,"minutes")
    }
    let disks = json.has(state,"storage") ? json.get(state,"storage") : json.array()
    for i in 0..(json.len(disks) as i64) {
        let d = json.at(disks,i)
        out = out + kit.rs() + "D\t" + kit.clean(text(d,"path")) + "\t" + number(d,"total") + "\t" + number(d,"used") + "\t" + number(d,"free")
    }
    let hardware = json.has(state,"hardware") ? json.get(state,"hardware") : json.object()
    for key in json.keys(hardware) { out = out + kit.rs() + "H\t" + kit.clean(key) + "\t" + kit.clean(text(hardware,key)) }
    return out
}
# The date and time now in `zone` (the shell's date with TZ set; separate arguments, no shell string).
fn localTime(zone:str):Vec<str> {
    let ran = hw.run(Vec<str>("env","TZ=" + zone,"date","+%Y-%m-%d %H:%M"),5000)
    let parts = strings.split(strings.trim(ran.out)," ")
    return ran.code == 0 && parts.len() == 2 ? parts : Vec<str>("","")
}
fn timeFrame(state:json.Value):str {
    let now = localTime(text(state,"timezone"))
    let out = "Z\t" + flag(state,"available") + "\t" + flag(state,"hostManaged") + "\t" + kit.clean(text(state,"timezone")) + "\t" + flag(state,"ntp") + "\t" + flag(state,"canNtp") + "\t" + flag(state,"synchronized") + "\t" + kit.clean(text(state,"error")) + "\t" + now[0] + "\t" + now[1]
    let zones = json.has(state,"zones") ? json.get(state,"zones") : json.array()
    for i in 0..(json.len(zones) as i64) { if strings.equal(json.kind(json.at(zones,i)),"string") { out = out + kit.rs() + "Q\t" + kit.clean(json.string(json.at(zones,i))) } }
    return out
}
fn inputFrame(kind:str, answer:json.Value):str {
    let settings = json.has(answer,"settings") ? json.get(answer,"settings") : json.object()
    let names = Vec<str>(); let list = json.has(answer,"devices") ? json.get(answer,"devices") : json.array()
    for i in 0..(json.len(list) as i64) { if strings.equal(json.kind(json.at(list,i)),"string") { names.push(kit.clean(json.string(json.at(list,i)))) } }
    return "N\t" + kind + "\t" + flag(answer,"applied") + "\t" + number(settings,"speed") + "\t" + flag(settings,"natural") + "\t" + flag(settings,"leftHanded") + "\t" + flag(settings,"repeat") + "\t" + number(settings,"delay") + "\t" + number(settings,"rate") + "\t" + strings.join(names,", ")
}
fn member(list:Vec<str>, value:str):bool { for item in list { if strings.equal(item,value) { return true } }; return false }
fn handle(root:str, line:str):str {
    let parsed = result.attempt(fn():json.Value { return json.parse(line) })
    if result.isErr(parsed) { return kit.failure("Invalid service request") }
    let request = result.unwrap(parsed)
    if !strings.equal(json.kind(request),"object") { return kit.failure("Expected an object request") }
    let action = text(request,"action")
    if strings.equal(action,"system") || strings.equal(action,"power") {
        let payload = {action:"get"}
        if strings.equal(action,"power") {
            let profile = text(request,"profile")
            if !member(Vec<str>("power-saver","balanced","performance"),profile) { return kit.failure("Choose Power saver, Balanced or Performance.") }
            payload = {action:"power",profile:profile}
        }
        let answer = ask(root,"dev-os-system",payload,75)
        if !strings.equal(answer.error,"") { return kit.failure(answer.error) }
        return systemFrame(root,json.get(answer.value,"state"))
    }
    if strings.startsWith(action,"time") {
        let payload = {action:"get"}
        if strings.equal(action,"time-timezone") { payload = {action:"set-timezone",timezone:text(request,"timezone")} }
        else if strings.equal(action,"time-ntp") { payload = {action:"set-ntp",enabled:flag(request,"enabled") == "1"} }
        else if strings.equal(action,"time-set") { payload = {action:"set-time",date:text(request,"date"),time:text(request,"time")} }
        else if strings.equal(action,"time-host") { payload = {action:"windows-settings"} }
        else if !strings.equal(action,"time") { return kit.failure("Unsupported action") }
        let answer = ask(root,"dev-os-time",payload,135)
        if !strings.equal(answer.error,"") { return kit.failure(answer.error) }
        return timeFrame(json.get(answer.value,"state"))
    }
    if strings.equal(action,"input") {
        let kind = text(request,"kind"); let op = text(request,"op")
        if !member(Vec<str>("mouse","keyboard"),kind) || !member(Vec<str>("get","save","reset"),op) { return kit.failure("Unsupported input request") }
        let settings = json.has(request,"settings") && strings.equal(json.kind(json.get(request,"settings")),"object") ? json.get(request,"settings") : json.object()
        let answer = ask(root,"dev-os-input-settings",{action:op,kind:kind,settings:settings},30)
        if !strings.equal(answer.error,"") { return kit.failure(answer.error) }
        return inputFrame(kind,answer.value)
    }
    return kit.failure("Unsupported action")
}
fn main():i32 {
    let root = args.len() > 0 ? args.get(0) : "."
    while true {
        let line = io.read_line(); if strings.equal(line,""){ break }
        print(handle(root,line))
    }
    return 0
}
return main()
