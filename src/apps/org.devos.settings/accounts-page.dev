#!/usr/bin/env d
# Data worker of the native Accounts page. It runs bin/dev-os-accounts (the DevLang helper that keeps the GitHub device flow, the
# identity file and the privileged account bridge) with the JSON that helper reads on standard input, and answers with a frame so the
# window never parses JSON. One JSON request per line on stdin:
#   {"action":"get"}   {"action":"begin"}   {"action":"poll"}   {"action":"cancel"}   {"action":"signout"}   {"action":"unlink"}
#   {"action":"switch","username":"alice"}      (asks the shell to switch to a user that is on this device)
# Creating users is not offered here: it needs the login screen's secure password prompt.
# Frame (records inside it are separated by ASCII 30):
#   A clientId provider name login id available currentUser bindingId bindingLogin firstSetup code url interval pending
#     then U username name uid home github githubId             or   E message
# Test hooks: DEVOS_SETTINGS_HELPERS (helper directory); with DEVOS_SETTINGS_TEST=1 also DEVOS_SETTINGS_SWITCH_COMMAND (JSON array).
use "std/args"
use "std/fs"
use "std/io"
use "std/process"
use "std/json"
use "std/strings"
use "std/result"
use "std/encoding"
use "../../../lib/hw.dev" as hw
use "./worker-kit.dev" as kit

fn text(value:json.Value, key:str):str { return json.has(value,key) && strings.equal(json.kind(json.get(value,key)),"string") ? json.string(json.get(value,key)) : "" }
fn number(value:json.Value, key:str):str { return json.has(value,key) && strings.equal(json.kind(json.get(value,key)),"number") ? json.stringify(json.get(value,key)) : "" }
fn yes(value:json.Value, key:str):str { return json.has(value,key) && strings.equal(json.kind(json.get(value,key)),"bool") && json.bool(json.get(value,key)) ? "1" : "0" }
struct Answer { error: str, value: json.Value }
fn ask(root:str, payload:json.Value):Answer {
    let directory = process.hasEnv("DEVOS_SETTINGS_HELPERS") ? process.getenv("DEVOS_SETTINGS_HELPERS") : root + "/bin"
    let ran = hw.runInput(Vec<str>("d",directory + "/dev-os-accounts"),json.stringify(payload),135000)
    let parsed = result.attempt(fn():json.Value { return json.parse(strings.trim(ran.out)) })
    if result.isErr(parsed) || !strings.equal(json.kind(result.unwrap(parsed)),"object") { return Answer("The account service did not answer.",json.null_value()) }
    let value = result.unwrap(parsed)
    if !(json.has(value,"ok") && strings.equal(json.kind(json.get(value,"ok")),"bool") && json.bool(json.get(value,"ok"))) {
        return Answer(text(value,"error") == "" ? "Account service failed." : text(value,"error"),json.null_value())
    }
    return Answer("",value)
}
# begin, poll and cancel answer with only the flow data: lay it over the full account state so the page keeps its profile and users.
fn withState(root:str, reply:json.Value):Answer {
    if json.has(reply,"system") { return Answer("",reply) }
    let base = ask(root,{action:"get"})
    if !strings.equal(base.error,"") { return base }
    let out = base.value
    for key in Vec<str>("code","url","interval","pending") { if json.has(reply,key) { out = json.set(out,key,json.get(reply,key)) } }
    return Answer("",out)
}
fn frame(answer:json.Value):str {
    let identity = json.has(answer,"identity") ? json.get(answer,"identity") : json.object()
    let system = json.has(answer,"system") ? json.get(answer,"system") : json.object()
    let binding = json.has(system,"binding") && strings.equal(json.kind(json.get(system,"binding")),"object") ? json.get(system,"binding") : json.object()
    let out = "A\t" + kit.clean(text(answer,"clientId")) + "\t" + kit.clean(text(identity,"provider")) + "\t" + kit.clean(text(identity,"name")) + "\t" + kit.clean(text(identity,"login")) + "\t" + number(identity,"id") + "\t" + yes(system,"available") + "\t" + kit.clean(text(system,"currentUser"))
    out = out + "\t" + number(binding,"id") + "\t" + kit.clean(text(binding,"login")) + "\t" + yes(system,"firstSetup") + "\t" + kit.clean(text(answer,"code")) + "\t" + kit.clean(text(answer,"url")) + "\t" + number(answer,"interval") + "\t" + yes(answer,"pending")
    let users = json.has(system,"users") ? json.get(system,"users") : json.array()
    for i in 0..(json.len(users) as i64) {
        let user = json.at(users,i)
        out = out + kit.rs() + "U\t" + kit.clean(text(user,"username")) + "\t" + kit.clean(text(user,"name")) + "\t" + number(user,"uid") + "\t" + kit.clean(text(user,"home")) + "\t" + kit.clean(text(user,"github")) + "\t" + number(user,"githubId")
    }
    return out
}
fn usernameOk(value:str):bool {
    let count = strings.charLength(value)
    if count < 1 || count > 65 { return false }
    for i in 0..count {
        let ch = strings.substring(value,i,i + 1)
        if !strings.contains(i == 0 ? "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_" : "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-$",ch) { return false }
    }
    return true
}
fn switchCommand(root:str, username:str):Vec<str> {
    let fallback = Vec<str>("sh",(process.hasEnv("DEV_OS_ROOT") ? process.getenv("DEV_OS_ROOT") : root) + "/bin/dev-os-shell","switch-user",username)
    if !process.hasEnv("DEVOS_SETTINGS_TEST") || !process.hasEnv("DEVOS_SETTINGS_SWITCH_COMMAND") { return fallback }
    let parsed = result.attempt(fn():json.Value { return json.parse(process.getenv("DEVOS_SETTINGS_SWITCH_COMMAND")) })
    if result.isErr(parsed) || !strings.equal(json.kind(result.unwrap(parsed)),"array") { return fallback }
    let out = Vec<str>(); let list = result.unwrap(parsed)
    for i in 0..(json.len(list) as i64) { if strings.equal(json.kind(json.at(list,i)),"string") { out.push(json.string(json.at(list,i))) } }
    out.push(username)
    return out
}
fn handle(root:str, line:str):str {
    let parsed = result.attempt(fn():json.Value { return json.parse(line) })
    if result.isErr(parsed) { return kit.failure("Invalid service request") }
    let request = result.unwrap(parsed)
    if !strings.equal(json.kind(request),"object") { return kit.failure("Expected an object request") }
    let action = text(request,"action")
    let known = false
    for name in Vec<str>("get","begin","poll","cancel","signout","unlink") { if strings.equal(name,action) { known = true } }
    if known {
        let payload = {action:action}
        if strings.equal(action,"begin") {
            # Link the GitHub account to this OS user when user management is available (like the JS page).
            let first = ask(root,{action:"get"})
            if !strings.equal(first.error,"") { return kit.failure(first.error) }
            let system = json.get(first.value,"system")
            payload = {action:"begin",link:json.has(system,"available") && strings.equal(json.kind(json.get(system,"available")),"bool") && json.bool(json.get(system,"available"))}
        }
        let answer = ask(root,payload)
        if !strings.equal(answer.error,"") { return kit.failure(answer.error) }
        let full = withState(root,answer.value)
        if !strings.equal(full.error,"") { return kit.failure(full.error) }
        return frame(full.value)
    }
    if strings.equal(action,"switch") {
        let username = text(request,"username")
        if !usernameOk(username) { return kit.failure("Choose a user from the list.") }
        # Only users that exist on this device, never the shared 'devos' profile or the current user.
        let state = ask(root,{action:"get"})
        if !strings.equal(state.error,"") { return kit.failure(state.error) }
        let system = json.get(state.value,"system")
        let listed = false; let users = json.has(system,"users") ? json.get(system,"users") : json.array()
        for i in 0..(json.len(users) as i64) { if strings.equal(text(json.at(users,i),"username"),username) { listed = true } }
        if !listed || strings.equal(username,"devos") || strings.equal(username,text(system,"currentUser")) { return kit.failure("Choose another user on this device.") }
        let ran = hw.run(switchCommand(root,username),30000)
        if ran.code != 0 { return kit.failure("Could not switch user: " + strings.trim(ran.out)) }
        return frame(state.value)
    }
    return kit.failure("Unsupported action")
}
fn main():i32 {
    let root = args.len() > 0 ? args.get(0) : "."
    while true {
        let line = io.read_line(); if strings.equal(line,"") { break }
        print(handle(root,line))
    }
    return 0
}
return main()
