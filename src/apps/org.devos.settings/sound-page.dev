#!/usr/bin/env d
# Data worker of the native Sound page (the audio.ts / audio.backend.ts of the JS page). It runs `pactl` (PulseAudio or PipeWire-pulse) with
# separate arguments, checks every request, and turns the sinks, sources and playing applications into a frame. One JSON request per line:
#   {"action":"get"}
#   {"action":"volume","kind":"sink"|"source"|"sink-input","id":3,"value":55}     {"action":"mute","kind":"sink","id":3,"muted":true}
#   {"action":"select","kind":"sink"|"source","name":"alsa_output..."}              {"action":"route","id":12,"output":3}
# Every change is followed by a fresh read. Frame (records separated by ASCII 30; text never holds tabs, newlines or ASCII 30):
#   V defaultOutput defaultInput
#   O id name title volume muted     (outputs)    I id name title volume muted  (inputs, monitors left out)
#   P id name title volume muted device  (playing applications)      E message
# Test hook (only with DEVOS_SETTINGS_TEST=1): DEVOS_SETTINGS_HELPERS, a folder holding a stand-in `pactl`.
use "std/args"
use "std/io"
use "std/process"
use "std/json"
use "std/strings"
use "std/result"
use "std/encoding"
use "../../../lib/hw.dev" as hw

fn rs():str { return encoding.decode(Vec<u8>(30),"utf8") }
fn clean(value:str):str {
    let out = strings.replaceAll(value,"\t"," "); out = strings.replaceAll(out,"\r"," "); out = strings.replaceAll(out,"\n"," ")
    return strings.replaceAll(out,rs()," ")
}
fn text(value:json.Value, key:str):str { return json.has(value,key) && strings.equal(json.kind(json.get(value,key)),"string") ? json.string(json.get(value,key)) : "" }
fn bool(value:json.Value, key:str):bool { return json.has(value,key) && strings.equal(json.kind(json.get(value,key)),"bool") && json.bool(json.get(value,key)) }
fn failure(message:str):str { return "E\t" + clean(message) }
fn testing():bool { return process.hasEnv("DEVOS_SETTINGS_TEST") }
fn pactl():str { return testing() && process.hasEnv("DEVOS_SETTINGS_HELPERS") ? process.getenv("DEVOS_SETTINGS_HELPERS") + "/pactl" : "pactl" }
struct Reply { error: str, out: str }
fn pa(args:Vec<str>):Reply {
    let argv = Vec<str>("env","LC_ALL=C",pactl())
    for a in args { argv.push(a) }
    let ran = hw.run(argv,5000)
    if ran.code != 0 { return Reply(strings.equal(strings.trim(ran.out),"") ? "The audio service did not respond." : strings.trim(ran.out),"") }
    return Reply("",ran.out)
}
struct Item { id: i64, name: str, title: str, volume: i64, muted: bool, device: i64 }
fn number(value:json.Value, key:str, fallback:f64):f64 { return json.has(value,key) && strings.equal(json.kind(json.get(value,key)),"number") ? json.float(json.get(value,key)) : fallback }
# One pactl JSON entry. Volume is the mean of the channels as a percentage (value / 65536 * 100), rounded; the title is the description or
# the application / media name.
fn item(entry:json.Value):Item {
    let props = json.has(entry,"properties") && strings.equal(json.kind(json.get(entry,"properties")),"object") ? json.get(entry,"properties") : json.object()
    let title = text(entry,"description")
    if strings.equal(title,"") { title = text(props,"application.name") }
    if strings.equal(title,"") { title = text(props,"media.name") }
    if strings.equal(title,"") { title = text(entry,"name") }
    if strings.equal(title,"") { title = "Application" }
    let sum = 0.0; let count = 0
    if json.has(entry,"volume") && strings.equal(json.kind(json.get(entry,"volume")),"object") {
        let channels = json.get(entry,"volume")
        for key in json.keys(channels) {
            let channel = json.get(channels,key)
            if strings.equal(json.kind(channel),"object") && json.has(channel,"value") && strings.equal(json.kind(json.get(channel,"value")),"number") { sum = sum + json.float(json.get(channel,"value")) / 65536.0 * 100.0; count = count + 1 }
        }
    }
    let volume = count > 0 ? ((sum / (count as f64) + 0.5) as i64) : 0
    let name = text(entry,"name"); let id = number(entry,"index",0.0 - 1.0)
    return Item(id as i64,strings.equal(name,"") ? "${id as i64}" : name,title,volume,bool(entry,"mute"),number(entry,"sink",0.0 - 1.0) as i64)
}
fn list(kind:str):json.Value {
    let reply = pa(Vec<str>("--format=json","list",kind))
    if !strings.equal(reply.error,"") { return json.null_value() }
    let parsed = result.attempt(fn():json.Value { return json.parse(strings.trim(reply.out)) })
    if result.isErr(parsed) || !strings.equal(json.kind(result.unwrap(parsed)),"array") { return json.null_value() }
    return result.unwrap(parsed)
}
fn row(letter:str, i:Item, withDevice:bool):str {
    return rs() + letter + "\t${i.id}\t" + clean(i.name) + "\t" + clean(i.title) + "\t${i.volume}\t" + (i.muted ? "1" : "0") + (withDevice ? "\t${i.device}" : "")
}
fn frame():str {
    let sinks = list("sinks"); let sources = list("sources"); let streams = list("sink-inputs")
    if json.is_null(sinks) || json.is_null(sources) || json.is_null(streams) { return failure("The audio service did not respond.") }
    let info = pa(Vec<str>("--format=json","info"))
    if !strings.equal(info.error,"") { return failure(info.error) }
    let parsed = result.attempt(fn():json.Value { return json.parse(strings.trim(info.out)) })
    if result.isErr(parsed) || !strings.equal(json.kind(result.unwrap(parsed)),"object") { return failure("The audio service did not respond.") }
    let details = result.unwrap(parsed)
    let out = "V\t" + clean(text(details,"default_sink_name")) + "\t" + clean(text(details,"default_source_name"))
    for i in 0..(json.len(sinks) as i64) { if strings.equal(json.kind(json.at(sinks,i)),"object") { out = out + row("O",item(json.at(sinks,i)),false) } }
    for i in 0..(json.len(sources) as i64) {
        if !strings.equal(json.kind(json.at(sources,i)),"object") { continue }
        let s = item(json.at(sources,i))
        if strings.endsWith(text(json.at(sources,i),"name"),".monitor") { continue }
        out = out + row("I",s,false)
    }
    for i in 0..(json.len(streams) as i64) { if strings.equal(json.kind(json.at(streams,i)),"object") { out = out + row("P",item(json.at(streams,i)),true) } }
    return out
}
fn idOk(value:json.Value, key:str):bool {
    if !json.has(value,key) || !strings.equal(json.kind(json.get(value,key)),"number") { return false }
    let n = json.float(json.get(value,key))
    return n >= 0.0 && n < 2147483648.0 && (n as i64) as f64 == n
}
fn kindOk(kind:str, allowInput:bool):bool { return strings.equal(kind,"sink") || strings.equal(kind,"source") || (allowInput && strings.equal(kind,"sink-input")) }
fn nameOk(name:str):bool {
    if strings.equal(name,"") || strings.startsWith(name,"-") || strings.charLength(name) > 256 { return false }
    for b in encoding.encode(name,"utf8") { if b < 32 || b == 127 { return false } }
    return true
}
fn change(args:Vec<str>):str {
    let reply = pa(args)
    if !strings.equal(reply.error,"") { return failure(reply.error) }
    return frame()
}
fn handle(line:str):str {
    let parsed = result.attempt(fn():json.Value { return json.parse(line) })
    if result.isErr(parsed) { return failure("Invalid service request") }
    let r = result.unwrap(parsed)
    if !strings.equal(json.kind(r),"object") { return failure("Expected an object request") }
    let action = text(r,"action"); let kind = text(r,"kind")
    if strings.equal(action,"get") { return frame() }
    if strings.equal(action,"volume") {
        if !kindOk(kind,true) || !idOk(r,"id") || !(json.has(r,"value") && strings.equal(json.kind(json.get(r,"value")),"number")) { return failure("Invalid volume.") }
        let value = json.float(json.get(r,"value")); if value < 0.0 { value = 0.0 }; if value > 100.0 { value = 100.0 }
        return change(Vec<str>("set-" + kind + "-volume","${json.int(json.get(r,"id"))}","${(value + 0.5) as i64}%"))
    }
    if strings.equal(action,"mute") {
        if !kindOk(kind,true) || !idOk(r,"id") || !(json.has(r,"muted") && strings.equal(json.kind(json.get(r,"muted")),"bool")) { return failure("Invalid audio device.") }
        return change(Vec<str>("set-" + kind + "-mute","${json.int(json.get(r,"id"))}",bool(r,"muted") ? "1" : "0"))
    }
    if strings.equal(action,"select") {
        if !kindOk(kind,false) || !nameOk(text(r,"name")) { return failure("Invalid audio device.") }
        return change(Vec<str>("set-default-" + kind,text(r,"name")))
    }
    if strings.equal(action,"route") {
        if !idOk(r,"id") || !idOk(r,"output") { return failure("Invalid audio device.") }
        return change(Vec<str>("move-sink-input","${json.int(json.get(r,"id"))}","${json.int(json.get(r,"output"))}"))
    }
    return failure("Unsupported action")
}
fn main():i32 {
    while true {
        let line = io.read_line(); if strings.equal(line,"") { break }
        print(handle(line))
    }
    return 0
}
return main()
