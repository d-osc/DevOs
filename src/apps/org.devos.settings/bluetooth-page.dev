#!/usr/bin/env d
# Data worker of the native Bluetooth page. It runs bin/dev-os-devices-linux (BlueZ over D-Bus; inside WSL the helper still lists what Linux
# can see and opens the Windows pages), checks the shape of every request and of every answer, and turns the state into a frame. Pairing is
# not here: it needs a BlueZ agent (org.bluez.Agent1) that the JS page still provides. One JSON request per line on stdin:
#   {"action":"get"}   {"action":"scan"}   {"action":"power","id":"/org/bluez/hci0","powered":true}   {"action":"settings","page":"bluetooth"}
#   {"action":"connect"|"disconnect"|"forget","id":"/org/bluez/hci0/dev_AA_BB_CC_DD_EE_FF"}
# Frame (records separated by ASCII 30; text cells never contain tabs, newlines or ASCII 30):
#   V host bluetoothError message
#   A id name powered                                   (adapters)
#   D id adapter name named address icon paired connected   (devices, already sorted by the helper)
#   U name vendor    (USB)      I name vendor    (input devices)
#   E message
# Test hooks (only with DEVOS_SETTINGS_TEST=1): DEVOS_SETTINGS_HELPERS, DEVOS_BLUETOOTH_MODE=linux|windows.
use "std/args"
use "std/fs"
use "std/io"
use "std/process"
use "std/json"
use "std/strings"
use "std/result"
use "std/encoding"
use "../../../lib/hw.dev" as hw
use "../../../lib/posix.dev" as posix
use "./worker-kit.dev" as kit

fn text(value:json.Value, key:str):str { return json.has(value,key) && strings.equal(json.kind(json.get(value,key)),"string") ? json.string(json.get(value,key)) : "" }
fn bool(value:json.Value, key:str):bool { return json.has(value,key) && strings.equal(json.kind(json.get(value,key)),"bool") && json.bool(json.get(value,key)) }
fn testing():bool { return process.hasEnv("DEVOS_SETTINGS_TEST") }
fn windows():bool {
    if testing() && process.hasEnv("DEVOS_BLUETOOTH_MODE") { return strings.equal(process.getenv("DEVOS_BLUETOOTH_MODE"),"windows") }
    let release = fs.existsSync("/proc/sys/kernel/osrelease") ? fs.readFileSync("/proc/sys/kernel/osrelease","utf8") : ""
    return strings.contains(strings.toLowerCase(release),"microsoft")
}
struct Answer { error: str, state: json.Value }
fn request(root:str, payload:json.Value, seconds:i64):Answer {
    let directory = testing() && process.hasEnv("DEVOS_SETTINGS_HELPERS") ? process.getenv("DEVOS_SETTINGS_HELPERS") : root + "/bin"
    let ran = hw.runInput(Vec<str>("d",directory + "/dev-os-devices-linux"),json.stringify(payload),seconds * 1000)
    if ran.code == 127 { return Answer("The Bluetooth request timed out. Check the Bluetooth service.",json.null_value()) }
    let parsed = result.attempt(fn():json.Value { return json.parse(strings.trim(ran.out)) })
    if result.isErr(parsed) || !strings.equal(json.kind(result.unwrap(parsed)),"object") { return Answer("The device helper returned no valid data. Check the installed desktop package.",json.null_value()) }
    let value = result.unwrap(parsed)
    if !bool(value,"ok") { return Answer(text(value,"error") == "" ? "The Bluetooth request failed." : text(value,"error"),json.null_value()) }
    return Answer("",json.has(value,"state") ? json.get(value,"state") : json.null_value())
}
# BlueZ object paths: /org/bluez/hciN (adapter) or /org/bluez/hciN/dev_XX_XX_XX_XX_XX_XX (device).
fn pathOk(value:str):bool {
    if !strings.startsWith(value,"/org/bluez/hci") || strings.charLength(value) > 80 { return false }
    for i in 0..(strings.charLength(value) as i64) { if !strings.contains("/_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ",strings.substring(value,i,i + 1)) { return false } }
    return true
}
fn listOf(state:json.Value, key:str):json.Value { return json.has(state,key) ? json.get(state,key) : json.null_value() }
fn objects(state:json.Value, key:str):bool {
    let list = listOf(state,key)
    if !strings.equal(json.kind(list),"array") { return false }
    for i in 0..(json.len(list) as i64) { if !strings.equal(json.kind(json.at(list,i)),"object") { return false } }
    return true
}
fn frame(state:json.Value, message:str):str {
    if !strings.equal(json.kind(state),"object") { return kit.failure("Device settings helper returned no state.") }
    for key in Vec<str>("adapters","devices","usb","inputs") { if !objects(state,key) { return kit.failure("Invalid device list returned by the system.") } }
    let out = "V\t" + (windows() ? "Windows" : "Linux") + "\t" + kit.clean(text(state,"bluetoothError")) + "\t" + kit.clean(message)
    let adapters = listOf(state,"adapters")
    for i in 0..(json.len(adapters) as i64) {
        let a = json.at(adapters,i)
        if !pathOk(text(a,"id")) { return kit.failure("Invalid Bluetooth adapter returned by the system.") }
        out = out + kit.rs() + "A\t" + text(a,"id") + "\t" + kit.clean(text(a,"name")) + "\t" + (bool(a,"powered") ? "1" : "0")
    }
    let devices = listOf(state,"devices")
    for i in 0..(json.len(devices) as i64) {
        let d = json.at(devices,i)
        if !pathOk(text(d,"id")) || !pathOk(text(d,"adapter")) { return kit.failure("Invalid Bluetooth device returned by the system.") }
        let named = !(json.has(d,"named") && strings.equal(json.kind(json.get(d,"named")),"bool") && !json.bool(json.get(d,"named")))
        out = out + kit.rs() + "D\t" + text(d,"id") + "\t" + text(d,"adapter") + "\t" + kit.clean(text(d,"name")) + "\t" + (named ? "1" : "0") + "\t" + kit.clean(text(d,"address")) + "\t" + kit.clean(text(d,"icon")) + "\t" + (bool(d,"paired") ? "1" : "0") + "\t" + (bool(d,"connected") ? "1" : "0")
    }
    let usb = listOf(state,"usb")
    for i in 0..(json.len(usb) as i64) { let u = json.at(usb,i); out = out + kit.rs() + "U\t" + kit.clean(text(u,"name")) + "\t" + kit.clean(text(u,"vendor")) }
    let inputs = listOf(state,"inputs")
    for i in 0..(json.len(inputs) as i64) { let u = json.at(inputs,i); out = out + kit.rs() + "I\t" + kit.clean(text(u,"name")) + "\t" + kit.clean(text(u,"vendor")) }
    let p = pairing()
    return out + kit.rs() + "P\t" + p.state + "\t" + p.kind + "\t" + kit.clean(p.code) + "\t" + kit.clean(p.message) + "\t" + kit.clean(p.device)
}

# Pairing. The agent program (native/devos-bluetooth-agent.c) does the D-Bus part and talks to this worker through two files in a private folder:
# `state` (written by the agent) and `response` (written here). A pairing that is over is reported once and its folder removed.
fn stateDir():str { return testing() && process.hasEnv("DEVOS_BLUETOOTH_STATE") ? process.getenv("DEVOS_BLUETOOTH_STATE") : (process.hasEnv("XDG_RUNTIME_DIR") ? process.getenv("XDG_RUNTIME_DIR") : "/tmp") + "/devos-bluetooth-pairing" }
fn agentProgram(root:str):str { return testing() && process.hasEnv("DEVOS_BLUETOOTH_AGENT") ? process.getenv("DEVOS_BLUETOOTH_AGENT") : root + "/dist/native/devos-bluetooth-agent" }
struct Pairing { state: str, kind: str, code: str, message: str, device: str }
fn noPairing():Pairing { return Pairing("none","","","","") }
fn deviceFile():str { return stateDir() + "/device" }
fn seconds(command:Vec<str>):i64 {
    let ran = hw.run(command,5000); let n = 0
    if ran.code != 0 { return 0 }
    for b in encoding.encode(strings.trim(ran.out),"utf8") { if b < 48 || b > 57 { return 0 }; n = n * 10 + ((b - 48) as i64) }
    return n
}
fn pairing():Pairing {
    let file = stateDir() + "/state"
    if !fs.existsSync(file) { return noPairing() }
    let device = fs.existsSync(deviceFile()) ? strings.trim(fs.readFileSync(deviceFile(),"utf8")) : ""
    let parts = strings.split(strings.trim(fs.readFileSync(file,"utf8")),"\t")
    let p = noPairing()
    if strings.equal(parts[0],"pairing") { p = Pairing("pairing","","","",device) }
    else if strings.equal(parts[0],"prompt") && parts.len() >= 3 { p = Pairing("prompt",parts[1],parts[2],"",device) }
    else if strings.equal(parts[0],"display") && parts.len() >= 2 { p = Pairing("display","",parts[1],"",device) }
    else if strings.equal(parts[0],"done") { p = Pairing("done","","","",device) }
    else if strings.equal(parts[0],"error") { p = Pairing("error","","",parts.len() >= 2 ? parts[1] : "Pairing failed.",device) }
    else { return noPairing() }
    # An agent that stopped without a last word (BlueZ gives up after 90 s) must not hold the page in "pairing" forever.
    let waiting = strings.equal(p.state,"pairing") || strings.equal(p.state,"prompt") || strings.equal(p.state,"display")
    if waiting && seconds(Vec<str>("date","+%s")) - seconds(Vec<str>("stat","-c","%Y",file)) > 120 { return Pairing("error","","","The pairing agent stopped. Try again.",device) }
    return p
}
fn pairingActive():bool { let p = pairing(); return strings.equal(p.state,"pairing") || strings.equal(p.state,"prompt") || strings.equal(p.state,"display") }
fn writeAtomic(name:str, content:str) {
    fs.writeFileSync(stateDir() + "/" + name + ".tmp",content)
    fs.renameSync(stateDir() + "/" + name + ".tmp",stateDir() + "/" + name)
}
fn quoteOk(value:str):bool { return !strings.contains(value,"'") && !strings.contains(value,"\n") }
fn clearPairing() { hw.run(Vec<str>("rm","-rf",stateDir()),5000) }
fn knownUnpaired(root:str, id:str):bool {
    let ran = request(root,{action:"get"},20)
    if !strings.equal(ran.error,"") || !strings.equal(json.kind(ran.state),"object") { return false }
    let devices = listOf(ran.state,"devices")
    if !strings.equal(json.kind(devices),"array") { return false }
    for i in 0..(json.len(devices) as i64) { let d = json.at(devices,i); if strings.equal(text(d,"id"),id) && !bool(d,"paired") { return true } }
    return false
}
fn startPairing(root:str, r:json.Value):str {
    let id = text(r,"id")
    if !pathOk(id) || !strings.contains(id,"/dev_") { return kit.failure("Choose a Bluetooth device first.") }
    if pairingActive() { return kit.failure("Another pairing request is in progress.") }
    if !knownUnpaired(root,id) { return kit.failure("Device is no longer available. Refresh the list.") }
    let agent = agentProgram(root)
    if !quoteOk(agent) || !quoteOk(stateDir()) || !fs.existsSync(agent) { return kit.failure("The Bluetooth pairing helper is missing. Reinstall the current DevOs runtime.") }
    clearPairing()
    fs.mkdirSync(stateDir(),true)
    fs.writeFileSync(deviceFile(),id + "\n")
    writeAtomic("state","pairing")
    posix.shell("'" + agent + "' '" + id + "' '" + stateDir() + "' >/dev/null 2>&1 &")
    return read(root,"")
}
# The user's answer to the pending request. PIN: 1 to 16 characters; passkey: up to six digits.
fn respond(root:str, r:json.Value):str {
    let p = pairing()
    if !strings.equal(p.state,"prompt") { return kit.failure("There is no pairing request to answer.") }
    if !(json.has(r,"accept") && strings.equal(json.kind(json.get(r,"accept")),"bool")) { return kit.failure("Invalid pairing answer.") }
    if !bool(r,"accept") { writeAtomic("response","decline"); return read(root,"") }
    let value = text(r,"value")
    if strings.equal(p.kind,"pin") && (strings.charLength(value) < 1 || strings.charLength(value) > 16 || !noControl(value)) { return kit.failure("Enter a PIN of 1–16 characters.") }
    if strings.equal(p.kind,"passkey") {
        let ok = strings.charLength(value) >= 1 && strings.charLength(value) <= 6
        for b in encoding.encode(value,"utf8") { if b < 48 || b > 57 { ok = false } }
        if !ok { return kit.failure("Enter a passkey of up to six digits.") }
    }
    writeAtomic("response","accept\t" + (strings.equal(p.kind,"pin") || strings.equal(p.kind,"passkey") ? value : ""))
    return read(root,"")
}
fn noControl(value:str):bool {
    for b in encoding.encode(value,"utf8") { if b < 32 || b == 127 { return false } }
    return true
}
fn poll(root:str):str {
    let answer = read(root,"")
    let p = pairing()
    if strings.equal(p.state,"done") || strings.equal(p.state,"error") { clearPairing() }
    return answer
}
fn read(root:str, message:str):str {
    let answer = request(root,{action:"get"},20)
    if !strings.equal(answer.error,"") { return kit.failure(answer.error) }
    return frame(answer.state,message)
}
fn answer(root:str, payload:json.Value, seconds:i64, message:str):str {
    let ran = request(root,payload,seconds)
    if !strings.equal(ran.error,"") { return kit.failure(ran.error) }
    return frame(ran.state,message)
}
fn handle(root:str, line:str):str {
    let parsed = result.attempt(fn():json.Value { return json.parse(line) })
    if result.isErr(parsed) { return kit.failure("Invalid service request") }
    let r = result.unwrap(parsed)
    if !strings.equal(json.kind(r),"object") { return kit.failure("Expected an object request") }
    let action = text(r,"action")
    if strings.equal(action,"get") { return read(root,"") }
    if strings.equal(action,"scan") { return answer(root,{action:"scan"},40,"") }
    if strings.equal(action,"pair") { return startPairing(root,r) }
    if strings.equal(action,"pairing") { return poll(root) }
    if strings.equal(action,"respond") { return respond(root,r) }
    if strings.equal(action,"cancelPair") {
        if pairingActive() { writeAtomic("response","cancel") }
        return read(root,"")
    }
    if strings.equal(action,"settings") {
        let page = text(r,"page")
        if !(strings.equal(page,"bluetooth") || strings.equal(page,"mouse") || strings.equal(page,"keyboard") || strings.equal(page,"printers")) { return kit.failure("Unknown devices settings page.") }
        let opened = request(root,{action:"settings",page:page},20)
        if !strings.equal(opened.error,"") { return kit.failure(opened.error) }
        return read(root,"")
    }
    if strings.equal(action,"power") {
        if !pathOk(text(r,"id")) || strings.contains(text(r,"id"),"/dev_") || !(json.has(r,"powered") && strings.equal(json.kind(json.get(r,"powered")),"bool")) { return kit.failure("Invalid Bluetooth adapter or power state.") }
        return answer(root,{action:"power",id:text(r,"id"),powered:bool(r,"powered")},20,"")
    }
    if strings.equal(action,"connect") || strings.equal(action,"disconnect") || strings.equal(action,"forget") {
        if !pathOk(text(r,"id")) || !strings.contains(text(r,"id"),"/dev_") { return kit.failure("Choose a Bluetooth device first.") }
        return answer(root,{action:action,id:text(r,"id")},30,"")
    }
    return kit.failure("Unsupported action")
}
fn main():i32 {
    let root = args.len() > 0 ? args.get(0) : "."
    while true {
        let line = io.read_line(); if strings.equal(line,"") { break }
        print(handle(root,line))
    }
    return 0
}
return main()
