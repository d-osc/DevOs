#!/usr/bin/env d
# Loopback server of the native Editor window. It serves only the bundled Monaco files (dist/editor), because Monaco's language workers need an
# HTTP origin and file:// pages cannot start them. The window picks the port and the secret path segment and passes them in the environment:
#   DEVOS_EDITOR_PORT, DEVOS_EDITOR_TOKEN (files are served at /<token>/<file>), DEV_OS_ROOT (the folder that holds dist/editor).
# DEVOS_EDITOR_OWNER is the window's process id: listen never returns, so a watcher ends this server when the window is gone.
# Every bundled file is text (the icon font is inlined into app.css by the build), which is all std/http can send.
use "std/http"
use "std/fs"
use "std/process"
use "std/strings"
use "std/json"
use "../../../lib/posix.dev" as posix

extern fn getpid(): i32

fn contentType(path:str):str {
    if strings.endsWith(path,".html") { return "text/html; charset=utf-8" }
    if strings.endsWith(path,".js") { return "text/javascript; charset=utf-8" }
    if strings.endsWith(path,".css") { return "text/css; charset=utf-8" }
    if strings.endsWith(path,".json") { return "application/json; charset=utf-8" }
    return "text/plain; charset=utf-8"
}
# The file below dist/editor for a request path, or "" when the path is not a plain file name under the token.
fn target(url:str, token:str):str {
    let path = strings.contains(url,"?") ? strings.substring(url,0,strings.indexOf(url,"?")) : url
    let prefix = "/" + token + "/"
    if !strings.startsWith(path,prefix) { return "" }
    let relative = strings.substring(path,strings.charLength(prefix),strings.charLength(path))
    if strings.equal(relative,"") { relative = "index.html" }
    if strings.contains(relative,"..") || strings.contains(relative,"\\") || strings.contains(relative,"//") || strings.startsWith(relative,"/") { return "" }
    return relative
}
fn main():i32 {
    let token = process.getenv("DEVOS_EDITOR_TOKEN")
    let base = process.getenv("DEV_OS_ROOT") + "/dist/editor/"
    let port = json.int(json.parse(process.getenv("DEVOS_EDITOR_PORT")))
    let server = http.createServer(fn(req:http.IncomingMessage, res:http.ServerResponse) {
        let relative = target(req.url,token)
        if !strings.equal(req.method,"GET") || strings.equal(relative,"") || !fs.existsSync(base + relative) || fs.is_dir(base + relative) { res.statusCode = 404; res.end("Not found"); return }
        res.setHeader("Content-Type",contentType(relative))
        res.setHeader("X-Content-Type-Options","nosniff")
        res.setHeader("Content-Security-Policy","default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; worker-src 'self' blob:; connect-src 'self'")
        res.end(fs.readFileSync(base + relative,"utf8"))
    })
    let me: i32 = 0
    unsafe { me = getpid() }
    posix.shell("(while kill -0 " + process.getenv("DEVOS_EDITOR_OWNER") + " 2>/dev/null; do sleep 1; done; kill " + "${me}" + ") >/dev/null 2>&1 &")
    server.listen(port)
    return 0
}
return main()
