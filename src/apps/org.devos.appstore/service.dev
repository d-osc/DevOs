#!/usr/bin/env d
# Data worker of the native App Store window. It reads the shared app-db catalog through pm-cli, lists what DevOsPM (`dev`) has installed, and installs,
# removes and rolls back packages by running `dev` with separate arguments: DevOsPM extracts, checks and registers the files, this worker only
# delegates catalog downloads and database writes to pm-cli, or hands over a package file the user chose. One JSON request per line:
#   {"action":"catalog"}                       {"action":"installed"}
#   {"action":"installApp","id":"firefox"}     (download the catalog's ARM64 package, install it, remember which catalog app it is)
#   {"action":"installFile","path":"/abs/file.dpk"}      {"action":"remove","id":"hello"}      {"action":"rollback","id":"hello"}
# Every answer is a frame (records separated by ASCII 30; cells never hold tabs or newlines):
#   V message                                              the first record
#     catalog's third cell is "inventory" when its P records are included atomically
#   A id name publisher category summary homepage format boundPackage softwareType
#   X id name publisher summary status version                            extension catalog
#   P id version kind files bytes previous commands title description     what is installed
#     P also carries displayIcon and the PM's softwareType after description
#   E message
# Test hooks (only with DEVOS_APPSTORE_TEST=1): DEVOS_APPSTORE_REGISTRY, DEVOS_APPSTORE_CURL, DEVOS_APPSTORE_ARCH, DEVOS_APPSTORE_TMP.
# The package manager is DEV_OS_PM when set, else the first of `dev` in PATH, <root>/bin/dev, <root>/build/wsl/bin/dev, ~/.local/bin/dev that answers `--version`.
use "std/args"
use "std/io"
use "std/fs"
use "std/process"
use "std/json"
use "std/strings"
use "std/result"
use "../../../lib/hw.dev" as hw
use "../../../lib/worker-kit.dev" as kit
use "./package-rules.dev" as rules

fn text(value:json.Value, key:str):str { return json.has(value,key) && strings.equal(json.kind(json.get(value,key)),"string") ? json.string(json.get(value,key)) : "" }
fn obj(value:json.Value, key:str):json.Value { return json.has(value,key) && strings.equal(json.kind(json.get(value,key)),"object") ? json.get(value,key) : json.object() }
fn list(value:json.Value, key:str):json.Value { return json.has(value,key) && strings.equal(json.kind(json.get(value,key)),"array") ? json.get(value,key) : json.array() }
fn testing():bool { return process.hasEnv("DEVOS_APPSTORE_TEST") }
fn setting(name:str, fallback:str):str { return testing() && process.hasEnv(name) ? process.getenv(name) : fallback }
fn env(name:str, fallback:str):str { return process.hasEnv(name) ? process.getenv(name) : fallback }
fn home():str { return env("HOME","/") }
fn dataHome():str { return env("XDG_DATA_HOME",home() + "/.local/share") }
fn quote(value:str):str { return "'" + strings.replaceAll(value,"'","'\\''") + "'" }

# --- the package manager ---
fn answers(path:str):bool {
    if strings.equal(path,"") || !fs.is_file(path) { return false }
    let ran = hw.run(Vec<str>(path,"--version"),10000)
    if ran.code != 0 { return false }
    let words = strings.split(strings.trim(ran.out)," ")
    if words.len() != 2 || !strings.equal(words[0],"dev") { return false }
    let parts = strings.split(words[1],".")
    return parts.len() >= 3 && !strings.equal(parts[0],"") && !strings.equal(parts[1],"")
}
fn devBinary(root:str):str {
    if process.hasEnv("DEV_OS_PM") { return answers(process.getenv("DEV_OS_PM")) ? process.getenv("DEV_OS_PM") : "" }
    let found = strings.trim(hw.run(Vec<str>("sh","-c","command -v dev"),5000).out)
    for candidate in Vec<str>(found,root + "/bin/dev",root + "/build/wsl/bin/dev",home() + "/.local/bin/dev","/usr/local/bin/dev","/usr/bin/dev") { if answers(candidate) { return candidate } }
    return ""
}
fn pm(root:str, arguments:Vec<str>, seconds:i64):hw.Run {
    let binary = devBinary(root)
    if strings.equal(binary,"") { return hw.Run(127,"The dev package manager is unavailable. For WSL development, run sh tools/setup/bootstrap-pm.sh and reopen App Store.") }
    # stderr is merged into the output, where `dev` writes its refusals ("dev: ...").
    let argv = Vec<str>("sh","-c","exec \"$@\" 2>&1","sh","env","NO_COLOR=1","TERM=dumb",binary)
    for a in arguments { argv.push(a) }
    return hw.run(argv,seconds * 1000)
}

# --- Read-only migration of old UI bindings; the PM registry owns current bindings. ---
fn storeIdentity():str {
    let store = process.hasEnv("DEV_ROOT") ? process.getenv("DEV_ROOT") : dataHome() + "/devos"
    return strings.trim(hw.run(Vec<str>("sh","-c","printf %s \"$1\" | sha256sum | cut -d' ' -f1","sh",store),5000).out)
}
fn bindingPath():str { return dataHome() + "/dev-os/app-store/bindings-" + storeIdentity() + ".json" }
fn bindings():json.Value {
    let path = bindingPath()
    if !fs.existsSync(path) || fs.existsSync(path + ".migrated") { return json.object() }
    let parsed = result.attempt(fn():json.Value { return json.parse(fs.readFileSync(path,"utf8")) })
    return result.isErr(parsed) || !strings.equal(json.kind(result.unwrap(parsed)),"object") ? json.object() : result.unwrap(parsed)
}
fn packageName(value:str):bool {
    if strings.equal(value,"") || strings.charLength(value) > 64 { return false }
    for i in 0..(strings.charLength(value) as i64) {
        let c = strings.substring(value,i,i + 1)
        if !strings.contains("abcdefghijklmnopqrstuvwxyz0123456789_-",c) || (i == 0 && (strings.equal(c,"-") || strings.equal(c,"_"))) { return false }
    }
    return true
}

# --- the catalog ---
fn categoryOf(id:str):str {
    if strings.equal(id,"developer-tools") { return "Developer Tools" }
    if strings.equal(id,"web-browsers") { return "Internet" }
    if strings.equal(id,"productivity") { return "Productivity" }
    if strings.equal(id,"creative") { return "Creative" }
    if strings.equal(id,"media") { return "Media" }
    return "Other"
}
fn safeWebsite(address:str):bool {
    if !strings.startsWith(address,"https://") || strings.contains(address," ") || strings.contains(address,"\\") { return false }
    let rest = strings.substring(address,8,strings.charLength(address))
    let slash = strings.indexOf(rest,"/")
    let host = slash < 0 ? rest : strings.substring(rest,0,slash)
    return !strings.equal(host,"") && !strings.contains(host,"@") && !strings.contains(host,"?") && !strings.contains(host,"#")
}
struct App { id: str, name: str, publisher: str, category: str, summary: str, homepage: str, url: str, format: str, software_type: str }
fn registry(root:str):json.Value {
    let ran = pm(root,Vec<str>("catalog","--summary","--json"),30)
    if ran.code != 0 { return json.null_value() }
    let parsed = result.attempt(fn():json.Value { return json.parse(strings.trim(ran.out)) })
    if result.isErr(parsed) { return json.null_value() }; return result.unwrap(parsed)
}
fn migrateBindings(root:str, data:json.Value):json.Value {
    let legacy = bindings(); if json.len(legacy) == 0 { return data }
    let known = obj(data,"bindings"); let changed = false; let failed = false
    let inventory = pm(root,Vec<str>("list","--summary","--json"),30)
    if inventory.code != 0 { return data }
    let parsed = result.attempt(fn():json.Value { return json.parse(strings.trim(inventory.out)) }); if result.isErr(parsed) { return data }
    let packages = obj(result.unwrap(parsed),"packages")
    for id in json.keys(legacy) {
        let name = text(legacy,id); if json.has(known,id) || !packageName(name) || !json.has(packages,name) { continue }
        let exists = false; let rows = list(data,"apps"); for i in 0..(json.len(rows) as i64) { if text(obj(json.at(rows,i),"manifest"),"id") == id { exists = true } }
        if exists { if pm(root,Vec<str>("catalog-bind",id,name),30).code == 0 { changed = true } else { failed = true } }
    }
    if !failed { fs.renameSync(bindingPath(),bindingPath() + ".migrated") }
    return changed ? registry(root) : data
}

fn apps(data:json.Value):Vec<App> {
    let out = Vec<App>()
    if json.is_null(data) { return out }
    let rows = list(data,"apps"); let seen = Vec<str>()
    for i in 0..(json.len(rows) as i64) {
        let manifest = obj(json.at(rows,i),"manifest"); let id = text(manifest,"id")
        if !packageName(id) || strings.equal(text(manifest,"name"),"") || !(json.has(manifest,"schema_version") && strings.equal(json.kind(json.get(manifest,"schema_version")),"number") && json.int(json.get(manifest,"schema_version")) == 2) { continue }
        let duplicate = false; for s in seen { if strings.equal(s,id) { duplicate = true } }
        if duplicate { continue }
        seen.push(id)
        let categories = list(manifest,"categories")
        let candidate = obj(json.at(rows,i),"candidate")
        let url = text(candidate,"file_url"); let format = text(candidate,"format")
        let homepage = text(obj(manifest,"links"),"homepage")
        out.push(App(id,text(manifest,"name"),text(obj(manifest,"publisher"),"name"),categoryOf(json.len(categories) > 0 && strings.equal(json.kind(json.at(categories,0)),"string") ? json.string(json.at(categories,0)) : ""),text(manifest,"summary"),safeWebsite(homepage) ? homepage : "",url,format,text(json.at(rows,i),"softwareType") == "package" ? "package" : "app"))
    }
    return out
}

# --- frames ---
fn installedFrame(root:str, message:str):str {
    let ran = pm(root,Vec<str>("list","--summary","--json"),30)
    if ran.code != 0 { return kit.failure(strings.equal(strings.trim(ran.out),"") ? "Could not list packages." : strings.trim(ran.out)) }
    let parsed = result.attempt(fn():json.Value { return json.parse(strings.trim(ran.out)) })
    if result.isErr(parsed) || !strings.equal(json.kind(result.unwrap(parsed)),"object") { return kit.failure("Could not list packages.") }
    let data = result.unwrap(parsed)
    return "V\t" + kit.clean(message) + installedRecords(data)
}
fn installedRecords(data:json.Value):str {
    let out = ""
    let packages = obj(data,"packages")
    let names = json.keys(packages); names.sort()
    for id in names {
        let item = json.get(packages,id); let active = obj(item,"active"); let manifest = obj(active,"manifest")
        let commands = Vec<str>()
        let bin = obj(manifest,"bin")
        for c in json.keys(bin) { if !strings.equal(c,"") { commands.push(c) } }
        if commands.len() == 0 { commands.push(id) }
        let title = text(manifest,"fullname"); if strings.equal(title,"") { title = text(manifest,"shortname") }; if strings.equal(title,"") { title = id }
        let previous = json.has(item,"previous") && strings.equal(json.kind(json.get(item,"previous")),"object") ? text(obj(json.get(item,"previous"),"manifest"),"version") : ""
        let files = json.has(active,"fileCount") ? json.int(json.get(active,"fileCount")) : (json.keys(obj(active,"files")).len() as i64)
        let bytes = json.has(active,"bytes") && strings.equal(json.kind(json.get(active,"bytes")),"number") ? json.int(json.get(active,"bytes")) : 0
        let icon = text(active,"displayIcon")
        let software_type = text(active,"softwareType")
        if software_type == "" { software_type = text(active,"kind") == "extension" ? "extension" : (icon == "" ? "package" : "app") }
        out = out + kit.rs() + "P\t" + kit.clean(id) + "\t" + kit.clean(text(manifest,"version")) + "\t" + kit.clean(text(active,"kind") == "" ? "app" : text(active,"kind")) + "\t${files}\t${bytes}\t" + kit.clean(previous) + "\t" + kit.clean(strings.join(commands,",")) + "\t" + kit.clean(title) + "\t" + kit.clean(text(manifest,"description")) + "\t" + kit.clean(icon) + "\t" + software_type
    }
    let extensions = obj(data,"extensions")
    let extNames = json.keys(extensions); extNames.sort()
    for id in extNames {
        let item = json.get(extensions,id)
        let count = json.has(item,"fileCount") ? json.int(json.get(item,"fileCount")) : (list(item,"files").len() as i64)
        out = out + kit.rs() + "P\t" + kit.clean(id) + "\t" + kit.clean(text(item,"version")) + "\textension\t${count}\t0\t\t\t" + kit.clean(id) + "\t" + kit.clean(text(item,"description")) + "\t\textension"
    }
    return out
}
fn catalogFrame(root:str):str {
    let data = registry(root)
    if json.is_null(data) { return kit.failure("The app registry is unavailable.") }
    data = migrateBindings(root,data)
    let all = apps(data)
    let bound = obj(data,"bindings")
    let complete = json.has(data,"inventory") && json.kind(json.get(data,"inventory")) == "object"
    let out = complete ? "V\t\tinventory" : "V\t"
    for a in all {
        let software_type = a.software_type
        let installed = obj(obj(obj(data,"inventory"),"packages"),text(bound,a.id))
        let detected = text(obj(installed,"active"),"softwareType")
        if detected == "app" || detected == "package" { software_type = detected }
        out = out + kit.rs() + "A\t" + kit.clean(a.id) + "\t" + kit.clean(a.name) + "\t" + kit.clean(a.publisher) + "\t" + kit.clean(a.category) + "\t" + kit.clean(a.summary) + "\t" + kit.clean(a.homepage) + "\t" + kit.clean(a.format) + "\t" + kit.clean(text(bound,a.id)) + "\t" + software_type
    }
    let extensions = list(data,"extensions")
    for i in 0..(json.len(extensions) as i64) {
        let entry = json.at(extensions,i)
        out = out + kit.rs() + "X\t" + kit.clean(text(entry,"id")) + "\t" + kit.clean(text(entry,"name")) + "\t" + kit.clean(text(obj(entry,"publisher"),"name")) + "\t" + kit.clean(text(entry,"summary")) + "\t" + kit.clean(text(entry,"status")) + "\t" + kit.clean(text(entry,"version"))
    }
    if complete { out = out + installedRecords(obj(data,"inventory")) }
    return out
}

# --- installing ---
# The "Installed NAME VERSION" line of `dev install`, as (name, version, isExtension); name is "" when there is none.
struct Installed { name: str, version: str, extension: bool }
fn parseInstalled(output:str):Installed {
    let found = Installed("","",false)
    for line in strings.split(output,"\n") {
        let words = strings.split(strings.trim(strings.replaceAll(line,"\r","")),"  ")[0]
        let w = strings.split(strings.trim(strings.replaceAll(line,"\r",""))," ")
        if w.len() >= 5 && strings.equal(w[0],"Installed") && strings.equal(w[1],"Dev") && strings.equal(w[2],"OS") && strings.equal(w[3],"extension") { found = Installed(w[4],w.len() > 5 ? w[5] : "",true) }
        else if w.len() >= 3 && strings.equal(w[0],"Installed") { found = Installed(w[1],w[2],false) }
    }
    return found
}
fn failureText(output:str, fallback:str):str {
    let lines = Vec<str>()
    for line in strings.split(output,"\n") { let t = strings.trim(line); let marker = strings.indexOf(t,"dev:"); if marker == 0 || (marker > 0 && strings.contains(t,"[INFO] dev:")) { let message = strings.trim(strings.substring(t,marker + 4,strings.charLength(t))); if !strings.startsWith(message,"warning:") { lines.push(message) } } }
    if lines.len() > 0 { return strings.join(lines," ") }
    return strings.equal(strings.trim(output),"") ? fallback : strings.trim(output)
}
fn installPath(root:str, path:str, replace:bool, catalogId:str):str {
    let arguments = Vec<str>("install")
    if replace { arguments.push("--replace") }
    arguments.push(path)
    let ran = pm(root,arguments,290)
    if ran.code != 0 { return kit.failure(failureText(ran.out,"Installation failed (exit ${ran.code}).")) }
    let done = parseInstalled(ran.out)
    if strings.equal(done.name,"") { return kit.failure(failureText(ran.out,"The package manager did not confirm the installation.")) }
    if !strings.equal(catalogId,"") {
        if done.extension { return kit.failure("An application download must not install an extension.") }
        if !packageName(done.name) { return kit.failure("Cannot determine a valid DevOsPM package name from the downloaded file.") }
        # Catalog bindings are committed atomically by pm-cli, not by this UI worker.
    }
    return installedFrame(root,"Installed " + done.name + " " + done.version + ".")
}
fn hostArch():str { return strings.trim(setting("DEVOS_APPSTORE_ARCH",strings.trim(hw.run(Vec<str>("uname","-m"),5000).out))) }
fn installApp(root:str, id:str):str {
    if !packageName(id) { return kit.failure("Choose a catalog app first.") }
    if !strings.equal(hostArch(),"aarch64") && !strings.equal(hostArch(),"arm64") { return kit.failure("This catalog provides Linux ARM64 packages. Use an ARM64 DevOs system.") }
    if strings.equal(devBinary(root),"") { return kit.failure("The package manager (dev) is not installed or is not available in PATH.") }
    let ran = pm(root,Vec<str>("install",id,"--replace"),290)
    if ran.code != 0 { return kit.failure(failureText(ran.out,"Installation failed (exit ${ran.code}).")) }
    let done = parseInstalled(ran.out)
    if done.name == "" || done.extension { return kit.failure("The package manager did not confirm an application installation.") }
    return installedFrame(root,"Installed " + done.name + " " + done.version + ".")
}

fn packageId(value:str):bool { return packageName(value) }
fn handle(root:str, line:str):str {
    let parsed = result.attempt(fn():json.Value { return json.parse(line) })
    if result.isErr(parsed) { return kit.failure("Invalid service request") }
    let r = result.unwrap(parsed)
    if !strings.equal(json.kind(r),"object") { return kit.failure("Expected an object request") }
    let action = text(r,"action")
    if strings.equal(action,"catalog") { return catalogFrame(root) }
    if strings.equal(action,"installed") { return installedFrame(root,"") }
    if strings.equal(action,"installApp") { return installApp(root,text(r,"id")) }
    if strings.equal(action,"installFile") {
        let path = text(r,"path")
        if !strings.startsWith(path,"/") || strings.contains(path,"\0") || strings.contains(path,"\n") { return kit.failure("Choose a package file with a full path.") }
        if !rules.isPackageFile(path) { return kit.failure("Not a package file (.dpk, .deb, .rpm or .tar.gz expected).") }
        if !fs.is_file(path) { return kit.failure("That file is not there.") }
        return installPath(root,path,true,"")
    }
    if strings.equal(action,"remove") || strings.equal(action,"rollback") {
        if !packageId(text(r,"id")) { return kit.failure("Choose an installed package first.") }
        let ran = pm(root,Vec<str>(action,text(r,"id")),120)
        if ran.code != 0 { return kit.failure(strings.equal(strings.trim(ran.out),"") ? "Could not " + action + " " + text(r,"id") + "." : failureText(ran.out,"")) }
        return installedFrame(root,strings.trim(ran.out))
    }
    return kit.failure("Unsupported action")
}
fn main():i32 {
    let root = args.len() > 0 ? args.get(0) : "."
    while true {
        let line = io.read_line(); if strings.equal(line,"") { break }
        print(handle(root,line))
    }
    return 0
}
return main()
