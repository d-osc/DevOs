use "react_devlang/ui" as ui

# Self-contained new tab page: no network requests until the user navigates.
fn html():ui.Text {return ui.text("<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>New tab</title><style>\n:root{color-scheme:light dark;--bg:#f4f7fa;--fg:#1d2b36;--muted:#71808c;--card:#ffffffc9;--line:#dce5eb;--accent:#297fa5;--wash:#d5eaf1}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% 0,var(--wash),transparent 65%),var(--bg);color:var(--fg);font:15px system-ui,sans-serif;min-height:100vh}main{width:min(680px,calc(100% - 48px));margin:auto;padding:clamp(48px,11vh,112px) 0 48px}.brand{display:flex;align-items:center;gap:10px;font-size:13px;letter-spacing:2px;font-weight:600;color:var(--accent)}.mark{width:30px;height:30px;border:1px solid var(--accent);border-radius:10px;display:grid;place-items:center;font-size:17px;letter-spacing:0}h1{font-size:clamp(36px,5vw,52px);font-weight:550;letter-spacing:-2px;margin:32px 0 12px;line-height:1.12}.subtitle{color:var(--muted);line-height:1.7;margin:0 0 32px}form{display:flex;align-items:center;gap:12px;background:var(--card);border:1px solid var(--line);border-radius:18px;padding:10px 10px 10px 20px;box-shadow:0 12px 40px #00000008}form:focus-within{border-color:var(--accent);box-shadow:0 0 0 3px #489fc71a}.search-icon{width:19px;height:19px;color:var(--muted);flex-shrink:0}input{min-width:0;flex:1;background:transparent;border:0;outline:0;color:var(--fg);font:inherit;padding:10px 0}input::placeholder{color:var(--muted)}button{background:var(--accent);color:white;border:0;border-radius:11px;width:42px;height:42px;cursor:pointer;font-size:22px}button:hover{filter:brightness(1.12)}.section{display:flex;align-items:center;gap:12px;margin:38px 0 14px;font-size:11px;letter-spacing:1.8px;color:var(--muted)}.section:after{content:'';height:1px;background:var(--line);flex:1}.links{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}a{color:inherit;text-decoration:none;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px;display:flex;align-items:center;gap:12px;transition:border-color .12s,background .12s}a:hover{border-color:var(--accent);background:var(--wash)}.site-icon{display:grid;place-items:center;flex-shrink:0;width:36px;height:36px;border-radius:11px;background:var(--wash);color:var(--accent);font-size:17px;font-weight:600}.site-name{font-size:13px;font-weight:600}.site-domain{display:block;color:var(--muted);font-size:11px;margin-top:4px}.hint{color:var(--muted);font-size:12px;margin-top:28px;text-align:center}kbd{border:1px solid var(--line);border-radius:5px;padding:2px 6px;font:11px system-ui}@media(prefers-color-scheme:dark){:root{--bg:#121719;--fg:#e6eef1;--muted:#899ba4;--card:#1a2228b8;--line:#2c3941;--accent:#65b8d6;--wash:#1b3643}button{background:#3488a8}}@media(max-width:540px){.links{grid-template-columns:1fr}main{padding-top:40px}h1{letter-spacing:-1px}}\n</style><main><div class=\"brand\"><span class=\"mark\">↗</span>DEVOS BROWSER</div><h1>A little space to explore.</h1><p class=\"subtitle\">Search for something new. Pick up where curiosity takes you.</p><form action=\"https://duckduckgo.com/\" method=\"get\"><svg class=\"search-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m16 16 5 5\"/></svg><input name=\"q\" aria-label=\"Search the web\" placeholder=\"Search the web\" autocomplete=\"off\" required><button aria-label=\"Search\" type=\"submit\">↗</button></form><div class=\"section\">QUICK LINKS</div><nav class=\"links\" aria-label=\"Quick links\"><a href=\"https://github.com\"><span class=\"site-icon\">&lt;/&gt;</span><span class=\"site-name\">GitHub<span class=\"site-domain\">Build &amp; discover</span></span></a><a href=\"https://developer.mozilla.org\"><span class=\"site-icon\">M</span><span class=\"site-name\">MDN Docs<span class=\"site-domain\">Learn the web</span></span></a><a href=\"https://www.wikipedia.org\"><span class=\"site-icon\">W</span><span class=\"site-name\">Wikipedia<span class=\"site-domain\">Keep exploring</span></span></a></nav><p class=\"hint\">You can also search from the address bar. Press <kbd>Enter</kbd> to go.</p></main></html>")}
