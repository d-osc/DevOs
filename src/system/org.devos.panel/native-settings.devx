use "react_devlang/ui" as ui
use "react_devlang/channel" as channel
use "./native-settings-model.dev" as model
use "./native-wire.dev" as wire
extern fn rc_env(name:str):str
extern fn rd_identity(id:str)
extern fn rd_control(root:*void,id:str,command:str):i32
extern fn rd_app_header_for(root:*void,title:str,icons:str,name:str,icon:str)
extern fn rd_theme_follow(root:*void,snapshot:str,fallback:str)
extern fn rd_default_theme():str
extern fn panel_timer(interval:i32,call:callback(*void):void,data:*void):u32
extern fn panel_untimer(timer:u32,keep:*void)
extern fn panel_flush()
fn label(text:ui.Text,style:str):ui.Node {let props=ui.props();props.className=ui.text(style);props.wrap=true;props.xalign=0.0;return ui.withProps(ui.TextLabel(text),props)}
fn box(nodes:Vec<ui.Node>,horizontal:bool,style:str):ui.Node {let props=ui.props();props.vertical=!horizontal;props.spacing=12;props.className=ui.text(style);return ui.Box(props,nodes)}
fn button(id:str,title:str,enabled:bool,clicked:fn():void):ui.Node {let props=ui.named(id);props.sensitive=enabled;return ui.Button(props,title,clicked)}
fn field(context:*ui.Context,item:model.Field,form:model.Form):ui.Node {
    let value=ui.useText(context,item.value);let edited=ui.useRef(context,0)
    ui.useEffect(context,fn():fn():void {if form.ack>=edited.get() {value.set(item.value)};return ui.noop},Vec<i64>(form.ack))
    let props=ui.props();props.id=ui.concatText(Vec<ui.Text>(ui.text("panel-"),item.key));props.sensitive=item.enabled && !form.busy;let control=ui.Box(ui.props(),Vec<ui.Node>())
    if ui.equalText(item.kind,ui.text("bool")) {props.valign=3;control=ui.Switch(props,channel.integer(value.value)==1,fn(active:bool) {value.set(ui.text(active ? "1" : "0"));edited.set(form.send(model.keyed("toggle",item.key)))})}
    else if ui.equalText(item.kind,ui.text("select")) {control=ui.Select(props,item.options,channel.integer(value.value),fn(index:i64) {value.set(ui.scalarText(index));edited.set(form.send(model.selection(item.key,index)))})}
    else {props.widthChars=4;let input=ui.Entry(props,value.value,fn(text:ui.Text) {value.set(text);edited.set(form.send(model.value("edit",item.key,text)))});let parts=Vec<ui.Node>();for delta in Vec<i64>(-1,1) {let step=ui.props();step.sensitive=props.sensitive;step.id=ui.concatText(Vec<ui.Text>(props.id,ui.text(delta<0 ? "-minus" : "-plus")));let node=ui.Button(step,delta<0 ? "−" : "+",fn() {edited.set(form.send(ui.concatText(Vec<ui.Text>(model.keyed("step",item.key),ui.text(",\"delta\":"),ui.scalarText(delta)))))});if delta<0 {parts.push(node);parts.push(input)}else {parts.push(node)}};parts.push(label(ui.text("px"),"settings-description"));control=box(parts,true,"")}
    let caption=label(item.title,"settings-field-title");caption.props.expand=true;let row=box(Vec<ui.Node>(caption,control),true,"settings-field");row.props.visible=item.visible;return row
}
fn formField(item:model.Field,index:i64,form:model.Form):ui.Node {let props=ui.keyed(index);return ui.component(9860,props,fn(context:*ui.Context):ui.Node {return field(context,item,form)})}
fn editorInput(context:*ui.Context,name:str,key:str,server:ui.Text,form:model.Form):ui.Node {
    let value=ui.useText(context,server);let edited=ui.useRef(context,0);ui.useEffect(context,fn():fn():void {if form.ack>=edited.get() {value.set(server)};return ui.noop},Vec<i64>(form.ack));let props=ui.named(name);props.sensitive=!form.busy;return ui.Entry(props,value.value,fn(input:ui.Text) {value.set(input);edited.set(form.send(model.value("custom-form",ui.text(key),input)))})
}
fn customEditor(context:*ui.Context,form:model.Form):ui.Node {
    let title=editorInput(context,"panel-custom-title","title",form.title,form);let command=editorInput(context,"panel-custom-command","command",form.command,form)
    let rows=Vec<ui.Node>(label(ui.text("Custom actions"),"section-heading"),label(ui.text("${form.custom.len()} / 50 · Only custom actions can be edited or removed."),"settings-description"))
    if form.invalidCustom.bytes.len()>0 {rows.push(label(form.invalidCustom,"error"));rows.push(button("panel-custom-clear-invalid","Clear invalid custom actions",!form.busy,fn() {form.send(model.fragment("custom-clear"))}))}
    else {for i in 0..(form.custom.len() as i64) {let item=form.custom[i];let toggle=ui.props();toggle.sensitive=!form.busy;toggle.valign=3;toggle.id=ui.concatText(Vec<ui.Text>(ui.text("panel-custom-toggle-"),item.id));let actions=Vec<ui.Node>(label(item.title,"settings-field-title"),ui.Switch(toggle,item.enabled,fn(active:bool) {form.send(model.keyed("custom-toggle",item.id))}),button("panel-custom-edit","Edit",!form.busy,fn() {form.send(model.keyed("custom-edit",item.id))}),button("panel-custom-delete","Remove",!form.busy,fn() {form.send(model.keyed("custom-delete",item.id))}));let card=box(Vec<ui.Node>(box(actions,true,""),label(item.command,"settings-description")),false,"files-custom-item");card.props.key=1000+i;rows.push(card)}
        rows.push(label(ui.text(form.editor.bytes.len()>0 ? "Edit custom action" : "New custom action"),"settings-field-title"));rows.push(title);rows.push(command);rows.push(label(ui.text("Commands run in your home folder. {path} and {directory} refer to your home folder. Shell operators and ~ are not expanded."),"settings-description"));rows.push(box(Vec<ui.Node>(button("panel-custom-cancel","Clear form",!form.busy,fn() {form.send(model.fragment("custom-cancel"))}),button("panel-custom-save",form.editor.bytes.len()>0 ? "Save item" : "Add item",!form.busy && form.title.bytes.len()>0 && form.command.bytes.len()>0,fn() {form.send(model.fragment("custom-save"))})),true,""));rows.push(label(ui.text("Add or save the item, then Apply to update Panel."),"settings-description"))}
    return box(rows,false,"settings-card files-settings-card")
}
fn preview(frame:ui.Text):ui.Node {
    let fields=channel.split(frame,9);let top=fields.len()==8 && wire.flag(fields,1);let height=fields.len()==8 ? channel.integer(fields[2]) as i32 : 36;let size=fields.len()==8 ? channel.integer(fields[3]) as i32 : 16;let pinned=fields.len()==8 && wire.flag(fields,6);let date=fields.len()==8 && wire.flag(fields,7);let apps=Vec<ui.Node>();for icon in Vec<str>("view-app-grid-symbolic","view-grid-symbolic") {let p=ui.props();p.iconSize=size;apps.push(ui.Icon(p,icon))};if pinned {for icon in Vec<str>("dev-os-terminal-symbolic","dev-os-files-symbolic") {let p=ui.props();p.iconSize=size;apps.push(ui.Icon(p,icon))}}
    let spacer=ui.props();spacer.expand=true;let clock=Vec<ui.Node>(label(ui.text("10:24"),"panel-preview-time"));if date {let node=label(ui.text("Sat, 17 Oct"),"panel-preview-date");node.props.id=ui.text("panel-preview-date");clock.push(node)};let bar=box(Vec<ui.Node>(box(apps,true,""),ui.Box(spacer,Vec<ui.Node>()),box(clock,false,""),ui.Icon(ui.props(),"preferences-system-notifications-symbolic")),true,"panel-preview-bar");bar.props.height=height;bar.props.spacing=fields.len()==8 ? channel.integer(fields[4]) as i32 : 12
    let workspace=box(Vec<ui.Node>(ui.Icon(ui.props(),"view-grid-symbolic"),label(ui.text("Your workspace"),"settings-description")),false,"");workspace.props.expand=true;workspace.props.valign=3;let nodes=top ? Vec<ui.Node>(bar,workspace) : Vec<ui.Node>(workspace,bar);let desktop=box(nodes,false,"panel-preview-desktop");desktop.props.height=180;return box(Vec<ui.Node>(label(ui.text("LAYOUT PREVIEW"),"settings-eyebrow"),desktop,label(ui.text("Example layout · Changes appear on every display after Apply."),"settings-description")),false,"panel-settings-stage")
}
fn App(context:*ui.Context,file:ui.Text):ui.Node {
    let form=model.useForm(context,file)
    let announced=ui.useRef(context,0)
    ui.useEffect(context,fn():fn():void {unsafe {if !ui.equalText(ui.text(rc_env("DEVOS_PANEL_SETTINGS_TRACE")),ui.text("1")) {return ui.noop};let tick=callback_context(fn() {unsafe {if announced.get()==0 && ui.find(context,"panel-height")!=null {announced.set(1);print("PANEL SETTINGS READY");panel_flush()}}});let timer=panel_timer(50,tick.call,tick.data);return fn() {unsafe {panel_untimer(timer,tick.data)}}}},Vec<i64>())
    ui.useEffect(context,fn():fn():void {unsafe {let root=rc_env("DEV_OS_ROOT");let runtime=rc_env("XDG_RUNTIME_DIR");let mode=rc_env("DEV_OS_THEME");if !ui.equalText(ui.text(mode),ui.text("dark")) && !ui.equalText(ui.text(mode),ui.text("light")) {mode=rd_default_theme()};let family=rc_env("DEV_OS_THEME_FAMILY");if !ui.equalText(ui.text(family),ui.text("github")) {family="vscode"};rd_theme_follow((*context).native,"${runtime}/devos-native-theme.css","${root}/dist/native/theme.${family}.${mode}.css");rd_app_header_for((*context).native,"Panel","${root}/data/icons","settings","dev-os-settings");return ui.noop}},Vec<i64>())
    let size=Vec<ui.Node>(label(ui.text("Size & spacing"),"section-heading"));let presets=Vec<ui.Node>();let names=Vec<str>("compact","comfortable","spacious");let titles=Vec<str>("Compact","Comfortable","Spacious");for i in 0..3 {let name=ui.text(names[i]);presets.push(button("panel-preset-"+names[i],titles[i],!form.busy,fn() {form.send(ui.concatText(Vec<ui.Text>(model.fragment("preset"),ui.text(",\"value\":"),channel.quote(name))))}))};size.push(box(presets,true,""))
    let layout=Vec<ui.Node>();let visibility=Vec<ui.Node>();let menu=Vec<ui.Node>(label(ui.text("Panel right-click menu"),"section-heading"));for i in 0..(form.fields.len() as i64) {let node=formField(form.fields[i],i+1,form);if i==0 {layout.push(node)}else if i<6 {size.push(node)}else if i<8 {visibility.push(node)}else {menu.push(node)}};menu.push(label(ui.text("MENU PREVIEW"),"settings-eyebrow"));for item in form.preview {let props=ui.props();props.iconSize=15;menu.push(box(Vec<ui.Node>(ui.element(11,props,item.icon,Vec<ui.Node>()),label(item.title,"")),true,"files-preview-menu-row"))}
    let custom=ui.component(9861,ui.keyed(301),fn(child:*ui.Context):ui.Node {return customEditor(child,form)});let error=label(form.error,"settings-error-banner");error.props.id=ui.text("panel-settings-error");error.props.visible=form.error.bytes.len()>0;let content=box(Vec<ui.Node>(preview(form.appearance),box(layout,false,"settings-card panel-settings-card"),box(size,false,"settings-card panel-settings-card"),box(visibility,false,"settings-card panel-settings-card"),box(menu,false,"settings-card panel-settings-card"),custom),false,"settings-form");let scroll=ui.props();scroll.expand=true
    let status=label(form.status.bytes.len()>0 ? form.status : ui.text(form.dirty ? "Unsaved changes · Preview only" : "Everything you need, within reach."),"settings-description");status.props.expand=true;status.props.id=ui.text("panel-settings-status");let actions=box(Vec<ui.Node>(status,button("panel-settings-reset","Reset",form.dirty && !form.busy,fn() {form.send(model.fragment("reset"))}),button("panel-settings-apply","Apply",form.dirty && !form.busy,form.apply)),true,"settings-action-bar")
    return <Box id="settings" className="settings-content panel-settings-page" spacing={12} margin={18} expand><Box className="settings-page-header" spacing={6}><Label className="settings-eyebrow">PERSONALIZATION / DESKTOP</Label><Label className="heading">Panel</Label><Label className="settings-description">Your apps, clock and controls. Give everything the right amount of space.</Label></Box>{ui.Scroll(scroll,content)}{error}{actions}</Box>
}
fn run():i32 {unsafe {
    let production=ui.equalText(ui.text(rc_env("DEVOS_PANEL_ROLE")),ui.text("settings"));let file=ui.text(rc_env("DEVOS_PANEL_PREFERENCES"));if production && file.bytes.len()==0 {let directory=rc_env("XDG_CONFIG_HOME");if ui.text(directory).bytes.len()==0 {directory="${rc_env("HOME")}/.config"};file=ui.text("${directory}/dev-os/extensions/org.devos.panel.json")}
    if file.bytes.len()==0 || (!production && !ui.equalText(ui.text(rc_env("DEVOS_PANEL_SETTINGS_PREVIEW")),ui.text("1"))) {print("Set DEVOS_PANEL_ROLE=settings or explicit preview preferences.");return 1}
    let identity=rc_env("DEV_OS_NATIVE_ID");rd_identity(identity);let ok=ui.run("DevOs · Panel Settings",900,820,fn(context:*ui.Context):ui.Node {ui.useEffect(context,fn():fn():void {unsafe {if production && rd_control((*context).native,identity,"settings.panel")==0 {ui.close(context)};return ui.noop}},Vec<i64>());return App(context,file)});return ok ? 0 : 1
}}
