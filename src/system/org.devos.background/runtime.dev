# One owned native UI per GDK output. No JS loader or shell metadata bridge.
extern fn bm_init():i32
extern fn bm_count():i32
extern fn bm_key(index:i32):i64
extern fn bm_env(name:str):str
extern fn bm_now():i64
extern fn bm_exists(path:str):i32
extern fn bm_flush()
extern fn sp_init()
extern fn sp_finish()
extern fn sp_step()
extern fn sp_wait(milliseconds:i32)
extern fn sp_stopping():i32
extern fn sp_builder():*void
extern fn sp_arg(builder:*void,value:str)
extern fn sp_spawn_owned(builder:*void):*void
extern fn sp_done(child:*void):i32
extern fn sp_pid(child:*void):i64
extern fn sp_code(child:*void):i32
extern fn sp_free(child:*void)
extern fn kill(pid:i32,signal:i32):i32
extern fn strlen(value:str):u64
struct Worker {key:i64,index:i32,target:i32,child:*void,desired:bool,stopping:bool,deadline:i64,retry:i64,failures:i32,since:i64}
fn launchWorker(root:str,file:str,binary:str,index:i32):*void {unsafe {
    let args=sp_builder()
    for value in Vec<str>("env","DEV_OS_ROOT=${root}","DEVOS_BACKGROUND_ROLE=desktop","DEVOS_BACKGROUND_EXECUTE_ACTIONS=1","DEVOS_BACKGROUND_PREFERENCES=${file}","DEVOS_BACKGROUND_MONITOR=${index}",binary) {sp_arg(args,value)}
    return sp_spawn_owned(args)
}}
fn stop(worker:Worker,signal:i32) {unsafe {let pid=sp_pid(worker.child);if pid>0 && pid<=2147483647 {kill(pid as i32,signal)}}}
fn main():i32 {unsafe {
    let root=bm_env("DEV_OS_ROOT");if strlen(root)==0 || bm_init()==0 {print("Native background requires DEV_OS_ROOT and a Wayland layer-shell display.");return 1}
    let file=bm_env("DEVOS_BACKGROUND_PREFERENCES")
    if strlen(file)==0 {let config=bm_env("XDG_CONFIG_HOME");if strlen(config)==0 {let home=bm_env("HOME");if strlen(home)==0 {return 1};config="${home}/.config"};file="${config}/dev-os/extensions/org.devos.background.json"}
    let binary=bm_env("DEVOS_BACKGROUND_EXECUTABLE");if strlen(binary)==0 {binary="${root}/dist/native/background"}
    if bm_exists(binary)==0 {print("Native background executable is missing. Build the native system components.");return 1}
    sp_init();let workers=Vec<Worker>();let closing=false;let status=0;print("DevOs background runtime started [native]");bm_flush()
    while true {
        sp_step();if sp_stopping()!=0 {closing=true};let now=bm_now()
        for j in 0..(workers.len() as i64) {let worker=workers[j];worker.desired=false;workers[j]=worker}
        if !closing {
            let count=bm_count()
            for number in 0..(count as i64) {
                let i=number as i32;let key=bm_key(i);let found=false
                for j in 0..(workers.len() as i64) {if workers[j].key==key {let worker=workers[j];worker.desired=true;worker.target=i;workers[j]=worker;found=true;break}}
                if !found {workers.push(Worker(key,i,i,null,true,false,0,0,0,now))}
            }
        }
        let retained=Vec<Worker>()
        for item in workers {
            let worker=item
            if worker.child!=null {
                if (!worker.desired || worker.index!=worker.target || closing) && !worker.stopping && sp_done(worker.child)==0 {stop(worker,15);worker.stopping=true;worker.deadline=now+2000000}
                if sp_done(worker.child)!=0 {
                    let unexpected=!worker.stopping && worker.desired && worker.index==worker.target && !closing;let code=sp_code(worker.child);sp_free(worker.child);worker.child=null;worker.stopping=false
                    if unexpected {if now-worker.since>30000000 {worker.failures=0};worker.failures=worker.failures+1;worker.retry=now+500000;print("Native background output ${worker.index} exited (${code}); restarting");bm_flush();if worker.failures>5 {closing=true;status=1}}
                } else if worker.stopping && worker.deadline>0 && now>=worker.deadline {stop(worker,9);worker.deadline=0}
            }
            if worker.child==null && worker.desired && !closing && now>=worker.retry {
                worker.index=worker.target;worker.child=launchWorker(root,file,binary,worker.index);worker.since=now
                if worker.child==null {worker.failures=worker.failures+1;worker.retry=now+500000;if worker.failures>5 {closing=true;status=1}}
                else {print("Native background output ${worker.index} started (${sp_pid(worker.child)})");bm_flush()}
            }
            if worker.desired || worker.child!=null {retained.push(worker)}
        }
        workers=retained;if closing && workers.len()==0 {break};sp_wait(100)
    }
    sp_finish();return status as i32
}}
return main()
