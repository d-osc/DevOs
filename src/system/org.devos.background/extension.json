{
  "id": "org.devos.background",
  "name": "Background",
  "description": "Wallpaper, pictures and background colors on every monitor.",
  "version": "1.0.0",
  "apiVersion": 1,
  "kind": "ui",
  "system": true,
  "native": "system-background",
  "order": 30,
  "settingsVersion": 1,
  "enabledByDefault": true,
  "settings": [
    {
      "id": "desktopWidgets",
      "title": "Desktop widgets",
      "fields": [
        {"key": "widgetClock", "title": "Clock widget", "type": "boolean", "default": false},
        {"key": "widgetDate", "title": "Date widget", "type": "boolean", "default": false},
        {"key": "widgetNote", "title": "Note widget", "type": "boolean", "default": false},
        {"key": "widgetNoteText", "title": "Note text", "type": "string", "default": ""},
        {"key": "widgetPosition", "title": "Widget position", "type": "string", "default": "right"},
        {"key": "widgetLocations", "title": "Saved widget positions", "type": "string", "default": "{}"},
        {"key": "widgetDesktops", "title": "Widgets by desktop", "type": "string", "default": "{}"},
        {"key": "widgetDesktopVersion", "title": "Desktop widget format", "type": "number", "default": 0},
        {"key": "menuWidgets", "title": "Show Desktop widgets", "type": "boolean", "default": true}
      ]
    },
    {
      "id": "wallpaper",
      "title": "Wallpaper",
      "fields": [
        {
          "key": "mode",
          "title": "Background type",
          "type": "string",
          "default": "design",
          "description": "design, solid or picture"
        },
        {
          "key": "style",
          "title": "DevOs design",
          "type": "string",
          "default": "dunes",
          "description": "dunes, aurora, contours, facets, waves, bokeh, orbits, horizon, mosaic, flow, ripples, fireflies, tide, planets, starfield, nebula, galaxy, meteors, eclipse, matrix, terminal, circuit, radar or network"
        },
        {
          "key": "useDesktopColor",
          "title": "Use theme background color",
          "type": "boolean",
          "default": true
        },
        {
          "key": "color",
          "title": "Background color",
          "type": "color",
          "default": "#101b25"
        },
        {
          "key": "imagePath",
          "title": "Picture file",
          "type": "string",
          "default": "",
          "description": "Absolute path to a local picture"
        },
        {
          "key": "fit",
          "title": "Picture fit",
          "type": "string",
          "default": "cover",
          "description": "cover, contain or stretch"
        }
      ]
    },
    {
      "id": "contextMenu",
      "fields": [
        {
          "key": "contextEnabled",
          "default": true,
          "type": "boolean",
          "title": "Enable desktop context menu"
        },
        {
          "key": "menuApplications",
          "default": true,
          "type": "boolean",
          "title": "Show Applications"
        },
        {
          "key": "menuTerminal",
          "default": true,
          "type": "boolean",
          "title": "Show Terminal"
        },
        {
          "key": "menuFiles",
          "default": true,
          "type": "boolean",
          "title": "Show Files"
        },
        {
          "key": "menuBackground",
          "default": true,
          "type": "boolean",
          "title": "Show Background"
        },
        {
          "key": "menuSettings",
          "default": true,
          "type": "boolean",
          "title": "Show Settings"
        },
        {
          "key": "menuReload",
          "default": true,
          "type": "boolean",
          "title": "Show Reload"
        },
        {
          "key": "menuLock",
          "default": true,
          "type": "boolean",
          "title": "Show Lock"
        },
        {
          "key": "menuLogout",
          "default": true,
          "type": "boolean",
          "title": "Show Logout"
        },
        {
          "key": "contextCustomItems",
          "default": "[]",
          "type": "string",
          "title": "Custom desktop actions"
        }
      ],
      "title": "Desktop context menu"
    }
  ]
}
