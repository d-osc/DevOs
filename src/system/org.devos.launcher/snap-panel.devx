use "react_devlang/ui" as ui
use "react_devlang/channel" as channel
use "../../apps/org.devos.settings/native-kit.devx" as k
use "../../apps/org.devos.settings/native-extensions-page.devx" as ext
use "../../apps/org.devos.settings/native-system-pages.devx" as sp
use "./shell-link.devx" as shell
extern fn rc_env(name:str):str
extern fn setenv(name:str,value:str,overwrite:i32):i32
extern fn rd_control(root:*void,id:str,command:str):i32
extern fn rd_identity(id:str)
extern fn rd_app_header(root:*void,title:str,icons:str)
extern fn rd_theme_follow(root:*void,snapshot:str,fallback:str)
extern fn rd_default_theme():str

# Native Snap window: pick one of five layouts, choose which window goes into each region and apply it (the tracker snaps and activates them), and the
# snap groups: restore a whole set of windows or remove it. The groups are kept by task-service.dev in a file, so they outlive this window and last until
# sign-out. Instead of dragging the sashes (a transparent layer-shell overlay that is not native yet) a group card has Narrower and Wider buttons for every
# divider, which send the same `sash` command and obey the same minimum window sizes. Like the Task View it is an ordinary window for now.
fn environment(name:str):str { unsafe { return rc_env(name) } }
fn plain(value:str):ui.Text { return ui.text(value) }
fn has(value:ui.Text):bool { return value.bytes.len() > 0 }
fn join(parts:Vec<ui.Text>):ui.Text { return ui.concatText(parts) }
fn smoke():bool { return has(plain(environment("DEVOS_SNAP_SMOKE"))) }
fn dashes(value:ui.Text):ui.Text { let out = Vec<u8>(); for b in value.bytes { out.push(b == 45 ? (32 as u8) : b) }; return ui.Text(out) }
struct Win { id:ui.Text, title:ui.Text, app:ui.Text, desktop:ui.Text, sticky:bool }
struct Desk { id:ui.Text, active:bool }
struct Group { id:ui.Text, layout:ui.Text, members:ui.Text, cuts:ui.Text }
fn layouts():Vec<str> { return Vec<str>("halves","wide-left","wide-right","thirds","quarters") }
fn layoutName(id:str):str { return id == "halves" ? "Two columns" : id == "wide-left" ? "Wide left" : id == "wide-right" ? "Wide right" : id == "thirds" ? "Three columns" : "Four quarters" }
fn regionCount(id:str):i64 { return id == "halves" || id == "wide-left" || id == "wide-right" ? 2 : id == "thirds" ? 3 : 4 }
fn regionNames(id:str):Vec<str> {
    if id == "halves" { return Vec<str>("Left","Right") }
    if id == "wide-left" { return Vec<str>("Wide left","Right") }
    if id == "wide-right" { return Vec<str>("Left","Wide right") }
    if id == "thirds" { return Vec<str>("Left","Center","Right") }
    return Vec<str>("Top left","Top right","Bottom left","Bottom right")
}
fn count(text:ui.Text):i64 { if !has(text) { return 0 }; return channel.split(text,44).len() as i64 }

fn SnapPanel(context:*ui.Context):ui.Node {
    let step = ui.useRef(context,0); let ticks = ui.useRef(context,0); let doneAt = ui.useRef(context,0); let tab = ui.useState(context,0); let layout = ui.useState(context,0); let note = ui.useText(context,ui.emptyText())
    let p0 = ui.useState(context,0); let p1 = ui.useState(context,0); let p2 = ui.useState(context,0); let p3 = ui.useState(context,0)
    let link = shell.useLink(context,fn(command:ui.Text) {
        # the last command is the sash line; the tracker gets half a second to read what was sent before the test window closes
        if k.isText(channel.split(command,32)[0],"sash") && smoke() && step.get() == 2 { step.set(3); doneAt.set(ticks.get() + 5) }
    })
    let frame = link.frame; let ask = link.ask
    ui.useEffect(context,fn():fn():void {
        let root = environment("DEV_OS_ROOT"); let mode = environment("DEV_OS_THEME"); let family = environment("DEV_OS_THEME_FAMILY")
        if ui.text(mode).bytes.len() == 0 { unsafe { mode = rd_default_theme() } }
        if ui.text(family).bytes.len() == 0 { family = "vscode" }
        unsafe {
            rd_theme_follow((*context).native,"${environment("XDG_RUNTIME_DIR")}/devos-native-theme.css","${root}/dist/native/theme.${family}.${mode}.css")
            rd_app_header((*context).native,"Snap","${root}/data/icons")
            rd_control((*context).native,environment("DEV_OS_NATIVE_ID"),"snap-layouts")
        }
        # `snap-layouts` toggles the window (it is open, so it closes), `snap-layouts hide` closes it.
        ui.onCommand(context,"snap-",fn(line:ui.Text) { ui.close(context) })
        ui.onTick(context,100,fn() {
            ticks.set(ticks.get() + 1); link.flush()
            if smoke() && step.get() == 3 && ticks.get() >= doneAt.get() { print("PASS native Snap arranged two windows through the tracker"); ui.close(context) }
            if smoke() && ticks.get() > 300 { print("FAIL native Snap timed out at step ${step.get()}"); ui.close(context) }
        })
        return ui.noop
    },Vec<i64>())
    # --- the state frame ---
    let windows = Vec<Win>(); let desks = Vec<Desk>(); let groups = Vec<Group>(); let canSnap = false; let canResize = false
    for record in channel.split(frame.value,30) {
        let c = channel.split(record,9)
        if sp.kindOf(record,67) { canSnap = ext.flag(sp.cell(c,3)); canResize = ext.flag(sp.cell(c,4)) }
        else if sp.kindOf(record,68) { desks.push(Desk(sp.cell(c,1),ext.flag(sp.cell(c,3)))) }
        else if sp.kindOf(record,87) { windows.push(Win(sp.cell(c,1),sp.cell(c,2),sp.cell(c,3),sp.cell(c,7),ext.flag(sp.cell(c,8)))) }
        else if sp.kindOf(record,71) { groups.push(Group(sp.cell(c,1),sp.cell(c,2),sp.cell(c,3),sp.cell(c,4))) }
    }
    let current = ui.emptyText(); for d in desks { if d.active { current = d.id } }
    let candidates = Vec<Win>(); for w in windows { if !w.sticky && (!has(current) || ui.equalText(w.desktop,current)) { candidates.push(w) } }
    let chosenLayout = layouts()[layout.value as usize]; let slots = regionCount(chosenLayout)
    let picks = Vec<i64>(p0.value,p1.value,p2.value,p3.value)
    # the chosen windows, by position in `candidates` (0 = nobody); valid when every region has a different window
    let ready = canSnap && candidates.len() >= (slots as usize)
    for i in 0..slots { if picks[i] == 0 || picks[i] > (candidates.len() as i64) { ready = false } else { for j in 0..i { if picks[j] == picks[i] { ready = false } } } }
    ui.useEffect(context,fn():fn():void {
        # DEVOS_SNAP_SMOKE=1: choose the first two windows for the two columns, then press Apply.
        if smoke() && step.get() == 0 && canSnap && candidates.len() >= 2 { step.set(1); p0.set(1); p1.set(2) }
        else if smoke() && step.get() == 1 && ready { step.set(2); ui.click(context,"snap-apply") }
        return ui.noop
    },Vec<i64>(candidates.len() as i64,p0.value,p1.value,ready ? 1 : 0))
    # --- the window ---
    let close = ui.named("snap-dismiss")
    let nodes = Vec<ui.Node>(ext.row(12,Vec<ui.Node>(ext.expand(ext.column(2,Vec<ui.Node>(k.note("YOUR WORKSPACE, ARRANGED","settings-description"),k.note("Snap","section-heading")))),ui.Button(close,"Close",fn() { ui.close(context) }))))
    if has(link.failure.value) { nodes.push(k.caption(link.failure.value,"settings-error-banner")) }
    let layoutsTab = ui.named("snap-tab-layouts"); let groupsTab = ui.named("snap-tab-groups")
    nodes.push(ext.row(8,Vec<ui.Node>(ui.Button(layoutsTab,tab.value == 0 ? "● Snap Layouts" : "Snap Layouts",fn() { tab.set(0) }),ui.Button(groupsTab,tab.value == 1 ? "● Groups (${groups.len()})" : "Groups (${groups.len()})",fn() { tab.set(1) }))))
    let body = Vec<ui.Node>()
    if tab.value == 0 {
        let cards = Vec<ui.Node>()
        for i in 0..(layouts().len() as i64) {
            let id = layouts()[i as usize]; let options = ui.named("snap-layout-" + id)
            cards.push(ui.Button(options,(layout.value == i ? "● " : "") + layoutName(id),fn() { layout.set(i); p0.set(0); p1.set(0); p2.set(0); p3.set(0) }))
        }
        body.push(k.note("Choose your layout","section-heading")); body.push(ext.row(8,cards))
        body.push(k.note("Place your windows","section-heading"))
        let names = regionNames(chosenLayout)
        for i in 0..slots {
            let items = Vec<ui.Text>(plain("Choose a window…"))
            for w in candidates { items.push(join(Vec<ui.Text>(w.app,plain(" · "),w.title))) }
            let place = ui.named("snap-place-${i}")
            let setter = fn(index:i64) { if i == 0 { p0.set(index) } else if i == 1 { p1.set(index) } else if i == 2 { p2.set(index) } else { p3.set(index) } }
            body.push(ext.row(8,Vec<ui.Node>(k.note(names[i as usize],"settings-description"),ext.expand(ui.Select(place,items,picks[i],setter)))))
        }
        if !canSnap { body.push(k.note("Snap Layouts requires the updated Dev OS compositor.","launcher-app-description")) }
        else if candidates.len() < (slots as usize) { body.push(k.note("Open ${slots} windows on this desktop to fill this layout.","launcher-app-description")) }
        let apply = ui.named("snap-apply"); apply.sensitive = ready
        body.push(ext.row(8,Vec<ui.Node>(ext.expand(k.caption(note.value,"launcher-hint")),ui.Button(apply,"Apply layout",fn() {
            let chosen = Vec<ui.Text>()
            for i in 0..slots { if i > 0 { chosen.push(plain(",")) }; chosen.push(candidates[(picks[i] - 1) as usize].id) }
            ask(join(Vec<ui.Text>(plain("{\"action\":\"arrange\",\"layout\":\"" + chosenLayout + "\",\"ids\":["),join(chosen),plain("]}")))); note.set(plain("Layout applied"))
        }))))
    } else {
        body.push(k.note("Pick up where you left off","section-heading"))
        body.push(k.note("Restore a whole set of windows, with the sizes you gave them. Groups stay available until you sign out.","launcher-app-description"))
        for g in groups {
            let label = join(Vec<ui.Text>(g.layout,plain(" · ${count(g.members)} windows")))
            let restore = ui.props(); restore.id = join(Vec<ui.Text>(plain("snap-restore-"),g.id)); let remove = ui.props(); remove.id = join(Vec<ui.Text>(plain("snap-remove-"),g.id))
            let row = Vec<ui.Node>(ext.expand(k.caption(dashes(label),"launcher-app-name")),ui.TextButton(restore,plain("Restore"),fn() { ask(join(Vec<ui.Text>(plain("{\"action\":\"restore-group\",\"id\":"),g.id,plain("}")))) }),
                ui.TextButton(remove,plain("Remove"),fn() { ask(join(Vec<ui.Text>(plain("{\"action\":\"remove-group\",\"id\":"),g.id,plain("}")))) }))
            body.push(ext.row(8,row))
            if canResize {
                let steps = Vec<ui.Node>(k.note("Resize","settings-description"))
                for index in 0..count(g.cuts) {
                    for sign in Vec<i64>(-1,1) {
                        let options = ui.props(); options.id = join(Vec<ui.Text>(plain("snap-resize-"),g.id,plain("-x${index}-${sign < 0 ? "narrower" : "wider"}")))
                        steps.push(ui.TextButton(options,plain("${sign < 0 ? "◀" : "▶"} divider ${index + 1}"),fn() { ask(join(Vec<ui.Text>(plain("{\"action\":\"resize-group\",\"id\":"),g.id,plain(",\"axis\":\"x\",\"index\":${index},\"delta\":${sign * 500}}")))) }))
                    }
                }
                if ui.equalText(g.layout,plain("quarters")) {
                    for sign in Vec<i64>(-1,1) {
                        let options = ui.props(); options.id = join(Vec<ui.Text>(plain("snap-resize-"),g.id,plain("-y0-${sign < 0 ? "narrower" : "wider"}")))
                        steps.push(ui.TextButton(options,plain("${sign < 0 ? "▲" : "▼"} row"),fn() { ask(join(Vec<ui.Text>(plain("{\"action\":\"resize-group\",\"id\":"),g.id,plain(",\"axis\":\"y\",\"index\":0,\"delta\":${sign * 500}}")))) }))
                    }
                }
                body.push(ext.row(8,steps))
            }
        }
        if groups.len() == 0 { body.push(k.note("No snap groups yet. Apply a layout and it will be kept here.","launcher-app-description")) }
    }
    let scroller = ui.props(); scroller.expand = true
    nodes.push(ui.Scroll(scroller,ext.column(10,body)))
    let outer = ui.props(); outer.spacing = 12; outer.margin = 0; outer.expand = true; outer.className = ui.text("rd-layer-panel")
    return ui.Box(outer,nodes)
}
fn run():i32 {
    let id = environment("DEV_OS_NATIVE_ID"); if ui.text(id).bytes.len() == 0 { id = "org.devos.App.snap.Native" }
    unsafe { rd_identity(id); setenv("RD_LAYER","1",0) }
    return ui.run("Snap",900,680,SnapPanel) ? 0 : 1
}
