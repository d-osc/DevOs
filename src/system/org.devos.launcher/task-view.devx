use "react_devlang/ui" as ui
use "react_devlang/channel" as channel
use "../../apps/org.devos.settings/native-kit.devx" as k
use "../../apps/org.devos.settings/native-extensions-page.devx" as ext
use "../../apps/org.devos.settings/native-system-pages.devx" as sp
use "./shell-link.devx" as shell
extern fn rc_env(name:str):str
extern fn setenv(name:str,value:str,overwrite:i32):i32
extern fn rd_control(root:*void,id:str,command:str):i32
extern fn rd_identity(id:str)
extern fn rd_app_header(root:*void,title:str,icons:str)
extern fn rd_theme_follow(root:*void,snapshot:str,fallback:str)
extern fn rd_default_theme():str

# Native Task View window: the open windows of the current desktop as cards (click to bring one forward, × to close it, a menu to move it to another
# desktop) and the desktops (switch, add, remove). The window starts dev-os-window-tracker itself (DEVOS_TASKVIEW_TRACKER replaces it in tests), batches
# its JSON event lines every 100 ms for task-service.dev, and forwards the commands that worker approves back to the tracker. Like the Launcher this is
# an ordinary window: the layer-shell overlay, the open/close motion and the keyboard navigation of the JS Task View are not here yet.
fn environment(name:str):str { unsafe { return rc_env(name) } }
fn plain(value:str):ui.Text { return ui.text(value) }
fn has(value:ui.Text):bool { return value.bytes.len() > 0 }
fn join(parts:Vec<ui.Text>):ui.Text { return ui.concatText(parts) }
fn smoke():bool { return has(plain(environment("DEVOS_TASKVIEW_SMOKE"))) }
fn action(name:str, id:ui.Text, extra:ui.Text):ui.Text { return join(Vec<ui.Text>(plain("{\"action\":\"" + name + "\",\"id\":"),has(id) ? id : plain("0"),extra,plain("}"))) }
struct Win { id:ui.Text, title:ui.Text, app:ui.Text, icon:ui.Text, active:bool, minimized:bool, desktop:ui.Text, sticky:bool }
struct Desk { id:ui.Text, name:ui.Text, active:bool }

fn TaskView(context:*ui.Context):ui.Node {
    let step = ui.useRef(context,0); let ticks = ui.useRef(context,0)
    let dismiss = fn() { ui.close(context) }
    let link = shell.useLink(context,fn(command:ui.Text) {
        if smoke() && step.get() == 1 { print("PASS native Task View listed the windows and sent the command to the tracker"); ui.close(context) }
        if k.isText(channel.split(command,32)[0],"activate") { dismiss() }
    })
    let frame = link.frame; let failure = link.failure; let ask = link.ask
    ui.useEffect(context,fn():fn():void {
        let root = environment("DEV_OS_ROOT"); let mode = environment("DEV_OS_THEME"); let family = environment("DEV_OS_THEME_FAMILY")
        if ui.text(mode).bytes.len() == 0 { unsafe { mode = rd_default_theme() } }
        if ui.text(family).bytes.len() == 0 { family = "vscode" }
        unsafe {
            rd_theme_follow((*context).native,"${environment("XDG_RUNTIME_DIR")}/devos-native-theme.css","${root}/dist/native/theme.${family}.${mode}.css")
            rd_app_header((*context).native,"Task View","${root}/data/icons")
            rd_control((*context).native,environment("DEV_OS_NATIVE_ID"),"task-view")
        }
        # `task-view` (a toggle: the window is open, so it closes) and `task-view hide`; `task-view show` keeps an open window open (it is already showing).
        ui.onCommand(context,"task-view-",fn(line:ui.Text) {
            let parts = channel.split(line,31)
            if !(parts.len() > 1 && k.isText(parts[1],"show")) { ui.close(context) }
        })
        ui.onTick(context,100,fn() {
            ticks.set(ticks.get() + 1); link.flush()
            if smoke() && ticks.get() > 300 { print("FAIL native Task View timed out at step ${step.get()}"); ui.close(context) }
        })
        return ui.noop
    },Vec<i64>())
    # --- the state frame ---
    let windows = Vec<Win>(); let desks = Vec<Desk>(); let canCreate = false; let canRemove = false
    for record in channel.split(frame.value,30) {
        let c = channel.split(record,9)
        if sp.kindOf(record,67) { canCreate = ext.flag(sp.cell(c,1)); canRemove = ext.flag(sp.cell(c,2)) }
        else if sp.kindOf(record,68) { desks.push(Desk(sp.cell(c,1),sp.cell(c,2),ext.flag(sp.cell(c,3)))) }
        else if sp.kindOf(record,87) { windows.push(Win(sp.cell(c,1),sp.cell(c,2),sp.cell(c,3),sp.cell(c,4),ext.flag(sp.cell(c,5)),ext.flag(sp.cell(c,6)),sp.cell(c,7),ext.flag(sp.cell(c,8)))) }
    }
    let currentDesktop = ui.emptyText(); for d in desks { if d.active { currentDesktop = d.id } }
    let visible = Vec<Win>()
    for w in windows { if !has(currentDesktop) || w.sticky || ui.equalText(w.desktop,currentDesktop) || ui.equalText(w.desktop,plain("0")) { visible.push(w) } }
    ui.useEffect(context,fn():fn():void {
        # DEVOS_TASKVIEW_SMOKE=1: once the windows are listed, bring the window named by DEVOS_TASKVIEW_ACTIVATE forward.
        if smoke() && step.get() == 0 && visible.len() > 0 { step.set(1); ui.click(context,"task-view-activate-" + environment("DEVOS_TASKVIEW_ACTIVATE")) }
        return ui.noop
    },Vec<i64>(visible.len() as i64))
    # --- the window ---
    let label = fn(value:ui.Text, style:str, align:f64, chars:i32):ui.Node {
        let options = ui.props(); options.className = ui.text(style); options.xalign = align; if chars > 0 { options.widthChars = chars; options.ellipsize = true }
        return ui.withProps(ui.TextLabel(value),options)
    }
    let pill = fn(value:ui.Text, style:str):ui.Node { let options = ui.props(); options.className = ui.text(style); options.valign = 3; return ui.withProps(ui.TextLabel(value),options) }
    let close = ui.named("task-view-dismiss"); close.valign = 3
    let heading = ext.column(4,Vec<ui.Node>(label(plain("WORKSPACE OVERVIEW"),"rd-eyebrow",0.0,0),label(plain("Task View"),"rd-heading",0.0,0),
        label(plain("Pick a window to bring it forward, or move it to another desktop."),"rd-muted",0.0,0)))
    let summary = pill(plain("${desks.len() > 0 ? desks.len() : 1} desktop${desks.len() == 1 ? "" : "s"}  ·  ${visible.len()} open window${visible.len() == 1 ? "" : "s"}"),"rd-pill")
    let nodes = Vec<ui.Node>(ext.row(16,Vec<ui.Node>(ext.expand(heading),summary,ui.Button(close,"Close",fn() { dismiss() }))))
    if has(failure.value) { nodes.push(k.caption(failure.value,"settings-error-banner")) }
    # --- window cards: app and title bar, a large emblem, the window title; move and close below ---
    let cards = Vec<ui.Node>(); let line = Vec<ui.Node>(); let perLine: usize = 4
    for w in visible {
        let small = ui.props(); small.iconSize = 16
        let big = ui.props(); big.iconSize = 56; big.halign = 3
        let glyph = has(w.icon) ? w.icon : plain("application-x-executable-symbolic")
        let top = Vec<ui.Node>(ui.element(11,small,glyph,Vec<ui.Node>()),ext.expand(label(w.app,"rd-card-app",0.0,22)))
        if w.active { top.push(pill(plain("Active"),"rd-badge")) } else if w.minimized { top.push(pill(plain("Minimized"),"rd-badge-muted")) }
        let body = Vec<ui.Node>(ext.row(8,top),ui.element(11,big,glyph,Vec<ui.Node>()),label(has(w.title) ? w.title : w.app,"rd-card-title",0.5,24))
        let tile = ui.props(); tile.id = join(Vec<ui.Text>(plain("task-view-activate-"),w.id)); tile.className = ui.text("rd-tile"); tile.width = 268; tile.height = 168
        let column = ui.props(); column.spacing = 14; column.margin = 4
        let controls = Vec<ui.Node>()
        if desks.len() > 1 && !w.sticky {
            let names = Vec<ui.Text>(plain("Move to…")); let ids = Vec<ui.Text>(ui.emptyText())
            for d in desks { if !ui.equalText(d.id,w.desktop) { names.push(d.name); ids.push(d.id) } }
            let mover = ui.props(); mover.id = join(Vec<ui.Text>(plain("task-view-move-"),w.id)); mover.expand = true
            controls.push(ui.Select(mover,names,0,fn(index:i64) { if index > 0 { ask(action("move",w.id,join(Vec<ui.Text>(plain(",\"desktop\":"),ids[index])))) } }))
        } else { controls.push(ext.expand(label(plain(w.sticky ? "On every desktop" : ""),"rd-muted",0.0,0))) }
        let closer = ui.props(); closer.id = join(Vec<ui.Text>(plain("task-view-close-"),w.id))
        controls.push(ui.Button(closer,"Close window",fn() { ask(action("close",w.id,ui.emptyText())) }))
        let card = ui.props(); card.spacing = 10; card.className = ui.text(w.active ? "rd-window rd-window-active" : "rd-window")
        let item = ui.Box(card,Vec<ui.Node>(ui.WidgetButton(tile,ui.Box(column,body),fn() { ask(action("activate",w.id,ui.emptyText())) }),ext.row(8,controls)))
        line.push(item)
        if line.len() >= perLine { let rowProps = ui.props(); rowProps.vertical = false; rowProps.spacing = 18; rowProps.halign = 3; cards.push(ui.Box(rowProps,line)); line = Vec<ui.Node>() }
    }
    if line.len() > 0 { let rowProps = ui.props(); rowProps.vertical = false; rowProps.spacing = 18; rowProps.halign = 3; cards.push(ui.Box(rowProps,line)) }
    if visible.len() == 0 {
        let empty = ui.props(); empty.valign = 3; empty.halign = 3; empty.spacing = 10
        cards.push(ui.Box(empty,Vec<ui.Node>(label(plain("No open windows on this desktop"),"rd-heading-small",0.5,0),label(plain("Open an app and it will show up here."),"rd-muted",0.5,0))))
    }
    let scroller = ui.props(); scroller.expand = true
    nodes.push(ui.Scroll(scroller,ext.column(18,cards)))
    # --- desktops ---
    if desks.len() > 0 {
        let chips = Vec<ui.Node>()
        for d in desks {
            let members = 0; for w in windows { if ui.equalText(w.desktop,d.id) || w.sticky { members = members + 1 } }
            let switcher = ui.props(); switcher.id = join(Vec<ui.Text>(plain("task-view-desktop-"),d.id)); switcher.className = ui.text(d.active ? "rd-chip rd-chip-current" : "rd-chip")
            let inner = ui.props(); inner.spacing = 2
            let caption = Vec<ui.Node>(label(d.name,"rd-card-title",0.0,0),label(plain("${members} window${members == 1 ? "" : "s"}${d.active ? "  ·  current" : ""}"),"rd-muted",0.0,0))
            let chip = ui.WidgetButton(switcher,ui.Box(inner,caption),fn() { ask(action("desktop",d.id,ui.emptyText())) })
            if canRemove && desks.len() > 1 { let remover = ui.props(); remover.valign = 3; remover.id = join(Vec<ui.Text>(plain("task-view-remove-"),d.id)); chips.push(ext.row(4,Vec<ui.Node>(chip,ui.Button(remover,"×",fn() { ask(action("remove-desktop",d.id,ui.emptyText())) })))) } else { chips.push(chip) }
        }
        if canCreate { let add = ui.named("task-view-create"); chips.push(ui.Button(add,"+ New desktop",fn() { ask(plain("{\"action\":\"create-desktop\"}")) })) }
        nodes.push(label(plain("YOUR DESKTOPS"),"rd-eyebrow",0.0,0))
        let strip = ui.props(); strip.vertical = false; strip.spacing = 12
        let stripScroll = ui.props(); stripScroll.height = 76
        nodes.push(ui.Scroll(stripScroll,ui.Box(strip,chips)))
    }
    let body = ui.props(); body.spacing = 18; body.margin = 0; body.expand = true; body.className = ui.text("rd-layer-panel")
    return ui.Box(body,nodes)
}
fn run():i32 {
    let id = environment("DEV_OS_NATIVE_ID"); if ui.text(id).bytes.len() == 0 { id = "org.devos.App.taskview.Native" }
    unsafe { rd_identity(id); setenv("RD_LAYER","1",0) }
    return ui.run("Task View",980,720,TaskView) ? 0 : 1
}
