#!/usr/bin/env d
# Worker of the native shell: carries out the steps router.dev makes of a command line. One request per line on stdin (the caller's folder first, then the
# command and its arguments, separated by ASCII 31) and exactly one answer line: "V" (done), "Q" (the session ends) or "E<TAB>message".
# Apps are started the way packages/shell/app-processes.ts starts them: a running one gets the command over D-Bus, a missing one is spawned
# (dist/native/<app> when there is one, else the JS app host). DEVOS_SHELL_TEST=1 appends what would be done to DEVOS_SHELL_LOG and starts nothing.
use "std/io"
use "std/fs"
use "std/json"
use "std/strings"
use "std/result"
use "std/encoding"
use "../../../lib/hw.dev" as hw
use "../../../lib/config.dev" as config
use "../../../lib/shell-command.dev" as shell
use "./router.dev" as router
use "./gestures.dev" as gestures
use "./theme.dev" as theme
use "./lock.dev" as locker
use "../../../lib/ext-prefs.dev" as prefs
use "../../services/window-state.dev" as tracking

fn us():str { return encoding.decode(Vec<u8>(31),"utf8") }
fn testing():bool { return !strings.equal(hw.env("DEVOS_SHELL_TEST"),"") }
fn root():str { return hw.envOr("DEV_OS_ROOT",".") }
fn shellId():str { return shell.applicationId(hw.env("XDG_RUNTIME_DIR"),hw.envOr("WAYLAND_DISPLAY","default")) }
fn note(line:str) { if testing() && !strings.equal(hw.env("DEVOS_SHELL_LOG"),"") { fs.appendFileSync(hw.env("DEVOS_SHELL_LOG"),line + "\n") } }
fn say(message:str) {
    hw.stderr("Dev OS: " + message)
    if testing() { note("message " + message); return }
    hw.run(Vec<str>("gdbus","emit","--session","--object-path","/org/devos/Panel","--signal","org.devos.Panel.Message",message),5000)
}

# The D-Bus identity of an app process: org.devos.App.<name>.<shell id>.
fn identity(name:str):str { return strings.replaceAll(shellId(),"org.devos.Shell.","org.devos.App." + name + ".") }
fn nativeRoles():Vec<str> { return Vec<str>("taskmanager","diskmanager","installer","files","terminal","settings","camera","microphone","editor","screenshot","browser","appstore") }
fn startProcess(argv:Vec<str>, extra:Vec<str>) {
    # The shell runs with RD_HIDDEN=1 (no window); the apps it starts must not inherit it, or they would run without showing a window.
    let all = Vec<str>("env","-u","RD_HIDDEN","DEV_OS_ROOT=" + root())
    for item in extra { all.push(item) }
    for item in argv { all.push(item) }
    hw.spawnDetached(all)
}
fn isExecutable(path:str):bool { return hw.isExecutable(path) }

# Starts a process of `role` for `command` (a running one is asked over D-Bus first).
fn launch(role:str, command:str, path:str) {
    let args = Vec<str>(command)
    if !strings.equal(path,"") { args.push(path) }
    let background = strings.equal(command,"settings.background")
    let panel = strings.equal(command,"settings.panel")
    let name = background ? "backgroundsettings" : panel ? "panelsettings" : role
    let id = identity(name)
    note("launch " + role + " " + strings.join(args," "))
    if testing() { return }
    let status = shell.remoteTo(id,args,"/")
    if status == 0 { return }
    if status != -1 { say(command + ": the process answered an error"); return }
    let executable = ""
    if background { executable = "background-settings" }
    else if panel { executable = "panel-settings" }
    else if shellRoleIs(nativeRoles(),role) { executable = role }
    if strings.equal(executable,"") { say(command + ": there is no app for " + role); return }
    let extra = Vec<str>()
    let argv = Vec<str>()
    let native = root() + "/dist/native/" + executable
    if !isExecutable(native) { say("Native " + executable + " is missing. Run sh tools/build/native-apps.sh."); return }
    extra.push("DEV_OS_NATIVE_ID=" + id); extra.push("DEV_OS_SHELL_ID=" + shellId())
    if background { extra.push("DEVOS_BACKGROUND_ROLE=settings") }
    if panel { extra.push("DEVOS_PANEL_ROLE=settings") }
    for name in Vec<str>("DEV_OS_THEME","DEV_OS_THEME_FAMILY") { if !strings.equal(hw.env(name),"") { extra.push(name + "=" + hw.env(name)) } }
    argv.push(native)
    for item in args { argv.push(item) }
    startProcess(argv,extra)
}
fn shellRoleIs(list:Vec<str>, role:str):bool { return router.contains(list,role) }

# The native Launcher, Task View and Snap windows: a running one gets the command (a toggle), a missing one is started when `open`.
fn overlayName(role:str):str { return strings.equal(role,"task-view") ? "taskview" : strings.equal(role,"snap-panel") ? "snap" : "launcher" }
fn overlay(role:str, command:str, open:bool) {
    let args = strings.split(command," ")
    note("overlay " + role + " " + command + (open ? " open" : " close"))
    if testing() { return }
    let id = identity(overlayName(role))
    let status = shell.remoteTo(id,args,"/")
    if status == 0 { return }
    if status != -1 { say(command + ": the window answered an error"); return }
    if !open { return }
    let extra = Vec<str>("DEV_OS_NATIVE_ID=" + id,"DEV_OS_SHELL_ID=" + shellId())
    if strings.equal(args.len() > 1 ? args[1] : "","logout") { extra.push("DEVOS_LAUNCHER_LOGOUT=1") }
    for name in Vec<str>("DEV_OS_THEME","DEV_OS_THEME_FAMILY") { if !strings.equal(hw.env(name),"") { extra.push(name + "=" + hw.env(name)) } }
    let executable = root() + "/dist/native/" + role
    if !isExecutable(executable) { say("Native " + role + " is missing. Run sh tools/build/native-apps.sh."); return }
    startProcess(Vec<str>(executable),extra)
}

fn configured(key:str):Vec<str> {
    let loaded = result.attempt(fn():json.Value { return config.load(config.configPath()) })
    let out = Vec<str>()
    if result.isErr(loaded) { say(result.message(loaded)); return out }
    let list = json.get(result.unwrap(loaded),key)
    for i in 0..(json.len(list) as i64) { out.push(config.expandHome(json.string(json.at(list,i)))) }
    return out
}
# terminal, files and lock: the Dev OS program when the config names it, else the configured command.
fn runCommand(command:str, folder:str):bool {
    if strings.equal(command,"files") { launch("files","files",""); return true }
    if strings.equal(command,"screenshot") {
        # Win+Shift+S: the capture worker of Screenshot picks an area, saves it and copies it. It runs apart so the shell is not held while the user drags.
        note("run screenshot region")
        if testing() { return true }
        let runner = strings.equal(hw.which("d"),"") ? "d" : hw.which("d")
        # An error answer ("E<TAB>message": grim or slurp missing, ...) goes to the panel; a saved picture is announced by the worker itself.
        let script = "out=$(printf '%s\\n' '{\"action\":\"region\",\"delay\":0}' | \"$1\" \"$2\" 2>&1); case \"$out\" in E*) gdbus emit --session --object-path /org/devos/Panel --signal org.devos.Panel.Message \"Screenshot: $(printf '%s' \"$out\" | cut -f2-)\" >/dev/null 2>&1;; esac"
        hw.spawnDetached(Vec<str>("sh","-c",script,"sh",runner,root() + "/src/apps/org.devos.screenshot/service.dev"))
        return true
    }
    let args = configured(command)
    if args.len() == 0 { return false }
    if strings.equal(command,"lock") && args.len() == 1 && strings.equal(args[0],"dev-os-lock") {
        # The answer comes once the lock surface is up, so `dev-os-shell lock` is a safe step before sleeping or switching the screen off.
        note("lock")
        if testing() { return true }
        let choice = theme.choice(themeValues())
        let problem = locker.lock(hw.which(hw.envOr("DEVOS_SHELL_SWAYLOCK","swaylock")),root(),choice.family,theme.resolve(choice,clock()))
        if !strings.equal(problem,"") { say(problem); return false }
        return true
    }
    if args.len() == 1 && (strings.equal(args[0],"dev-os-terminal") || strings.equal(args[0],"foot")) { launch("terminal","terminal.native",folder); return true }
    if !testing() && strings.equal(hw.which(args[0]),"") { say("Install " + args[0] + " or change '" + command + "' in config.json."); return false }
    note("run " + strings.join(args," "))
    if testing() { return true }
    let argv = Vec<str>("sh","-c","cd \"$1\" 2>/dev/null || cd /; shift; unset RD_HIDDEN; exec \"$@\"","sh",folder)
    for item in args { argv.push(item) }
    hw.spawnDetached(argv)
    return true
}

# --- window gestures: ask the tracker for the windows, bring the one the gesture names forward ---
fn trackerPath():str {
    if !strings.equal(hw.env("DEVOS_SHELL_TRACKER"),"") { return hw.env("DEVOS_SHELL_TRACKER") }
    for path in Vec<str>(root() + "/build/native/dev-os-window-tracker",root() + "/native/dev-os-window-tracker") { if isExecutable(path) { return path } }
    return hw.which("dev-os-window-tracker")
}
fn trackerState(tracker:str):tracking.Snapshot {
    let ran = hw.run(Vec<str>("sh","-c","sleep 0.5 | \"$1\"","sh",tracker),8000)
    let state = tracking.empty()
    for line in strings.split(ran.out,"\n") {
        if strings.equal(strings.trim(line),"") { continue }
        let parsed = result.attempt(fn():json.Value { return json.parse(line) })
        if result.isOk(parsed) { state = tracking.consume(state,result.unwrap(parsed)) }
    }
    return state
}
fn gesture(action:str) {
    let tracker = trackerPath()
    if strings.equal(tracker,"") { say("Build the window tracker with tools/setup/bootstrap-window-tracker.sh"); return }
    let id = gestures.target(trackerState(tracker),action)
    note("gesture " + action + " " + (id > 0 ? "activate " + "${id}" : "none"))
    if id <= 0 { return }
    hw.run(Vec<str>("sh","-c","{ printf '%s\n' \"$2\"; sleep 0.4; } | \"$1\" > /dev/null","sh",tracker,"activate " + "${id}"),8000)
}

# --- theme: the Theme extension's choice (auto follows the clock) becomes $XDG_RUNTIME_DIR/devos-native-theme.css, which every native window follows ---
fn themeValues():json.Value {
    let read = result.attempt(fn():json.Value {
        let manifest = json.parse(fs.readFileSync(root() + "/src/apps/org.devos.theme/extension.json","utf8"))
        let directory = testing() && !strings.equal(hw.env("DEVOS_PREFERENCES_DIR"),"") ? hw.env("DEVOS_PREFERENCES_DIR") : hw.configHome() + "/dev-os/extensions"
        return hw.jget(prefs.read(directory,"org.devos.theme",manifest),"values")
    })
    return result.isErr(read) ? json.object() : result.unwrap(read)
}
fn clock():str { return !strings.equal(hw.env("DEVOS_SHELL_CLOCK"),"") ? hw.env("DEVOS_SHELL_CLOCK") : strings.trim(hw.run(Vec<str>("date","+%H:%M"),5000).out) }
fn syncTheme() {
    let runtime = hw.env("XDG_RUNTIME_DIR")
    if strings.equal(runtime,"") { return }
    let choice = theme.choice(themeValues())
    let name = theme.resolve(choice,clock())
    let source = root() + "/dist/native/theme." + choice.family + "." + name + ".css"
    if !fs.existsSync(source) { return }
    let next = fs.readFileSync(source,"utf8")
    let target = runtime + "/devos-native-theme.css"
    if fs.existsSync(target) && strings.equal(fs.readFileSync(target,"utf8"),next) { return }
    let temporary = target + ".tmp"
    fs.writeFileSync(temporary,next); fs.renameSync(temporary,target)
    note("theme " + choice.family + " " + name)
}

# Carries out one command line; returns the answer line.
fn handle(line:str):str {
    let parts = strings.split(line,us())
    let cwd = parts[0]
    if parts.len() > 1 && strings.equal(parts[1],"devos.theme-sync") { syncTheme(); return "V" }
    let args = Vec<str>()
    for i in 1..(parts.len() as i64) { args.push(parts[i]) }
    let quit = false
    let failed = ""
    for s in router.route(args,cwd) {
        if strings.equal(s.kind,"launch") { launch(s.role,s.command,s.path) }
        else if strings.equal(s.kind,"overlay") { overlay(s.role,s.command,strings.equal(s.path,"open")) }
        else if strings.equal(s.kind,"run") { if !runCommand(s.command,strings.equal(s.path,"") ? cwd : s.path) { failed = "Could not run " + s.command + "." } }
        else if strings.equal(s.kind,"message") { say(s.path) }
        else if strings.equal(s.kind,"reload") { syncTheme(); say("Configuration reloaded") }
        else if strings.equal(s.kind,"quit") { quit = true }
        else if strings.equal(s.kind,"gesture") { gesture(strings.substring(s.command,7,strings.charLength(s.command))) }
    }
    if !strings.equal(failed,"") { return "E\t" + failed }
    return quit ? "Q" : "V"
}
fn splash(step:str) { if !testing() && !strings.equal(hw.which("devos-splash"),"") { hw.spawnDetached(Vec<str>("devos-splash","--step",step)) } }
fn main():i32 {
    splash("shell")
    if !testing() && !strings.equal(hw.which("devos-splash"),"") { hw.spawnDetached(Vec<str>("sh","-c","sleep 0.7; exec devos-splash --step ready")) }
    while true {
        let line = io.read_line(); if strings.equal(line,"") { break }
        let done = result.attempt(fn():str { return handle(line) })
        print(result.isErr(done) ? "E\t" + hw.clean(result.message(done)) : result.unwrap(done))
    }
    return 0
}
return main()
