use "std/io"
use "std/json"
use "std/strings"
use "std/result"
use "../../lib/hw.dev" as hw
use "../system/org.devos.panel/battery-care.dev" as care
use "../system/org.devos.background/wire.dev" as wire
while true {let line=io.read_line();if strings.equal(line,"") {break}
    let response=result.attempt(fn():str {let request=json.parse(line);let state=care.handle(request);return care.frame(state)+(strings.equal(hw.jstr(request,"action","get"),"full") ? wire.separator()+"A" : "")})
    print(result.isOk(response) ? result.unwrap(response) : "E\t"+wire.encoded(hw.errorText(result.message(response))))
}
