use "std/io"
use "std/json"
use "std/strings"
use "std/result"
use "../../lib/hw.dev" as hw
use "../../lib/accounts.dev" as accounts
use "../../lib/desktop.dev" as util
use "../../lib/shell-command.dev" as shell
use "../system/org.devos.panel/accounts-model.dev" as model
use "../system/org.devos.panel/avatars.dev" as avatars
use "../system/org.devos.background/wire.dev" as wire
struct Reply {system:json.Value,updated:i64,ack:bool}
struct Download {id:i64,task:Task<bool>}
let system=json.object();let updated:i64=0;let downloads=Vec<Download>();let attempted=Map<i64,bool>()
while true {let line=io.read_line();if strings.equal(line,"") {break}
    let response=result.attempt(fn():Reply {
        let request=json.parse(line);if !strings.equal(json.kind(request),"object") {result.raise("Invalid account request")}
        let next=system;let now=util.monotonic();let stamp=updated
        if updated==0 || now-updated>=60 || hw.jbool(request,"refresh",false) || json.has(request,"switch") {next=hw.jget(accounts.execute(json.value({action:"get"})),"system");stamp=now}
        if json.has(request,"switch") {let args=model.choose(next,hw.jget(request,"switch"));let argv=Vec<str>("sh",hw.env("DEV_OS_ROOT")+"/bin/dev-os-shell");for argument in args {argv.push(argument)};let done=hw.run(hw.concat(Vec<str>("sh","-c","exec \"$@\" 2>&1","switch-user"),argv),180000);if done.code!=0 {result.raise(strings.equal(strings.trim(done.out),"") ? "Could not switch user." : strings.trim(done.out))};return Reply(next,stamp,true)}
        return Reply(next,stamp,false)
    })
    if result.isErr(response) {print("E\t"+wire.encoded(hw.errorText(result.message(response))));continue}
    let value=result.unwrap(response);system=value.system;updated=value.updated
    let active=Vec<Download>();for download in downloads {if ready(download.task) {await(download.task)}else {active.push(download)}};downloads=active
    for id in model.avatarIds(system) {if downloads.len()>=4 {break};if !attempted.contains(id) {attempted.set(id,true);downloads.push(Download(id,spawn(fn():bool {return avatars.load(id)})))}}
    print((value.ack ? "A"+wire.separator() : "")+model.frame(system,hw.env("USER")))
}
# Avatar tasks are bounded, optional cache work. Detached tasks end with this process.
