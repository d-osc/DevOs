use "std/io"
use "std/json"
use "std/strings"
use "std/result"
use "../../lib/hw.dev" as hw
use "../../lib/shell-command.dev" as shell
use "../system/org.devos.panel/menu-model.dev" as menu
use "../system/org.devos.background/wire.dev" as wire
extern fn sp_builder():*void
extern fn sp_arg(builder:*void,value:str)
extern fn sp_detach_at(builder:*void,cwd:str):i32
fn frame(values:json.Value):str {let rows=menu.presentation(values);let out="M";for i in 0..(json.len(rows) as i64) {let row=json.at(rows,i);out=out+wire.separator()+(hw.jbool(row,"separator",false) ? "Q" : "M\t"+wire.encoded(hw.jstr(row,"key",""))+"\t"+wire.encoded(hw.jstr(row,"title",""))+"\t"+wire.encoded(hw.jstr(row,"icon","system-run-symbolic")))};return out}
while true {let line=io.read_line();if strings.equal(line,"") {break}
    let response=result.attempt(fn():str {
        let request=json.parse(line);if !strings.equal(json.kind(request),"object") {result.raise("Invalid panel menu request")}
        let saved=hw.loadJson(hw.envOr("DEVOS_PANEL_PREFERENCES",hw.configHome()+"/dev-os/extensions/org.devos.panel.json"));let values=hw.jget(saved,"values")
        if !json.has(request,"key") {return frame(values)}
        let key=hw.jget(request,"key");if !strings.equal(json.kind(key),"string") {result.raise("Invalid panel menu selection")};let plan=menu.plan(values,json.string(key),hw.home())
        if strings.equal(hw.jstr(plan,"kind",""),"shell") {let command=hw.jstr(plan,"command","");if strings.equal(command,"settings.clock") {command="time"};let status=shell.remote(Vec<str>(command),hw.env("XDG_RUNTIME_DIR"),hw.env("WAYLAND_DISPLAY"),hw.home());if status!=0 {result.raise("Could not open this panel action.")}}
        else {let args=hw.jget(plan,"argv");unsafe {let builder=sp_builder();for i in 0..(json.len(args) as i64) {sp_arg(builder,json.string(json.at(args,i)))};if sp_detach_at(builder,hw.home())==0 {result.raise("Could not start the custom panel action.")}}}
        return "A"
    });print(result.isOk(response) ? result.unwrap(response) : "E\t"+wire.encoded(hw.errorText(result.message(response))))
}
