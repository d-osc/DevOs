use "std/io"
use "std/json"
use "std/strings"
use "std/result"
use "../../lib/hw.dev" as hw
use "../system/org.devos.panel/power-model.dev" as power
while true {
    let line=io.read_line();if strings.equal(line,"") {break}
    let reply=result.attempt(fn():json.Value {
        let request=json.parse(line)
        return json.value({id:hw.jget(request,"id"),power:power.read(hw.envOr("DEVOS_PANEL_SYS","/sys")+"/class/power_supply")})
    })
    if result.isOk(reply) {print(json.stringify(result.unwrap(reply)))} else {print(json.stringify({error:"Could not read panel power state"}))}
}
