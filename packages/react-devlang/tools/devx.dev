#!/usr/bin/env d
# DevLang source-runtime JSX compiler driver. Applications still build natively.
use "std/args"
use "std/module"
use "std/path"
use "std/fs"
use "std/json"
use "std/process"
use "std/io"
use "std/strings"
use "std/result"
use "./devx/base.dev" as b
use "./devx/project.dev" as project

fn help() {
    print("DevLang JSX: d devx.dev -- emit|check SOURCE.devx [--out-dir DIRECTORY] [--syntax-only] [--compiler d]")
    print("             d devx.dev -- compile MANIFEST -- COMMAND [ARGUMENTS...]")
}
fn execute(): i32 {
    if args.len() == 0 { help(); return 1 }
    let action = args.get(0)
    if b.eq(action, "--help") || b.eq(action, "-h") { help(); return 0 }
    if args.len() < 2 { result.raise("Missing source file or manifest") }
    let library = path.dirname(path.dirname(project.canonical(module.entry())))
    if b.eq(action, "compile") {
        let command = Vec<str>()
        let begin = 2
        if args.len() > 2 && b.eq(args.get(2), "--") { begin = 3 }
        for i in begin..(args.len() as i64) { command.push(args.get(i)) }
        return project.compile(command, json.parse(fs.readFileSync(args.get(1), "utf8"))) as i32
    }
    if !b.eq(action, "emit") && !b.eq(action, "check") { result.raise("Unknown JSX command: " + action) }
    let source = args.get(1)
    let directory = "build/react-devlang/check"
    let compiler = process.getenv("DEVLANG_D")
    if b.eq(compiler, "") { compiler = "d" }
    let syntaxOnly = false
    let givenOutput = false
    let i = 2
    while i < args.len() as i64 {
        let option = args.get(i)
        if b.eq(option, "--syntax-only") { syntaxOnly = true }
        else if b.eq(option, "--out-dir") || b.eq(option, "--compiler") {
            if i + 1 >= args.len() as i64 { result.raise("Missing value for " + option) }
            i = i + 1
            if b.eq(option, "--out-dir") { directory = args.get(i); givenOutput = true }
            else { compiler = args.get(i) }
        } else { result.raise("Unknown JSX option: " + option) }
        i = i + 1
    }
    if b.eq(action, "emit") && !givenOutput { result.raise("emit requires --out-dir DIRECTORY") }
    let generated = project.emit(source, directory, library)
    if b.eq(action, "emit") { print(generated); return 0 }
    if syntaxOnly { print("JSX syntax and props checked: " + source); return 0 }
    let manifest = json.parse(fs.readFileSync(generated + ".manifest.json", "utf8"))
    return project.compile(Vec<str>(compiler, "check", generated, "--module-dir", "react_devlang=" + path.resolve(library, "src")), manifest) as i32
}
fn main(): i32 {
    let outcome = result.attempt(execute)
    if result.isOk(outcome) { return result.unwrap(outcome) }
    let message = result.message(outcome)
    let marker = "std/result.raise: "
    let index = strings.lastIndexOf(message, marker)
    if index >= 0 { message = project.byteSlice(message, index + strings.len(marker) as i64, strings.len(message) as i64) }
    project.stderr(message + "\n")
    return 1
}
return main()
