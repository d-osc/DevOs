// Validator for the JSON Schema keywords used by this registry, not a general
// Draft 2020-12 implementation. Unknown validation keywords fail closed.
use "std/json"
use "std/strings"
use "std/regex"
use "std/datetime"
use "std/result"
use "std/url"

fn safe_path(text str) bool {
    if text == "" || strings.startsWith(text, "/") || strings.contains(text, "\\") || strings.contains(text, ":") { return false }
    if strings.len(text) > 1024 { return false }
    let controls = regex.compile("[\\x00-\\x1f\\x7f]", "")
    let has_control = controls.test(text)
    controls.close()
    if has_control { return false }
    for part in strings.split(text, "/") {
        if part == ".." { return false }
    }
    return true
}

fn matches(pattern str, text str) bool {
    // Rust regex does not support JSON Schema's look-ahead assertions.
    // These two exact patterns encode relative paths in app.schema.json.
    if pattern == "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$" { return safe_path(text) }
    if pattern == "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+\\.png$" { return safe_path(text) && strings.endsWith(text, ".png") }
    let compiled = regex.compile(pattern, "")
    let ok = compiled.test(text)
    compiled.close()
    return ok
}

fn format_ok(format str, text str) bool {
    if format == "uri" {
        let parsed = result.attempt(fn() bool {
            let value = url.parse(text)
            return value.protocol == "https:" && value.hostname != "" && !strings.contains(text, " ")
        })
        return result.unwrapOr(parsed, false)
    }
    if format == "date" || format == "date-time" {
        let parsed = result.attempt(fn() bool {
            if format == "date" {
                if !matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$", text) { return false }
                datetime.parse(text + "T00:00:00Z")
            } else { datetime.parse(text) }
            return true
        })
        return result.unwrapOr(parsed, false)
    }
    result.raise("Unsupported schema format: " + format)
    return false
}

fn validate(node json.Value, value json.Value, root json.Value, location str) str {
    for key in json.keys(node) {
        if !strings.contains("|$schema|title|$defs|description|$ref|type|const|enum|required|properties|additionalProperties|items|minItems|uniqueItems|minLength|maxLength|minimum|maximum|pattern|format|allOf|anyOf|not|if|then|else|", "|" + key + "|") {
            result.raise("Unsupported schema keyword: " + key)
        }
    }
    if json.has(node, "$ref") {
        let pointer = json.string(json.get(node, "$ref"))
        if !strings.startsWith(pointer, "#/$defs/") { result.raise("Unsupported schema reference: " + pointer) }
        let name = strings.substring(pointer, 8, strings.charLength(pointer))
        let error = validate(json.get(json.get(root, "$defs"), name), value, root, location)
        if error != "" { return error }
    }
    if json.has(node, "type") {
        let expected = json.string(json.get(node, "type"))
        let actual = json.kind(value)
        let ok = actual == expected || (expected == "boolean" && actual == "bool")
        if expected == "integer" && actual == "number" { ok = matches("^-?[0-9]+$", json.stringify(value)) }
        if !ok { return location + ": expected " + expected }
    }
    if json.has(node, "const") && json.stringify(value) != json.stringify(json.get(node, "const")) { return location + ": invalid constant" }
    if json.has(node, "enum") {
        let found = false
        let values = json.get(node, "enum")
        for i in 0..(json.len(values) as i64) {
            if json.stringify(value) == json.stringify(json.at(values, i)) { found = true }
        }
        if !found { return location + ": invalid enum value" }
    }
    if json.kind(value) == "object" {
        if json.has(node, "required") {
            let required = json.get(node, "required")
            for i in 0..(json.len(required) as i64) {
                let key = json.string(json.at(required, i))
                if !json.has(value, key) { return location + ": missing " + key }
            }
        }
        let properties = json.object()
        if json.has(node, "properties") { properties = json.get(node, "properties") }
        for key in json.keys(value) {
            if json.has(properties, key) {
                let error = validate(json.get(properties, key), json.get(value, key), root, location + "." + key)
                if error != "" { return error }
            } else {
                if json.has(node, "additionalProperties") {
                    let additional = json.get(node, "additionalProperties")
                    if json.kind(additional) == "object" {
                        let error = validate(additional, json.get(value, key), root, location + "." + key)
                        if error != "" { return error }
                    } else {
                        if !json.bool(additional) { return location + ": unknown field " + key }
                    }
                }
            }
        }
    }
    if json.kind(value) == "array" {
        let count = json.len(value) as i64
        if json.has(node, "minItems") && count < json.int(json.get(node, "minItems")) { return location + ": too few items" }
        for i in 0..count {
            if json.has(node, "items") {
                let error = validate(json.get(node, "items"), json.at(value, i), root, location + "[]")
                if error != "" { return error }
            }
            if json.has(node, "uniqueItems") && json.bool(json.get(node, "uniqueItems")) {
                for j in 0..i {
                    if json.stringify(json.at(value, i)) == json.stringify(json.at(value, j)) { return location + ": duplicate item" }
                }
            }
        }
    }
    if json.kind(value) == "string" {
        let text = json.string(value)
        let length = strings.charLength(text)
        if json.has(node, "minLength") && length < json.int(json.get(node, "minLength")) { return location + ": string too short" }
        if json.has(node, "maxLength") && length > json.int(json.get(node, "maxLength")) { return location + ": string too long" }
        if json.has(node, "pattern") && !matches(json.string(json.get(node, "pattern")), text) { return location + ": invalid pattern" }
        if json.has(node, "format") && !format_ok(json.string(json.get(node, "format")), text) { return location + ": invalid format" }
    }
    if json.kind(value) == "number" && json.has(node, "minimum") {
        if json.float(value) < json.float(json.get(node, "minimum")) { return location + ": below minimum" }
    }
    if json.kind(value) == "number" && json.has(node, "maximum") {
        if json.float(value) > json.float(json.get(node, "maximum")) { return location + ": above maximum" }
    }
    if json.has(node, "allOf") {
        let clauses = json.get(node, "allOf")
        for i in 0..(json.len(clauses) as i64) {
            let error = validate(json.at(clauses, i), value, root, location)
            if error != "" { return error }
        }
    }
    if json.has(node, "anyOf") {
        let clauses = json.get(node, "anyOf")
        let found = false
        for i in 0..(json.len(clauses) as i64) {
            if validate(json.at(clauses, i), value, root, location) == "" { found = true }
        }
        if !found { return location + ": no matching schema branch" }
    }
    if json.has(node, "not") && validate(json.get(node, "not"), value, root, location) == "" { return location + ": forbidden field combination" }
    if json.has(node, "if") {
        let branch = "else"
        if validate(json.get(node, "if"), value, root, location) == "" { branch = "then" }
        if json.has(node, branch) { return validate(json.get(node, branch), value, root, location) }
    }
    return ""
}
