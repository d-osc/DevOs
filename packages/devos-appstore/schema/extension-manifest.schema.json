{
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "required": [
    "id",
    "name",
    "description",
    "version",
    "apiVersion",
    "settingsVersion",
    "enabledByDefault",
    "kind",
    "settings"
  ],
  "properties": {
    "description": {
      "minLength": 1,
      "type": "string"
    },
    "enabledByDefault": {
      "type": "boolean"
    },
    "entry": {
      "pattern": "^[a-z][a-z0-9.-]*\\.js$",
      "type": "string"
    },
    "version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "kind": {
      "enum": [
        "settings",
        "ui"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "apiVersion": {
      "const": 1
    },
    "settingsVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "order": {
      "minimum": 0,
      "type": "integer",
      "maximum": 9007199254740991
    },
    "settings": {
      "minItems": 0,
      "type": "array",
      "items": {
        "required": [
          "id",
          "title",
          "fields"
        ],
        "type": "object",
        "properties": {
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "fields": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "title",
                "type",
                "default"
              ],
              "properties": {
                "default": {},
                "type": {
                  "enum": [
                    "string",
                    "color",
                    "number",
                    "boolean"
                  ]
                },
                "min": {
                  "type": "number"
                },
                "title": {
                  "minLength": 1,
                  "type": "string"
                },
                "integer": {
                  "type": "boolean"
                },
                "key": {
                  "pattern": "^[a-z][a-zA-Z0-9_]*$",
                  "type": "string"
                },
                "description": {
                  "minLength": 1,
                  "type": "string"
                },
                "max": {
                  "type": "number"
                }
              },
              "allOf": [
                {
                  "then": {
                    "properties": {
                      "default": {
                        "type": "string"
                      }
                    }
                  },
                  "if": {
                    "properties": {
                      "type": {
                        "const": "string"
                      }
                    }
                  }
                },
                {
                  "then": {
                    "properties": {
                      "default": {
                        "pattern": "^#[0-9a-fA-F]{6}$",
                        "type": "string"
                      }
                    }
                  },
                  "if": {
                    "properties": {
                      "type": {
                        "const": "color"
                      }
                    }
                  }
                },
                {
                  "then": {
                    "properties": {
                      "default": {
                        "type": "number"
                      }
                    }
                  },
                  "if": {
                    "properties": {
                      "type": {
                        "const": "number"
                      }
                    }
                  }
                },
                {
                  "then": {
                    "properties": {
                      "default": {
                        "type": "boolean"
                      }
                    }
                  },
                  "if": {
                    "properties": {
                      "type": {
                        "const": "boolean"
                      }
                    }
                  }
                }
              ],
              "additionalProperties": false
            }
          },
          "title": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "system": {
      "const": false
    }
  },
  "allOf": [
    {
      "then": {
        "required": [
          "system",
          "entry",
          "order"
        ]
      },
      "else": {
        "properties": {
          "settings": {
            "minItems": 1
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "system"
              ]
            },
            {
              "required": [
                "entry"
              ]
            },
            {
              "required": [
                "order"
              ]
            }
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "ui"
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "title": "DevOs user extension manifest: canonical registry subset"
}
