#!/bin/sh
set -eu
base=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -f "$base/src/main.ts" ] || [ -f "$base/dist/main.js" ]; then root=$base; else root="$base/share/dev-os"; fi
export DEV_OS_ROOT="$root"
export DEV_OS_SHELL="$base/bin/dev-os-shell"
. "$base/bin/dev-os-runtime-env"
# Boot animation: continue it as a window over the compositor until the shell reports ready (fire-and-forget, never blocks).
splash_window=/usr/libexec/devos-splash-window.js
if [ -r "$splash_window" ] && command -v devos-splash >/dev/null 2>&1; then
    case " $(cat /proc/cmdline 2>/dev/null || true) " in
        *' devos.splash=0 '*|*' debug '*|*' systemd.show_status=1 '*) ;;
        *' splash '*)
            if [ ! -d /run/devos-splash.d ]; then
                DEVOS_SPLASH_STEPS=${XDG_RUNTIME_DIR:-/tmp}/devos-splash.d; mkdir -p "$DEVOS_SPLASH_STEPS"; export DEVOS_SPLASH_STEPS
            fi
            devos-splash --step compositor || true
            gjs -m "$splash_window" >/dev/null 2>&1 &
            ;;
    esac
fi
if [ "${DEV_OS_LOGIN:-0}" = 1 ]; then
    gjs -m "$root/dist/login.js"
fi
# Fast path of dev-os-system-run for the supervisor: same systemd scope, without starting DevLang first.
uid=$(id -u)
bus="/run/user/$uid/bus"
run_supervisor() {
    if [ -e "$bus" ] && command -v systemd-run >/dev/null 2>&1 &&
        DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" systemctl --user show-environment >/dev/null 2>&1; then
        scope=$(od -An -N6 -tx1 /dev/urandom | tr -d '[:space:]')
        if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then set -- "DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS"
        else set -- -u DBUS_SESSION_BUS_ADDRESS; fi
        DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" systemd-run --user --scope --quiet --collect --slice=app.slice             --unit="devos-system-$scope.scope" --property=MemoryAccounting=yes --property=MemorySwapMax=0             --property=MemoryLow=256M --property=CPUWeight=200 --property=IOWeight=200 -- /usr/bin/env "$@" gjs -m "$root/dist/supervisor.js"
    else
        d "$base/bin/dev-os-system-run" -- gjs -m "$root/dist/supervisor.js"
    fi
}
# The supervisor ends the session itself (it terminates labwc) on logout, so any other way out of it, such as an OOM kill
# of its scope, would leave labwc alone with an empty desktop. Start it again while the compositor is still alive.
labwc=${LABWC_PID:-}
case "$labwc" in ''|*[!0-9]*) labwc= ;; esac
failures=0
window=$(date +%s)
while :; do
    status=0
    run_supervisor || status=$?
    if [ "$status" -eq 0 ] || [ -z "$labwc" ] || ! kill -0 "$labwc" 2>/dev/null; then exit "$status"; fi
    now=$(date +%s)
    if [ $((now - window)) -gt 300 ]; then window=$now; failures=0; fi
    failures=$((failures + 1))
    if [ "$failures" -gt 5 ]; then
        printf '%s
' 'Dev OS: the session supervisor keeps failing; ending the session.' >&2
        kill -TERM "$labwc" 2>/dev/null || true
        exit "$status"
    fi
    printf 'Dev OS: session supervisor stopped (status %s); restarting (%s/5).
' "$status" "$failures" >&2
    sleep 1
done
