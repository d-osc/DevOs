#!/usr/bin/env python3
"""Display care for Dev OS Settings (the MyASUS "OLED Care", "OLED Flicker-Free Dimming", "Splendid" and "Target Mode" cards).

Usage: dev-os-display-care get | set <key> <value> | reset | apply | serve
JSON on stdout, exit 1 on failure. Everything runs as the user; no root and no polkit action is needed.

What is real on this stack (labwc / wlroots, no vendor driver) and what is not:
  gamma ramps   `serve` is a Wayland client of wlr-gamma-control-unstable-v1. One ramp per output carries the Splendid mode
                (Normal, Vivid, Manual temperature, Eye Care) and the Flicker-Free Dimming level. A ramp is three 1-D lookup
                tables, so it can change colour temperature, contrast and overall level, but it can NOT change saturation or turn
                the picture black and white. Vivid is therefore a contrast boost and E-Reading (grayscale) is reported as
                unavailable. Dimming scales pixel values (no PWM, so no flicker) and is separate from the kernel backlight.
  pixel refresh `serve` also listens to ext-idle-notify-v1 and creates $XDG_RUNTIME_DIR/devos-pixel-refresh after 30 minutes
                without input (removed on activity). The shell (org.devos.displaycare) draws the screen saver; idle inhibitors
                such as a fullscreen video are honoured by the compositor.
  colour gamut  needs ICC/colour-transform support in the compositor. wlroots/labwc here has none, so only "Native" exists.
  shell effects panel auto-hide, panel transparency, Pixel Shift, Target Mode and Adaptive Edge Brightness are drawn by the
                shell itself; this helper only validates and stores their settings.
`serve` is started by the shell (org.devos.displaycare) and by `set`/`apply`; a lock keeps it to one copy per session.
State: $XDG_CONFIG_HOME/devos/display-care.json. `serve` re-reads it when the file changes and holds no gamma control while
every value is at its default, so other gamma tools keep working.
Test hooks: DEVOS_DISPLAY_SPAWN, DEVOS_DISPLAY_BACKLIGHT, DEVOS_DISPLAY_SYS, DEVOS_DISPLAY_IDLE_MS, DEVOS_DISPLAY_ONCE.
"""
import json
import math
import os
import select
import shlex
import socket
import struct
import subprocess
import sys
import time

SPLENDID = ('normal', 'vivid', 'manual', 'eyecare')
RECOMMENDED_BRIGHTNESS = 70
IDLE_MS = int(os.environ.get('DEVOS_DISPLAY_IDLE_MS') or 30 * 60 * 1000)

DEFAULTS = {
    'splendid': 'normal', 'temperature': 0, 'eyeCare': 3, 'gamut': 'native', 'dimming': 100,
    'pixelRefresh': True, 'autoHidePanel': False, 'panelTransparency': True,
    'targetMode': False, 'edgeBrightness': 0,
}
# The settings Reset button restores exactly these (plus the backlight).
RESET_KEYS = ('splendid', 'temperature', 'eyeCare', 'gamut', 'dimming')
REASONS = {
    'ereading': 'E-Reading turns the picture black and white. A gamma ramp is three 1-D tables and cannot remove colour, and the compositor has no colour matrix, so it is not offered.',
    'gamut': 'Changing the colour gamut needs ICC / colour-transform support in the compositor. labwc and wlroots here only drive the panel natively, so only Native exists.',
}


class Failure(Exception):
    pass


def config_dir():
    base = os.environ.get('XDG_CONFIG_HOME') or os.path.join(os.path.expanduser('~'), '.config')
    return os.path.join(base, 'devos')


STATE = lambda: os.path.join(config_dir(), 'display-care.json')
runtime = lambda: os.environ.get('XDG_RUNTIME_DIR') or '/tmp'
FLAG = lambda: os.path.join(runtime(), 'devos-pixel-refresh')
tool = lambda env, name: shlex.split(os.environ.get(env) or name)


def integer(value, low, high, name):
    try:
        number = int(str(value).strip(), 10)
    except ValueError:
        raise Failure(f'{name} must be a whole number from {low} to {high}.')
    if not low <= number <= high:
        raise Failure(f'{name} must be a whole number from {low} to {high}.')
    return number


def boolean(value, name):
    text = str(value).strip().lower()
    if text in ('1', 'true', 'on', 'yes'):
        return True
    if text in ('0', 'false', 'off', 'no'):
        return False
    raise Failure(f'{name} must be on or off.')


def validate(key, value):
    if key == 'splendid':
        text = str(value).strip().lower()
        if text == 'ereading':
            raise Failure(REASONS['ereading'])
        if text not in SPLENDID:
            raise Failure('Splendid mode must be normal, vivid, manual or eyecare.')
        return text
    if key == 'temperature':
        return integer(value, -50, 50, 'Colour temperature')
    if key == 'eyeCare':
        return integer(value, 1, 5, 'Eye Care level')
    if key == 'gamut':
        if str(value).strip().lower() != 'native':
            raise Failure(REASONS['gamut'])
        return 'native'
    if key == 'dimming':
        return integer(value, 0, 100, 'Dimming level')
    if key == 'edgeBrightness':
        return integer(value, 0, 4, 'Adaptive Edge Brightness')
    if key in ('pixelRefresh', 'autoHidePanel', 'panelTransparency', 'targetMode'):
        return boolean(value, key)
    raise Failure(f'Unknown display setting "{key}".')


def load_settings():
    """Saved values; anything missing or invalid falls back to its default, so a damaged file never blocks the desktop."""
    values = dict(DEFAULTS)
    try:
        with open(STATE(), encoding='utf-8') as handle:
            saved = json.load(handle)
    except (OSError, ValueError):
        return values
    if isinstance(saved, dict):
        for key in DEFAULTS:
            if key in saved:
                try:
                    values[key] = validate(key, saved[key]) if not isinstance(saved[key], bool) else boolean(saved[key], key)
                except Failure:
                    pass
    return values


def save_settings(values):
    os.makedirs(config_dir(), exist_ok=True)
    temporary = STATE() + '.tmp'
    with open(temporary, 'w', encoding='utf-8') as handle:
        json.dump(values, handle, indent=2, sort_keys=True)
        handle.write('\n')
    os.replace(temporary, STATE())


# ---------------------------------------------------------------- colour maths

def kelvin_rgb(kelvin):
    """Black-body colour (Tanner Helland's approximation), each channel 0..1."""
    t = kelvin / 100.0
    clamp = lambda x: max(0.0, min(255.0, x))
    red = 255.0 if t <= 66 else clamp(329.698727446 * ((t - 60) ** -0.1332047592))
    green = clamp(99.4708025861 * math.log(t) - 161.1195681661) if t <= 66 else clamp(288.1221695283 * ((t - 60) ** -0.0755148492))
    blue = 255.0 if t >= 66 else (0.0 if t <= 19 else clamp(138.5177312231 * math.log(t - 10) - 305.0447927307))
    return red / 255.0, green / 255.0, blue / 255.0


def temperature_gains(offset):
    """-50 (warm) .. +50 (cool) around 6500 K; gains never exceed 1 so the picture only gets dimmer, never clipped."""
    target, reference = kelvin_rgb(6500 + offset * 60), kelvin_rgb(6500)
    gains = [t / r for t, r in zip(target, reference)]
    top = max(gains)
    return tuple(g / top for g in gains)


def profile(values):
    """(per-channel gains, vivid amount, overall scale) for a settings dictionary."""
    gains, vivid, mode = (1.0, 1.0, 1.0), 0.0, values['splendid']
    if mode == 'manual':
        gains = temperature_gains(values['temperature'])
    elif mode == 'eyecare':
        level = values['eyeCare']
        gains = (1.0, 1.0 - 0.012 * level, 1.0 - 0.06 * level)
    elif mode == 'vivid':
        vivid = 0.35
    scale = 0.25 + 0.75 * values['dimming'] / 100.0
    return gains, vivid, scale


def is_identity(values):
    gains, vivid, scale = profile(values)
    return vivid == 0.0 and scale == 1.0 and all(abs(g - 1.0) < 1e-9 for g in gains)


def ramp(size, values):
    """Red, green and blue tables of `size` 16-bit entries."""
    gains, vivid, scale = profile(values)
    channels = []
    for gain in gains:
        table = []
        for index in range(size):
            x = index / (size - 1) if size > 1 else 1.0
            if vivid:
                x = x * (1 - vivid) + vivid * (x * x * (3 - 2 * x))
            table.append(max(0, min(65535, int(round(x * gain * scale * 65535)))))
        channels.append(table)
    return channels


# --------------------------------------------------------------- Wayland client

class Wayland:
    """The few Wayland requests this helper needs, spoken directly (no pywayland on the image)."""

    def __init__(self, path=None):
        path = path or os.environ.get('WAYLAND_DISPLAY') or 'wayland-0'
        if not os.path.isabs(path):
            path = os.path.join(runtime(), path)
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            self.sock.connect(path)
        except OSError as reason:
            raise Failure(f'No Wayland compositor at {path}: {reason.strerror or reason}.')
        self.buffer = b''
        self.next = 2
        self.handlers = {1: self.display_event}
        self.globals = {}
        self.removed = []
        self.callbacks = {}
        self.registry = self.allocate(self.registry_event)
        self.send(1, 1, struct.pack('<I', self.registry))

    def allocate(self, handler):
        number = self.next
        self.next += 1
        self.handlers[number] = handler
        return number

    @staticmethod
    def string(text):
        data = text.encode() + b'\0'
        return struct.pack('<I', len(data)) + data + b'\0' * (-len(data) % 4)

    def send(self, obj, opcode, payload=b'', fds=()):
        message = struct.pack('<II', obj, ((8 + len(payload)) << 16) | opcode) + payload
        if fds:
            socket.send_fds(self.sock, [message], list(fds))
        else:
            self.sock.sendall(message)

    def bind(self, name, interface, version, handler):
        number = self.allocate(handler)
        self.send(self.registry, 0, struct.pack('<I', name) + self.string(interface) + struct.pack('<II', version, number))
        return number

    def display_event(self, opcode, data):
        if opcode == 0:
            _object, code = struct.unpack_from('<II', data)
            length = struct.unpack_from('<I', data, 8)[0]
            raise Failure('Wayland protocol error %d: %s' % (code, data[12:12 + max(0, length - 1)].decode(errors='replace')))
        if opcode == 1:
            self.handlers.pop(struct.unpack_from('<I', data)[0], None)

    def registry_event(self, opcode, data):
        if opcode == 0:
            name, length = struct.unpack_from('<II', data)
            interface = data[8:8 + length - 1].decode()
            version = struct.unpack_from('<I', data, 8 + length + (-length % 4))[0]
            self.globals[name] = (interface, version)
        elif opcode == 1:
            name = struct.unpack_from('<I', data)[0]
            self.globals.pop(name, None)
            self.removed.append(name)

    def find(self, interface):
        return [(name, version) for name, (iface, version) in sorted(self.globals.items()) if iface == interface]

    def pump(self, timeout=0.0):
        ready, _, _ = select.select([self.sock], [], [], timeout)
        if not ready:
            return False
        chunk = self.sock.recv(65536)
        if not chunk:
            raise Failure('The compositor closed the connection.')
        self.buffer += chunk
        while len(self.buffer) >= 8:
            obj, word = struct.unpack_from('<II', self.buffer)
            size = word >> 16
            if size < 8 or len(self.buffer) < size:
                break
            data, self.buffer = self.buffer[8:size], self.buffer[size:]
            handler = self.handlers.get(obj)
            if handler:
                handler(word & 0xffff, data)
        return True

    def roundtrip(self, timeout=3.0):
        done = []
        callback = self.allocate(lambda opcode, data: done.append(True))
        self.send(1, 0, struct.pack('<I', callback))
        deadline = time.monotonic() + timeout
        while not done:
            left = deadline - time.monotonic()
            if left <= 0:
                raise Failure('The compositor did not answer.')
            self.pump(left)
        self.handlers.pop(callback, None)

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass


def probe():
    """What this session's compositor offers, without changing anything."""
    result = {'gamma': {'available': False, 'reason': ''}, 'idle': {'available': False, 'reason': ''}}
    try:
        wl = Wayland()
        wl.roundtrip()
    except Failure as reason:
        text = str(reason)
        return {'gamma': {'available': False, 'reason': text}, 'idle': {'available': False, 'reason': text}}
    try:
        if wl.find('zwlr_gamma_control_manager_v1') and wl.find('wl_output'):
            result['gamma']['available'] = True
        else:
            result['gamma']['reason'] = 'The compositor does not offer wlr-gamma-control, so colour and dimming changes cannot be applied.'
        if wl.find('ext_idle_notifier_v1') and wl.find('wl_seat'):
            result['idle']['available'] = True
        else:
            result['idle']['reason'] = 'The compositor does not report idle time, so Pixel refresh cannot start by itself.'
    finally:
        wl.close()
    return result


class Output:
    def __init__(self, name, handle):
        self.name, self.handle, self.control, self.size, self.failed = name, handle, None, 0, False


class Service:
    """Applies the saved settings to every output and reports idle time until it is stopped."""

    def __init__(self):
        self.wl = Wayland()
        self.wl.roundtrip()
        self.values = None
        self.outputs = {}
        self.manager = None
        self.idle = None
        self.idle_object = None
        self.seat = None
        gamma, notifier, seats = (self.wl.find(x) for x in ('zwlr_gamma_control_manager_v1', 'ext_idle_notifier_v1', 'wl_seat'))
        if gamma:
            self.manager = self.wl.bind(gamma[0][0], 'zwlr_gamma_control_manager_v1', 1, lambda opcode, data: None)
        if notifier and seats:
            self.idle = self.wl.bind(notifier[0][0], 'ext_idle_notifier_v1', 1, lambda opcode, data: None)
            self.seat = self.wl.bind(seats[0][0], 'wl_seat', 1, lambda opcode, data: None)
        self.sync_outputs()
        if not self.manager and not self.idle:
            raise Failure('The compositor offers neither gamma control nor idle notifications.')
        self.mtime = None

    def sync_outputs(self):
        """Bind new outputs and forget removed ones; True when the set changed."""
        if not self.manager:
            return False
        changed = bool(self.wl.removed)
        known = {o.name for o in self.outputs.values()}
        for name, _version in self.wl.find('wl_output'):
            if name not in known:
                handle = self.wl.bind(name, 'wl_output', 1, lambda opcode, data: None)
                self.outputs[name] = Output(name, handle)
                changed = True
        for name in self.wl.removed:
            output = self.outputs.pop(name, None)
            if output and output.control:
                self.wl.send(output.control, 1)
        self.wl.removed.clear()
        return changed

    def attach(self, output):
        def event(opcode, data, output=output):
            if opcode == 0:
                output.size = struct.unpack_from('<I', data)[0]
                self.paint(output)
            elif opcode == 1:
                output.failed = True
                output.size = 0
                print(f'DevOs display care: another client controls the gamma of {output.name}; leaving it alone.', file=sys.stderr)
        output.failed = False
        output.control = self.wl.allocate(event)
        self.wl.send(self.manager, 0, struct.pack('<II', output.control, output.handle))

    def release(self, output):
        if output.control:
            self.wl.send(output.control, 1)
            self.wl.handlers.pop(output.control, None)
            output.control, output.size = None, 0

    def paint(self, output):
        if not output.control or output.size < 2 or self.values is None:
            return
        red, green, blue = ramp(output.size, self.values)
        payload = struct.pack('<%dH' % (output.size * 3), *(red + green + blue))
        fd = os.memfd_create('devos-gamma', 0) if hasattr(os, 'memfd_create') else os.open(os.environ.get('TMPDIR', '/tmp'), os.O_TMPFILE | os.O_RDWR, 0o600)
        try:
            os.write(fd, payload)
            os.lseek(fd, 0, os.SEEK_SET)
            self.wl.send(output.control, 0, b'', [fd])
        finally:
            os.close(fd)

    def apply_gamma(self):
        if not self.manager:
            return
        for output in list(self.outputs.values()):
            if is_identity(self.values):
                self.release(output)
            elif not output.control or output.failed:
                if output.control:
                    self.release(output)
                self.attach(output)
            else:
                self.paint(output)

    def apply_idle(self):
        if not self.idle:
            return
        want = self.values['pixelRefresh']
        if want and not self.idle_object:
            def event(opcode, data):
                if opcode == 0:
                    try:
                        with open(FLAG(), 'w') as handle:
                            handle.write(str(int(time.time())))
                    except OSError:
                        pass
                elif opcode == 1:
                    self.clear_flag()
            self.idle_object = self.wl.allocate(event)
            self.wl.send(self.idle, 1, struct.pack('<III', self.idle_object, IDLE_MS, self.seat))
        elif not want and self.idle_object:
            self.wl.send(self.idle_object, 0)
            self.wl.handlers.pop(self.idle_object, None)
            self.idle_object = None
            self.clear_flag()

    @staticmethod
    def clear_flag():
        try:
            os.unlink(FLAG())
        except OSError:
            pass

    def reload(self):
        try:
            stamp = os.stat(STATE()).st_mtime_ns
        except OSError:
            stamp = 0
        if stamp != self.mtime or self.values is None:
            self.mtime = stamp
            self.values = load_settings()
            self.apply_gamma()
            self.apply_idle()

    def run(self):
        once = bool(os.environ.get('DEVOS_DISPLAY_ONCE'))
        try:
            while True:
                self.reload()
                if self.sync_outputs():
                    self.apply_gamma()
                self.wl.pump(1.0)
                if once and all(o.size or o.failed or not o.control for o in self.outputs.values()):
                    self.wl.roundtrip()
                    break
        finally:
            self.clear_flag()
            self.wl.close()


# ------------------------------------------------------------------- commands

def battery_state():
    root = os.environ.get('DEVOS_DISPLAY_SYS') or '/sys'
    base = os.path.join(root, 'class/power_supply')
    present, mains = False, None
    try:
        names = sorted(os.listdir(base))
    except OSError:
        names = []
    for name in names:
        try:
            kind = open(os.path.join(base, name, 'type')).read().strip()
            if kind == 'Battery':
                present = True
            elif kind == 'Mains':
                online = open(os.path.join(base, name, 'online')).read().strip() == '1'
                mains = online or bool(mains)
        except OSError:
            pass
    return {'present': present, 'onBattery': bool(present and mains is False)}


def report(extra=None):
    values = load_settings()
    capability = probe()
    result = {'ok': True, 'settings': values, 'gamma': capability['gamma'], 'idle': capability['idle'],
              'ereading': {'available': False, 'reason': REASONS['ereading']},
              'gamut': {'available': False, 'options': ['native'], 'reason': REASONS['gamut']},
              'battery': battery_state(), 'recommendedBrightness': RECOMMENDED_BRIGHTNESS}
    if extra:
        result.update(extra)
    return result


def start_service():
    """Make sure `serve` runs. It is a plain child of the caller, because only the desktop session knows the compositor
    socket (the systemd user manager does not); a second copy sees the lock and exits at once, so this is always safe."""
    command = tool('DEVOS_DISPLAY_SPAWN', '') or [sys.executable, os.path.abspath(__file__)]
    try:
        subprocess.Popen(command + ['serve'], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def hold_lock():
    """One `serve` per user session; returns the open lock file, or None when another copy already runs."""
    import fcntl
    handle = open(os.path.join(runtime(), 'devos-display-care.lock'), 'w')
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        handle.close()
        return None
    return handle


def reset_brightness():
    command = tool('DEVOS_DISPLAY_BACKLIGHT', 'dev-os-backlight')
    try:
        done = subprocess.run(command + ['set', str(RECOMMENDED_BRIGHTNESS)], capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired) as reason:
        return {'brightness': {'ok': False, 'reason': str(reason)}}
    if done.returncode != 0:
        return {'brightness': {'ok': False, 'reason': (done.stdout + done.stderr).strip() or 'The backlight could not be set.'}}
    return {'brightness': {'ok': True, 'percent': RECOMMENDED_BRIGHTNESS}}


def main(argv):
    command = argv[1] if len(argv) > 1 else ''
    try:
        if command == 'get':
            result = report()
        elif command == 'set':
            if len(argv) != 4:
                raise Failure('Usage: dev-os-display-care set <key> <value>')
            values = load_settings()
            values[argv[2]] = validate(argv[2], argv[3])
            save_settings(values)
            start_service()
            result = report()
        elif command == 'reset':
            values = load_settings()
            values.update({key: DEFAULTS[key] for key in RESET_KEYS})
            save_settings(values)
            start_service()
            result = report(reset_brightness())
        elif command == 'apply':
            start_service()
            result = {'ok': True}
        elif command == 'serve':
            lock = hold_lock()
            if lock is None:
                return 0
            try:
                Service().run()
            except Failure as reason:
                print(f'DevOs display care: {reason}', file=sys.stderr)
                return 0 if 'neither' in str(reason) else 1
            return 0
        else:
            raise Failure('Usage: dev-os-display-care get | set <key> <value> | reset | apply | serve')
    except Failure as reason:
        print(json.dumps({'ok': False, 'error': str(reason)}))
        return 1
    print(json.dumps(result))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
