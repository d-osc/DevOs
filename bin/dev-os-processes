#!/usr/bin/env d
# Compatibility entry point; sampler and safe termination are shared with native apps.
use "std/json"
use "../lib/processes.dev" as core
fn confValue(name:str):i64 { return core.confValue(name) }
fn selfPidValue():i64 { return core.selfPidValue() }
fn readProcess(pid:i64, page:i64, uids:json.Value):json.Value { return core.readProcess(pid,page,uids) }
fn rawSample(page:i64, uids:json.Value):json.Value { return core.rawSample(page,uids) }
fn sample(previous:json.Value,names:json.Value,page:i64,ticks:i64,pid:i64):json.Value { return core.sample(previous,names,page,ticks,pid) }
fn stopProcess(request:json.Value,page:i64,pid:i64):json.Value { return core.stopProcess(request,page,pid) }
fn main():i32 { return core.main() }
return main()
