#!/usr/bin/env d
# Load the platform GIO library in a DevLang worker; secrets travel only over stdin.
use "std/fs"
use "std/io"
use "std/json"
use "std/path"
use "std/module"
use "std/strings"
use "std/result"
use "../lib/posix.dev" as posix
use "../lib/desktop.dev" as util
fn systemLibrary(library: str): str {
    for base in Vec<str>("/usr/lib", "/lib", "/usr/lib64", "/lib64") {
        let direct = base + "/" + library
        if fs.is_file(direct) { return direct }
        for name in util.children(base) {
            let candidate = base + "/" + name + "/" + library
            if fs.is_file(candidate) { return candidate }
        }
    }
    result.raise("A required network library is not installed.")
    return ""
}
fn main(): i32 {
    let raw = io.read_line()
    let request = util.parse(raw)
    util.require(strings.equal(json.kind(request), "object") && !util.failed(request), "Invalid network request.")
    if strings.equal(util.text(util.get(request, "action")), "settings") { result.raise("Manage Wi-Fi inside DevOs Settings. External network settings are disabled.") }
    if strings.equal(util.text(util.get(request, "action")), "airplane") {
        util.require(strings.equal(json.kind(util.get(request, "enabled")), "bool"), "Invalid airplane mode state.")
        let args = Vec<str>("/usr/libexec/devos-radio-admin")
        let program = "pkexec"
        if posix.euid() == 0 { program = "/usr/libexec/devos-radio-admin"; args = Vec<str>() }
        let response = util.run(program, args, raw + "\n", 60000)
        let answer = util.parse(util.output(response))
        util.require(response.success && !util.failed(answer), "Airplane mode was not changed. Administrator authentication or radio access failed.")
        raw = "{\"action\":\"radios\"}"
    }
    let worker = path.dirname(path.dirname(module.entry())) + "/lib/network-settings-worker.dev"
    let args = Vec<str>(worker, "--ffi-lib", systemLibrary("libgio-2.0.so.0"))
    if strings.equal(util.text(util.get(request, "action")), "vpn-import") { args.push("--ffi-lib"); args.push(systemLibrary("libnm.so.0")) }
    let response = util.run("d", args, raw + "\n", 85000)
    let value = util.parse(util.output(response))
    print(json.stringify(value))
    return response.success && !util.failed(value) ? 0 : 1
}
let outcome = result.attempt(fn(): i32 { return main() })
if result.isErr(outcome) { print(json.stringify(util.error(result.message(outcome)))); return 1 }
return result.unwrap(outcome)
