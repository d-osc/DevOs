#!/usr/bin/env python3
"""Touchpad lock and Smart Gestures for Dev OS Settings (the MyASUS "Touchpad" and "Smart Gestures" cards).

Usage: dev-os-touchpad-gestures get | lock on|off|toggle | gestures on|off | launch <target> | apply | serve
JSON on stdout, exit 1 on failure. Everything runs as the user; no root and no polkit action is needed.

Lock: the choice is saved in $XDG_CONFIG_HOME/dev-os/touchpad-gestures.json and applied by regenerating the labwc
`<device category="touchpad">` block with `<sendEventsMode>no</sendEventsMode>` (lib/touchpad.dev reads the file, so the
lock also survives a new session). The helper re-runs `dev-os-touchpad save` with the saved touchpad settings to do it.
Fn+F9 style hotkeys (XF86TouchpadToggle/On/Off) are bound in config/labwc/rc.xml to `lock toggle|on|off`.

Smart Gestures (off by default): `serve` observes the touchpad's evdev node read-only (it never grabs it, the compositor
keeps the pointer). A single finger that touches down inside an edge zone and moves mostly along that edge gives
  left edge   slide up/down       volume        wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+/5%-  (limit 100%)
  right edge  slide up/down       brightness    dev-os-backlight up|down (5% steps, real backlight)
  top edge    slide right/left    seek          MPRIS Player.Seek over busctl (5 s per step)
  top-right corner, swipe inward  launch target dev-os-shell <task-manager|launcher|task-view|settings|files|terminal>
Because the device is not grabbed, the cursor still moves while a finger slides along an edge; libinput offers no
per-zone event filtering. A 2nd finger, a start outside a zone or a mostly sideways path cancels the gesture.

Test hooks: DEVOS_TP_PROC (bus device list), DEVOS_TP_DEV (dir with eventN nodes), DEVOS_TP_RANGE ("minx,maxx,miny,maxy"
for nodes that are not real evdev devices), DEVOS_TP_TOUCHPAD_HELPER, DEVOS_TP_SYSTEMCTL, DEVOS_TP_SYSTEMRUN, DEVOS_TP_SYS, DEVOS_TP_PATH,
DEVOS_TP_BUSCTL, DEVOS_TP_WPCTL, DEVOS_TP_BACKLIGHT, DEVOS_TP_SHELL, DEVOS_TP_NOTIFY, DEVOS_TP_ONESHOT.
"""
import fcntl
import json
import os
import select
import shlex
import shutil
import struct
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
LAUNCH_TARGETS = {
    'task-manager': 'Task Manager', 'launcher': 'Application launcher', 'task-view': 'Task View',
    'settings': 'Settings', 'files': 'Files', 'terminal': 'Terminal', 'none': 'Nothing',
}
UNIT = 'devos-touchpad-gestures.service'
TRANSIENT = 'devos-touchpad-gestures-session.service'
DEFAULTS = {'locked': False, 'enabled': False, 'launch': 'task-manager'}

# Zone geometry as fractions of the touchpad, and how far a finger has to move.
EDGE = 0.08          # left / right / top strips
CORNER = 0.15        # top-right square
DEAD = 0.03          # movement along the edge before the gesture starts
STEP = 0.05          # one volume / brightness / seek step per this much travel along the edge
SIDEWAYS = 1.5       # along-edge travel must be at least this much more than the travel across the edge
CORNER_PULL = 0.10   # inward travel (both axes) that completes the corner swipe
COOLDOWN = 1.5       # seconds between launches
SEEK_SECONDS = 5

EV_SYN, EV_KEY, EV_ABS = 0, 1, 3
SYN_REPORT = 0
ABS_X, ABS_Y, ABS_MT_SLOT, ABS_MT_POSITION_X, ABS_MT_POSITION_Y, ABS_MT_TRACKING_ID = 0, 1, 0x2f, 0x35, 0x36, 0x39
BTN_TOUCH, BTN_TOOL_FINGER = 0x14a, 0x145
EVENT = struct.Struct('llHHi')


class Failure(Exception):
    pass


def config_dir():
    base = os.environ.get('XDG_CONFIG_HOME') or os.path.join(os.path.expanduser('~'), '.config')
    return os.path.join(base, 'dev-os')


def state_path():
    return os.path.join(config_dir(), 'touchpad-gestures.json')


def tool(env, name):
    return shlex.split(os.environ.get(env) or name)


def run(command, timeout=15, stdin=None):
    try:
        done = subprocess.run(command, capture_output=True, text=True, timeout=timeout, input=stdin)
    except (OSError, subprocess.TimeoutExpired) as reason:
        return 127, str(reason)
    return done.returncode, (done.stdout or '') + (done.stderr or '')


def which(name):
    return shutil.which(name, path=os.environ.get('DEVOS_TP_PATH')) is not None


# ---- saved state ------------------------------------------------------------------------------------------------
def load():
    state = dict(DEFAULTS)
    try:
        with open(state_path(), encoding='utf8') as file:
            saved = json.load(file)
    except (OSError, ValueError):
        return state
    if isinstance(saved, dict):
        for key in ('locked', 'enabled'):
            if isinstance(saved.get(key), bool):
                state[key] = saved[key]
        if saved.get('launch') in LAUNCH_TARGETS:
            state['launch'] = saved['launch']
    return state


def save(state):
    os.makedirs(config_dir(), exist_ok=True)
    temporary = state_path() + '.tmp'
    with open(temporary, 'w', encoding='utf8') as file:
        json.dump({key: state[key] for key in DEFAULTS}, file)
    os.replace(temporary, state_path())


# ---- touchpad detection (kernel device list, no udev and no invented paths) ---------------------------------------
def bits(text):
    """Value of a /proc/bus/input/devices bitmap: space separated hex words, most significant word first."""
    value = 0
    for word in text.split():
        value = (value << 64) | int(word, 16)
    return value


def touchpads():
    """Touchpad event nodes: absolute X/Y plus a finger tool button. Returns [{name, path}]."""
    found = []
    try:
        with open(os.environ.get('DEVOS_TP_PROC') or '/proc/bus/input/devices', encoding='utf8', errors='replace') as file:
            blocks = file.read().split('\n\n')
    except OSError:
        return found
    base = os.environ.get('DEVOS_TP_DEV') or '/dev/input'
    for block in blocks:
        name, handlers, key, absolute = '', '', 0, 0
        for line in block.splitlines():
            if line.startswith('N: Name='):
                name = line.split('=', 1)[1].strip().strip('"')
            elif line.startswith('H: Handlers='):
                handlers = line.split('=', 1)[1]
            try:
                if line.startswith('B: KEY='):
                    key = bits(line.split('=', 1)[1])
                elif line.startswith('B: ABS='):
                    absolute = bits(line.split('=', 1)[1])
            except ValueError:
                pass
        event = next((word for word in handlers.split() if word.startswith('event') and word[5:].isdigit()), '')
        if event and key >> BTN_TOOL_FINGER & 1 and absolute & 1 and absolute >> 1 & 1:
            found.append({'name': name or event, 'path': os.path.join(base, event)})
    return found


def abs_range(descriptor):
    """(min_x, max_x, min_y, max_y) from EVIOCGABS; DEVOS_TP_RANGE stands in for nodes that are not evdev devices."""
    override = os.environ.get('DEVOS_TP_RANGE')
    if override:
        values = [int(part) for part in override.split(',')]
        return tuple(values)
    out = []
    for axis in (ABS_X, ABS_Y):
        request = 0x80184540 | axis  # _IOR('E', 0x40 + axis, struct input_absinfo)
        value, minimum, maximum = struct.unpack('iii', fcntl.ioctl(descriptor, request, b'\0' * 24)[:12])
        out += [minimum, maximum]
    return out[0], out[1], out[2], out[3]


# ---- gesture recognition -----------------------------------------------------------------------------------------
class Engine:
    """Turns touchpad events into actions. `emit(action, steps)` gets 'volume'/'brightness'/'seek' with a signed step
    count, or 'launch' with 1. `gate()` says whether gestures are active (enabled and not locked)."""

    def __init__(self, extent, emit, gate=lambda: True, clock=time.monotonic):
        self.min_x, self.max_x, self.min_y, self.max_y = extent
        self.width = max(1, self.max_x - self.min_x)
        self.height = max(1, self.max_y - self.min_y)
        self.emit, self.gate, self.clock = emit, gate, clock
        self.slot = 0
        self.contacts = {}        # slot -> [x, y]
        self.gesture = None       # dict while one finger is being tracked
        self.dead = False         # cancelled until every finger has lifted
        self.last_launch = -COOLDOWN

    def fraction(self, x, y):
        return (x - self.min_x) / self.width, (y - self.min_y) / self.height

    def zone(self, fx, fy):
        if fx >= 1 - CORNER and fy <= CORNER:
            return 'corner'
        if fy <= EDGE:
            return 'top'
        if fx <= EDGE:
            return 'left'
        if fx >= 1 - EDGE:
            return 'right'
        return None

    def feed(self, kind, code, value):
        if kind == EV_ABS:
            if code == ABS_MT_SLOT:
                self.slot = value
            elif code == ABS_MT_TRACKING_ID:
                if value < 0:
                    self.contacts.pop(self.slot, None)
                else:
                    self.contacts[self.slot] = [None, None]
            elif code in (ABS_MT_POSITION_X, ABS_MT_POSITION_Y):
                point = self.contacts.setdefault(self.slot, [None, None])
                point[0 if code == ABS_MT_POSITION_X else 1] = value
        elif kind == EV_SYN and code == SYN_REPORT:
            self.report()

    def report(self):
        fingers = [p for p in self.contacts.values() if p[0] is not None and p[1] is not None]
        if not self.contacts:
            self.gesture, self.dead = None, False
            return
        if len(self.contacts) > 1:
            self.gesture, self.dead = None, True
            return
        if self.dead or not fingers:
            return
        x, y = fingers[0]
        fx, fy = self.fraction(x, y)
        if self.gesture is None:
            zone = self.zone(fx, fy)
            if zone is None or not self.gate():
                self.dead = True
                return
            self.gesture = {'zone': zone, 'x': fx, 'y': fy, 'steps': 0, 'active': False}
            return
        if not self.gate():
            self.gesture, self.dead = None, True
            return
        self.track(fx, fy)

    def track(self, fx, fy):
        g = self.gesture
        dx, dy = fx - g['x'], fy - g['y']
        if g['zone'] == 'corner':
            if dx <= -CORNER_PULL and dy >= CORNER_PULL:
                self.gesture, self.dead = None, True
                now = self.clock()
                if now - self.last_launch >= COOLDOWN:
                    self.last_launch = now
                    self.emit('launch', 1)
            return
        along, across = (dy, dx) if g['zone'] in ('left', 'right') else (dx, dy)
        if not g['active']:
            if abs(along) < DEAD and abs(across) < DEAD:
                return
            if abs(along) < SIDEWAYS * abs(across) or abs(along) < DEAD:
                self.gesture, self.dead = None, True   # moved off sideways: ordinary pointer use
                return
            g['active'], g['origin'] = True, along
        steps = int((along - g['origin']) / STEP)
        change = steps - g['steps']
        if change:
            g['steps'] = steps
            # Up the left/right edges and to the right along the top mean "more".
            self.emit({'left': 'volume', 'right': 'brightness', 'top': 'seek'}[g['zone']], change if g['zone'] == 'top' else -change)


# ---- actions -----------------------------------------------------------------------------------------------------
def seek(steps):
    busctl = tool('DEVOS_TP_BUSCTL', 'busctl')
    code, listing = run(busctl + ['--user', '--no-legend', 'list', '--acquired'], 5)
    names = [line.split()[0] for line in listing.splitlines() if line.startswith('org.mpris.MediaPlayer2.')] if code == 0 else []
    chosen = None
    for name in names:
        code, answer = run(busctl + ['--user', 'get-property', name, '/org/mpris/MediaPlayer2', 'org.mpris.MediaPlayer2.Player', 'PlaybackStatus'], 5)
        if code == 0 and 'Playing' in answer:
            chosen = name
            break
        chosen = chosen or name
    if chosen:
        run(busctl + ['--user', 'call', chosen, '/org/mpris/MediaPlayer2', 'org.mpris.MediaPlayer2.Player', 'Seek', 'x', str(steps * SEEK_SECONDS * 1000000)], 5)


class Actions:
    def __init__(self):
        self.running = []

    def spawn(self, command):
        self.running = [p for p in self.running if p.poll() is None]
        if len(self.running) >= 4:
            return
        try:
            self.running.append(subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
        except OSError:
            pass

    def __call__(self, action, steps):
        if action == 'volume':
            for _ in range(abs(steps)):
                self.spawn(tool('DEVOS_TP_WPCTL', 'wpctl') + (['set-volume', '--limit', '1.0', '@DEFAULT_AUDIO_SINK@', '5%+'] if steps > 0 else ['set-volume', '@DEFAULT_AUDIO_SINK@', '5%-']))
        elif action == 'brightness':
            for _ in range(abs(steps)):
                self.spawn(tool('DEVOS_TP_BACKLIGHT', 'dev-os-backlight') + ['--', 'up' if steps > 0 else 'down'])
        elif action == 'seek':
            seek(steps)
        elif action == 'launch':
            target = load()['launch']
            if target in LAUNCH_TARGETS and target != 'none':
                self.spawn(tool('DEVOS_TP_SHELL', 'dev-os-shell') + [target])


# ---- commands ----------------------------------------------------------------------------------------------------
def readable(path):
    return os.access(path, os.R_OK)


def snapshot():
    state = load()
    pads = touchpads()
    backlight = os.path.join(os.environ.get('DEVOS_TP_SYS', '/sys'), 'class/backlight')
    backends = {
        'volume': which('wpctl'),
        'brightness': which('dev-os-backlight') and os.path.isdir(backlight) and bool(os.listdir(backlight)),
        'seek': which('busctl'),
        'launch': which('dev-os-shell'),
    }
    reason = ''
    if not pads:
        reason = 'No touchpad was detected on this device.'
    elif not any(readable(p['path']) for p in pads):
        reason = 'The touchpad cannot be read by this user, so edge gestures cannot work. The lock is not affected.'
    return {
        'ok': True, 'supported': bool(pads), 'reason': reason, 'devices': [p['name'] for p in pads],
        'locked': state['locked'], 'enabled': state['enabled'], 'launch': state['launch'],
        'gesturesAvailable': bool(pads) and any(readable(p['path']) for p in pads),
        'backends': backends, 'targets': [{'id': key, 'title': title} for key, title in LAUNCH_TARGETS.items()],
    }


def apply_lock(state):
    """Regenerate the compositor config through dev-os-touchpad so `sendEventsMode` follows the saved lock."""
    command = tool('DEVOS_TP_TOUCHPAD_HELPER', 'd ' + shlex.quote(os.path.join(HERE, 'dev-os-touchpad')))
    code, out = run(command, 30, json.dumps({'action': 'get'}) + '\n')
    try:
        settings = json.loads(out.splitlines()[-1])['settings']
    except (ValueError, KeyError, IndexError, TypeError):
        raise Failure('The touchpad settings could not be read.')
    code, out = run(command, 30, json.dumps({'action': 'save', 'settings': settings}) + '\n')
    try:
        answer = json.loads(out.splitlines()[-1])
    except (ValueError, IndexError):
        answer = {}
    if code != 0 or answer.get('ok') is not True:
        raise Failure(answer.get('error') or 'The compositor could not apply the touchpad lock.')


def notify(text):
    if os.environ.get('DEVOS_TP_NOTIFY') or which('notify-send'):
        run(tool('DEVOS_TP_NOTIFY', 'notify-send') + ['-t', '1500', 'Touchpad', text], 5)


def ensure_service(enabled):
    systemctl = tool('DEVOS_TP_SYSTEMCTL', 'systemctl')
    if not enabled:
        return
    code, _ = run(systemctl + ['--user', 'start', '--no-block', UNIT], 10)
    if code != 0:   # live session without the packaged unit
        run(tool('DEVOS_TP_SYSTEMRUN', 'systemd-run') + ['--user', '--unit', TRANSIENT, '--collect', sys.executable, os.path.abspath(__file__), 'serve'], 10)


def command_lock(argument):
    if argument not in ('on', 'off', 'toggle'):
        raise Failure('Usage: lock on|off|toggle')
    state = load()
    wanted = (not state['locked']) if argument == 'toggle' else argument == 'on'
    if wanted and not touchpads():
        raise Failure('No touchpad was detected, so there is nothing to lock.')
    previous = dict(state)
    state['locked'] = wanted
    save(state)
    try:
        apply_lock(state)
    except Failure:
        save(previous)
        raise
    if argument == 'toggle' or os.environ.get('DEVOS_TP_NOTIFY'):
        notify('Touchpad locked' if wanted else 'Touchpad unlocked')


def command_set(key, value):
    state = load()
    state[key] = value
    save(state)
    if key == 'enabled':
        ensure_service(value)


def reply(payload):
    print(json.dumps(payload))


def main(argv):
    if not argv:
        raise Failure('Usage: dev-os-touchpad-gestures get | lock | gestures | launch | apply | serve')
    action, rest = argv[0], argv[1:]
    if action == 'get':
        pass
    elif action == 'lock':
        command_lock(rest[0] if rest else '')
    elif action == 'gestures':
        if rest[:1] not in (['on'], ['off']):
            raise Failure('Usage: gestures on|off')
        if rest[0] == 'on' and not touchpads():
            raise Failure('No touchpad was detected, so gestures cannot be turned on.')
        command_set('enabled', rest[0] == 'on')
    elif action == 'launch':
        if len(rest) != 1 or rest[0] not in LAUNCH_TARGETS:
            raise Failure('Unsupported launch target.')
        command_set('launch', rest[0])
    elif action == 'apply':
        if load()['enabled']:
            ensure_service(True)
    elif action == 'serve':
        serve()
        return
    else:
        raise Failure('Unsupported touchpad gesture action.')
    reply(snapshot())


# ---- daemon --------------------------------------------------------------------------------------------------------
def serve():
    actions = Actions()
    descriptors = {}   # fd -> [path, Engine, buffer]
    config = {'stamp': None, 'state': dict(DEFAULTS)}

    def refresh():
        try:
            stamp = os.stat(state_path()).st_mtime_ns
        except OSError:
            stamp = None
        if stamp != config['stamp']:
            config['stamp'], config['state'] = stamp, load()
        return config['state']

    def gate():
        state = refresh()
        return state['enabled'] and not state['locked']

    def close_all():
        for fd in list(descriptors):
            os.close(fd)
            del descriptors[fd]

    oneshot = bool(os.environ.get('DEVOS_TP_ONESHOT'))   # tests: return once the input ends
    last_scan = -10.0
    while True:
        state = refresh()
        if not (state['enabled'] and not state['locked']):
            close_all()
            if oneshot:
                return
            time.sleep(1.0)
            continue
        if not descriptors and time.monotonic() - last_scan >= 5.0:
            last_scan = time.monotonic()
            for pad in touchpads():
                try:
                    fd = os.open(pad['path'], os.O_RDONLY | os.O_NONBLOCK)
                    descriptors[fd] = [pad['path'], Engine(abs_range(fd), actions, gate), b'']
                except (OSError, ValueError):
                    continue
        if not descriptors:
            if oneshot:
                return
            time.sleep(1.0)
            continue
        ready, _, _ = select.select(list(descriptors), [], [], 1.0)
        for fd in ready:
            try:
                data = os.read(fd, EVENT.size * 64)
            except BlockingIOError:
                continue
            except OSError:
                data = b''
            if not data:
                os.close(fd)
                del descriptors[fd]
                if oneshot:
                    return
                continue
            pending = descriptors[fd][2] + data
            usable = len(pending) - len(pending) % EVENT.size
            for offset in range(0, usable, EVENT.size):
                _, _, kind, code, value = EVENT.unpack_from(pending, offset)
                descriptors[fd][1].feed(kind, code, value)
            descriptors[fd][2] = pending[usable:]


if __name__ == '__main__':
    try:
        main(sys.argv[1:])
    except Failure as reason:
        print(json.dumps({'ok': False, 'error': str(reason)}))
        sys.exit(1)
