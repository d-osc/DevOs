#!/bin/sh
# Settings front end for Swap (compressed RAM swap / swap file / off).
# Usage: dev-os-swap get | set key=value ...                                           (JSON on stdout, exit 1 on failure)
# `get` runs as the user; changes go through pkexec to /usr/libexec/devos-swap (polkit action org.devos.swap).
export PATH=/usr/bin:/usr/sbin:/bin:/sbin
here=$(dirname "$0")
core=${DEVOS_SWAP_CORE:-/usr/libexec/devos-swap}
[ -x "$core" ] || core="$here/../native/devos-swap"
[ -f "$core" ] || { echo '{"ok":false,"error":"Swap settings are not installed."}'; exit 1; }
privileged() {
    if [ "$(id -u)" = 0 ] || [ -n "$DEVOS_SWAP_ALLOW_USER" ]; then sh "$core" "$@"; else pkexec "$core" "$@"; fi
}
case "$1" in
    get) sh "$core" get || exit 1 ;;
    set)
        if ! out=$(privileged "$@"); then
            [ -n "$out" ] && echo "$out" || echo '{"ok":false,"error":"The swap was not changed. Administrator access was denied or failed."}'
            exit 1
        fi
        echo "$out" ;;
    *) echo '{"ok":false,"error":"Unsupported swap action."}'; exit 1 ;;
esac
