#!/bin/sh
set -eu
base=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
database=
for candidate in "$base/pm-cli/catalog-data" "$base/app-db" /usr/share/devos-pm/cli/catalog-data; do
    if [ -f "$candidate/service.sh" ]; then database=$candidate; break; fi
done
[ -n "$database" ] || { echo 'The app-db service is not installed.' >&2; exit 1; }
action=${1:-health}
if [ "$#" -gt 0 ]; then shift; fi
runner=${DEVLANG_RUN:-$(command -v devrun || command -v d)}
source=${DEVOS_APPSTORE_DATABASE:-$database}
case "$action" in
    run|start|stop) exec sh "$database/service.sh" "$action" "$source" "$runner";;
    health|catalog) exec "$runner" "$database/database-cli.dev" -- --source "$source" --action "$action" --arch "$(uname -m)";;
    search|get)
        [ "$#" -eq 1 ] || { echo "Usage: dev-os-app-db $action QUERY" >&2; exit 2; }
        exec "$runner" "$database/database-cli.dev" -- --source "$source" --action "$action" --query "$1" --arch "$(uname -m)";;
    *) echo 'Usage: dev-os-app-db run|start|stop|health|catalog|search QUERY|get ID' >&2; exit 2;;
esac
