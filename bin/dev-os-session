#!/bin/sh
set -eu
base=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -f "$base/src/system/command.dev" ]; then root=$base; else root="$base/share/dev-os"; fi
mode=native
check=no
for argument in "$@"; do
    case "$argument" in
        --check) check=yes ;;
        --nested|--headless)
            if [ "$mode" != native ]; then printf '%s\n' 'Choose either --nested or --headless.' >&2; exit 1; fi
            mode=${argument#--} ;;
        --help|-h) printf '%s\n' 'Usage: dev-os-session [--nested | --headless] [--check]'; exit 0 ;;
        *) printf 'Unknown argument: %s\n' "$argument" >&2; exit 1 ;;
    esac
done
# Each doctor run is a full GJS start; prebuilt images set DEV_OS_SKIP_DOCTOR=1 (--check still runs it).
if [ "${DEV_OS_SKIP_DOCTOR:-0}" != 1 ] || [ "$check" = yes ]; then
    if ! "$base/bin/dev-os-shell" doctor; then exit 1; fi
fi
if [ "$check" = yes ]; then exit 0; fi
if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -d "$XDG_RUNTIME_DIR" ]; then
    printf '%s\n' 'XDG_RUNTIME_DIR is missing. Start from a logged-in Linux session.' >&2
    exit 1
fi
export DEV_OS_ROOT="$root"
export DEV_OS_SHELL="$base/bin/dev-os-shell"
export PATH="$base/bin:$PATH"
export XDG_DATA_DIRS="$root/data:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export XDG_CURRENT_DESKTOP=DevOS:labwc XDG_SESSION_DESKTOP=dev-os XDG_SESSION_TYPE=wayland
export GDK_BACKEND=wayland QT_QPA_PLATFORM=wayland
export GIO_USE_PROXY_RESOLVER=${GIO_USE_PROXY_RESOLVER:-gnome}
export DEV_OS_TASK_VIEW=1
export DEV_OS_WINDOW_ANIMATIONS=${DEV_OS_WINDOW_ANIMATIONS:-1}
if [ "$mode" != headless ]; then export DEV_OS_LOGIN=${DEV_OS_LOGIN:-1}; fi
if [ "$mode" = nested ]; then
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then export WLR_BACKENDS=wayland
    elif [ -n "${DISPLAY:-}" ]; then export WLR_BACKENDS=x11
    else printf '%s\n' '--nested needs an existing Wayland or X11 display.' >&2; exit 1; fi
fi
# Explicit selection wins over inherited settings; auto delegates native rendering to wlroots.
renderer=${DEV_OS_RENDERER:-${WLR_RENDERER:-auto}}
case "$renderer" in
    auto)
        unset WLR_RENDERER
        # WSL can expose DRM nodes while Mesa still uses llvmpipe. Avoid software GL.
        if [ -n "${WSL_DISTRO_NAME:-}${WSL_INTEROP:-}" ]; then
            if command -v timeout >/dev/null 2>&1 && command -v glxinfo >/dev/null 2>&1 &&
                timeout 5 glxinfo -B 2>/dev/null | grep -q 'Accelerated: yes'; then
                export WLR_RENDERER=gles2
            else
                export WLR_RENDERER=pixman
            fi
        fi ;;
    gles2|vulkan)
        unset LIBGL_ALWAYS_SOFTWARE WEBKIT_DISABLE_COMPOSITING_MODE WEBKIT_DISABLE_DMABUF_RENDERER WEBKIT_SKIA_ENABLE_CPU_RENDERING
        export WLR_RENDERER="$renderer" ;;
    pixman) export WLR_RENDERER=pixman ;;
    *) printf 'Unsupported renderer: %s\n' "$renderer" >&2; exit 1 ;;
esac
if [ "${WLR_RENDERER:-}" = pixman ]; then export LIBGL_ALWAYS_SOFTWARE=1; fi
if [ "$mode" = headless ]; then
    export WLR_BACKENDS=headless WLR_RENDERER=pixman WLR_HEADLESS_OUTPUTS="${WLR_HEADLESS_OUTPUTS:-1}"
    unset WAYLAND_DISPLAY DISPLAY
fi
printf 'Dev OS: renderer=%s\n' "${WLR_RENDERER:-auto}"
if [ "$mode" != native ]; then export LABWC_UPDATE_ACTIVATION_ENV=0; fi
# Quote the startup command for labwc, including paths containing single quotes.
startup=$(printf '%s' "$base/bin/dev-os-start" | sed "s/'/'\\\\''/g")
startup="'$startup'"
DEV_OS_COMPOSITOR_CONFIG=$(d "$base/bin/dev-os-language" -- prepare --base "$root/config/labwc")
export DEV_OS_COMPOSITOR_CONFIG
printf 'Dev OS: starting compositor (%s)...\n' "$mode"
if [ "$mode" != native ] || [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    exec dbus-run-session -- labwc -C "$DEV_OS_COMPOSITOR_CONFIG" -s "$startup"
fi
exec labwc -C "$DEV_OS_COMPOSITOR_CONFIG" -s "$startup"
