#!/bin/sh
set -eu
base=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -f "$base/src/main.ts" ] || [ -f "$base/dist/main.js" ]; then root=$base; else root="$base/share/dev-os"; fi
mode=native
check=no
for argument in "$@"; do
    case "$argument" in
        --check) check=yes ;;
        --nested|--headless)
            if [ "$mode" != native ]; then printf '%s\n' 'Choose either --nested or --headless.' >&2; exit 1; fi
            mode=${argument#--} ;;
        --help|-h) printf '%s\n' 'Usage: dev-os-session [--nested | --headless] [--check]'; exit 0 ;;
        *) printf 'Unknown argument: %s\n' "$argument" >&2; exit 1 ;;
    esac
done
if ! "$base/bin/dev-os-shell" doctor; then exit 1; fi
if [ "$check" = yes ]; then exit 0; fi
if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -d "$XDG_RUNTIME_DIR" ]; then
    printf '%s\n' 'XDG_RUNTIME_DIR is missing. Start from a logged-in Linux session.' >&2
    exit 1
fi
export DEV_OS_ROOT="$root"
export DEV_OS_SHELL="$base/bin/dev-os-shell"
export PATH="$base/bin:$PATH"
export XDG_DATA_DIRS="$root/data:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export XDG_CURRENT_DESKTOP=DevOS:labwc XDG_SESSION_DESKTOP=dev-os XDG_SESSION_TYPE=wayland
export GDK_BACKEND=wayland QT_QPA_PLATFORM=wayland
if [ "$mode" = nested ]; then
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then export WLR_BACKENDS=wayland
    elif [ -n "${DISPLAY:-}" ]; then export WLR_BACKENDS=x11
    else printf '%s\n' '--nested needs an existing Wayland or X11 display.' >&2; exit 1; fi
fi
if [ "$mode" = headless ]; then
    export WLR_BACKENDS=headless WLR_RENDERER=pixman WLR_HEADLESS_OUTPUTS="${WLR_HEADLESS_OUTPUTS:-1}"
    unset WAYLAND_DISPLAY DISPLAY
fi
if [ "$mode" != native ]; then export LABWC_UPDATE_ACTIVATION_ENV=0; fi
# Quote the startup command for labwc, including paths containing single quotes.
startup=$(printf '%s' "$base/bin/dev-os-start" | sed "s/'/'\\\\''/g")
startup="'$startup'"
printf 'Dev OS: starting compositor (%s)...\n' "$mode"
if [ "$mode" != native ] || [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    exec dbus-run-session -- labwc -C "$root/config/labwc" -s "$startup"
fi
exec labwc -C "$root/config/labwc" -s "$startup"

