#!/usr/bin/env python3
"""Speaker sound modes and voice-only filtering for Dev OS Settings (the MyASUS "AI Noise-Canceling Speaker" and "Sound Modes" cards).

Usage: dev-os-speaker get | voice on|off | boost on|off | mode <id> | smart on|off | device <node.name> | custom <slot> <bass> <mid> <treble> | apply | serve
JSON on stdout, exit 1 on failure. Runs as the user; no root and no polkit action.

Backend (PipeWire filter-chain with the built-in biquad filters, nothing else is invented):
  Sound modes  Dynamic (no processing), Game, Movie, Music, Voice and Custom 1-3 are equalizer curves (low shelf, peaking and high
               shelf biquads with headroom so they do not clip). This is NOT Dolby Atmos and has no spatial or object audio.
  Voice only   "AI Noise-Canceling Speaker" is a voice-band filter (high-pass 300 Hz, low-pass 3.4 kHz, 24 dB/octave). It removes sounds
               outside the human voice range; it is not a trained model and cannot remove noise inside the voice range.
  Volume Booster  +9.5 dB of gain into a soft saturator (g / (1 + |g|)) with make-up gain so full scale stays full scale: quiet and
               mid-level sounds get much louder, peaks are rounded instead of hard-clipped. It is not a look-ahead limiter or compressor.
  Smart switch with Voice Mode Smart Switch on, the Voice curve is used while an application is recording audio (a call).
The effect runs as a virtual sink "devos-spk-fx" feeding the chosen real output; `serve` (devos-speaker.service) supervises one
`pipewire -c` filter process and rebuilds it within a few seconds when the state file changes or a recording starts or stops.
The helper shares its PipeWire plumbing with dev-os-microphone (same directory) and its DEVOS_MIC_* test hooks.
"""
import importlib.machinery
import importlib.util
import json
import os
import shutil
import signal
import subprocess
import sys
import time

MODES = ('dynamic', 'game', 'movie', 'music', 'voice', 'custom1', 'custom2', 'custom3')
FX = 'devos-spk-fx'
UNIT = 'devos-speaker.service'
TRANSIENT = 'devos-speaker-session.service'
# (biquad label, frequency Hz, Q, gain dB)
SHELF = lambda bass, mid, treble: [('bq_lowshelf', 100, 0.7, bass), ('bq_peaking', 1000, 1.0, mid), ('bq_highshelf', 8000, 0.7, treble)]
PRESETS = {
    'game': [('bq_lowshelf', 120, 0.7, 2), ('bq_peaking', 3000, 1.0, 3), ('bq_highshelf', 8000, 0.7, 3)],
    'movie': SHELF(5, -1, 3),
    'music': SHELF(3, -1, 2),
    'voice': [('bq_lowshelf', 150, 0.7, -4), ('bq_peaking', 2000, 1.0, 4), ('bq_highshelf', 8000, 0.7, 0)],
}
BOOST_GAIN = 3.0
VOICE_BAND = [('bq_highpass', 300, 0.707, 0)] * 2 + [('bq_lowpass', 3400, 0.707, 0)] * 2


def load_shared():
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), 'dev-os-microphone')
    loader = importlib.machinery.SourceFileLoader('devos_microphone', path)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader('devos_microphone', loader))
    loader.exec_module(module)
    return module


mic = load_shared()
Failure, run, tool, clean, snapshot, wait_for, wait_seconds = mic.Failure, mic.run, mic.tool, mic.clean, mic.snapshot, mic.wait_for, mic.wait_seconds
STATE = lambda: os.path.join(mic.config_dir(), 'speaker.json')
CONF = lambda: os.path.join(mic.config_dir(), 'speaker-filter.conf')


# ---- state ----------------------------------------------------------------------------------------------------------
def gain(value):
    try:
        return max(-10.0, min(10.0, float(value)))
    except (TypeError, ValueError):
        return 0.0


def load_state():
    try:
        with open(STATE(), encoding='utf-8') as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        data = {}
    data = data if isinstance(data, dict) else {}
    custom = data.get('custom') if isinstance(data.get('custom'), dict) else {}
    slots = {}
    for slot in ('custom1', 'custom2', 'custom3'):
        values = custom.get(slot)
        slots[slot] = [gain(value) for value in values[:3]] if isinstance(values, list) and len(values) == 3 else [0.0, 0.0, 0.0]
    return {'mode': data.get('mode') if data.get('mode') in MODES else 'dynamic', 'voice': data.get('voice') is True, 'boost': data.get('boost') is True,
            'smart': data.get('smart') is not False, 'device': data.get('device') if isinstance(data.get('device'), str) else '', 'custom': slots}


def save_state(state):
    os.makedirs(mic.config_dir(), exist_ok=True)
    with open(STATE() + '.new', 'w', encoding='utf-8') as handle:
        json.dump(state, handle)
    os.replace(STATE() + '.new', STATE())


def effective_mode(state, recorders):
    return 'voice' if state['smart'] and recorders > 0 else state['mode']


def wants_filter(state, mode):
    return state['boost'] or bool(bands(state, mode))


def bands(state, mode):
    chain = list(VOICE_BAND) if state['voice'] else []
    if mode in PRESETS:
        chain += PRESETS[mode]
    elif mode.startswith('custom'):
        bass, middle, treble = state['custom'][mode]
        if any(value for value in (bass, middle, treble)):
            chain += SHELF(bass, middle, treble)
    return chain


def filters_available():
    def found(*parts):
        return any(os.path.isfile(os.path.join(base, *parts)) for base in mic.libdirs())
    missing = []
    if not found('pipewire-0.3', 'libpipewire-module-filter-chain.so'):
        missing.append('the PipeWire filter-chain module (pipewire-modules-filter-chain)')
    if not found('spa-0.2', 'filter-graph', 'libspa-filter-graph-plugin-builtin.so') or not found('spa-0.2', 'filter-graph', 'libspa-filter-graph.so'):
        missing.append('the built-in filter graph plugin (pipewire-spa-plugins-filter-graph, pipewire-spa-plugins-filter-graph-plugin-builtin)')
    if shutil.which(tool('DEVOS_MIC_PIPEWIRE', 'pipewire')[0]) is None:
        missing.append('the pipewire program')
    if missing:
        return False, 'Sound effects need ' + ' and '.join(missing) + ', which ' + ('is' if len(missing) == 1 else 'are') + ' not installed in this system.'
    return True, ''


def pick_device(state, graph):
    names = [speaker['name'] for speaker in graph['speakers']]
    for candidate in (state['device'], graph['default_sink']):
        if candidate in names:
            return candidate
    return names[0] if names else ''


# ---- filter graph -----------------------------------------------------------------------------------------------------
def render(chain, device, boost=False):
    """PipeWire client config: a virtual sink devos-spk-fx whose biquad chain feeds the real output `device`."""
    q = json.dumps
    peak = max([0.0] + [float(band[3]) for band in chain])
    stages = ([('linear', 'linear', {'Mult': round(10 ** (-peak / 20), 4), 'Add': 0.0})] if peak > 0 else []) + \
             [('eq%d' % index, band[0], {'Freq': band[1], 'Q': band[2], 'Gain': float(band[3])}) for index, band in enumerate(chain)]
    if boost:
        # g = gain; y = g / (1 + |g|) * makeup, so the output never exceeds full scale and quiet sounds are much louder.
        stages += [('gain', 'linear', {'Mult': BOOST_GAIN, 'Add': 0.0}), ('abs', 'abs', {}), ('one', 'linear', {'Mult': 1.0, 'Add': 1.0}), ('recip', 'recip', {}),
                   ('mix', 'mult', {}), ('makeup', 'linear', {'Mult': round((1 + BOOST_GAIN) / BOOST_GAIN, 4), 'Add': 0.0})]
    nodes, links = [], []
    first, last = [], []
    for channel in 'LR':
        names = {name: channel + name for name, _, _ in stages}
        for name, label, controls in stages:
            nodes.append('        { type = builtin name = %s label = %s control = { %s } }' % (names[name], label, ' '.join('%s = %s' % (q(key), value) for key, value in controls.items())))
        order = [name for name, _, _ in stages]
        edges = [(a, 'Out', b, 'In') for a, b in zip(order, order[1:]) if not (boost and b in ('abs', 'one', 'recip', 'mix', 'makeup'))]
        if boost:
            edges += [('gain', 'Out', 'abs', 'In'), ('abs', 'Out', 'one', 'In'), ('one', 'Out', 'recip', 'In'), ('gain', 'Out', 'mix', 'In 1'), ('recip', 'Out', 'mix', 'In 2'), ('mix', 'Out', 'makeup', 'In')]
        links += ['        { output = "%s:%s" input = "%s:%s" }' % (names[a], pa, names[b], pb) for a, pa, b, pb in edges]
        first.append('%s:In' % names[order[0]])
        last.append('%s:Out' % names[order[-1]])
    return '''# Generated by dev-os-speaker; changes are overwritten.
context.properties = {
    log.level = 0
}
context.spa-libs = {
    audio.convert.* = audioconvert/libspa-audioconvert
    support.*       = support/libspa-support
}
context.modules = [
    { name = libpipewire-module-rt flags = [ ifexists nofail ] }
    { name = libpipewire-module-protocol-native }
    { name = libpipewire-module-client-node }
    { name = libpipewire-module-adapter }
    { name = libpipewire-module-filter-chain
        args = {
            node.description = "Sound effects"
            media.name = "Sound effects"
            filter.graph = {
                nodes = [
%s
                ]
                links = [
%s
                ]
                inputs = [ %s ]
                outputs = [ %s ]
            }
            audio.channels = 2
            audio.position = [ FL FR ]
            capture.props = {
                node.name = %s
                node.description = "Sound effects"
                media.class = Audio/Sink
            }
            playback.props = {
                node.name = "devos-spk-out"
                node.passive = true
                target.object = %s
                node.dont-fallback = true
            }
        }
    }
]
''' % ('\n'.join(nodes), '\n'.join(links), ' '.join(q(port) for port in first), ' '.join(q(port) for port in last), q(FX), q(device))


# ---- reporting -----------------------------------------------------------------------------------------------------
def report():
    state, graph = load_state(), snapshot()
    available, reason = filters_available()
    out = {'ok': True, 'supported': graph is not None, 'reason': '', 'speakers': [], 'device': '', 'voice': state['voice'], 'boost': state['boost'], 'mode': state['mode'],
           'smart': state['smart'], 'custom': state['custom'], 'effective': state['mode'], 'running': False, 'active': False,
           'filters': {'available': available, 'reason': reason}, 'warning': ''}
    if graph is None:
        out['reason'] = 'The audio server (PipeWire) is not running or pw-dump is not installed.'
        return out
    out['speakers'] = [{'name': speaker['name'], 'title': speaker['title']} for speaker in graph['speakers']]
    out['device'] = pick_device(state, graph)
    out['effective'] = effective_mode(state, graph['recorders'])
    out['running'] = graph['fx'] is not None
    out['active'] = graph['fx'] is not None and graph['default_sink'] == FX
    wanted = wants_filter(state, out['effective'])
    if not graph['speakers']:
        out['warning'] = 'No audio output is available.'
    elif wanted and not available:
        out['warning'] = reason + ' The sound is played without effects.'
    elif wanted and not out['active']:
        out['warning'] = 'The sound effects are not active yet. They start with your session; sound is played without effects until then.'
    return out


# ---- switching ----------------------------------------------------------------------------------------------------
def ensure_service():
    code, out = run(tool('DEVOS_MIC_SYSTEMCTL', 'systemctl') + ['--user', 'start', UNIT], 30)
    if code == 0:
        return
    if 'not found' not in out.lower() and 'not-found' not in out.lower():
        raise Failure('The sound effects service could not start: ' + clean(out or 'systemctl failed'))
    code, out = run(tool('DEVOS_MIC_SYSTEMD_RUN', 'systemd-run') + ['--user', '--collect', '--quiet', '--unit=' + TRANSIENT, '--setenv=DEVOS_MIC_WAIT=45',
                    sys.executable, os.path.abspath(sys.argv[0]), 'serve'], 30)
    if code != 0 and 'already' not in out.lower():
        raise Failure('The sound effects service could not start: ' + clean(out or 'systemd-run failed'))


def settled(state, graph):
    """True when the graph already matches the state (nothing to wait for)."""
    wanted = wants_filter(state, effective_mode(state, graph['recorders']))
    if wanted:
        return graph['fx'] is not None and graph['default_sink'] == FX
    return graph['fx'] is None and graph['default_sink'] != FX


def settle():
    state = load_state()
    available, _ = filters_available()
    graph = snapshot()
    if graph is None:
        raise Failure('The audio server (PipeWire) is not running.')
    if available or not wants_filter(state, effective_mode(state, graph['recorders'])):
        ensure_service()
        wait_for(lambda g: settled(state, g))


# ---- service ------------------------------------------------------------------------------------------------------
def point_default_at(name, graph):
    for node in graph['speakers'] + ([graph['fx']] if graph['fx'] else []):
        if node['name'] == name:
            run(tool('DEVOS_MIC_WPCTL', 'wpctl') + ['set-default', str(node['id'])])
            return


def serve():
    stop = []
    signal.signal(signal.SIGTERM, lambda *_: stop.append(1))
    child, signature, seen, quiet, calls = None, None, 0, 0, False
    started, retry_at = 0.0, 0.0
    once = bool(os.environ.get('DEVOS_SPK_ONCE'))

    def halt():
        nonlocal child, signature
        if child is not None:
            graph = snapshot()
            if graph and graph['default_sink'] == FX:
                point_default_at(pick_device(load_state(), graph), graph)
            child.terminate()
            try:
                child.wait(5)
            except subprocess.TimeoutExpired:
                child.kill()
        child, signature = None, None

    while not stop:
        state = load_state()
        available, reason = filters_available()
        # With Smart Switch off, no filter wanted and no filter running there is nothing to watch: skip the pw-dump (a whole graph dump
        # parsed in Python every few seconds) and only look at the state file again.
        idle = child is None and not state['smart'] and not wants_filter(state, state['mode'])
        graph = snapshot() if available and not idle else None
        if graph is not None:
            # Debounce the call detection: two polls to switch on, three to switch off.
            seen, quiet = (seen + 1, 0) if graph['recorders'] > 0 else (0, quiet + 1)
            if seen >= 2:
                calls = True
            elif quiet >= 3:
                calls = False
            mode = 'voice' if state['smart'] and calls else state['mode']
            chain = bands(state, mode)
            filtered = bool(chain) or state['boost']
            device = pick_device(state, graph)
            wanted = (render(chain, device, state['boost']), device) if filtered and device else None
            if child is not None and child.poll() is not None and time.time() - started < 10:
                retry_at = time.time() + 30  # the filter fails at once (bad graph or plugin): do not respawn it every few seconds
                print('dev-os-speaker: the filter process exited at once; retrying in 30 s', file=sys.stderr)
            if wanted is None or (child is not None and child.poll() is not None) or (signature is not None and wanted != signature):
                halt()
            if wanted is not None and child is None and time.time() >= retry_at:
                os.makedirs(mic.config_dir(), exist_ok=True)
                with open(CONF(), 'w', encoding='utf-8') as handle:
                    handle.write(wanted[0])
                command = tool('DEVOS_MIC_PIPEWIRE', 'pipewire') + ['-c', CONF()]
                child, signature, started = subprocess.Popen(command), wanted, time.time()
                after = wait_for(lambda g: g['fx'] is not None)
                if after and after['fx']:
                    point_default_at(FX, after)
        if once:
            break
        # Without Smart Switch nothing needs polling; the state file is read again every tick.
        for _ in range(3 if state['smart'] else 2):
            if stop:
                break
            time.sleep(1)
    if not once:
        halt()


# ---- command line -------------------------------------------------------------------------------------------------
def main(argv):
    action, rest = (argv[1] if len(argv) > 1 else ''), argv[2:]
    try:
        state = load_state()
        if action == 'get':
            pass
        elif action == 'serve':
            serve()
            return 0
        elif action == 'apply':
            settle()
        elif action in ('voice', 'smart', 'boost') and rest in (['on'], ['off']):
            state[action] = rest[0] == 'on'
            save_state(state)
            settle()
        elif action == 'mode' and len(rest) == 1 and rest[0] in MODES:
            state['mode'] = rest[0]
            save_state(state)
            settle()
        elif action == 'device' and len(rest) == 1 and rest[0] and not rest[0].startswith('devos-'):
            graph = snapshot()
            if graph is None:
                raise Failure('The audio server (PipeWire) is not running.')
            if rest[0] not in [speaker['name'] for speaker in graph['speakers']]:
                raise Failure('That output is not connected.')
            state['device'] = rest[0]
            save_state(state)
            settle()
        elif action == 'custom' and len(rest) == 4 and rest[0] in ('custom1', 'custom2', 'custom3'):
            try:
                values = [float(value) for value in rest[1:]]
            except ValueError:
                raise Failure('Custom sound levels must be numbers.')
            state['custom'][rest[0]] = [gain(value) for value in values]
            save_state(state)
            settle()
        else:
            raise Failure('Unsupported sound action.')
    except Failure as reason:
        print(json.dumps({'ok': False, 'error': clean(reason)}))
        return 1
    print(json.dumps(report()))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
