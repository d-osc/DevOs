#!/usr/bin/env d
# System information, native settings launchers and power profiles for DevOs.
use "std/fs"
use "std/json"
use "std/child_process"
use "std/strings"
use "std/io"
use "std/os"
use "std/process"
use "std/args"

fn decodeText(bytes: Vec<u8>): str {
    let out = ""
    for i in 0..(bytes.len() as i64) {
        let ch = bytes[i]
        if ch >= 0x20 && ch < 0x7f { out = out + asciiChar(ch) }
        else { if ch == 0x0a { out = out + "\n" } }
    }
    return out
}

fn asciiChar(code: u8): str {
    let chars = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    return strings.charAt(chars, (code - 0x20) as i64)
}

fn capture(command: str): str {
    let output = child_process.execFileSync("sh", Vec<str>("-c", command + " 2>/dev/null"), child_process.options())
    return decodeText(output.stdout)
}

fn readTrimmed(path: str): str {
    if !fs.existsSync(path) { return "" }
    return strings.trim(fs.readFileSync(path, "utf8"))
}

fn fieldOf(text: str, key: str, separator: str): str {
    let lines = strings.split(text, "\n")
    for i in 0..(lines.len() as i64) {
        let at = strings.indexOf(lines[i], separator)
        if at > 0 {
            let name = strings.trim(strings.substring(lines[i], 0, at))
            if strings.equal(name, key) {
                return strings.trim(strings.replaceAll(strings.substring(lines[i], at + 1, strings.charLength(lines[i])), "\"", ""))
            }
        }
    }
    return ""
}

fn isWsl(): bool {
    if !fs.existsSync("/proc/sys/kernel/osrelease") { return false }
    return strings.contains(strings.toLowerCase(fs.readFileSync("/proc/sys/kernel/osrelease", "utf8")), "microsoft")
}

fn jsonText(value: json.Value): str {
    if strings.equal(json.kind(value), "string") { return json.string(value) }
    return ""
}

fn optGet(value: json.Value, key: str): json.Value {
    if json.has(value, key) { return json.get(value, key) }
    return json.null_value()
}

fn powerProperties(name: str, path: str): json.Value {
    let output = capture("busctl --timeout=3 --json=short call " + name + " " + path + " org.freedesktop.DBus.Properties GetAll s " + name)
    if !json.valid(output) { return json.object() }
    let value = json.parse(output)
    if !json.has(value, "data") { return json.object() }
    let data = json.get(value, "data")
    if strings.equal(json.kind(data), "array") && json.len(data) > 0 { return json.at(data, 0) }
    return json.object()
}

fn powerValue(props: json.Value, key: str): json.Value {
    if !json.has(props, key) { return json.null_value() }
    let value = json.get(props, key)
    if strings.equal(json.kind(value), "object") && json.has(value, "data") { return json.get(value, "data") }
    return value
}

fn advertisedProfiles(props: json.Value): json.Value {
    let profiles = json.array()
    let values = powerValue(props, "Profiles")
    if !strings.equal(json.kind(values), "array") { return profiles }
    for i in 0..(json.len(values) as i64) {
        let item = json.at(values, i)
        let name = jsonText(powerValue(item, "Profile"))
        if strings.equal(name, "power-saver") || strings.equal(name, "balanced") || strings.equal(name, "performance") { profiles = json.push(profiles, name) }
    }
    return profiles
}

fn powerProfileState(): json.Value {
    let result = json.set(json.object(), "available", false)
    result = json.set(result, "active", "")
    result = json.set(result, "profiles", json.array())
    result = json.set(result, "degraded", "")
    result = json.set(result, "error", "")
    let props = powerProperties("org.freedesktop.UPower.PowerProfiles", "/org/freedesktop/UPower/PowerProfiles")
    if !json.has(props, "Profiles") { props = powerProperties("net.hadess.PowerProfiles", "/net/hadess/PowerProfiles") }
    let profiles = advertisedProfiles(props)
    if json.len(profiles) == 0 { return json.set(result, "error", "Power modes are not supported by the current hardware or service.") }
    result = json.set(result, "available", true)
    result = json.set(result, "profiles", profiles)
    result = json.set(result, "active", jsonText(powerValue(props, "ActiveProfile")))
    result = json.set(result, "degraded", jsonText(powerValue(props, "PerformanceDegraded")))
    return result
}

fn batteries(): json.Value {
    let result = json.array()
    if !fs.existsSync("/sys/class/power_supply") { return result }
    let names = fs.readdirSync("/sys/class/power_supply")
    for i in 0..(names.len() as i64) {
        let base = "/sys/class/power_supply/" + names[i]
        if !strings.equal(readTrimmed(base + "/type"), "Battery") { continue }
        let capacity = readTrimmed(base + "/capacity")
        let percent = json.null_value()
        if !strings.equal(capacity, "") && strings.charLength(capacity) > 0 && strings.contains("0123456789", strings.charAt(capacity, 0)) {
            let value = intOf(capacity)
            if value < 0 { value = 0 }
            if value > 100 { value = 100 }
            percent = json.value(value)
        } else {
            // qcom_battmgr reports no capacity until the firmware sends a percentage; use the energy/charge counters.
            let now = readTrimmed(base + "/energy_now")
            let total = readTrimmed(base + "/energy_full")
            if strings.equal(now, "") || strings.equal(total, "") { now = readTrimmed(base + "/charge_now"); total = readTrimmed(base + "/charge_full") }
            if !strings.equal(now, "") && intOf(total) > 0 && intOf(now) <= intOf(total) { percent = json.value(intOf(now) * 100 / intOf(total)) }
        }
        let model = readTrimmed(base + "/model_name")
        let status = readTrimmed(base + "/status")
        let item = json.set(json.object(), "name", strings.equal(model, "") ? names[i] : model)
        item = json.set(item, "status", strings.equal(status, "") ? "Unknown" : status)
        item = json.set(item, "percent", percent)
        let full = intOf(readTrimmed(base + "/energy_full"))
        let design = intOf(readTrimmed(base + "/energy_full_design"))
        if full == 0 || design == 0 { full = intOf(readTrimmed(base + "/charge_full")); design = intOf(readTrimmed(base + "/charge_full_design")) }
        let health = json.null_value()
        if full > 0 && design > 0 { let value = full * 100 / design; if value > 100 { value = 100 }; health = json.value(value) }
        item = json.set(item, "health", health)
        let cycles = readTrimmed(base + "/cycle_count")
        item = json.set(item, "cycles", strings.equal(cycles, "") ? json.null_value() : json.value(intOf(cycles)))
        let energy = intOf(readTrimmed(base + "/energy_now"))
        let rate = intOf(readTrimmed(base + "/power_now"))
        let minutes = json.null_value()
        if energy > 0 && rate > 0 && strings.equal(status, "Discharging") { minutes = json.value(energy * 60 / rate) }
        let energyFull = intOf(readTrimmed(base + "/energy_full"))
        if energyFull > energy && rate > 0 && strings.equal(status, "Charging") { minutes = json.value((energyFull - energy) * 60 / rate) }
        item = json.set(item, "minutes", minutes)
        result = json.push(result, item)
    }
    return result
}

fn intOf(text: str): i64 {
    let value = 0
    for i in 0..strings.charLength(text) {
        let ch = strings.charAt(text, i)
        if !strings.contains("0123456789", ch) { break }
        let digit = 0
        let digits = "0123456789"
        for d in 0..10 {
            if strings.equal(strings.charAt(digits, d), ch) { digit = d }
        }
        value = value * 10 + digit
    }
    return value
}

fn storageEntries(): json.Value {
    let result = json.array()
    let seen = ""
    for i in 0..2 {
        let path = "/"
        if i == 1 { path = os.homedir() }
        let device = strings.trim(capture("stat -c %d " + path))
        if strings.equal(device, "") || strings.contains(seen, " " + device + " ") { continue }
        seen = seen + " " + device + " "
        let dfLine = strings.trim(capture("df -k -P " + path + " | tail -1"))
        let parts = strings.split(dfLine, " ")
        let numbers = Vec<str>()
        for p in 0..(parts.len() as i64) {
            if !strings.equal(parts[p], "") { numbers.push(parts[p]) }
        }
        if numbers.len() < 4 { continue }
        let item = json.set(json.object(), "path", path)
        item = json.set(item, "total", json.value(intOf(numbers[1]) * 1024))
        item = json.set(item, "used", json.value(intOf(numbers[2]) * 1024))
        item = json.set(item, "free", json.value(intOf(numbers[3]) * 1024))
        result = json.push(result, item)
    }
    return result
}

fn toolAvailable(tool: str): bool {
    return !strings.equal(strings.trim(capture("command -v " + tool)), "")
}

fn hardwareText(path: str): str {
    if !fs.existsSync(path) { return "" }
    let output = child_process.execFileSync("cat", Vec<str>(path), child_process.options())
    let value = strings.trim(decodeText(output.stdout))
    let lower = strings.toLowerCase(value)
    for placeholder in Vec<str>("unknown", "none", "not specified", "default string", "to be filled by o.e.m.", "system serial number", "00000000-0000-0000-0000-000000000000") {
        if strings.equal(lower, placeholder) { return "" }
    }
    return value
}

fn hardwareInfo(cpuinfo: str): json.Value {
    let details = capture("LC_ALL=C lscpu")
    let model = hardwareText("/sys/class/dmi/id/product_name")
    if strings.equal(model, "") { model = hardwareText("/sys/firmware/devicetree/base/model") }
    let cpuName = fieldOf(details, "Model name", ":")
    if strings.equal(cpuName, "") { cpuName = fieldOf(cpuinfo, "model name", ":") }
    if strings.equal(cpuName, "") { cpuName = hardwareText("/sys/devices/soc0/machine") }
    let manufacturer = hardwareText("/sys/class/dmi/id/sys_vendor")
    if strings.equal(manufacturer, "") { manufacturer = hardwareText("/sys/class/dmi/id/board_vendor") }
    let data = json.set(json.object(), "manufacturer", manufacturer)
    data = json.set(data, "model", model)
    data = json.set(data, "family", hardwareText("/sys/class/dmi/id/product_family"))
    data = json.set(data, "serial", hardwareText("/sys/class/dmi/id/product_serial"))
    data = json.set(data, "productUuid", hardwareText("/sys/class/dmi/id/product_uuid"))
    data = json.set(data, "machineId", hardwareText("/etc/machine-id"))
    data = json.set(data, "boardVendor", hardwareText("/sys/class/dmi/id/board_vendor"))
    data = json.set(data, "boardModel", hardwareText("/sys/class/dmi/id/board_name"))
    data = json.set(data, "biosVendor", hardwareText("/sys/class/dmi/id/bios_vendor"))
    data = json.set(data, "biosVersion", hardwareText("/sys/class/dmi/id/bios_version"))
    data = json.set(data, "biosDate", hardwareText("/sys/class/dmi/id/bios_date"))
    data = json.set(data, "cpuName", cpuName)
    data = json.set(data, "cpuVendor", fieldOf(details, "Vendor ID", ":"))
    data = json.set(data, "cpuSockets", fieldOf(details, "Socket(s)", ":"))
    data = json.set(data, "coresPerSocket", fieldOf(details, "Core(s) per socket", ":"))
    data = json.set(data, "threadsPerCore", fieldOf(details, "Thread(s) per core", ":"))
    data = json.set(data, "cpuMaxMHz", fieldOf(details, "CPU max MHz", ":"))
    data = json.set(data, "socFamily", hardwareText("/sys/devices/soc0/family"))
    data = json.set(data, "socId", hardwareText("/sys/devices/soc0/soc_id"))
    data = json.set(data, "socRevision", hardwareText("/sys/devices/soc0/revision"))
    data = json.set(data, "bootMode", fs.existsSync("/sys/firmware/efi") ? "UEFI" : "Legacy / non-EFI")
    return data
}

fn inventory(): json.Value {
    let wsl = isWsl()
    let meminfo = fs.readFileSync("/proc/meminfo", "utf8")
    let cpuinfo = fs.readFileSync("/proc/cpuinfo", "utf8")
    let release = fs.readFileSync("/etc/os-release", "utf8")
    let root = process.getenv("DEV_OS_ROOT")
    if strings.equal(root, "") { root = "/usr/share/dev-os" }
    let build = json.object()
    if fs.existsSync(root + "/dist/build-info.json") {
        build = json.parse(fs.readFileSync(root + "/dist/build-info.json", "utf8"))
    }
    let memTotal = fieldOf(meminfo, "MemTotal", ":")
    let memValue = intOf(memTotal) * 1024
    let cpuModel = fieldOf(cpuinfo, "model name", ":")
    let hardware = hardwareInfo(cpuinfo)
    let reportedCpu = json.string(json.get(hardware, "cpuName"))
    if !strings.equal(reportedCpu, "") { cpuModel = reportedCpu }
    if strings.equal(cpuModel, "") { cpuModel = fieldOf(cpuinfo, "Processor", ":") }
    let machine = strings.trim(capture("uname -m"))
    if strings.equal(cpuModel, "") { cpuModel = machine }
    let hostname = strings.trim(capture("hostname"))
    let kernel = strings.trim(capture("uname -r"))
    let sessionType = process.getenv("XDG_SESSION_TYPE")
    if strings.equal(sessionType, "") { sessionType = "unknown" }
    let power = wsl ? json.set(json.set(json.set(json.set(json.object(), "available", false), "active", ""), "profiles", json.array()), "error", "") : powerProfileState()
    let tools = json.set(json.object(), "display", toolAvailable("wlr-randr"))
    tools = json.set(tools, "sound", toolAvailable("pactl"))
    let state = json.set(json.object(), "hostManaged", wsl)
    state = json.set(state, "hostname", hostname)
    state = json.set(state, "os", fieldOf(release, "PRETTY_NAME", "="))
    if strings.equal(json.string(optGet(state, "os")), "") { state = json.set(state, "os", "Linux") }
    state = json.set(state, "kernel", kernel)
    state = json.set(state, "architecture", machine)
    state = json.set(state, "cpu", cpuModel)
    state = json.set(state, "hardware", hardware)
    state = json.set(state, "processors", json.value(os.availableParallelism()))
    state = json.set(state, "memory", json.value(memValue))
    state = json.set(state, "session", sessionType)
    state = json.set(state, "desktopBuild", build)
    state = json.set(state, "storage", storageEntries())
    state = json.set(state, "batteries", batteries())
    state = json.set(state, "power", power)
    state = json.set(state, "tools", tools)
    state = json.set(state, "hostSettings", wsl && fs.existsSync("/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"))
    return state
}

fn hostPage(page: str): str {
    if strings.equal(page, "display") { return "display" }
    if strings.equal(page, "sound") { return "sound" }
    if strings.equal(page, "power") { return "powersleep" }
    if strings.equal(page, "storage") { return "storagesense" }
    if strings.equal(page, "about") { return "about" }
    return ""
}

fn openPage(page: str, host: bool): str {
    let mapped = hostPage(page)
    if strings.equal(mapped, "") { return "Unknown system settings page." }
    if host {
        if !isWsl() { return "Windows settings are unavailable." }
        let rc = capture("/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -NonInteractive -Command \"Start-Process 'ms-settings:" + mapped + "'\"")
        return ""
    }
    let tool = ""
    if strings.equal(page, "display") { return "Configure displays in DevOs Settings." }
    if strings.equal(page, "sound") { return "Configure sound in DevOs Settings." }
    if !strings.equal(tool, "") {
        if !toolAvailable(tool) { return "The configuration tool is not installed. It is included in the DevOs desktop image." }
        posix.shell(tool + " >/dev/null 2>&1 &")
    }
    return ""
}

use "../lib/posix.dev" as posix

fn selectProfile(profile: str): str {
    if !strings.equal(profile, "power-saver") && !strings.equal(profile, "balanced") && !strings.equal(profile, "performance") {
        return "This power profile is unavailable."
    }
    let name = "org.freedesktop.UPower.PowerProfiles"
    let path = "/org/freedesktop/UPower/PowerProfiles"
    let props = powerProperties(name, path)
    if !json.has(props, "Profiles") {
        name = "net.hadess.PowerProfiles"
        path = "/net/hadess/PowerProfiles"
        props = powerProperties(name, path)
    }
    let supported = false
    let profiles = advertisedProfiles(props)
    for i in 0..(json.len(profiles) as i64) { if strings.equal(jsonText(json.at(profiles, i)), profile) { supported = true } }
    if !supported { return "This power profile is unavailable." }
    let output = child_process.execFileSync("busctl", Vec<str>("--timeout=10", "call", name, path,
        "org.freedesktop.DBus.Properties", "Set", "ssv", name, "ActiveProfile", "s", profile), child_process.options())
    if !output.success { return "This power profile is unavailable." }
    return ""
}

fn main(): i32 {
    let raw = io.read_line()
    if strings.equal(strings.trim(raw), "") { return fail("Invalid system settings request.") }
    let request = json.parse(raw)
    let action = ""
    if json.has(request, "action") { action = jsonText(json.get(request, "action")) }
    if strings.equal(action, "get") {
        print(json.stringify(json.set(json.set(json.object(), "ok", true), "state", inventory())))
        return 0
    }
    if strings.equal(action, "open") {
        let host = false
        if json.has(request, "host") { host = json.bool(json.get(request, "host")) }
        let page = ""
        if json.has(request, "page") { page = jsonText(json.get(request, "page")) }
        let error = openPage(page, host)
        if !strings.equal(error, "") { return fail(error) }
        print(json.stringify(json.set(json.object(), "ok", true)))
        return 0
    }
    if strings.equal(action, "power") {
        if isWsl() { return fail("Windows manages power profiles in WSL.") }
        let profile = ""
        if json.has(request, "profile") { profile = jsonText(json.get(request, "profile")) }
        let error = selectProfile(profile)
        if !strings.equal(error, "") { return fail(error) }
        print(json.stringify(json.set(json.set(json.object(), "ok", true), "state", inventory())))
        return 0
    }
    return fail("Unsupported system settings action.")
}

fn fail(message: str): i32 {
    print(json.stringify(json.set(json.set(json.object(), "ok", false), "error", message)))
    return 1
}
return main()
