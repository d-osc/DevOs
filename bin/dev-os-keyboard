#!/usr/bin/env python3
"""Keyboard settings for Dev OS Settings (the MyASUS "Function key", "Automatic keyboard backlight" and
"Keyboard backlight sleep mode" cards).

Usage: dev-os-keyboard get
       dev-os-keyboard set fn locked|normal | auto-brighten on|off | auto-dim on|off
                          | sleep nothing|both|battery | sleep-both SECONDS | sleep-battery SECONDS
       dev-os-keyboard serve        per-user daemon: ambient light + idle sleep for the keyboard backlight
JSON on stdout, exit 1 on failure. Preferences are per user; only the Fn key mode is system wide and goes through
pkexec to /usr/libexec/devos-keyboard (polkit org.devos.keyboard.fn).

Backends (nothing is invented; a missing device turns the control off with a reason):
  backlight  LED class device /sys/class/leds/*kbd_backlight* (asus::kbd_backlight from the asus-glymur-ec driver). The
             brightness is written through logind SetBrightness (works for the active session without root), with a
             direct write as the fallback.
  sensor     IIO ambient light sensor /sys/bus/iio/devices/iio:device*/in_illuminance_{input,raw}. Auto-brighten turns the
             backlight on when the room turns dark, auto-dim turns it off when the room turns bright; both use two lux
             thresholds (hysteresis) and need several consecutive samples (debounce) and only act on a change.
  idle       Wayland ext-idle-notify-v1 (speaks the wire protocol itself, no extra package). The backlight goes off after
             the chosen idle time and the previous level returns on the first key press or pointer movement; "battery only"
             applies when no mains supply is online.
Test hooks: DEVOS_KBD_SYS (path prefix for /sys), DEVOS_KBD_PREFS (preferences file), DEVOS_KBD_CORE (privileged helper),
DEVOS_KBD_DIRECT=1 (write the LED directly), DEVOS_KBD_TICK (seconds), DEVOS_KBD_DARK / DEVOS_KBD_BRIGHT (lux),
DEVOS_KBD_DEBOUNCE (samples), DEVOS_KBD_ROUNDS (daemon loop count).
"""
import glob
import json
import os
import select
import socket
import struct
import subprocess
import sys
import time

SYSFS = os.environ.get('DEVOS_KBD_SYS', '') + '/sys'
TIMEOUTS = (10, 30, 60, 120, 300, 600)
SLEEP_MODES = ('nothing', 'both', 'battery')
DEFAULTS = {'autoBrighten': False, 'autoDim': False, 'sleep': 'nothing', 'sleepBoth': 60, 'sleepBattery': 60}
DARK_LUX = float(os.environ.get('DEVOS_KBD_DARK', '15'))
BRIGHT_LUX = float(os.environ.get('DEVOS_KBD_BRIGHT', '60'))
DEBOUNCE = int(os.environ.get('DEVOS_KBD_DEBOUNCE', '3'))
TICK = float(os.environ.get('DEVOS_KBD_TICK', '1'))


def out(value):
    print(json.dumps(value, separators=(',', ':')))


def fail(message):
    out({'ok': False, 'error': message})
    sys.exit(1)


def read(path):
    try:
        with open(path, 'r') as handle:
            return handle.read(256).strip()
    except (OSError, UnicodeDecodeError):
        return None


def number(path):
    text = read(path)
    try:
        return float(text) if text is not None else None
    except ValueError:
        return None


# ---- preferences --------------------------------------------------------------------------------------------------
def prefs_path():
    custom = os.environ.get('DEVOS_KBD_PREFS')
    if custom:
        return custom
    base = os.environ.get('XDG_CONFIG_HOME') or os.path.join(os.path.expanduser('~'), '.config')
    return os.path.join(base, 'dev-os', 'keyboard.json')


def validate(raw):
    """Return a clean preferences dict; anything out of range falls back to the default."""
    value = dict(DEFAULTS)
    if not isinstance(raw, dict):
        return value
    for key in ('autoBrighten', 'autoDim'):
        if isinstance(raw.get(key), bool):
            value[key] = raw[key]
    if raw.get('sleep') in SLEEP_MODES:
        value['sleep'] = raw['sleep']
    for key in ('sleepBoth', 'sleepBattery'):
        if isinstance(raw.get(key), int) and not isinstance(raw.get(key), bool) and raw[key] in TIMEOUTS:
            value[key] = raw[key]
    return value


def load_prefs():
    try:
        with open(prefs_path(), 'r') as handle:
            return validate(json.load(handle))
    except (OSError, ValueError):
        return dict(DEFAULTS)


def save_prefs(value):
    path = prefs_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    temporary = path + '.tmp'
    with open(temporary, 'w') as handle:
        json.dump(value, handle, indent=2)
        handle.write('\n')
    os.replace(temporary, path)


# ---- hardware -----------------------------------------------------------------------------------------------------
def find_led():
    for base in sorted(glob.glob(SYSFS + '/class/leds/*kbd_backlight*')):
        maximum = number(base + '/max_brightness')
        if maximum and maximum > 0 and os.path.exists(base + '/brightness'):
            return {'name': os.path.basename(base), 'path': base, 'max': int(maximum)}
    return None


def get_level(led):
    value = number(led['path'] + '/brightness')
    return None if value is None else max(0, min(led['max'], int(value)))


def set_level(led, level):
    level = max(0, min(led['max'], int(level)))
    if not os.environ.get('DEVOS_KBD_DIRECT'):
        try:
            done = subprocess.run(['busctl', 'call', 'org.freedesktop.login1', '/org/freedesktop/login1/session/auto',
                                   'org.freedesktop.login1.Session', 'SetBrightness', 'ssu', 'leds', led['name'], str(level)],
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
            if done.returncode == 0:
                return True
        except (OSError, subprocess.SubprocessError):
            pass
    try:
        with open(led['path'] + '/brightness', 'w') as handle:
            handle.write(str(level))
        return True
    except OSError:
        return False


def read_lux():
    """Illuminance in lux from the first IIO ambient light sensor that reports one, else None."""
    for device in sorted(glob.glob(SYSFS + '/bus/iio/devices/iio:device*')):
        direct = number(device + '/in_illuminance_input')
        if direct is not None:
            return direct
        raw = number(device + '/in_illuminance_raw')
        if raw is not None:
            scale = number(device + '/in_illuminance_scale')
            offset = number(device + '/in_illuminance_offset')
            return (raw + (offset or 0.0)) * (1.0 if scale is None else scale)
    return None


def has_sensor():
    return any(os.path.exists(d + '/in_illuminance_input') or os.path.exists(d + '/in_illuminance_raw')
               for d in glob.glob(SYSFS + '/bus/iio/devices/iio:device*'))


def on_mains():
    """True / False when a mains supply exists and is online / all offline; None when the machine reports none."""
    seen = False
    for supply in sorted(glob.glob(SYSFS + '/class/power_supply/*')):
        if (read(supply + '/type') or '') == 'Battery':
            continue
        online = read(supply + '/online')
        if online is None:
            continue
        seen = True
        if online == '1':
            return True
    return False if seen else None


def wayland_path():
    runtime = os.environ.get('XDG_RUNTIME_DIR', '')
    name = os.environ.get('WAYLAND_DISPLAY', '')
    if name:
        return name if os.path.isabs(name) else os.path.join(runtime, name)
    found = sorted(p for p in glob.glob(os.path.join(runtime, 'wayland-*')) if not p.endswith('.lock'))
    return found[0] if runtime and found else None


# ---- Wayland ext-idle-notify-v1 -------------------------------------------------------------------------------------
class WaylandIdle:
    """Just enough of the Wayland wire protocol to ask for idle / resume events. Object 1 is wl_display."""

    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(2)
        self.sock.connect(path)
        self.buffer = b''
        self.next = 2
        self.globals = {}
        self.seat = None
        self.notifier = None
        self.notifier_version = 1
        self.notification = None
        self.registry = self.new_id()
        self.send(1, 1, struct.pack('<I', self.registry))
        callback = self.new_id()
        self.send(1, 0, struct.pack('<I', callback))
        while not self.roundtrip_done(callback):
            pass
        self.sock.settimeout(None)

    def new_id(self):
        self.next += 1
        return self.next - 1

    def send(self, obj, opcode, payload=b''):
        self.sock.sendall(struct.pack('<II', obj, ((8 + len(payload)) << 16) | opcode) + payload)

    @staticmethod
    def string(text):
        data = text.encode() + b'\0'
        return struct.pack('<I', len(data)) + data + b'\0' * (-len(data) % 4)

    def messages(self):
        while len(self.buffer) >= 8:
            obj, header = struct.unpack_from('<II', self.buffer)
            size, opcode = header >> 16, header & 0xffff
            if size < 8 or len(self.buffer) < size:
                break
            payload, self.buffer = self.buffer[8:size], self.buffer[size:]
            yield obj, opcode, payload

    def fill(self):
        chunk = self.sock.recv(4096)
        if not chunk:
            raise ConnectionError('The compositor closed the connection.')
        self.buffer += chunk

    def roundtrip_done(self, callback):
        self.fill()
        done = False
        for obj, opcode, payload in self.messages():
            if obj == 1 and opcode == 0:
                raise OSError('Wayland error: ' + payload[8:].decode(errors='replace').strip('\0'))
            if obj == self.registry and opcode == 0:
                name, length = struct.unpack_from('<II', payload)
                interface = payload[8:8 + length - 1].decode()
                version = struct.unpack_from('<I', payload, 8 + ((length + 3) & ~3))[0]
                self.globals[interface] = (name, version)
            if obj == callback and opcode == 0:
                done = True
        return done

    def bind(self, interface, version):
        name, advertised = self.globals[interface]
        version = min(version, advertised)
        ident = self.new_id()
        self.send(self.registry, 0, struct.pack('<I', name) + self.string(interface) + struct.pack('<II', version, ident))
        return ident, version

    def available(self):
        return 'ext_idle_notifier_v1' in self.globals and 'wl_seat' in self.globals

    def watch(self, seconds):
        """Replace the idle notification; None removes it."""
        if self.notification is not None:
            self.send(self.notification, 0)
            self.notification = None
        if seconds is None:
            return
        if self.notifier is None:
            self.seat, _ = self.bind('wl_seat', 1)
            self.notifier, self.notifier_version = self.bind('ext_idle_notifier_v1', 2)
        self.notification = self.new_id()
        # v2 get_input_idle_notification ignores idle inhibitors (video playback must not keep the backlight on).
        opcode = 2 if self.notifier_version >= 2 else 1
        self.send(self.notifier, opcode, struct.pack('<III', self.notification, int(seconds * 1000), self.seat))

    def events(self):
        """Read what is pending; yields 'idled' / 'resumed'. Raises ConnectionError when the compositor goes away."""
        self.fill()
        for obj, opcode, payload in self.messages():
            if obj == 1 and opcode == 0:
                raise OSError('Wayland error: ' + payload[8:].decode(errors='replace').strip('\0'))
            if obj == self.notification and opcode in (0, 1):
                yield 'idled' if opcode == 0 else 'resumed'

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass


def probe_idle():
    path = wayland_path()
    if not path:
        return False, 'No Wayland compositor is running in this session.'
    try:
        client = WaylandIdle(path)
    except (OSError, ConnectionError, struct.error) as reason:
        return False, 'The compositor could not be queried (%s).' % reason
    try:
        return (True, '') if client.available() else (False, 'The compositor does not offer idle notifications (ext-idle-notify-v1).')
    finally:
        client.close()


# ---- front end ----------------------------------------------------------------------------------------------------
def core_path():
    for candidate in (os.environ.get('DEVOS_KBD_CORE'), '/usr/libexec/devos-keyboard',
                      os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'native', 'devos-keyboard')):
        if candidate and os.path.isfile(candidate):
            return candidate
    return None


def core(*args, privileged=False):
    path = core_path()
    if not path:
        return None, 'Keyboard settings are not installed.'
    command = ['sh', path, *args]
    if privileged and os.geteuid() != 0 and not os.environ.get('DEVOS_KBD_ALLOW_USER'):
        command = ['pkexec', path, *args]
    try:
        done = subprocess.run(command, capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError):
        return None, 'The Fn key mode was not changed. Administrator access was denied or failed.'
    try:
        value = json.loads(done.stdout or '{}')
    except ValueError:
        value = {}
    if done.returncode != 0 or value.get('ok') is not True:
        return None, value.get('error') or 'The Fn key mode was not changed. Administrator access was denied or failed.'
    return value, ''


def snapshot():
    led = find_led()
    prefs = load_prefs()
    fn, _ = core('get')
    fn = fn or {'supported': False, 'reason': 'Keyboard settings are not installed.', 'mode': ''}
    idle_ok, idle_reason = probe_idle()
    sensor = has_sensor()
    return {
        'ok': True, 'settings': prefs, 'timeouts': list(TIMEOUTS),
        'fn': {'supported': bool(fn.get('supported')), 'reason': fn.get('reason', ''), 'mode': fn.get('mode', '')},
        'backlight': {'supported': led is not None, 'name': led['name'] if led else '', 'max': led['max'] if led else 0,
                      'level': (get_level(led) or 0) if led else 0,
                      'reason': '' if led else 'This keyboard has no backlight that the kernel can control.'},
        'sensor': {'supported': led is not None and sensor, 'lux': read_lux() if sensor else None,
                   'reason': '' if sensor else 'This laptop has no ambient light sensor that the kernel exposes.'},
        'idle': {'supported': led is not None and idle_ok, 'reason': idle_reason},
        'mains': on_mains(),
    }


def command_set(args):
    if len(args) != 2:
        fail('Usage: dev-os-keyboard set <setting> <value>')
    key, value = args
    if key == 'fn':
        if value not in ('locked', 'normal'):
            fail('Unknown Fn key mode.')
        _, error = core('set', 'fn', value, privileged=True)
        if error:
            fail(error)
        return out(snapshot())
    prefs = load_prefs()
    if key in ('auto-brighten', 'auto-dim'):
        if value not in ('on', 'off'):
            fail('Use on or off.')
        prefs['autoBrighten' if key == 'auto-brighten' else 'autoDim'] = value == 'on'
    elif key == 'sleep':
        if value not in SLEEP_MODES:
            fail('Unknown sleep mode.')
        prefs['sleep'] = value
    elif key in ('sleep-both', 'sleep-battery'):
        if not value.isdigit() or int(value) not in TIMEOUTS:
            fail('The idle time must be one of: ' + ', '.join(str(t) for t in TIMEOUTS) + ' seconds.')
        prefs['sleepBoth' if key == 'sleep-both' else 'sleepBattery'] = int(value)
    else:
        fail('Unsupported keyboard setting.')
    try:
        save_prefs(prefs)
    except OSError:
        fail('The keyboard preferences could not be saved.')
    out(snapshot())


# ---- daemon -------------------------------------------------------------------------------------------------------
class Backlight:
    def __init__(self, led):
        self.led = led
        self.prefs = load_prefs()
        self.stamp = None
        self.idle_off = False
        self.saved = None
        self.last_on = led['max']
        self.dark = None  # None until the first debounced reading
        self.run = 0
        self.candidate = None
        self.idle = None
        self.retry = 0.0
        self.watching = 'unset'
        self.stopped = False

    def reload(self):
        try:
            stamp = os.stat(prefs_path()).st_mtime_ns
        except OSError:
            stamp = None
        if stamp != self.stamp:
            self.stamp = stamp
            self.prefs = load_prefs()

    def timeout(self):
        mode = self.prefs['sleep']
        if mode == 'both':
            return self.prefs['sleepBoth']
        if mode == 'battery' and on_mains() is not True:
            return self.prefs['sleepBattery']
        return None

    def restore(self):
        if self.idle_off:
            self.idle_off = False
            if self.saved:
                set_level(self.led, self.saved)
            self.saved = None

    def went_idle(self):
        level = get_level(self.led) or 0
        self.idle_off = True
        self.saved = level or None
        if level:
            set_level(self.led, 0)

    def sensor_tick(self):
        lux = read_lux()
        if lux is None:
            return
        if lux <= DARK_LUX:
            state = True
        elif lux >= BRIGHT_LUX:
            state = False
        else:
            self.candidate, self.run = None, 0  # between the thresholds: keep the current state (hysteresis)
            return
        if state == self.dark:
            self.candidate, self.run = None, 0
            return
        if state != self.candidate:
            self.candidate, self.run = state, 0
        self.run += 1
        if self.run < DEBOUNCE:
            return
        previous, self.dark, self.candidate, self.run = self.dark, state, None, 0
        if previous is None or self.idle_off:
            return  # the first reading only sets the baseline; a sleeping backlight stays asleep
        level = get_level(self.led) or 0
        if state and self.prefs['autoBrighten'] and level == 0:
            set_level(self.led, self.last_on or 1)
        elif not state and self.prefs['autoDim'] and level > 0:
            set_level(self.led, 0)

    def tick(self):
        self.reload()
        level = get_level(self.led)
        if level and not self.idle_off:
            self.last_on = level
        self.sensor_tick()
        wanted = self.timeout()
        if wanted is None:
            self.restore()
        if self.idle is None and wanted is not None and time.monotonic() >= self.retry:
            self.retry = time.monotonic() + 5
            path = wayland_path()
            if path:
                try:
                    client = WaylandIdle(path)
                    if client.available():
                        self.idle, self.watching = client, 'unset'
                    else:
                        client.close()
                except (OSError, ConnectionError, struct.error):
                    self.idle = None
        if self.idle is not None and wanted != self.watching:
            try:
                self.idle.watch(wanted)
                self.watching = wanted
            except (OSError, ConnectionError):
                self.drop()

    def drop(self):
        if self.idle is not None:
            self.idle.close()
        self.idle, self.watching = None, 'unset'
        self.restore()

    def serve(self, rounds=None):
        count = 0
        while not self.stopped and (rounds is None or count < rounds):
            count += 1
            self.tick()
            if self.idle is None:
                time.sleep(TICK)
                continue
            if select.select([self.idle.sock], [], [], TICK)[0]:
                try:
                    for event in self.idle.events():
                        if event == 'idled' and self.timeout() is not None:
                            self.went_idle()
                        elif event == 'resumed':
                            self.restore()
                except (OSError, ConnectionError, struct.error):
                    self.drop()


def command_serve():
    led = find_led()
    if not led:
        print('No keyboard backlight; nothing to do.', file=sys.stderr)
        return
    rounds = os.environ.get('DEVOS_KBD_ROUNDS')
    Backlight(led).serve(int(rounds) if rounds else None)


def main(argv):
    action = argv[1] if len(argv) > 1 else ''
    if action == 'get':
        out(snapshot())
    elif action == 'set':
        command_set(argv[2:])
    elif action == 'serve':
        command_serve()
    else:
        fail('Unsupported keyboard action.')


if __name__ == '__main__':
    main(sys.argv)
