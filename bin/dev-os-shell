#!/bin/sh
set -eu
if [ "${1:-}" = drivers ]; then
    shift
    exec d "$(dirname -- "$0")/dev-os-drivers" -- "$@"
fi
base=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -f "$base/src/system/command.dev" ]; then root=$base; else root="$base/share/dev-os"; fi
export DEV_OS_ROOT="$root"
. "$base/bin/dev-os-runtime-env"
export GDK_BACKEND=wayland
# Metadata and commands to an existing desktop go through the DevLang client; only starting the shell itself reaches the native shell below.
native_client=no
if [ -r "$root/src/system/command.dev" ]; then
    case "${1:-shell}" in
        shell) ;;
        doctor|--version|--help|-h) native_client=yes ;;
        *) if [ -r "$root/dist/native/libsupervisor.so" ]; then native_client=yes; fi ;;
    esac
fi
if [ "$native_client" = yes ]; then
    status=0
    if [ -r "$root/dist/native/libsupervisor.so" ]; then
        native_output=$(devrun "$root/src/system/command.dev" --ffi-lib "$root/dist/native/libsupervisor.so" -- "$@") || status=$?
    else
        native_output=$(devrun "$root/src/system/command.dev" -- "$@") || status=$?
    fi
    if [ "$status" -ne 75 ] || [ "$native_output" != DEVOS_NATIVE_CONTROL_NO_OWNER ]; then
        if [ -n "$native_output" ]; then printf '%s\n' "$native_output"; fi
        exit "$status"
    fi
fi
# Hiding an absent overview, or a window gesture with no desktop running, must not start one.
case "${1:-shell}" in task-view-hide|overlays-hide|window-next|window-previous|window-restore) exit 0 ;; esac
# The shell is the DevLang program dist/native/shell: it owns the shell's D-Bus name without a window and starts the native apps.
if [ ! -x "$root/dist/native/shell" ]; then
    printf '%s\n' 'Native shell missing. Run sh tools/build/native-apps.sh.' >&2
    exit 1
fi
id=$(printf "%s" "${XDG_RUNTIME_DIR:-}/${WAYLAND_DISPLAY:-default}" | sha256sum | cut -c1-16)
DEV_OS_NATIVE_ID="org.devos.Shell.s$id"
export DEV_OS_NATIVE_ID
exec "$root/dist/native/shell"
