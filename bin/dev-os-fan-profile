#!/bin/sh
# Settings front end for the Fan Profile (Performance / Standard / Whisper) and Power Mode Synchronization.
# Usage: dev-os-fan-profile get | set ac|battery|both <performance|standard|whisper> | sync on|off      (JSON on stdout, exit 1 on failure)
# `get` runs as the user; changes go through pkexec to /usr/libexec/devos-fan-profile (polkit action org.devos.fan.profile).
export PATH=/usr/bin:/usr/sbin:/bin:/sbin
here=$(dirname "$0")
core=${DEVOS_FAN_PROFILE_CORE:-/usr/libexec/devos-fan-profile}
[ -x "$core" ] || core="$here/../native/devos-fan-profile"
[ -f "$core" ] || { echo '{"ok":false,"error":"Fan profiles are not installed."}'; exit 1; }
privileged() {
    if [ "$(id -u)" = 0 ] || [ -n "$DEVOS_FAN_ALLOW_USER" ]; then sh "$core" "$@"; else pkexec "$core" "$@"; fi
}
case "$1" in
    get) sh "$core" get || exit 1 ;;
    set|sync)
        if ! out=$(privileged "$@"); then
            [ -n "$out" ] && echo "$out" || echo '{"ok":false,"error":"The fan profile was not changed. Administrator access was denied or failed."}'
            exit 1
        fi
        sh "$core" get ;;
    *) echo '{"ok":false,"error":"Unsupported fan profile action."}'; exit 1 ;;
esac
