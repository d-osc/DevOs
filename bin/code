#!/bin/sh
# Open the Linux editor inside the Dev OS session, including on WSL.
set -eu
if [ -x /usr/share/code/bin/code ]; then
    editor=/usr/share/code/bin/code
elif [ -x /usr/bin/code ] && [ "$(readlink -f /usr/bin/code)" != "$(readlink -f "$0")" ]; then
    editor=/usr/bin/code
else
    printf '%s\n' 'Install the Linux Visual Studio Code package first.' >&2
    exit 1
fi
export DONT_PROMPT_WSL_INSTALL=1
if [ "${XDG_SESSION_TYPE:-}" = wayland ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
    set -- --ozone-platform=wayland "$@"
fi
if [ "$(id -u)" = 0 ] && [ -f /run/devos-live/root-session-enabled ]; then
    set -- --no-sandbox --user-data-dir="${XDG_CONFIG_HOME:-$HOME/.config}/devos-live/code" "$@"
fi
software=${DEV_OS_CODE_SOFTWARE_RENDERING:-auto}
if [ "$software" = auto ]; then
    software=0
    if [ "${WLR_RENDERER:-}" = pixman ]; then software=1; fi
fi
if [ "$software" = 1 ]; then set -- --disable-gpu "$@"; fi
if [ -f /run/devos-live/root-session-enabled ]; then
    logs=${XDG_STATE_HOME:-$HOME/.local/state}/devos/logs
    mkdir -p "$logs"
    exec "$editor" "$@" >>"$logs/vscode.log" 2>&1
fi
exec "$editor" "$@"
