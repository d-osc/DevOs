use "std/fs"
use "std/test"
use "std/strings"
use "../tools/lib/tool.dev" as tool
use "../src/apps/org.devos.screenshot/geometry.dev" as g
use "./lib/react-devlang.dev" as t

fn same(a:g.Rect, x:f64, y:f64, w:f64, h:f64):bool { return a.x == x && a.y == y && a.width == w && a.height == h }
fn temporary():str { return strings.trim(tool.exec(Vec<str>("mktemp","-d"))) }

test.case("rectangles are normalised from any two corners and overlaps are clipped",fn() {
    test.expect(same(g.normalizeRect(g.Point(10.0,40.0),g.Point(4.0,12.0)),4.0,12.0,6.0,28.0),"normalizeRect wrong")
    test.expect(same(g.intersect(g.Rect(0.0,0.0,10.0,10.0),g.Rect(5.0,6.0,10.0,10.0)),5.0,6.0,5.0,4.0),"Overlap wrong")
    test.expect(same(g.intersect(g.Rect(0.0,0.0,10.0,10.0),g.Rect(20.0,20.0,5.0,5.0)),20.0,20.0,0.0,0.0),"Disjoint rectangles must give a zero-sized overlap")
    test.expect(g.usable(g.Rect(0.0,0.0,4.0,4.0)) && !g.usable(g.Rect(0.0,0.0,3.9,100.0)) && !g.usable(g.Rect(0.0,0.0,100.0,3.0)),"usable wrong")
})
test.case("a freehand path has bounds and is thinned to every point at least `distance` apart, keeping the last one",fn() {
    test.expect(same(g.pathBounds(Vec<g.Point>()),0.0,0.0,0.0,0.0),"Empty bounds wrong")
    test.expect(same(g.pathBounds(Vec<g.Point>(g.Point(5.0,9.0),g.Point(-2.0,4.0),g.Point(8.0,-1.0))),-2.0,-1.0,10.0,10.0),"pathBounds wrong")
    let kept = g.thin(Vec<g.Point>(g.Point(0.0,0.0),g.Point(1.0,0.0),g.Point(2.0,0.0),g.Point(2.5,0.0),g.Point(3.0,0.0)),2.0)
    test.expect(kept.len() == 3 && kept[0].x == 0.0 && kept[1].x == 2.0 && kept[2].x == 3.0,"thin wrong: ${kept.len()}")
    test.expect(g.thin(Vec<g.Point>(g.Point(1.0,1.0)),2.0).len() == 1 && g.thin(Vec<g.Point>(),2.0).len() == 0,"thin of tiny paths wrong")
})
test.case("a logical selection scales outwards to image pixels and the desktop is the union of the monitors",fn() {
    test.expect(same(g.scaleRect(g.Rect(10.2,20.7,30.1,40.0),2.0),20.0,41.0,61.0,81.0),"scaleRect wrong")
    test.expect(same(g.scaleRect(g.Rect(0.0,0.0,100.0,50.0),1.0),0.0,0.0,100.0,50.0),"scaleRect at scale 1 wrong")
    test.expect(g.imageScale(3840.0,1920.0) == 2.0 && g.imageScale(0.0,1920.0) == 1.0 && g.imageScale(100.0,0.0) == 1.0,"imageScale wrong")
    test.expect(same(g.desktopBounds(Vec<g.Rect>(g.Rect(0.0,0.0,1920.0,1080.0),g.Rect(1920.0,-200.0,1280.0,1024.0))),0.0,-200.0,3200.0,1280.0),"desktopBounds wrong")
    test.expect(same(g.desktopBounds(Vec<g.Rect>()),0.0,0.0,0.0,0.0),"Empty desktop wrong")
})
test.case("snip names carry the local time and never overwrite an earlier snip",fn() {
    test.expect(strings.equal(g.snipFileName(2026,1,5,9,5,3),"Screenshot 2026-01-05 09-05-03.png") && strings.equal(g.snipFileName(2026,12,31,23,59,59),"Screenshot 2026-12-31 23-59-59.png"),"snipFileName wrong")
    let d = temporary()
    test.expect(strings.equal(g.uniqueIn(d,"a.png"),"a.png"),"A free name was changed")
    fs.writeFileSync(d + "/a.png","x")
    test.expect(strings.equal(g.uniqueIn(d,"a.png"),"a (2).png"),"The first duplicate wrong")
    fs.writeFileSync(d + "/a (2).png","x"); fs.writeFileSync(d + "/noext","x")
    test.expect(strings.equal(g.uniqueIn(d,"a.png"),"a (3).png") && strings.equal(g.uniqueIn(d,"noext"),"noext (2)"),"The next duplicate or a name without extension wrong")
    tool.exec(Vec<str>("rm","-rf",d))
})
return t.finish()
