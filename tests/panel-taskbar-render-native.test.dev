test.case("native hover and context events preserve pointer lifecycle without window actions",fn() {
    let root=t.root();let binary=root+"/build/react-devlang/panel/taskbar-pointer-test";let layer=strings.trim(tool.exec(Vec<str>("cc","-print-file-name=libgtk-layer-shell.so.0")));let object=root+"/build/react-devlang/panel/pointer-test.o"
    tool.checked(Vec<str>("sh","-c","cc -Wall -Wextra -Werror -fPIC -c \"$1\" $(pkg-config --cflags gtk+-3.0) -o \"$2\"","pointer-build",root+"/tests/react-devlang/panel-pointer.c",object),Map<str,str>(),"",15000)
    tool.checked(Vec<str>("sh",t.library()+"/tools/build.sh",root+"/tests/react-devlang/panel-taskbar-pointer.devx",binary,root+"/build/react-devlang/panel/host.o",object,layer),Map<str,str>(),"",90000)
    tool.scope("panel-pointer-",fn(dir:str) {
        let helper=dir+"/tracker";let log=dir+"/commands";tool.write(log,"")
        tool.write(helper,"#!/bin/sh\nprintf '%s\\n' '{\"type\":\"window\",\"id\":1,\"title\":\"Example\",\"appId\":\"org.example.Task\",\"active\":true}'\nwhile IFS= read -r line; do printf '%s\\n' \"$line\" >> "+util.quote(log)+"\nprintf '%s\\n' '{\"type\":\"window\",\"id\":1,\"active\":false,\"minimized\":true}'; done\n")
        tool.chmod(helper,"755");let env=Map<str,str>();env.set("DEV_OS_ROOT",root);env.set("DEVOS_PANEL_TRACKER",helper);env.set("GDK_BACKEND","x11");env.set("G_DEBUG","fatal-criticals");env.set("NO_AT_BRIDGE","1")
        let done=tool.run(Vec<str>("xvfb-run","--auto-servernum",binary),env,"",18000);t.success(done);t.contains(t.out(done),"PASS pointer hover")
        t.equal(strings.trim(tool.read(log)),"minimize 1")
    })
})
test.case("native clock popup renders prepared data and executes Time settings RPC once",fn() {
    let root=t.root();let binary=root+"/build/react-devlang/panel/clock-popup-test";let layer=strings.trim(tool.exec(Vec<str>("cc","-print-file-name=libgtk-layer-shell.so.0")))
    tool.checked(Vec<str>("sh",t.library()+"/tools/build.sh",root+"/tests/react-devlang/panel-clock-popup.devx",binary,root+"/build/react-devlang/panel/host.o",layer),Map<str,str>(),"",90000)
    tool.scope("panel-clock-popup-",fn(dir:str) {
        tool.checked(Vec<str>("mkdir","-p",dir+"/dist/native"),Map<str,str>(),"",5000)
        tool.checked(Vec<str>("ln","-s",root+"/src",dir+"/src"),Map<str,str>(),"",5000);tool.checked(Vec<str>("ln","-s",root+"/lib",dir+"/lib"),Map<str,str>(),"",5000)
        tool.checked(Vec<str>("cc","-shared","-fPIC",root+"/tests/fixtures/panel-rpc.c","-o",dir+"/dist/native/libsupervisor.so"),Map<str,str>(),"",15000)
        let env=Map<str,str>();env.set("DEV_OS_ROOT",dir);env.set("PANEL_RPC_LOG",dir+"/calls");env.set("GDK_BACKEND","x11");env.set("G_DEBUG","fatal-criticals");env.set("NO_AT_BRIDGE","1")
        let done=tool.run(Vec<str>("xvfb-run","--auto-servernum",binary),env,"",15000);t.success(done);t.contains(t.out(done),"PASS native clock popup");t.equal(strings.trim(tool.read(dir+"/calls")),"time")
    })
})
