use "std/test"
use "std/strings"
use "../tools/lib/tool.dev" as tool
use "./lib/react-devlang.dev" as t
use "../lib/desktop.dev" as util
test.case("native taskbar renders prepared frames without GJS",fn() {
    let root=t.root();tool.checked(Vec<str>("sh",root+"/tools/build/native-panel.sh"),Map<str,str>(),"",90000)
    let layer=strings.trim(tool.exec(Vec<str>("cc","-print-file-name=libgtk-layer-shell.so.0")));let binary=root+"/build/react-devlang/panel/taskbar-test"
    tool.checked(Vec<str>("sh",t.library()+"/tools/build.sh",root+"/tests/react-devlang/panel-taskbar.devx",binary,root+"/build/react-devlang/panel/host.o",layer),Map<str,str>(),"",90000)
    t.lacks(tool.exec(Vec<str>("ldd",binary)),"mozjs")
    let env=Map<str,str>();env.set("GDK_BACKEND","x11");env.set("G_DEBUG","fatal-criticals");env.set("NO_AT_BRIDGE","1")
    let done=tool.run(Vec<str>("xvfb-run","--auto-servernum",binary),env,"",15000);t.success(done);t.contains(t.out(done),"PASS native taskbar GIcons")
})
test.case("native taskbar click transport executes each tracker command once",fn() {
    let root=t.root();let binary=root+"/build/react-devlang/panel/taskbar-actions-test";let layer=strings.trim(tool.exec(Vec<str>("cc","-print-file-name=libgtk-layer-shell.so.0")))
    tool.checked(Vec<str>("sh",t.library()+"/tools/build.sh",root+"/tests/react-devlang/panel-taskbar-actions.devx",binary,root+"/build/react-devlang/panel/host.o",layer),Map<str,str>(),"",90000)
    tool.scope("panel-taskbar-actions-",fn(dir:str) {
        let helper=dir+"/tracker";let log=dir+"/commands";tool.write(log,"")
        tool.write(dir+"/data/applications/org.example.Task.desktop","[Desktop Entry]\nType=Application\nName=Catalog App\nExec=/bin/true\nIcon=folder-symbolic\nNoDisplay=true\n")
        tool.write(helper,"#!/bin/sh\nprintf '%s\\n' '{\"type\":\"window\",\"id\":1,\"title\":\"Example\",\"appId\":\"org.example.Task\",\"active\":true,\"minimized\":false}'\nwhile IFS= read -r line; do\nprintf '%s\\n' \"$line\" >> "+util.quote(log)+"\ncase \"$line\" in\n'minimize 1') printf '%s\\n' '{\"type\":\"window\",\"id\":1,\"active\":false,\"minimized\":true}';;\n'activate 1') printf '%s\\n' '{\"type\":\"window\",\"id\":1,\"active\":true,\"minimized\":false}';;\nesac\ndone\n")
        tool.chmod(helper,"755");let env=Map<str,str>();env.set("DEV_OS_ROOT",root);env.set("DEVOS_PANEL_TRACKER",helper);env.set("GDK_BACKEND","x11");env.set("G_DEBUG","fatal-criticals");env.set("NO_AT_BRIDGE","1")
        env.set("XDG_DATA_HOME",dir+"/data")
        let done=tool.run(Vec<str>("xvfb-run","--auto-servernum",binary),env,"",15000);t.success(done);t.contains(t.out(done),"PASS native taskbar clicks")
        t.equal(strings.trim(tool.read(log)),"minimize 1\nactivate 1")
    })
})
test.case("native picker sends individual window actions and follows live tracker state",fn() {
    let root=t.root();let binary=root+"/build/react-devlang/panel/taskbar-picker-test";let layer=strings.trim(tool.exec(Vec<str>("cc","-print-file-name=libgtk-layer-shell.so.0")))
    tool.checked(Vec<str>("sh",t.library()+"/tools/build.sh",root+"/tests/react-devlang/panel-taskbar-picker.devx",binary,root+"/build/react-devlang/panel/host.o",layer),Map<str,str>(),"",90000)
    tool.scope("panel-taskbar-picker-",fn(dir:str) {
        let helper=dir+"/tracker";let log=dir+"/commands";tool.write(log,"")
        tool.write(helper,"#!/bin/sh\nprintf '%s\\n' '{\"type\":\"window\",\"id\":1,\"title\":\"One\",\"appId\":\"org.example.Task\"}' '{\"type\":\"window\",\"id\":2,\"title\":\"เอกสาร\",\"appId\":\"org.example.Task\"}'\nwhile IFS= read -r line; do\nprintf '%s\\n' \"$line\" >> "+util.quote(log)+"\ncase \"$line\" in\n'maximize 2') printf '%s\\n' '{\"type\":\"window\",\"id\":2,\"maximized\":true}';;\n'minimize 2') printf '%s\\n' '{\"type\":\"window\",\"id\":2,\"minimized\":true}';;\n'unmaximize 2') printf '%s\\n' '{\"type\":\"window\",\"id\":2,\"maximized\":false}';;\n'close 1') printf '%s\\n' '{\"type\":\"closed\",\"id\":1}';;\nesac\ndone\n")
        tool.chmod(helper,"755");let env=Map<str,str>();env.set("DEV_OS_ROOT",root);env.set("DEVOS_PANEL_TRACKER",helper);env.set("GDK_BACKEND","x11");env.set("G_DEBUG","fatal-criticals");env.set("NO_AT_BRIDGE","1")
        let done=tool.run(Vec<str>("xvfb-run","--auto-servernum",binary),env,"",15000);t.success(done);t.contains(t.out(done),"PASS native picker actions")
        t.equal(strings.trim(tool.read(log)),"maximize 2\nminimize 2\nunmaximize 2\nclose 1\nactivate 2")
    })
})
