test.case("native Quick settings executes device actions once and exposes live failures",fn() {
    let root=t.root();let binary=root+"/build/react-devlang/panel/quick-settings-test";let layer=strings.trim(tool.exec(Vec<str>("cc","-print-file-name=libgtk-layer-shell.so.0")))
    tool.checked(Vec<str>("sh",t.library()+"/tools/build.sh",root+"/tests/react-devlang/panel-quick-settings.devx",binary,root+"/build/react-devlang/panel/host.o",layer),Map<str,str>(),"",90000)
    tool.scope("panel-quick-settings-",fn(dir:str) {
        let log=dir+"/actions";let radio=dir+"/radio";let volume=dir+"/volume";let brightness=dir+"/sys/class/backlight/display/brightness";let removed=dir+"/removed";tool.write(log,"");tool.write(radio,"no");tool.write(volume,"0.6");tool.write(brightness,"50");tool.write(dir+"/sys/class/backlight/display/max_brightness","100")
        tool.write(dir+"/bin/wpctl","#!/bin/sh\nif [ \"$1\" = get-volume ]; then if [ -f "+util.quote(removed)+" ]; then exit 1; fi; printf 'Volume: '; cat "+util.quote(volume)+"; echo; exit 0; fi\nprintf '%s\\n' \"wpctl $*\" >> "+util.quote(log)+"\nif [ \"$1\" = set-mute ]; then touch "+util.quote(removed)+"; echo 'permission denied by fixture' >&2; exit 7; fi\nsleep 0.15\necho 0.85 > "+util.quote(volume)+"\n")
        tool.write(dir+"/bin/bluetoothctl","#!/bin/sh\nif [ \"$1\" = show ]; then if [ -f "+util.quote(removed)+" ]; then exit 1; fi; printf 'Powered: '; cat "+util.quote(radio)+"; echo; else printf '%s\\n' \"bluetoothctl $*\" >> "+util.quote(log)+"; echo yes > "+util.quote(radio)+"; fi\n")
        tool.write(dir+"/bin/dev-os-backlight","#!/bin/sh\nprintf '%s\\n' \"backlight $*\" >> "+util.quote(log)+"\nprintf '%s' \"$3\" > "+util.quote(brightness)+"\n")
        for name in Vec<str>("pactl","nmcli") {tool.write(dir+"/bin/"+name,"#!/bin/sh\nexit 1\n")}
        for name in Vec<str>("wpctl","pactl","nmcli","bluetoothctl","dev-os-backlight") {tool.chmod(dir+"/bin/"+name,"755")}
        let env=Map<str,str>();env.set("DEV_OS_ROOT",root);env.set("PATH",dir+"/bin:/usr/bin:/bin");env.set("DEVOS_PANEL_SYS",dir+"/sys");env.set("DEVOS_PANEL_PROC",dir+"/proc");env.set("GDK_BACKEND","x11");env.set("G_DEBUG","fatal-criticals");env.set("NO_AT_BRIDGE","1")
        let done=tool.run(Vec<str>("xvfb-run","--auto-servernum",binary),env,"",20000);t.success(done);t.contains(t.out(done),"PASS native Quick settings")
        t.equal(strings.trim(tool.read(log)),"bluetoothctl power on\nwpctl set-volume @DEFAULT_AUDIO_SINK@ 85%\nbacklight -- set 55\nwpctl set-mute @DEFAULT_AUDIO_SINK@ toggle")
    })
})
test.case("native battery-care switch preserves authorization failure and removal",fn() {
    let root=t.root();let binary=root+"/build/react-devlang/panel/battery-care-test";let layer=strings.trim(tool.exec(Vec<str>("cc","-print-file-name=libgtk-layer-shell.so.0")))
    tool.checked(Vec<str>("sh",t.library()+"/tools/build.sh",root+"/tests/react-devlang/panel-battery-care.devx",binary,root+"/build/react-devlang/panel/host.o",layer),Map<str,str>(),"",90000)
    tool.scope("panel-care-ui-",fn(dir:str) {
        let env=Map<str,str>();env.set("DEV_OS_ROOT",root);env.set("DEVOS_PANEL_BATTERY_HELPER",root+"/tests/fixtures/panel-battery-care.sh");env.set("PANEL_CARE_CALLS",dir+"/calls");env.set("PANEL_CARE_DENY_AFTER_OFF","1");for key in Vec<str>("STATE","BAD","DENIED","UNSUPPORTED","HIDDEN","DISABLED") {env.set("PANEL_CARE_"+key,dir+"/"+key)};tool.write(dir+"/STATE","off")
        env.set("GDK_BACKEND","x11");env.set("G_DEBUG","fatal-criticals");env.set("NO_AT_BRIDGE","1")
        let done=tool.run(Vec<str>("xvfb-run","--auto-servernum",binary),env,"",18000);t.success(done);t.contains(t.out(done),"PASS native full-charge switch")
        let calls=tool.read(dir+"/calls");test.expect(tool.count(calls,"full on")==2 && tool.count(calls,"full off")==1,"Battery switch repeated a mutation")
    })
})
