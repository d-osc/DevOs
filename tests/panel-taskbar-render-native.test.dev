test.case("native panel settings edits a draft and saves only on Apply",fn() {
    let root=t.root();let binary=root+"/build/react-devlang/panel/settings-test";let layer=strings.trim(tool.exec(Vec<str>("cc","-print-file-name=libgtk-layer-shell.so.0")))
    tool.checked(Vec<str>("sh",t.library()+"/tools/build.sh",root+"/tests/react-devlang/panel-settings.devx",binary,root+"/build/react-devlang/panel/host.o",layer),Map<str,str>(),"",90000)
    tool.scope("panel-settings-ui-",fn(dir:str) {
        let env=Map<str,str>();env.set("DEV_OS_ROOT",root);env.set("DEVOS_PANEL_PREFERENCES",dir+"/panel.json");env.set("GDK_BACKEND","x11");env.set("G_DEBUG","fatal-criticals");env.set("NO_AT_BRIDGE","1")
        let done=tool.run(Vec<str>("xvfb-run","--auto-servernum",binary),env,"",20000);t.success(done);t.contains(t.out(done),"PASS native panel settings");let saved=tool.read(dir+"/panel.json");t.contains(saved,"\"height\":44");t.contains(saved,"\"showDate\":false");t.contains(saved,"literal;$(false)")
