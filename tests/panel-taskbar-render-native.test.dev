test.case("native language selector validates live layouts before tracker command",fn() {
    let root=t.root();let binary=root+"/build/react-devlang/panel/language-test";let layer=strings.trim(tool.exec(Vec<str>("cc","-print-file-name=libgtk-layer-shell.so.0")))
    tool.checked(Vec<str>("sh",t.library()+"/tools/build.sh",root+"/tests/react-devlang/panel-language.devx",binary,root+"/build/react-devlang/panel/host.o",layer),Map<str,str>(),"",90000)
    tool.scope("panel-language-",fn(dir:str) {
        let helper=dir+"/tracker";let log=dir+"/commands";tool.write(log,"")
        let before="{\"type\":\"desktop-begin\"}\n{\"type\":\"keyboard-layout\",\"index\":0,\"name\":\"English (US)\",\"active\":false}\n{\"type\":\"keyboard-layout\",\"index\":1,\"name\":\"Thai\",\"active\":true}\n{\"type\":\"desktop-done\"}"
        let after=strings.replaceAll(strings.replaceAll(before,"false","TEMP"),"true","false");after=strings.replaceAll(after,"TEMP","true")
        tool.write(helper,"#!/bin/sh\nprintf '%s\\n' "+util.quote(before)+"\nwhile IFS= read -r line; do printf '%s\\n' \"$line\" >> "+util.quote(log)+"\nif [ \"$line\" = 'layout 0' ]; then printf '%s\\n' "+util.quote(after)+"; fi\ndone\n");tool.chmod(helper,"755")
        let env=Map<str,str>();env.set("DEV_OS_ROOT",root);env.set("DEVOS_PANEL_TRACKER",helper);env.set("GDK_BACKEND","x11");env.set("G_DEBUG","fatal-criticals");env.set("NO_AT_BRIDGE","1")
        let done=tool.run(Vec<str>("xvfb-run","--auto-servernum",binary),env,"",15000);t.success(done);t.contains(t.out(done),"PASS native language selection");t.equal(strings.trim(tool.read(log)),"layout 0")
    })
})
