use "react_devlang/ui" as ui
extern fn gtk_widget_get_visible(widget:*void):i32
extern fn gtk_widget_get_child_visible(widget:*void):i32
extern fn rd_widget_live_count():i64
fn check(value:bool,message:str) {if !value {unsafe {ui.rd_fail(message)}}}
fn page(name:str,label:str):ui.Node {return ui.Box(ui.named(name),Vec<ui.Node>(ui.Label(label)))}
fn App(context:*ui.Context):ui.Node {
    let phase=ui.useState(context,0);let widget=ui.useRef(context,0)
    ui.useEffect(context,fn():fn():void {unsafe {
        if phase.value==0 {
            widget.set(ui.find(context,"first") as i64)
            check(ui.readText(context,"first-label").bytes.len()>0,"Page 0 was not mounted")
            check(ui.readText(context,"second-label").bytes.len()>0,"Hidden page was not mounted")
            check(gtk_widget_get_visible(ui.find(context,"first"))==1,"Page 0 should be visible")
            phase.set(1)
        } else if phase.value==1 {
            check(widget.get()==ui.find(context,"first") as i64,"Switching pages replaced a page widget")
            phase.set(2)
        } else {ui.close(context)};return ui.noop
    }},Vec<i64>(phase.value))
    let first=ui.Box(ui.named("first"),Vec<ui.Node>(ui.withProps(ui.Label("One"),ui.named("first-label"))))
    let second=ui.Box(ui.named("second"),Vec<ui.Node>(ui.withProps(ui.Label("Two"),ui.named("second-label"))))
    return ui.Stack(ui.named("pages"),phase.value==0?0:1,Vec<ui.Node>(first,second))
}
fn main():i32 {check(ui.run("Stack",320,200,App),"Stack failed");unsafe {check(rd_widget_live_count()==0,"Stack leaked widgets")};print("PASS native Stack keeps pages mounted while switching");return 0}
return main()
