use "react_devlang/ui" as ui
use "../../src/system/org.devos.panel/native-taskbar.dev" as tasks
extern fn gtk_widget_get_sensitive(widget:*void):i32
extern fn gtk_widget_get_tooltip_text(widget:*void):*u8
extern fn g_free(value:*void)
extern fn rd_widget_live_count():i64
fn tooltip(context:*ui.Context,name:str):ui.Text {unsafe {let value=gtk_widget_get_tooltip_text(ui.find(context,name));let bytes=Vec<u8>();if value!=null {let i=0;while value[i]!=0 {bytes.push(value[i]);i=i+1};g_free(value as *void)};return ui.Text(bytes)}}
fn App(context:*ui.Context):ui.Node {
    let phase=ui.useRef(context,0);let ticks=ui.useRef(context,0)
    let node=tasks.Bar(context,false,16,2,fn() {unsafe {ui.rd_fail("Native picker transport failed")}})
    ui.useEffect(context,fn():fn():void {unsafe {
        let callback=callback_context(fn() {unsafe {
            ticks.set(ticks.get()+1);if ticks.get()>400 {ui.rd_fail("Timed out waiting for native picker")}
            if phase.get()==0 && ui.find(context,"panel-task-1")!=null {phase.set(1);ui.click(context,"panel-task-1")}
            else if phase.get()==1 && ui.find(context,"panel-window-maximize-2")!=null {phase.set(2);ui.click(context,"panel-window-maximize-2")}
            else if phase.get()==2 && ui.equalText(tooltip(context,"panel-window-maximize-2"),ui.text("Restore size")) {phase.set(3);ui.click(context,"panel-window-minimize-2")}
            else if phase.get()==3 && gtk_widget_get_sensitive(ui.find(context,"panel-window-minimize-2"))==0 {phase.set(4);ui.click(context,"panel-window-maximize-2")}
            else if phase.get()==4 && ui.equalText(tooltip(context,"panel-window-maximize-2"),ui.text("Maximize")) {phase.set(5);ui.click(context,"panel-window-close-1")}
            else if phase.get()==5 && ui.find(context,"panel-window-close-1")==null {phase.set(6);if ui.find(context,"panel-task-2")==null || !ui.click(context,"panel-window-minimize-2") {ui.rd_fail("Picker lost Restore control after anchor changed")}}
            else if phase.get()==6 && ui.find(context,"panel-task-picker")==null {ui.close(context)}
        }})
        let timer=tasks.panel_timer(25,callback.call,callback.data);return fn() {unsafe {tasks.panel_untimer(timer,callback.data)}}
    }},Vec<i64>())
    return node
}
fn main():i32 {if !ui.run("Native taskbar picker test",640,64,App) {return 1};unsafe {if rd_widget_live_count()!=0 {ui.rd_fail("Picker leaked native widgets")}};print("PASS native picker actions, live state, removal and cleanup");return 0}
return main()
