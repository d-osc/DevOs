use "react_devlang/ui" as ui
use "../../src/system/org.devos.background/native-view.devx" as view
use "../../src/system/org.devos.background/native-widget-board.dev" as board
use "../../src/system/org.devos.background/native-shell.dev" as shell
use "../../src/system/org.devos.background/scene.dev" as scene
extern fn g_file_set_contents(path:str,value:*u8,length:i64,error:*void):i32
extern fn g_file_test(path:str,flags:i32):i32
extern fn rd_widget_live_count():i64
fn mark(path:str) {unsafe {let value=ui.nativeText(ui.text("ok"));if g_file_set_contents(path,value,2,null)==0 {ui.rd_fail("Cannot write shell test marker")};ui.rd_buffer_free(value as *void)}}
fn main():i32 {unsafe {
    let base=view.rc_env("DEVOS_BACKGROUND_SHELL_TEST");let cache=scene.cache();let frame=view.Frame(0,0,0,0,-1,-1,0,-1,-1,-1,-1);let painter=&cache;let image=&frame;let photo=view.bg_picture_new();let complete=0;let accepted=&complete
    let ok=ui.runStyled("Native shell state test",800,600,board.previewCss(),fn(context:*ui.Context):ui.Node {
        let stage=ui.useRef(context,0);let ticks=ui.useRef(context,0);let saved=ui.useRef(context,0);let paused=ui.useRef(context,0)
        let controls=board.useBoard(context,"desktop-widgets",board.configuration(ui.text("{\"widgetClock\":true,\"style\":\"radar\"}"),ui.emptyText()),fn(value:ui.Text) {})
        shell.useShell(context,controls,0)
        ui.useEffect(context,fn():fn():void {paused.set(controls.paused ? 1 : 0);return ui.noop},Vec<i64>(controls.paused ? 1 : 0))
        ui.useEffect(context,fn():fn():void {unsafe {
            let callback=callback_context(fn() {unsafe {
                let mounted=ui.find(context,"desktop-widget-clock")!=null
                ticks.set(ticks.get()+1);if ticks.get()>240 {ui.rd_fail("Shell state timeout at stage ${stage.get()}, style ${(*image).style}, revision ${(*image).revision}, paused ${paused.get()}, clock ${mounted}")}
                let clock=ui.find(context,"desktop-widget-clock");let current=stage.get()
                if current==0 && clock!=null && (*image).revision>3 {mark("${base}/cover");stage.set(1);ticks.set(0);return}
                if current==1 && paused.get()==1 {saved.set((*image).revision);stage.set(2);ticks.set(0);return}
                if current==2 && ticks.get()>12 {
                    if (*image).revision!=saved.get() {ui.rd_fail("Covered wallpaper kept animating")}
                    mark("${base}/uncover");stage.set(3);ticks.set(0);return
                }
                if current==3 && paused.get()==0 && (*image).revision>saved.get() {mark("${base}/second");stage.set(4);ticks.set(0);return}
                if current==4 && clock==null {mark("${base}/first");stage.set(5);ticks.set(0);return}
                if current==5 && clock!=null {mark("${base}/disconnect");stage.set(6);ticks.set(0);return}
                if current==6 && clock==null {stage.set(7);ticks.set(0);return}
                if current==7 && clock!=null && g_file_test("${base}/reconnected",16)!=0 {(*accepted)=1;ui.close(context)}
            }})
            let timer=view.bg_timer(25,callback.call,callback.data);return fn() {unsafe {view.bg_untimer(timer,callback.data)}}
        }},Vec<i64>())
        let overlay=ui.named("desktop-widgets");overlay.expand=true
        return ui.Overlay(overlay,view.AppWithRuntime(context,painter,image,photo,true,controls.appearance,controls.appearanceRevision,controls.paused,controls.interval))
    })
    if frame.surface!=0 {scene.cairo_surface_destroy(frame.surface as *void)};scene.freeCache(&cache);view.bg_picture_free(photo)
    if !ok || complete!=1 || rd_widget_live_count()!=0 {return 1}
    print("PASS native tracker transport, covered animation pause/resume, live desktops, reconnect and cleanup");return 0
}}
return main()
