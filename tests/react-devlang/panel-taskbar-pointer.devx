use "react_devlang/ui" as ui
use "../../src/system/org.devos.panel/native-taskbar.dev" as tasks
extern fn panel_test_pointer(root:*void,name:str,kind:i32):i32
extern fn gtk_popover_get_modal(widget:*void):i32
extern fn gtk_widget_get_style_context(widget:*void):*void
extern fn gtk_style_context_has_class(style:*void,name:str):i32
extern fn rd_widget_live_count():i64
fn App(context:*ui.Context):ui.Node {
    let phase=ui.useRef(context,0);let since=ui.useRef(context,0);let ticks=ui.useRef(context,0)
    let node=tasks.Bar(context,false,16,2,fn() {unsafe {ui.rd_fail("Pointer taskbar transport failed")}})
    ui.useEffect(context,fn():fn():void {unsafe {
        let callback=callback_context(fn() {unsafe {
            ticks.set(ticks.get()+1);if ticks.get()>500 {ui.rd_fail("Timed out testing pointer lifecycle")};let now=tasks.panel_now();let elapsed=now-since.get();let popup=ui.find(context,"panel-task-picker")
            if phase.get()==0 && ui.find(context,"panel-task-1")!=null {phase.set(1);since.set(now);panel_test_pointer((*context).native,"panel-task-1",0)}
            else if phase.get()==1 && elapsed>=150 {if popup!=null {ui.rd_fail("Hover opened before delay")};panel_test_pointer((*context).native,"panel-task-1",1);phase.set(2);since.set(now)}
            else if phase.get()==2 && elapsed>=500 {if popup!=null {ui.rd_fail("Cancelled hover opened later")};panel_test_pointer((*context).native,"panel-task-1",0);phase.set(3);since.set(now)}
            else if phase.get()==3 && popup!=null {if elapsed<350 || gtk_popover_get_modal(popup)!=0 {ui.rd_fail("Hover delay or nonmodal preview changed")};panel_test_pointer((*context).native,"panel-task-1",1);panel_test_pointer((*context).native,"panel-task-picker",0);panel_test_pointer((*context).native,"panel-task-picker",2);phase.set(4);since.set(now)}
            else if phase.get()==4 && elapsed>=400 {if popup==null {ui.rd_fail("Crossing into picker closed it")};panel_test_pointer((*context).native,"panel-task-picker",1);phase.set(5);since.set(now)}
            else if phase.get()==5 && elapsed>=350 {if popup!=null {ui.rd_fail("Hover leave failed to close")};panel_test_pointer((*context).native,"panel-task-1",0);phase.set(6)}
            else if phase.get()==6 && popup!=null {if panel_test_pointer((*context).native,"panel-task-1",3)!=1 {ui.rd_fail("Context press was not consumed")};phase.set(7);since.set(now)}
            else if phase.get()==7 && elapsed>=100 {if popup==null || gtk_popover_get_modal(popup)==0 {ui.rd_fail("Context did not promote the existing hover picker")};panel_test_pointer((*context).native,"panel-task-picker",1);phase.set(8);since.set(now)}
            else if phase.get()==8 && elapsed>=350 {if popup==null {ui.rd_fail("Context picker used hover dismissal")};panel_test_pointer((*context).native,"panel-task-1",4);ui.click(context,"panel-task-1");phase.set(9)}
            else if phase.get()==9 && popup==null {let widget=ui.find(context,"panel-task-1");if gtk_style_context_has_class(gtk_widget_get_style_context(widget),"task-minimized")!=0 {panel_test_pointer((*context).native,"panel-task-1",0);ui.close(context)}}
        }})
        let timer=tasks.panel_timer(25,callback.call,callback.data);return fn() {unsafe {tasks.panel_untimer(timer,callback.data)}}
    }},Vec<i64>())
    return node
}
fn main():i32 {if !ui.run("Native pointer taskbar",640,64,App) {return 1};unsafe {if rd_widget_live_count()!=0 {ui.rd_fail("Pointer popup leaked widgets")}};print("PASS pointer hover, cancellation, child crossing, context and teardown");return 0}
return main()
