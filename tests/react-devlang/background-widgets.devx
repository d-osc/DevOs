use "react_devlang/ui" as ui
use "../../src/system/org.devos.background/native-widget-board.dev" as board
use "../../src/system/org.devos.background/native-view.devx" as host
use "../../src/system/org.devos.background/scene.dev" as s
use "../../src/system/org.devos.background/native-theme.dev" as theme
extern fn rd_window(root:*void):*void
extern fn gtk_layer_set_layer(window:*void,layer:i32)
extern fn bg_menu_visible_count():i32
extern fn gtk_widget_get_mapped(widget:*void):i32
extern fn gtk_widget_translate_coordinates(widget:*void,target:*void,x:i32,y:i32,tx:*i32,ty:*i32):i32
extern fn gtk_widget_get_margin_start(widget:*void):i32
extern fn gtk_widget_get_margin_top(widget:*void):i32
extern fn g_file_set_contents(path:str,value:*u8,length:i64,error:*void):i32
extern fn bg_flush_stdout()
extern fn bg_card_unmap_count():i32
fn write(path:str,value:ui.Text) {unsafe {let bytes=ui.nativeText(value);if g_file_set_contents(path,bytes,value.bytes.len() as i64,null)==0 {ui.rd_fail("Cannot write native widget marker")};ui.rd_buffer_free(bytes as *void)}}
fn main():i32 {unsafe {
    let base=host.rc_env("DEVOS_BACKGROUND_WIDGET_TEST");if ui.text(base).bytes.len()==0 {return 1}
    let preferences=ui.text(host.rc_env("DEVOS_BACKGROUND_PREFERENCES"))
    let started=0;let accepted=&started
    let ok=ui.runStyled("Native widget test",800,600,board.previewCss(),fn(context:*ui.Context):ui.Node {
        theme.useTheme(context)
        let ready=ui.useRef(context,0)
        # Keep the pointer fixture above the private shell's existing wallpaper,
        # whose asynchronous startup must not cover this test's input surface.
        ui.useEffect(context,fn():fn():void {unsafe {if host.bg_prepare((*context).native,1,0)==0 {ui.rd_fail("Native widget test needs layer-shell")};gtk_layer_set_layer(rd_window((*context).native),2);return ui.noop}},Vec<i64>())
        let controls=board.useDesktop(context,"desktop-widgets",board.configuration(ui.text("{\"widgetClock\":true,\"widgetDate\":true,\"widgetNote\":true,\"widgetPosition\":\"left\",\"widgetNoteText\":\"Native note\\nภาษาไทย %\"}"),preferences),fn(value:ui.Text) {write("${base}/committed.json",value)},fn(value:ui.Text) {write("${base}/action.json",value)})
        ui.useEffect(context,fn():fn():void {unsafe {
            let callback=callback_context(fn() {unsafe {
                let clock=ui.find(context,"desktop-widget-clock");let grip=ui.find(context,"desktop-widget-clock-grip")
                if ready.get()==5 && bg_menu_visible_count()==1 {write("${base}/menu-ready",ui.text("ok"));ready.set(6)}
                if ready.get()==2 && clock==null {
                    controls.selectDesktop(ui.text("[{\"name\":\"One\",\"active\":false},{\"name\":\"Two\",\"active\":true}]"));ready.set(3);return
                }
                if ready.get()==3 && ui.find(context,"desktop-widget-note")==null {
                    controls.selectDesktop(ui.text("[{\"name\":\"One\",\"active\":true},{\"name\":\"Two\",\"active\":false}]"));ready.set(4);return
                }
                if ready.get()==4 && ui.find(context,"desktop-widget-note")!=null {write("${base}/desktop-ready",ui.text("ok"));ready.set(5);return}
                if ready.get()==1 && clock!=null && gtk_widget_get_margin_start(clock)==224 && gtk_widget_get_margin_top(clock)==180 {
                    if bg_card_unmap_count()!=0 {ui.rd_fail("Dragging unmapped a native widget")}
                    let remove=ui.find(context,"desktop-widget-clock-remove");let x=0 as i32;let y=0 as i32
                    gtk_widget_translate_coordinates(remove,rd_window((*context).native),ui.gtk_widget_get_allocated_width(remove)/2,ui.gtk_widget_get_allocated_height(remove)/2,&x,&y)
                    write("${base}/remove-ready",ui.text("${x} ${y}"));ready.set(2)
                }
                if ready.get()!=0 || clock==null || grip==null || gtk_widget_get_mapped(grip)==0 || gtk_widget_get_margin_start(clock)!=24 {return}
                let x=0 as i32;let y=0 as i32
                if gtk_widget_translate_coordinates(grip,rd_window((*context).native),10,8,&x,&y)==0 {return}
                write("${base}/drag-ready",ui.text("${x} ${y}"));ready.set(1);(*accepted)=1
            }})
            let timer=host.bg_timer(25,callback.call,callback.data);return fn() {unsafe {host.bg_untimer(timer,callback.data)}}
        }},Vec<i64>())
        let area=ui.props();area.expand=true;let canvas=ui.DrawingArea(area,fn(cr:*void,w:i32,h:i32) {unsafe {s.cairo_set_source_rgb(cr,0.04,0.05,0.07);s.cairo_paint(cr)}})
        let overlay=ui.named("desktop-widgets");overlay.expand=true;return ui.Overlay(overlay,canvas)
    })
    return ok && started==1 ? 0 : 1
}}
return main()
