use "react_devlang/ui" as ui
use "react_devlang/channel" as channel
use "../../src/system/org.devos.background/native-view.devx" as view
use "../../src/system/org.devos.background/native-widget-board.dev" as board
use "../../src/system/org.devos.background/native-preferences.dev" as preferences
use "../../src/system/org.devos.background/scene.dev" as s
extern fn g_file_set_contents(path:str,contents:*u8,length:i64,error:*void):i32
extern fn bg_card_unmap_count():i32
extern fn rd_widget_live_count():i64
fn save(file:str,values:ui.Text) {unsafe {
    let text=ui.concatText(Vec<ui.Text>(ui.text("{\"version\":1,\"enabled\":true,\"values\":{"),ui.text("\"widgetClock\":true,"),values,ui.text("}}")));let bytes=ui.nativeText(text)
    if g_file_set_contents(file,bytes,text.bytes.len() as i64,null)==0 {ui.rd_fail("Cannot update preferences fixture")};ui.rd_buffer_free(bytes as *void)
}}
fn pixel(frame:*view.Frame,corner:bool):u32 {unsafe {
    let surface=(*frame).surface as *void;s.cairo_surface_flush(surface);let data=s.cairo_image_surface_get_data(surface) as *u32;let stride=(s.cairo_image_surface_get_stride(surface)/4) as i64
    # Sample inside the scaled image, away from Cairo's antialiased outer edge.
    let x=corner ? 32 : ((*frame).width/2) as i64;let y=corner ? 32 : ((*frame).height/2) as i64
    return data[y*stride+x]&16777215
}}
fn main():i32 {unsafe {
    let file=view.rc_env("DEVOS_BACKGROUND_PREFERENCES");let imagePath="${file}.ไทย%.png"
    let surface=s.cairo_image_surface_create(0,32,16);let pen=s.cairo_create(surface);s.rgb(pen,s.Color(0.0,0.8,0.4));s.cairo_paint(pen)
    if s.cairo_surface_write_to_png(surface,imagePath)!=0 {return 1};s.cairo_destroy(pen);s.cairo_surface_destroy(surface)
    let cache=s.cache();let frame=view.Frame(0,0,0,0,-1,-1,0,-1,-1,-1,-1);let painter=&cache;let image=&frame;let photo=view.bg_picture_new();let complete=0;let accepted=&complete
    let ok=ui.runStyled("Native preferences test",800,600,board.previewCss(),fn(context:*ui.Context):ui.Node {
        let stage=ui.useRef(context,0);let ticks=ui.useRef(context,0);let card=ui.useRef(context,0)
        let controls=board.useBoard(context,"desktop-widgets",board.configuration(ui.text("{}"),ui.text(file)),fn(value:ui.Text) {})
        preferences.useWatch(context,ui.text(file),controls.refresh)
        ui.useEffect(context,fn():fn():void {unsafe {
            let callback=callback_context(fn() {unsafe {
                ticks.set(ticks.get()+1);if ticks.get()>120 {ui.rd_fail("Live preferences timeout at phase ${stage.get()}, mode ${(*image).mode}, style ${(*image).style}, fit ${(*image).fit}, pixel ${pixel(image,true)}")}
                let widget=ui.find(context,"desktop-widget-clock");if widget==null || (*image).surface==0 {return}
                if card.get()!=0 && (card.get()!=(widget as i64) || bg_card_unmap_count()!=0) {ui.rd_fail("Wallpaper change remounted a widget")}
                let current=stage.get()
                if current==0 && (*image).mode==1 && (*image).style==17 && (*image).fit==2 && pixel(image,true)==1122867 {
                    card.set(widget as i64);save(file,ui.text("\"mode\":\"solid\",\"style\":\"meteors\",\"fit\":\"stretch\",\"useDesktopColor\":false,\"color\":\"#445566\""));stage.set(1);ticks.set(0);return
                }
                if current==1 && (*image).mode==1 && pixel(image,true)==4478310 {
                    let path=channel.quote(ui.text(imagePath));save(file,ui.concatText(Vec<ui.Text>(ui.text("\"mode\":\"picture\",\"fit\":\"contain\",\"useDesktopColor\":false,\"color\":\"#445566\",\"imagePath\":"),path)));stage.set(2);ticks.set(0);return
                }
                if current==2 && (*image).mode==2 && (*image).fit==1 && pixel(image,true)==4478310 && pixel(image,false)==52326 {
                    let path=channel.quote(ui.text(imagePath));save(file,ui.concatText(Vec<ui.Text>(ui.text("\"mode\":\"picture\",\"fit\":\"stretch\",\"imagePath\":"),path)));stage.set(3);ticks.set(0);return
                }
                if current==3 && (*image).mode==2 && (*image).fit==2 && pixel(image,true)==52326 {
                    save(file,ui.text("\"mode\":\"design\",\"style\":\"radar\""));stage.set(4);ticks.set(0);return
                }
                if current==4 && (*image).mode==0 && (*image).style==22 {
                    save(file,ui.text("\"mode\":\"design\",\"style\":\"dunes\""));stage.set(5);ticks.set(0);return
                }
                if current==5 && (*image).mode==0 && (*image).style==0 {(*accepted)=1;ui.close(context)}
            }})
            let timer=view.bg_timer(25,callback.call,callback.data);return fn() {unsafe {view.bg_untimer(timer,callback.data)}}
        }},Vec<i64>())
        let overlay=ui.named("desktop-widgets");overlay.expand=true
        return ui.Overlay(overlay,view.AppWithAppearance(context,painter,image,photo,true,controls.appearance,controls.appearanceRevision))
    })
    if frame.surface!=0 {s.cairo_surface_destroy(frame.surface as *void)};s.freeCache(&cache);view.bg_picture_free(photo)
    if !ok || complete!=1 || rd_widget_live_count()!=0 {return 1}
    print("PASS live service preferences, color cache, picture path and fit, design styles, stable widgets and cleanup");return 0
}}
return main()
