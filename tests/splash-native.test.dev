use "std/test"
use "std/fs"
use "std/json"
use "../lib/splash-model.dev" as scene
use "../src/system/splash-font.dev" as font
use "./lib/react-devlang.dev" as t
test.case("layout matches original scale clamps and text placement",fn() {
    let small=scene.layout(320.0,240.0);test.expect(small.u==0.5 && small.stroke==2.5,"Small display clamp changed")
    let full=scene.layout(1920.0,1080.0);test.expect(full.u==1.0 && full.cx==960.0 && full.cy==460.0 && full.word==598.0 && full.line==668.0,"Original 1080p layout changed")
    test.expect(scene.layout(12000.0,8000.0).u==3.0,"Large display clamp changed")
})
test.case("spinner repeats every 4.8 seconds and fade lasts 300 ms",fn() {
    let a=scene.arc(0.8);let b=scene.arc(5.6)
    test.expect(scene.max(a.length-b.length,b.length-a.length)<0.0000001,"Spinner period changed")
    test.expect(scene.opacity(2.0,-1.0)==1.0 && scene.opacity(2.15,2.0)>0.49 && scene.opacity(2.15,2.0)<0.51,"Fade midpoint changed")
    test.expect(scene.opacity(2.31,2.0)==0.0,"Fade must finish")
})
test.case("native font contains all 95 original bitmap glyphs",fn() {
    let bytes=font.bytes();test.expect(bytes.len()==475,"Missing glyphs")
    # D, E, V and the question-mark fallback retain the framebuffer shapes.
    test.expect(bytes[(68-32)*5]==0x7f && bytes[(69-32)*5+1]==0x49 && bytes[(86-32)*5+2]==0x40,"Wordmark glyph changed")
    test.expect(bytes[(63-32)*5]==0x02,"Fallback glyph changed")
})
return t.finish()
