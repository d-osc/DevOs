use "std/test"
use "std/fs"
use "std/strings"
use "std/json"
use "../tools/lib/tool.dev" as tool
use "./lib/react-devlang.dev" as t
fn inspect(folder:str) {for name in fs.readdirSync(folder) {let path=folder+"/"+name;if fs.is_dir(path) {inspect(path)}else {for extension in Vec<str>(".js",".ts",".tsx",".jsx") {test.expect(!strings.endsWith(name,extension),"Legacy source remains: "+path)}}}}
test.case("system panel contains no JavaScript or TypeScript and declares a native manager",fn() {
    let folder=t.root()+"/src/system/org.devos.panel";inspect(folder);let manifest=json.parse(tool.read(folder+"/extension.json"));t.equal(json.string(json.get(manifest,"native")),"system-panel");test.expect(!json.has(manifest,"entry") && json.bool(json.get(manifest,"system")),"Panel still loads through the JS extension host")
    for file in Vec<str>("native.devx","runtime.dev","settings-service.dev","native-settings.devx") {test.expect(fs.is_file(folder+"/"+file),"Missing native panel source "+file)}
})
return t.finish()
