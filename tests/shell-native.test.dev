use "std/fs"
use "std/test"
use "std/strings"
use "std/encoding"
use "../tools/lib/tool.dev" as tool
use "./lib/react-devlang.dev" as t
use "std/json"
use "../src/system/org.devos.shell/router.dev" as router
use "../src/system/org.devos.shell/theme.dev" as theme

# The native shell: the command router (what each command asks for), the worker that carries the steps out, and the program that owns the shell's D-Bus
# name without a window. Nothing is started: DEVOS_SHELL_TEST makes the worker log what it would do.
fn us():str { return encoding.decode(Vec<u8>(31),"utf8") }
fn kinds(steps:Vec<router.Step>):str { let out = Vec<str>(); for s in steps { out.push(s.kind + ":" + s.role + ":" + s.command + ":" + s.path) }; return strings.join(out,"|") }
test.case("commands are routed to the app that owns them, settings pages to Settings, and overlays close the others",fn() {
    t.equal(kinds(router.route(Vec<str>("settings"),"/")),"launch:settings:settings:")
    t.equal(kinds(router.route(Vec<str>("wifi"),"/")),"launch:settings:settings.wifi:")
    t.equal(kinds(router.route(Vec<str>("task-manager"),"/")),"launch:taskmanager:task-manager:")
    t.equal(kinds(router.route(Vec<str>("switch-user","alice"),"/")),"launch:settings:session.switch-user:alice")
    t.equal(kinds(router.route(Vec<str>("settings.panel"),"/")),"launch:settings:settings.panel:")
    t.equal(kinds(router.route(Vec<str>("launcher"),"/")),"overlay:task-view:task-view hide:close|overlay:snap-panel:snap-layouts hide:close|overlay:launcher:launcher:open")
    t.equal(kinds(router.route(Vec<str>("task-view-hide"),"/")),"overlay:task-view:task-view hide:close")
    t.equal(kinds(router.route(Vec<str>("overlays-hide"),"/")),"overlay:launcher:launcher hide:close|overlay:task-view:task-view hide:close|overlay:snap-panel:snap-layouts hide:close")
    t.equal(kinds(router.route(Vec<str>("session.quit"),"/")),"quit:::")
    t.equal(kinds(router.route(Vec<str>("terminal"),"/home/u")),"run::terminal:/home/u")
    t.equal(kinds(router.route(Vec<str>("lock"),"/")),"run::lock:/")
    t.equal(kinds(router.route(Vec<str>("screenshot"),"/h")),"run::screenshot:/h")
    t.equal(kinds(router.route(Vec<str>("screenshot-app"),"/h")),"launch:screenshot:screenshot-app:")
    t.equal(kinds(router.route(Vec<str>("browser"),"/")),"launch:browser:browser:")
    t.equal(kinds(router.route(Vec<str>("window-next"),"/")),"gesture::window-next:")
    t.equal(kinds(router.route(Vec<str>("nothing-here"),"/")),"none:::")
    t.equal(kinds(router.route(Vec<str>(),"/")),"none:::")
})
test.case("editor and package paths are made absolute against the caller's folder, file: URIs are read, and no path opens the app",fn() {
    t.equal(kinds(router.route(Vec<str>("editor"),"/w")),"launch:editor:editor:")
    t.equal(kinds(router.route(Vec<str>("editor","a.txt","../b.txt","/c/./d","file:///e/f"),"/w/x")),"launch:editor:editor:/w/x/a.txt|launch:editor:editor:/w/b.txt|launch:editor:editor:/c/d|launch:editor:editor:/e/f")
    t.equal(kinds(router.route(Vec<str>("package-install","p.dpk"),"/w")),"launch:appstore:package-install:/w/p.dpk")
    t.equal(kinds(router.route(Vec<str>("package-install"),"/w")),"launch:appstore:package-install:")
    t.equal(router.appFor("settings.bluetooth"),"settings")
    t.equal(router.appFor("app-store-extensions"),"appstore")
    t.equal(router.appFor("launcher"),"")
})
fn worker(lines:str, log:str):str {
    let env = Map<str,str>(); env.set("DEV_OS_ROOT",t.root()); env.set("DEVOS_SHELL_TEST","1"); env.set("DEVOS_SHELL_LOG",log); env.set("XDG_RUNTIME_DIR","/nonexistent-devos"); env.set("WAYLAND_DISPLAY","wayland-test")
    return t.out(tool.run(Vec<str>("d",t.root() + "/src/system/org.devos.shell/service.dev"),env,lines,120000))
}
test.case("the worker answers one line per command and logs what it would start",fn() {
    let d = strings.trim(tool.exec(Vec<str>("mktemp","-d"))); let log = d + "/log"
    let answer = worker("/w" + us() + "settings.x\n/w" + us() + "settings" + us() + "\n/w" + us() + "logout\n/w" + us() + "editor" + us() + "a.txt\n/w" + us() + "session.quit\n",log)
    let lines = strings.split(strings.trim(answer),"\n")
    test.expect(lines.len() == 5 && strings.equal(lines[0],"V") && strings.equal(lines[1],"V") && strings.equal(lines[4],"Q"),"answers: " + answer)
    let seen = fs.readFileSync(log,"utf8")
    test.expect(strings.contains(seen,"launch settings settings\n") && strings.contains(seen,"launch editor editor /w/a.txt") && strings.contains(seen,"overlay launcher launcher logout open") && strings.contains(seen,"overlay task-view task-view hide close"),"log: " + seen)
    tool.exec(Vec<str>("rm","-rf",d))
})
test.case("the program owns the shell's D-Bus name without a window: commands arrive, an unknown one is refused, and session.quit ends it",fn() {
    let executable = t.root() + "/build/react-devlang/tests/shell-native"
    tool.checked(Vec<str>("sh",t.root() + "/packages/react-devlang/tools/build.sh",t.root() + "/src/system/org.devos.shell/native-main.devx",executable),Map<str,str>(),"",180000)
    let d = strings.trim(tool.exec(Vec<str>("mktemp","-d"))); let log = d + "/log"
    let done = tool.run(Vec<str>("dbus-run-session","--","xvfb-run","-a","sh",t.root() + "/tests/lib/shell-route.sh",executable,t.root(),log),Map<str,str>(),"",120000)
    let out = t.out(done)
    test.expect(strings.contains(out,"ROUTE shell: (0, '')"),"the shell answers: " + out + t.err(done))
    test.expect(strings.contains(out,"ROUTE unknown:") && strings.contains(out,"Unsupported app command"),"an unknown command is refused: " + out)
    test.expect(strings.contains(out,"ROUTE still running") && strings.contains(out,"ROUTE quit ended the shell"),"lifetime: " + out)
    let seen = fs.existsSync(log) ? fs.readFileSync(log,"utf8") : ""
    test.expect(strings.contains(seen,"launch settings settings.wifi") && strings.contains(seen,"overlay launcher launcher open") && strings.contains(seen,"launch editor editor /work/a.txt") && strings.contains(seen,"launch editor editor /tmp/b%20c"),"worker log: " + seen)
    tool.exec(Vec<str>("rm","-rf",d))
})
test.case("window gestures read the tracker and bring the next, previous or last minimized window of the current desktop forward",fn() {
    let d = strings.trim(tool.exec(Vec<str>("mktemp","-d"))); let log = d + "/log"; let trackerLog = d + "/tracker"
    let env = Map<str,str>(); env.set("DEV_OS_ROOT",t.root()); env.set("DEVOS_SHELL_TEST","1"); env.set("DEVOS_SHELL_LOG",log); env.set("DEVOS_SHELL_TRACKER",t.root() + "/tests/lib/fake-tracker.sh"); env.set("DEVOS_TRACKER_LOG",trackerLog)
    let answer = t.out(tool.run(Vec<str>("d",t.root() + "/src/system/org.devos.shell/service.dev"),env,"/w" + us() + "window-next\n/w" + us() + "window-previous\n/w" + us() + "window-restore\n",120000))
    test.expect(strings.equal(strings.trim(answer),"V\nV\nV"),"answers: " + answer)
    let seen = fs.readFileSync(log,"utf8")
    test.expect(strings.contains(seen,"gesture next activate 12") && strings.contains(seen,"gesture previous activate 12") && strings.contains(seen,"gesture restore activate 12"),"log: " + seen)
    test.expect(fs.existsSync(trackerLog) && strings.contains(fs.readFileSync(trackerLog,"utf8"),"activate 12"),"the tracker was sent activate 12")
    tool.exec(Vec<str>("rm","-rf",d))
})
test.case("the theme choice resolves Auto by the clock and the schedule, and unknown values mean Auto",fn() {
    let none = json.parse("{}")
    t.equal(theme.resolve(theme.choice(none),"12:00"),"light")
    t.equal(theme.resolve(theme.choice(none),"19:00"),"dark")
    t.equal(theme.resolve(theme.choice(none),"06:59"),"dark")
    let fixed = json.parse("{\"mode\":\"dark\",\"family\":\"github\"}")
    t.equal(theme.resolve(theme.choice(fixed),"12:00"),"dark"); t.equal(theme.choice(fixed).family,"github")
    let custom = json.parse("{\"mode\":\"auto\",\"lightFrom\":\"09:30\",\"darkFrom\":\"21:15\"}")
    t.equal(theme.resolve(theme.choice(custom),"09:29"),"dark"); t.equal(theme.resolve(theme.choice(custom),"09:30"),"light"); t.equal(theme.resolve(theme.choice(custom),"21:15"),"dark")
    let wrapped = json.parse("{\"lightFrom\":\"22:00\",\"darkFrom\":\"06:00\"}")
    t.equal(theme.resolve(theme.choice(wrapped),"23:00"),"light"); t.equal(theme.resolve(theme.choice(wrapped),"12:00"),"dark")
    t.equal(theme.resolve(theme.choice(json.parse("{\"mode\":\"plum\"}")),"12:00"),"dark")
    t.equal(theme.resolve(theme.choice(json.parse("{\"mode\":\"nonsense\",\"lightFrom\":\"25:00\"}")),"12:00"),"light")
})
test.case("the worker writes the chosen theme to the shared file the native windows follow, and only when it changes",fn() {
    let d = strings.trim(tool.exec(Vec<str>("mktemp","-d"))); fs.mkdirSync(d + "/prefs",false); fs.mkdirSync(d + "/run",false)
    let env = Map<str,str>(); env.set("DEV_OS_ROOT",t.root()); env.set("DEVOS_SHELL_TEST","1"); env.set("DEVOS_SHELL_LOG",d + "/log"); env.set("DEVOS_PREFERENCES_DIR",d + "/prefs"); env.set("XDG_RUNTIME_DIR",d + "/run"); env.set("DEVOS_SHELL_CLOCK","20:30")
    let line = "/" + us() + "devos.theme-sync\n"
    t.out(tool.run(Vec<str>("d",t.root() + "/src/system/org.devos.shell/service.dev"),env,line + line,120000))
    let written = fs.readFileSync(d + "/run/devos-native-theme.css","utf8")
    test.expect(strings.startsWith(written,"/* devos-theme:dark */") && strings.equal(written,fs.readFileSync(t.root() + "/dist/native/theme.vscode.dark.css","utf8")),"Auto at 20:30 is the dark vscode theme")
    let notes = fs.readFileSync(d + "/log","utf8")
    test.expect(strings.equal(notes,"theme vscode dark\n"),"written once: " + notes)
    fs.writeFileSync(d + "/prefs/org.devos.theme.json","{\"enabled\":true,\"values\":{\"mode\":\"light\",\"family\":\"github\"},\"version\":2}")
    t.out(tool.run(Vec<str>("d",t.root() + "/src/system/org.devos.shell/service.dev"),env,line,120000))
    test.expect(strings.startsWith(fs.readFileSync(d + "/run/devos-native-theme.css","utf8"),"/* devos-theme:light */") && strings.contains(fs.readFileSync(d + "/log","utf8"),"theme github light"),"the saved choice is followed")
    tool.exec(Vec<str>("rm","-rf",d))
})
return t.finish()
