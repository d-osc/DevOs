use "std/test"
use "std/json"
use "std/fs"
use "std/strings"
use "../lib/theme-palette.dev" as palette
use "./lib/react-devlang.dev" as t
test.case("alpha colors preserve JS compositing and GTK rounding",fn() {
    t.equal(palette.flatten("#ffffff80","#000000"),"#808080")
    t.equal(palette.flatten("#12345600","#abcdef"),"#abcdef")
    t.equal(palette.flatten("#AbCdEf","#000000"),"#abcdef")
    t.equal(palette.rgba("#11223380"),"rgba(17, 34, 51, 0.502)")
    t.equal(palette.rgba("#fff"),"rgba(255, 255, 255, 1)")
})
test.case("the generated palette data is what data/themes/palettes.json holds (native shell and Monaco page read it)",fn() {
    let data=palette.generate(t.root())
    t.equal(json.stringify(data),json.stringify(json.parse(fs.readFileSync(t.root()+"/data/themes/palettes.json","utf8"))))
    for name in Vec<str>("familyPalettes","paletteSources","syntaxRules") { test.expect(json.has(data,name),"Missing " + name) }
})
return t.finish()
