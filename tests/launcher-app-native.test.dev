use "std/fs"
use "std/test"
use "std/strings"
use "std/encoding"
use "../tools/lib/tool.dev" as tool
use "./lib/react-devlang.dev" as t

# The native Launcher: its worker lists desktop entries with the same visibility rules as GIO and writes the preferences, and its window is run
# under Xvfb against a private set of entries (searching, launching and the view switch). Nothing is launched and no shell command is sent (DEVOS_LAUNCHER_TEST).
fn rs():str { return encoding.decode(Vec<u8>(30),"utf8") }
fn rig():str {
    let d = strings.trim(tool.exec(Vec<str>("mktemp","-d")))
    fs.mkdirSync(d + "/u",false); fs.mkdirSync(d + "/u/applications",false); fs.mkdirSync(d + "/s",false); fs.mkdirSync(d + "/s/applications",false); fs.mkdirSync(d + "/prefs",false)
    fs.writeFileSync(d + "/s/applications/zed.desktop","[Desktop Entry]\nType=Application\nName=Zed Editor\nName[th]=ซี\nComment=Edit text\nExec=zed %F\nIcon=zed\nKeywords=code;ide;\n")
    fs.writeFileSync(d + "/s/applications/alpha.desktop","[Desktop Entry]\nType=Application\nName=Alpha\nExec=alpha\n")
    fs.writeFileSync(d + "/s/applications/hidden.desktop","[Desktop Entry]\nType=Application\nName=Hidden one\nExec=h\nNoDisplay=true\n")
    fs.writeFileSync(d + "/s/applications/mask.desktop","[Desktop Entry]\nType=Application\nName=Masked\nExec=m\n")
    fs.writeFileSync(d + "/u/applications/mask.desktop","[Desktop Entry]\nType=Application\nName=Masked\nExec=m\nHidden=true\n")
    fs.writeFileSync(d + "/s/applications/tool.desktop","[Desktop Entry]\nType=Application\nName=Needs a tool\nExec=x\nTryExec=no-such-tool-xyz\n")
    return d
}
fn env(d:str):Map<str,str> {
    let e = Map<str,str>(); e.set("DEV_OS_ROOT",t.root()); e.set("DEVOS_LAUNCHER_TEST","1"); e.set("DEVOS_LAUNCHER_DATA_DIRS",d + "/u:" + d + "/s"); e.set("DEVOS_PREFERENCES_DIR",d + "/prefs")
    e.set("PATH","/home/ondev/.local/bin:/usr/local/bin:/usr/bin:/bin"); e.set("XDG_CURRENT_DESKTOP","DevOS")
    return e
}
fn worker(d:str, input:str):Vec<str> {
    let ran = tool.run(Vec<str>("d",t.root() + "/src/system/org.devos.launcher/service.dev"),env(d),input,120000)
    return strings.split(strings.trim(t.out(ran)),"\n")
}
fn apps(frame:str):Vec<str> {
    let names = Vec<str>()
    for record in strings.split(frame,rs()) { if strings.startsWith(record,"A\t") { names.push(strings.split(record,"\t")[2]) } }
    return names
}
test.case("the worker lists the entries GIO would show, sorted by name, with the user's hidden entry masking the system one",fn() {
    let d = rig()
    let lines = worker(d,"{\"action\":\"start\"}\n")
    let shown = apps(lines[0])
    test.expect(shown.len() == 2 && strings.equal(shown[0],"Alpha") && strings.equal(shown[1],"Zed Editor"),"shown apps: " + strings.join(shown,","))
    test.expect(strings.contains(lines[0],"S\t600\t28\t0\t1\t1\t0\tlist") && strings.contains(lines[0],"W\tbuiltin:terminal"),"defaults: " + lines[0])
    test.expect(strings.contains(lines[0],"code ide"),"keywords are searchable")
    tool.exec(Vec<str>("rm","-rf",d))
})
test.case("saving writes the app view and the workspace and keeps every other value",fn() {
    let d = rig()
    let lines = worker(d,"{\"action\":\"save\",\"appView\":\"grid\",\"workspace\":[\"builtin:files\",\"app:zed.desktop\"]}\n{\"action\":\"shell\",\"command\":\"rm\"}\n{\"action\":\"launch\",\"id\":\"\",\"file\":\"\"}\n{\"action\":\"request\",\"what\":\"explode\"}\n")
    test.expect(strings.contains(lines[0],"\tgrid") && strings.contains(lines[0],"W\tbuiltin:files" + rs() + "W\tapp:zed.desktop"),"saved: " + lines[0])
    test.expect(strings.contains(fs.readFileSync(d + "/prefs/org.devos.launcher.json","utf8"),"\"menuWidth\":600"),"other values kept")
    test.expect(strings.equal(lines[1],"E\tUnsupported command"),"only known shell commands: " + lines[1])
    test.expect(strings.equal(lines[2],"E\tChoose an application."),"launch needs an app: " + lines[2])
    test.expect(strings.startsWith(lines[3],"E\t"),"an unknown power action is refused: " + lines[3])
    tool.exec(Vec<str>("rm","-rf",d))
})
test.case("the native Launcher window searches, launches the result and switches to the grid under real GTK",fn() {
    let d = rig()
    let executable = t.root() + "/build/react-devlang/tests/launcher-native"
    tool.checked(Vec<str>("sh", t.root() + "/packages/react-devlang/tools/build.sh", t.root() + "/src/system/org.devos.launcher/native-main.devx", executable), Map<str,str>(), "", 240000)
    let e = env(d); e.set("DEVOS_LAUNCHER_SMOKE","1"); e.set("DEVOS_LAUNCHER_QUERY","zed"); e.set("NO_AT_BRIDGE","1")
    let done = tool.run(Vec<str>("sh","-c","ulimit -c 0; exec \"$@\"","launcher-native","xvfb-run","-a",executable),e,"",120000)
    test.expect(done.success && strings.contains(t.out(done),"PASS native Launcher listed, searched, launched and switched view"),"Launcher: " + t.out(done) + " / " + t.err(done))
    test.expect(strings.contains(fs.readFileSync(d + "/prefs/org.devos.launcher.json","utf8"),"\"appView\":\"grid\""),"the view choice is stored")
    tool.exec(Vec<str>("rm","-rf",d))
})
test.case("the commands the shell sends reach the running window: logout asks for the confirmation, launcher toggles it closed",fn() {
    let executable = t.root() + "/build/react-devlang/tests/launcher-native"
    let done = tool.run(Vec<str>("dbus-run-session","--","xvfb-run","-a","sh",t.root() + "/tests/lib/launcher-route.sh",executable,t.root()),Map<str,str>(),"",120000)
    let out = t.out(done)
    test.expect(strings.contains(out,"ROUTE logout kept the window open"),"logout: " + out + t.err(done))
    test.expect(strings.contains(out,"ROUTE unknown:") && strings.contains(out,"Unsupported app command"),"a command that is not the launcher's is refused: " + out)
    test.expect(strings.contains(out,"ROUTE toggle closed the window"),"toggle: " + out)
})
fn taskServiceFrame(input:str):Vec<str> {
    let e = Map<str,str>(); e.set("DEV_OS_ROOT",t.root())
    let ran = tool.run(Vec<str>("d",t.root() + "/src/system/org.devos.launcher/task-service.dev"),e,input,120000)
    return strings.split(strings.trim(t.out(ran)),"\n")
}
test.case("the Task View worker keeps windows and desktops from tracker events and approves only valid commands",fn() {
    let lines = taskServiceFrame("{\"events\":[{\"type\":\"desktop-begin\",\"canCreate\":true,\"canRemove\":true},{\"type\":\"desktop\",\"id\":1,\"name\":\"Workspace 1\",\"active\":true},{\"type\":\"desktop\",\"id\":2,\"name\":\"Mail\",\"active\":false},{\"type\":\"desktop-done\"},{\"type\":\"window\",\"id\":11,\"title\":\"Dev OS Terminal\",\"appId\":\"org.devos.App.terminal.s1\",\"active\":true,\"minimized\":false,\"desktop\":1},{\"type\":\"window\",\"id\":12,\"title\":\"Notes\",\"appId\":\"org.example.notes\",\"active\":false,\"minimized\":true,\"desktop\":2}]}\n{\"action\":\"activate\",\"id\":12}\n{\"action\":\"activate\",\"id\":99}\n{\"action\":\"move\",\"id\":11,\"desktop\":2}\n{\"action\":\"move\",\"id\":11,\"desktop\":7}\n{\"action\":\"remove-desktop\",\"id\":2}\n{\"events\":[{\"type\":\"closed\",\"id\":12}],\"action\":\"close\",\"id\":11}\n")
    test.expect(strings.contains(lines[0],"D\t1\tDesktop 1\t1") && strings.contains(lines[0],"D\t2\tMail\t0"),"desktops: " + lines[0])
    test.expect(strings.contains(lines[0],"W\t11\tDev OS Terminal\tTerminal\tdev-os-terminal-symbolic\t1\t0\t1\t0") && strings.contains(lines[0],"W\t12\tNotes\torg.example.notes"),"windows: " + lines[0])
    test.expect(strings.contains(lines[1],"T\tactivate 12") && !strings.contains(lines[2],"T\t") && strings.contains(lines[3],"T\tmove 11 2") && !strings.contains(lines[4],"T\t"),"commands are checked against the state")
    test.expect(strings.contains(lines[5],"T\tremove-desktop 2") && strings.contains(lines[6],"T\tclose 11") && !strings.contains(lines[6],"W\t12"),"remove, close and the closed event")
})
test.case("the native Task View lists the windows of the current desktop and sends the activate command to the tracker under real GTK",fn() {
    let d = strings.trim(tool.exec(Vec<str>("mktemp","-d")))
    let executable = t.root() + "/build/react-devlang/tests/task-view-native"
    tool.checked(Vec<str>("sh", t.root() + "/packages/react-devlang/tools/build.sh", t.root() + "/src/system/org.devos.launcher/task-view-main.devx", executable), Map<str,str>(), "", 240000)
    let e = Map<str,str>(); e.set("DEV_OS_ROOT",t.root()); e.set("NO_AT_BRIDGE","1"); e.set("PATH","/home/ondev/.local/bin:/usr/local/bin:/usr/bin:/bin")
    e.set("DEVOS_TASKVIEW_SMOKE","1"); e.set("DEVOS_TASKVIEW_ACTIVATE","12"); e.set("DEVOS_TASKVIEW_TRACKER",t.root() + "/tests/lib/fake-tracker.sh"); e.set("DEVOS_TRACKER_LOG",d + "/log")
    let done = tool.run(Vec<str>("sh","-c","ulimit -c 0; exec \"$@\"","task-view-native","xvfb-run","-a",executable),e,"",120000)
    test.expect(done.success && strings.contains(t.out(done),"PASS native Task View listed the windows and sent the command to the tracker"),"Task View: " + t.out(done) + " / " + t.err(done))
    test.expect(fs.existsSync(d + "/log") && strings.contains(fs.readFileSync(d + "/log","utf8"),"activate 12"),"the tracker received the command")
    tool.exec(Vec<str>("rm","-rf",d))
})
test.case("the snap groups are validated, limited by the windows' minimum sizes, persisted, and pruned when a member closes",fn() {
    let d = strings.trim(tool.exec(Vec<str>("mktemp","-d")))
    let g = "\"geometry\":{\"x\":0,\"y\":0,\"width\":500,\"height\":600,\"output\":\"o1\",\"area\":{\"x\":0,\"y\":0,\"width\":1000,\"height\":800},\"region\":\"\",\"minWidth\":200,\"minHeight\":100}"
    let setup = "{\"events\":[{\"type\":\"snap-capability\",\"supported\":true,\"canResize\":true},{\"type\":\"desktop-begin\",\"canCreate\":true,\"canRemove\":true},{\"type\":\"desktop\",\"id\":1,\"name\":\"W 1\",\"active\":true},{\"type\":\"desktop-done\"},{\"type\":\"window\",\"id\":11,\"title\":\"A\",\"appId\":\"a\",\"active\":true,\"minimized\":false,\"desktop\":1},{\"type\":\"window\",\"id\":12,\"title\":\"B\",\"appId\":\"b\",\"active\":false,\"minimized\":false,\"desktop\":1},{\"type\":\"geometry\",\"id\":11," + g + "},{\"type\":\"geometry\",\"id\":12," + g + "}]}\n"
    let requests = setup + "{\"action\":\"arrange\",\"layout\":\"halves\",\"ids\":[11,12]}\n{\"action\":\"arrange\",\"layout\":\"halves\",\"ids\":[11,11]}\n{\"action\":\"arrange\",\"layout\":\"thirds\",\"ids\":[11,12]}\n{\"action\":\"resize-group\",\"id\":1,\"axis\":\"x\",\"index\":0,\"delta\":4000}\n{\"action\":\"resize-group\",\"id\":1,\"axis\":\"x\",\"index\":0,\"delta\":-9000}\n{\"action\":\"restore-group\",\"id\":1}\n"
    let e = Map<str,str>(); e.set("DEV_OS_ROOT",t.root()); e.set("DEVOS_SNAP_STATE",d + "/snap.json")
    let lines = strings.split(strings.trim(t.out(tool.run(Vec<str>("d",t.root() + "/src/system/org.devos.launcher/task-service.dev"),e,requests,120000))),"\n")
    test.expect(strings.contains(lines[1],"G	1	halves	11=devos-half-left,12=devos-half-right	5000	5000") && strings.contains(lines[1],"T	snap 11 devos-half-left") && strings.contains(lines[1],"T	sash 11,0,0,5000,10000 12,5000,0,5000,10000"),"arrange: " + lines[1])
    test.expect(!strings.contains(lines[2],"T	") && !strings.contains(lines[3],"T	"),"the same window twice, or the wrong number of windows, is refused")
    test.expect(strings.contains(lines[4],"G	1	halves	11=devos-half-left,12=devos-half-right	7900") && strings.contains(lines[5],"G	1	halves	11=devos-half-left,12=devos-half-right	2100"),"the divider stops where the 200 px minimum width (plus 10) allows: " + lines[4] + lines[5])
    test.expect(strings.contains(lines[6],"T	desktop 1") && strings.contains(lines[6],"T	snap 12 devos-half-right") && strings.contains(lines[6],"T	sash 11,0,0,2100,10000 12,2100,0,7900,10000"),"restore uses the resized cuts: " + lines[6])
    let again = strings.split(strings.trim(t.out(tool.run(Vec<str>("d",t.root() + "/src/system/org.devos.launcher/task-service.dev"),e,"{\"events\":[{\"type\":\"window\",\"id\":11,\"title\":\"A\",\"appId\":\"a\",\"active\":true,\"minimized\":false,\"desktop\":1},{\"type\":\"window\",\"id\":12,\"title\":\"B\",\"appId\":\"b\",\"active\":false,\"minimized\":false,\"desktop\":1}]}\n{\"events\":[{\"type\":\"closed\",\"id\":12}]}\n",120000))),"\n")
    test.expect(strings.contains(again[0],"G	1	halves") && !strings.contains(again[1],"G	"),"a new worker process still knows the group, and a closed member removes it: " + again[0] + again[1])
    tool.exec(Vec<str>("rm","-rf",d))
})
test.case("the native Snap window arranges two windows: the tracker is sent snap, activate and sash under real GTK",fn() {
    let d = strings.trim(tool.exec(Vec<str>("mktemp","-d")))
    let executable = t.root() + "/build/react-devlang/tests/snap-panel-native"
    tool.checked(Vec<str>("sh", t.root() + "/packages/react-devlang/tools/build.sh", t.root() + "/src/system/org.devos.launcher/snap-panel-main.devx", executable), Map<str,str>(), "", 240000)
    let e = Map<str,str>(); e.set("DEV_OS_ROOT",t.root()); e.set("NO_AT_BRIDGE","1"); e.set("PATH","/home/ondev/.local/bin:/usr/local/bin:/usr/bin:/bin")
    e.set("DEVOS_SNAP_SMOKE","1"); e.set("DEVOS_SNAP_STATE",d + "/snap.json"); e.set("DEVOS_TASKVIEW_TRACKER",t.root() + "/tests/lib/fake-tracker.sh"); e.set("DEVOS_TRACKER_LOG",d + "/log")
    let done = tool.run(Vec<str>("sh","-c","ulimit -c 0; exec \"$@\"","snap-native","xvfb-run","-a",executable),e,"",120000)
    test.expect(done.success && strings.contains(t.out(done),"PASS native Snap arranged two windows through the tracker"),"Snap: " + t.out(done) + " / " + t.err(done))
    let log = fs.existsSync(d + "/log") ? fs.readFileSync(d + "/log","utf8") : ""
    test.expect(strings.contains(log,"snap 11 devos-half-left") && strings.contains(log,"snap 12 devos-half-right") && strings.contains(log,"sash 11,0,0,5000,10000"),"the tracker received the commands: " + log)
    tool.exec(Vec<str>("rm","-rf",d))
})
test.case("the manifest is a settings manifest: a native manifest would make the session supervisor keep a Launcher window running",fn() {
    let manifest = fs.readFileSync(t.root() + "/src/system/org.devos.launcher/extension.json","utf8")
    test.expect(strings.contains(manifest,"\"kind\": \"settings\"") && !strings.contains(manifest,"\"native\"") && !strings.contains(manifest,"\"entry\""),"manifest: " + manifest)
})
test.case("on a real layer-shell compositor the Launcher is a full-screen overlay: all four edges, the overlay layer, the keyboard, and the compositor sizes it to the output",fn() {
    let labwc = t.root() + "/build/wsl/bin/labwc"
    if !fs.existsSync(labwc) { return }
    let done = tool.run(Vec<str>("sh",t.root() + "/tests/lib/layer-check.sh",t.root() + "/build/react-devlang/tests/launcher-native",t.root(),labwc),Map<str,str>(),"",120000)
    let out = t.out(done)
    test.expect(strings.contains(out,"get_layer_surface(new id zwlr_layer_surface_v1") && strings.contains(out,", 3, \"devos-overlay\")"),"on the overlay layer: " + out)
    test.expect(strings.contains(out,"set_anchor(15)") && strings.contains(out,"set_keyboard_interactivity(1)") && strings.contains(out,"set_exclusive_zone(-1)"),"anchored to every edge with the keyboard: " + out)
    test.expect(strings.contains(out,".configure(") && strings.contains(out,"1280, 720"),"the compositor gave it the whole output: " + out)
})
return t.finish()
