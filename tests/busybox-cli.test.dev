    all_same(d, Vec<str>(data + "@grep apple g.txt",data + "@grep -n apple g.txt",data + "@grep -c apple g.txt",data + "@grep -v apple g.txt",data + "@grep -i banana g.txt",data + "@grep -x apple g.txt",data + "@grep -w cat g.txt",data + "@grep -w ca g.txt; echo rc=$?",
