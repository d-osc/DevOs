use "std/fs"
use "std/test"
use "std/strings"
use "std/child_process"
use "../tools/lib/tool.dev" as tool
use "./lib/react-devlang.dev" as t

# busybox-cli (the native DevLang busybox) against the real tools: each case is a shell command line run once with the system program (`env CMD`)
# and once with `busybox CMD`; standard output, standard error and the exit status must be identical. The oracle is whatever coreutils / util-linux
# the machine has, so cases stay to behavior that does not vary between implementations.
fn busybox(): str { return t.root() + "/build/busybox-cli/busybox" }
fn build() {
    tool.checked(Vec<str>("sh", t.root() + "/busybox-cli/build.sh"), Map<str,str>(), "", 300000)
    test.expect(fs.existsSync(busybox()), "busybox was not built")
}
fn sandbox(): str {
    let d = strings.trim(tool.exec(Vec<str>("mktemp","-d")))
    let script = "cd " + d + " && printf 'one\\ntwo words here\\n\\nfour\\tx\\nlast no newline' > a.txt && printf 'alpha\\nbeta\\n' > b.txt && printf 'z\\ny\\nx\\ny\\n' > c.txt && printf '' > empty.txt && mkdir -p dir/sub && printf 'in sub\\n' > dir/sub/f.txt && printf 'abc\\n' > dir/g.txt"
    script = script + " && printf '10\\n9\\n100\\n-5\\n3.5\\n007\\n' > n.txt && printf 'b 2\\na 10\\nc 1\\na 2\\n' > kv.txt && printf 'x,3\\ny,1\\nz,20\\n' > csv.txt && printf 'banana\\nApple\\ncherry\\napple\\n' > mixed.txt && printf 'Mar\\nJan\\nFeb\\nDec\\n' > months.txt && printf '1e3\\n5\\n2.5e1\\n-1\\n' > g.txt && printf 'a\\na\\nb\\nb\\nb\\nc\\n' > u.txt && printf 'a\\tb\\tc\\nd\\te\\tf\\nplain\\n' > tabs.txt"
    tool.exec(Vec<str>("sh","-c",script))
    return d
}
fn outcome(d: str, command: str): str {
    # every run gets its own copy of the sandbox, so a case that changes files cannot affect the one run after it
    let script = "export LC_ALL=C TZ=UTC; w=$(mktemp -d) && o=$(mktemp) && cp -a " + d + "/. $w && cd $w && { " + command + "\n} > $o 2>/dev/null; rc=$?; cd /; sed \"s#$w#W#g\" $o; rm -rf $w $o; echo \"rc=$rc\""
    let run = tool.run(Vec<str>("sh","-c",script), Map<str,str>(), "", 60000)
    return t.out(run)
}
# "@" in a case stands for the program prefix: the system tool (`env`) on one side, busybox on the other ("echo hi | @tee f"). A case without "@" gets
# the prefix put in front of it.
fn same_as_system(d: str, command: str) {
    let line = strings.contains(command, "@") ? command : "@" + command
    let expected = outcome(d, strings.replaceAll(line, "@", "env "))
    let got = outcome(d, strings.replaceAll(line, "@", busybox() + " "))
    test.expect(strings.equal(expected, got), "busybox " + command + "\n--- system\n" + expected + "\n--- busybox\n" + got)
}
fn all_same(d: str, commands: Vec<str>) { for c in commands { same_as_system(d, c) } }

test.case("the program builds and lists its applets; an unknown applet is refused",fn() {
    build()
    let d = sandbox()
    let listed = outcome(d, busybox() + " --list")
    for name in Vec<str>("cat","echo","head","tail","wc","seq","tee","yes","basename","dirname","pwd","sleep","true","false") {
        test.expect(strings.contains(listed, name + "\n"), name + " is missing from --list: " + listed)
    }
    test.expect(strings.contains(outcome(d, "{ " + busybox() + " nosuchapplet 2>&1; }"), "applet not found"), "an unknown applet was not refused")
    tool.exec(Vec<str>("rm","-rf",d))
})
test.case("true false echo pwd basename dirname sleep",fn() {
    let d = sandbox()
    all_same(d, Vec<str>("true","false","echo hello world","echo -n hi","echo -e 'a\\tb\\\\n'","echo -e 'x\\cy'","echo -e '\\x41\\0102'","echo -- -n","echo -ne 'q\\n'","echo","pwd",
        "basename /usr/bin/cat","basename /usr/bin/cat.txt .txt","basename /","basename a/b/","basename cat cat","dirname /usr/bin/cat","dirname cat","dirname /","dirname /usr/","dirname a//b","dirname ''",
        "sleep 0","sleep 0.1","sleep x"))
    tool.exec(Vec<str>("rm","-rf",d))
})
test.case("cat head tail tee",fn() {
    let d = sandbox()
    all_same(d, Vec<str>("cat a.txt b.txt","cat nosuch","cat dir","cat < a.txt","cat - < b.txt","cat empty.txt",
        "head a.txt","head -n 2 a.txt","head -c 7 a.txt","head -2 a.txt b.txt","head -n 0 a.txt","head -q a.txt b.txt","head -v a.txt","head nosuch a.txt","head -n 100 b.txt","head < a.txt","head -c 3k a.txt",
        "tail a.txt","tail -n 2 a.txt","tail -n +3 a.txt","tail -c 7 a.txt","tail a.txt b.txt","tail -2 a.txt","tail -n 0 a.txt","tail -n 100 b.txt","tail -c +5 b.txt","tail < b.txt","tail nosuch",
        "echo hi | @tee t1 t2 >/dev/null; cat t1 t2","echo one > t1; echo two | @tee -a t1; cat t1"))
    tool.exec(Vec<str>("rm","-rf",d))
})
test.case("wc and seq",fn() {
    let d = sandbox()
    all_same(d, Vec<str>("wc a.txt","wc -l a.txt","wc -w a.txt","wc -c a.txt","wc a.txt b.txt","wc -lw a.txt","wc < a.txt","wc -L a.txt","wc -l a.txt b.txt c.txt","wc nosuch a.txt","wc empty.txt",
        "seq 5","seq 2 5","seq 1 2 9","seq 5 -1 1","seq -w 8 11","seq -s , 4","seq 3 1","seq 0","seq -1 1","seq 1 0 5","seq a"))
    tool.exec(Vec<str>("rm","-rf",d))
})
test.case("mkdir rmdir rm touch ln",fn() {
    let d = sandbox()
    all_same(d, Vec<str>("@mkdir n1 n2; find . -maxdepth 1 -name 'n*' | sort","@mkdir -p a/b/c; find a | sort","@mkdir -m 700 mm; stat -c %a mm","@mkdir dir","@mkdir -p dir/sub","@mkdir nosuch/x","@mkdir",
        "mkdir -p e1/e2; @rmdir e1/e2; find e1","mkdir -p e1/e2; @rmdir -p e1/e2; ls e1","@rmdir dir","@rmdir nosuch","@rmdir a.txt","@rmdir --ignore-fail-on-non-empty dir; echo done",
        "@rm a.txt; ls a.txt","@rm nosuch","@rm -f nosuch","@rm -f","@rm dir; ls dir","@rm -r dir; ls dir","@rm -rf dir; ls dir","@rm a.txt b.txt; ls",
        "@touch t1; stat -c %s t1","@touch -c nonesuch; ls nonesuch","@touch -d '2020-01-02 03:04:05' t2; stat -c %Y t2","@touch a.txt; stat -c %s a.txt","@touch -d @86400 t3; stat -c %Y t3","@touch nosuchdir/x",
        "@ln -s a.txt l1; readlink l1","@ln a.txt h1; stat -c %h a.txt","@ln -s b.txt l1 ; echo rc","@ln -sf b.txt l2; ln -sf c.txt l2; readlink l2","@ln -s a.txt b.txt c.txt","@ln a.txt dir; ls dir","@ln -s a.txt nosuchdir/l"))
    tool.exec(Vec<str>("rm","-rf",d))
})
test.case("realpath readlink cp mv install chmod mktemp mkfifo",fn() {
    let d = sandbox()
    all_same(d, Vec<str>("@realpath dir/sub/../g.txt","ln -s dir sl; @readlink -f sl/sub","ln -s a.txt s1; @readlink s1","@readlink a.txt; echo rc","@readlink -n nosuch; echo","ln -s dir/sub sl2; @realpath sl2/f.txt",
        "@cp a.txt z.txt; cmp a.txt z.txt && echo same","@cp -r dir cdir; find cdir | sort","@cp a.txt b.txt c.txt","@cp dir x; ls x","@cp -p a.txt p.txt; stat -c '%a %Y' a.txt p.txt","@cp nosuch x","@cp a.txt dir; cat dir/a.txt | wc -c","@cp -R dir/ cd2; find cd2 | sort","@cp -s a.txt sl3; readlink sl3",
        "@mv a.txt m1; ls a.txt m1","@mv a.txt b.txt c.txt","@mv nosuch x","@mv a.txt dir; ls dir","@mv dir ndir; ls ndir",
        "@install -m 640 a.txt inst; stat -c %a inst","@install -d x1/y1; test -d x1/y1 && echo dir","@install -D a.txt q1/q2/a; ls q1/q2","@install a.txt b.txt dir; ls dir","@install -m 700 -d idir; stat -c %a idir",
        "@chmod 600 a.txt; stat -c %a a.txt","@chmod u+x,g-r a.txt; stat -c %a a.txt","@chmod -R a=rX dir; find dir -printf '%m %p\\n' | sort","@chmod 999 a.txt; echo rc","@chmod 600 nosuch","@chmod a+x,o-r b.txt; stat -c %a b.txt","@chmod g=u a.txt; stat -c %a a.txt","@chmod +t dir; stat -c %a dir","@chmod -c 644 a.txt","@chmod -v 644 a.txt",
        "f=$(@mktemp); test -f $f && echo ok; rm -f $f","d=$(@mktemp -d); test -d $d && echo ok; rmdir $d","f=$(@mktemp -p dir tXXXXXX); test -f $f && echo ok; rm -f $f","@mktemp bad","f=$(@mktemp -t fooXXXXXX); echo $f | grep -c '^/tmp/foo'; rm -f $f",
        "@mkfifo ff; test -p ff && echo fifo","@mkfifo -m 600 ff2; stat -c %a ff2","@mkfifo dir","@sync; echo rc"))
    tool.exec(Vec<str>("rm","-rf",d))
})
