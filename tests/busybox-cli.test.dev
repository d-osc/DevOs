        data + "@grep -A1 cherry g.txt",data + "@grep -B1 cherry g.txt",data + "@grep -C1 cherry g.txt",data + "@grep -A1 apple g.txt",data + "@grep -m1 apple g.txt",data + "@grep -q apple g.txt; echo rc=$?",data + "@grep -q zzz g.txt; echo rc=$?",data + "@grep zzz g.txt; echo rc=$?",data + "@grep apple g.txt g.txt",data + "@grep -h apple g.txt g.txt",data + "@grep -H apple g.txt",
