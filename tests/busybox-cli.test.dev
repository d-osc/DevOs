    tool.exec(Vec<str>("rm","-rf",d))
})
test.case("sed",fn() {
    let d = sandbox()
    let data = "printf 'one\\ntwo\\nthree\\nfour\\nfive\\nsix\\nseven\\n' > s.txt; "
    all_same(d, Vec<str>(data + "@sed 's/o/0/' s.txt",data + "@sed 's/o/0/g' s.txt",data + "@sed -n '2p' s.txt",data + "@sed -n '2,4p' s.txt",data + "@sed '2d' s.txt",data + "@sed '2,3d' s.txt",data + "@sed '$d' s.txt",data + "@sed -n '$p' s.txt",data + "@sed -n '/t/p' s.txt",data + "@sed '/t/d' s.txt",data + "@sed -n '/two/,/four/p' s.txt",
        data + "@sed '1!d' s.txt",data + "@sed -n '2~3p' s.txt",data + "@sed -n '2,+2p' s.txt",data + "@sed -n '2,~4p' s.txt",data + "@sed 's/e/E/2' s.txt",data + "@sed -E 's/(o+)/<\\1>/' s.txt",data + "@sed 's/\\(t\\)\\(.\\)/\\2\\1/' s.txt",data + "@sed 's/.*/[&]/' s.txt",data + "@sed 's/x*/-/g' s.txt | head -3",data + "@sed 's/o/&&/' s.txt",
        data + "@sed 's|e|/|' s.txt",data + "@sed 'y/abcdef/ABCDEF/' s.txt",data + "@sed '2q' s.txt",data + "@sed -n '3{p;q}' s.txt",data + "@sed '2i\\\\inserted' s.txt",data + "@sed '2a appended' s.txt",data + "@sed '2c changed' s.txt",data + "@sed '2,3c changed' s.txt",data + "@sed -n '$=' s.txt",data + "@sed = s.txt | head -4",data + "@sed 'N;s/\\n/+/' s.txt",
        data + "@sed -n 'h;n;G;p' s.txt",data + "@sed '1!G;h;$!d' s.txt",data + "@sed -n 'x;p' s.txt",data + "@sed '/two/{s/two/2/;s/2/II/}' s.txt",data + "@sed -e 's/one/1/' -e 's/two/2/' s.txt",data + "@sed 's/o/0/;s/e/3/' s.txt",data + "@sed ':a;s/o/0/;ta' s.txt",data + "@sed -n '/one/{n;p}' s.txt",data + "@sed '$!N;P;D' s.txt",
        data + "@sed 's/t/T/p' s.txt -n",data + "@sed -s -n '$p' s.txt s.txt",data + "@sed -n '$p' s.txt s.txt",data + "@sed 's/\\(.\\)\\(.\\)/\\U\\1\\E\\2/' s.txt",data + "@sed 's/.*/\\L&/' s.txt",data + "@sed 's/^/> /' s.txt",data + "@sed 's/$/ </' s.txt",data + "@sed 's/[aeiou]//g' s.txt",data + "@sed 's/\\bt/T/' s.txt",data + "@sed 's/two/a\\tb/' s.txt",
        data + "@sed -n 'l' s.txt | head -2",data + "@sed 'n;d' s.txt",data + "@sed '1~2d' s.txt",data + "@sed '/three/,$d' s.txt",data + "@sed '/one/,/two/!d' s.txt",data + "@sed -n '/e$/!p' s.txt",data + "@sed 's/e/E/w out.txt' s.txt > /dev/null; cat out.txt",data + "@sed -i 's/one/ONE/' s.txt; cat s.txt",data + "@sed -i.bak 's/one/ONE/' s.txt; cat s.txt s.txt.bak | head -9",
        data + "printf 'a\\nb' | @sed 's/b/c/'","printf 'a b c\\n' | @sed 's/ /\\n/g'","printf 'x\\n' | @sed 's/x/a\\/b/'","printf 'foo bar\\n' | @sed -E 's/(foo|bar)/[\\1]/g'","printf 'aaa\\n' | @sed 's/a/b/2g'","printf 'abc\\n' | @sed 's/b*/X/g'","printf 'hello\\n' | @sed 's/l*/X/g'","printf '1\\n2\\n3\\n' | @sed -n '2{p}'","printf 'a\\n' | @sed -n -e 'p' -e 'p'","printf 'a\\n' | @sed 's/a/b/;#comment","printf 'a\\n' | @sed --quiet 'p'"))
    tool.exec(Vec<str>("rm","-rf",d))
})
test.case("md5sum sha1sum sha256sum sha512sum cksum sum",fn() {
    let d = sandbox()
    let data = "for n in 0 1 3 55 56 63 64 65 111 112 113 127 128 129 1000; do head -c $n /dev/zero | tr '\\0' 'x' > h$n.bin; done; "
    let cmds = Vec<str>()
    for tool_name in Vec<str>("md5sum","sha1sum","sha256sum","sha512sum","cksum") {
        cmds.push(data + "@" + tool_name + " h*.bin a.txt b.txt")
        cmds.push(data + "cat a.txt | @" + tool_name)
        cmds.push(data + "@" + tool_name + " nosuchfile; echo rc=$?")
    }
    cmds.push(data + "@md5sum -c /dev/null; echo rc=$?")
    cmds.push(data + "@sha256sum a.txt b.txt > sums.txt; @sha256sum -c sums.txt; echo rc=$?")
    cmds.push(data + "@sha256sum a.txt > sums.txt; echo x >> a.txt; @sha256sum -c sums.txt; echo rc=$?")
    cmds.push(data + "@sum a.txt b.txt h1000.bin")
    cmds.push(data + "@sum -s a.txt b.txt h1000.bin")
    cmds.push(data + "@sum -r a.txt")
    all_same(d, cmds)
    tool.exec(Vec<str>("rm","-rf",d))
})
test.case("printf",fn() {
    let d = sandbox()
    all_same(d, Vec<str>("@printf 'hello\\n'","@printf '%s\\n' a b c","@printf '%d %d\\n' 1 2 3 4","@printf '%5d|%-5d|%05d\\n' 42 42 42","@printf '%x %X %o %#x %#o\\n' 255 255 8 255 8","@printf '%+d % d %d\\n' 5 5 -5","@printf '%s|%10s|%-10s|%.2s\\n' abc abc abc abc","@printf '%c%c\\n' hello world","@printf '%%\\n'",
        "@printf '%b\\n' 'a\\tb\\\\n'","@printf '%b' 'one\\ctwo'; echo","@printf 'a\\x41\\101\\n'","@printf '%d\\n' 0x10 010 \"'A\"","@printf '%d\\n' abc; echo rc=$?","@printf '%s\\n'","@printf '%d\\n'","@printf '%.3d|%5.3d\\n' 7 7","@printf '%*d|%-*d|\\n' 5 1 5 2","@printf '%u\\n' -1","@printf '%i\\n' 12","@printf 'no newline'; echo","@printf; echo rc=$?","@printf '%s %s\\n' a","@printf '%5s%%\\n' 50"))
    tool.exec(Vec<str>("rm","-rf",d))
})
test.case("process applets and system information (BusyBox only)",fn() {
    let d = sandbox()
    let bb = busybox()
    let script = "cp /bin/sleep zzsleep; ./zzsleep 40 & p=$!; "
    test.expect(strings.contains(outcome(d, script + bb + " pidof zzsleep | tr ' ' '\\n' | grep -c \"^$p$\"; kill $p"), "1\nrc=0"), "pidof did not find the process")
    test.expect(strings.contains(outcome(d, script + bb + " pgrep -x zzsleep | grep -c \"^$p$\"; kill $p"), "1\nrc=0"), "pgrep did not find the process")
    test.expect(strings.contains(outcome(d, script + bb + " pgrep -f 'zzsleep 40' >/dev/null; echo found=$?; kill $p"), "found=0"), "pgrep -f missed the command line")
    test.expect(strings.contains(outcome(d, script + bb + " pgrep nosuchprocessname; echo rc=$?; kill $p"), "rc=1"), "pgrep found something that is not there")
    test.expect(strings.contains(outcome(d, script + bb + " pkill -x zzsleep; wait $p; echo rc=$?"), "rc=143"), "pkill did not terminate the process")
    test.expect(strings.contains(outcome(d, script + bb + " killall zzsleep; wait $p; echo rc=$?"), "rc=143"), "killall did not terminate the process")
    test.expect(strings.contains(outcome(d, bb + " killall nosuchprocessname; echo rc=$?"), "rc=1"), "killall reported success for nothing")
    test.expect(strings.contains(outcome(d, bb + " killall -q nosuchprocessname; echo rc=$?"), "rc=1"), "killall -q changed the status")
    test.expect(strings.contains(outcome(d, script + bb + " ps | grep -c \"^ *$p \"; kill $p"), "1\nrc=0"), "ps does not list the process")
    test.expect(strings.contains(outcome(d, bb + " ps -o pid,comm | head -1"), "PID COMM"), "ps -o headers are wrong")
    test.expect(strings.contains(outcome(d, bb + " ps -o pid=ID,comm | head -1"), "ID COMM"), "ps -o col=header is wrong")
    test.expect(strings.contains(outcome(d, bb + " free"), "Mem:"), "free prints no Mem line")
    test.expect(strings.contains(outcome(d, bb + " uptime"), " up "), "uptime prints no uptime")
    test.expect(strings.contains(outcome(d, bb + " timeout -t 1 sleep 5; echo rc=$?"), "rc=143"), "timeout did not stop the program")
    test.expect(strings.contains(outcome(d, bb + " timeout -t 5 sh -c 'exit 4'; echo rc=$?"), "rc=4"), "timeout lost the exit status")
    test.expect(strings.contains(outcome(d, bb + " timeout -s KILL -t 1 sleep 5; echo rc=$?"), "rc=137"), "timeout -s KILL is wrong")
    test.expect(strings.contains(outcome(d, bb + " usleep 1000; echo rc=$?"), "rc=0"), "usleep failed")
    test.expect(strings.contains(outcome(d, bb + " logname >/dev/null; echo rc=$?"), "rc="), "logname did not run")
    tool.exec(Vec<str>("rm","-rf",d))
})
test.case("dos2unix unix2dos length (BusyBox only)",fn() {
    let d = sandbox()
    test.expect(strings.contains(outcome(d, "printf 'a\\r\\nb\\r\\n' | " + busybox() + " dos2unix | od -An -c"), "a  \\n   b  \\n"), "dos2unix did not strip the carriage returns")
    test.expect(strings.contains(outcome(d, "printf 'a\\nb\\n' | " + busybox() + " unix2dos | od -An -c"), "a  \\r  \\n   b  \\r  \\n"), "unix2dos did not add them")
    test.expect(strings.contains(outcome(d, "printf 'x\\r\\ny\\r\\n' > f.txt; " + busybox() + " dos2unix f.txt; od -An -c f.txt"), "x  \\n   y  \\n"), "dos2unix in place failed")
    test.expect(strings.contains(outcome(d, busybox() + " length hello; " + busybox() + " length ''"), "5\n0\n"), "length is wrong")
    tool.exec(Vec<str>("rm","-rf",d))
})
test.case("cat passes binary data through untouched and yes stops when its reader does",fn() {
    let d = sandbox()
    tool.exec(Vec<str>("sh","-c","head -c 3000000 /dev/urandom > " + d + "/r.bin"))
    let same = outcome(d, busybox() + " cat r.bin | cmp - r.bin && echo identical")
    test.expect(strings.contains(same, "identical"), "binary data changed: " + same)
    test.expect(strings.contains(outcome(d, busybox() + " yes ab | head -2"), "ab\nab\n"), "yes did not repeat its line")
    tool.exec(Vec<str>("rm","-rf",d))
})
return t.finish()
