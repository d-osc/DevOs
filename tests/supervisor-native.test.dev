use "std/test"
use "std/fs"
use "std/json"
use "std/result"
use "std/strings"
use "std/child_process"
use "../lib/posix.dev" as posix
use "../lib/session-supervisor.dev" as supervisor
use "../lib/config.dev" as config
use "../lib/session-version.dev" as versions
use "../lib/desktop.dev" as util
use "../tools/lib/tool.dev" as tool
use "./lib/react-devlang.dev" as t
fn invalid(value:json.Value):bool { return result.isErr(result.attempt(fn():json.Value { return config.validate(value) })) }
fn script(path:str,body:str) { tool.write(path,"#!/bin/sh\n"+body+"\n"); tool.chmod(path,"755") }
fn environment(dir:str,shell:str):Map<str,str> {
    let env=Map<str,str>(); env.set("DEV_OS_ROOT",t.root()); env.set("DEV_OS_SHELL",shell);env.set("XDG_RUNTIME_DIR",dir);env.set("XDG_CONFIG_HOME",dir+"/config");env.set("XDG_DATA_HOME",dir+"/data");env.set("LABWC_PID","");env.set("WLR_BACKENDS","headless");return env
}
fn argv(options:json.Value):Vec<str> { return Vec<str>("devrun",t.root()+"/src/system/supervisor.dev","--ffi-lib",t.root()+"/dist/native/libsupervisor.so","--","--options",json.stringify(json.set(options,"nativeSystem",false))) }
test.case("compositor PID cannot wrap into a process-group signal",fn() {
    for value in Vec<str>("","0","01","-1","+1","4294967295","2147483648","999999999999999999999999") {test.expect(supervisor.compositorPid(value)==0,"Invalid compositor PID accepted")}
    test.expect(supervisor.compositorPid("1234")==1234,"Valid compositor PID lost")
})
fn metadata(dir:str):str {
    let key="1.2.3-0123456789ab";let root=dir+"/data/dev-os-updates/releases/"+key
    tool.jsonWrite(root+"/release.json",{format:1,version:"1.2.3",platform:"linux-arm64"})
    tool.jsonWrite(dir+"/data/dev-os-updates/history.json",{current:{key:key,version:"1.2.3",platform:"linux-arm64",repository:"owner/repo"},previous:null})
    return root
}
test.case("configuration preserves the npm config contract",fn() {
    let value=config.validate({name:"Custom",panel_height:48,accent:"legacy",background:"legacy",autostart:[["sh","-c","exit 0"]]})
    t.equal(json.string(json.get(value,"name")),"Custom");test.expect(json.int(json.get(value,"panel_height"))==48,"Panel height changed")
    test.expect(!json.has(value,"accent") && !json.has(value,"background"),"Legacy colors not removed")
    test.expect(json.len(json.get(value,"terminal"))==1 && json.len(json.get(value,"autostart"))==1,"Defaults lost")
})
test.case("configuration rejects unknown, fractional and malformed commands",fn() {
    test.expect(invalid({unknown:true}) && invalid({panel_height:48.5}) && invalid({panel_height:31}),"Invalid scalar accepted")
    test.expect(invalid({files:[]}) && invalid({autostart:[["sh",7]]}) && invalid({name:"  "}),"Malformed command accepted")
    test.expect(invalid(json.parse("{\"terminal\":[\"bad\\u0000argument\"]}")),"NUL command accepted")
})
test.case("version accepts supported tags and rejects unsafe numbers",fn() {
    t.equal(versions.version(json.value("v1.2.3-ux3407na-dev")),"1.2.3")
    for value in Vec<str>("01.2.3","1.2.3-other","9007199254740992.0.0","1.2.3/path") {
        # Bind the parameter in a helper to avoid relying on loop-local closure capture.
        test.expect(!validVersion(value),"Unsafe version accepted")
    }
})
test.case("installed selection checks metadata and rejects path keys",fn() {
    tool.scope("devos-supervisor-history-",fn(dir:str) {
        let root=metadata(dir); t.equal(versions.selectedAt(dir+"/data/dev-os-updates"),root)
        tool.jsonWrite(root+"/release.json",{format:1,version:"9.9.9",platform:"linux-arm64"})
        test.expect(!validSelection(dir+"/data/dev-os-updates"),"Mismatched metadata accepted")
        tool.jsonWrite(dir+"/data/dev-os-updates/history.json",{current:{key:"../../escape",version:"1.2.3",platform:"linux-arm64",repository:"owner/repo"},previous:null})
        test.expect(!validSelection(dir+"/data/dev-os-updates"),"Escaping key accepted")
    })
})
test.case("native supervisor finishes a clean shell without GJS",fn() {
    tool.scope("devos-supervisor-clean-",fn(dir:str) {let done=tool.run(argv({services:false}),environment(dir,"/usr/bin/true"),"",15000);t.success(done)})
})
test.case("legacy config is detected even inside a .json-named directory",fn() {
    tool.scope("devos-supervisor-legacy-",fn(dir:str) {
        tool.write(dir+"/parent.json/dev-os/config.toml","name='Legacy'\n")
        let env=environment(dir,"/usr/bin/true");env.set("XDG_CONFIG_HOME",dir+"/parent.json")
        let done=tool.run(argv({services:false}),env,"",15000)
        test.expect(!done.success,"Legacy config was ignored");t.contains(t.err(done),"legacy configuration")
    })
})
test.case("crashed shells restart until a clean logout",fn() {
    tool.scope("devos-supervisor-crash-",fn(dir:str) {
        let counter=util.quote(dir+"/starts");script(dir+"/shell","n=$(cat "+counter+" 2>/dev/null || echo 0)\nn=$((n+1)); echo $n > "+counter+"\nif [ $n -eq 1 ]; then kill -9 $$; elif [ $n -eq 2 ]; then exit 3; fi\nexit 0")
        let done=tool.run(argv({services:false,restartDelaySeconds:0.01}),environment(dir,dir+"/shell"),"",15000)
        t.success(done);t.equal(strings.trim(tool.read(dir+"/starts")),"3")
    })
})
test.case("crash loops are bounded",fn() {
    tool.scope("devos-supervisor-loop-",fn(dir:str) {
        let done=tool.run(argv({services:false,restartDelaySeconds:0.01,maxRestarts:2}),environment(dir,"/usr/bin/false"),"",15000)
        test.expect(!done.success,"Crash loop returned success");t.contains(t.err(done),"crashed repeatedly")
    })
})
test.case("service recovery leaves the shell running",fn() {
    tool.scope("devos-supervisor-services-",fn(dir:str) {
        script(dir+"/shell","echo started >> "+util.quote(dir+"/shell-starts")+"\nsleep 1\nexit 0")
        let counter=util.quote(dir+"/service-starts");script(dir+"/services","n=$(cat "+counter+" 2>/dev/null || echo 0)\nn=$((n+1)); echo $n > "+counter+"\nif [ $n -eq 1 ]; then exit 5; fi\nsleep 5")
        let env=environment(dir,dir+"/shell");env.set("DEV_OS_SERVICES_HOST",dir+"/services")
        let done=tool.run(argv({restartDelaySeconds:0.01}),env,"",15000);t.success(done)
        t.equal(strings.trim(tool.read(dir+"/service-starts")),"2");t.equal(strings.trim(tool.read(dir+"/shell-starts")),"started")
    })
})
test.case("shutdown kills an autostart group that ignores TERM",fn() {
    tool.scope("devos-supervisor-groups-",fn(dir:str) {
        script(dir+"/shell","sleep 0.5; exit 0")
        tool.jsonWrite(dir+"/config/dev-os/config.json",{autostart:[["sh","-c","trap '' TERM; echo $$ > \"$1\"; sleep 5","sh",dir+"/pid"]]})
        let done=tool.run(argv({services:false}),environment(dir,dir+"/shell"),"",15000);t.success(done)
        let pid=strings.trim(tool.read(dir+"/pid"));test.expect(strings.charLength(pid)>0,"Autostart did not run")
        test.expect(!fs.existsSync("/proc/"+pid),"Autostart leader survived shutdown")
    })
})
test.case("version switch launches only the selected runtime",fn() {
    tool.scope("devos-supervisor-switch-",fn(dir:str) {
        let root=metadata(dir)
        script(root+"/bin/dev-os-start","echo switched > "+util.quote(dir+"/switched"))
        script(dir+"/shell","printf '%s' "+util.quote(json.stringify({root:root}))+" > \"$DEV_OS_VERSION_REQUEST\"\nexit 0")
        let done=tool.run(argv({services:false}),environment(dir,dir+"/shell"),"",15000);t.success(done)
        tool.waitFor(fn():bool {return fs.existsSync(dir+"/switched")},3000,"Selected runtime was not launched")
    })
})
test.case("forged version switch is rejected",fn() {
    tool.scope("devos-supervisor-forged-",fn(dir:str) {
        metadata(dir);script(dir+"/shell","printf '%s' "+util.quote(json.stringify({root:dir+"/arbitrary"}))+" > \"$DEV_OS_VERSION_REQUEST\"\nexit 0")
        let done=tool.run(argv({services:false}),environment(dir,dir+"/shell"),"",15000);t.success(done);t.contains(t.err(done),"version request rejected")
    })
})
test.case("SIGTERM stops the native supervisor and its shell group",fn() {
    tool.scope("devos-supervisor-signal-",fn(dir:str) {
        script(dir+"/shell","echo $$ > "+util.quote(dir+"/shell-pid")+"\nsleep 5")
        let args=tool.envArgs(environment(dir,dir+"/shell"));for item in argv({services:false}) {args.push(item)}
        let child=child_process.spawn("env",args,child_process.Options("",15000,1048576,Vec<u8>()))
        tool.waitFor(fn():bool {return fs.existsSync(dir+"/shell-pid")},5000,"Shell did not start")
        test.expect(posix.send(child.pid(),15),"Could not signal owned supervisor")
        let result=child.wait();t.success(result)
        let pid=strings.trim(tool.read(dir+"/shell-pid"));test.expect(!fs.existsSync("/proc/"+pid),"Shell survived supervisor termination")
    })
})
fn validVersion(value:str):bool {return result.isOk(result.attempt(fn():str {return versions.version(json.value(value))}))}
fn validSelection(value:str):bool {return result.isOk(result.attempt(fn():str {return versions.selectedAt(value)}))}
test.case("native system discovery ignores ordinary files and validates executable names",fn() {
    tool.scope("devos-supervisor-systems-",fn(dir:str) {
        tool.write(dir+"/src/system/helper.dev","return 0")
        tool.jsonWrite(dir+"/src/system/org.devos.fixture/extension.json",{id:"org.devos.fixture",system:true,kind:"ui",native:"fixture"})
        script(dir+"/dist/native/fixture","exit 0")
        let commands=supervisor.systems(dir);test.expect(commands.len()==1,"Wrong native system count")
        t.equal(commands[0].role,"native:org.devos.fixture");t.equal(commands[0].args[2],dir+"/dist/native/fixture")
        tool.jsonWrite(dir+"/src/system/org.devos.fixture/extension.json",{id:"org.devos.fixture",system:true,kind:"ui",native:"../escape"})
        test.expect(result.isErr(result.attempt(fn():i64 {return supervisor.systems(dir).len() as i64})),"Unsafe native executable accepted")
    })
})
return t.finish()
