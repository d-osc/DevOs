# File system helpers of the DevLang BusyBox: directory listing, copying, removing trees, users and groups, chmod modes.
use "./sys.dev" as sys

extern fn mkdir(path: str, mode: i64): i32
extern fn rmdir(path: str): i32
extern fn unlink(path: str): i32
extern fn rename(from: str, to: str): i32
extern fn link(from: str, to: str): i32
extern fn symlink(target: str, linkpath: str): i32
extern fn readlink(path: str, buffer: *void, size: usize): isize
extern fn chmod(path: str, mode: i64): i32
extern fn chown(path: str, owner: i64, group: i64): i32
extern fn lchown(path: str, owner: i64, group: i64): i32
extern fn utimes(path: str, times: *void): i32
extern fn opendir(path: str): *void
extern fn readdir(dir: *void): *void
extern fn closedir(dir: *void): i32
extern fn mkfifo(path: str, mode: i64): i32
extern fn sync()
extern fn umask(mask: i64): i64
extern fn getuid(): i32
extern fn getgid(): i32
extern fn geteuid(): i32
extern fn getegid(): i32

fn uid(): i64 { unsafe { return getuid() as i64 } }
fn gid(): i64 { unsafe { return getgid() as i64 } }
fn euid(): i64 { unsafe { return geteuid() as i64 } }
fn egid(): i64 { unsafe { return getegid() as i64 } }
# Safe forms of the calls (result 0 on success, like C).
fn do_chmod(path: str, mode: i64): i64 { unsafe { return chmod(path, mode) as i64 } }
fn do_unlink(path: str): i64 { unsafe { return unlink(path) as i64 } }
fn do_rmdir(path: str): i64 { unsafe { return rmdir(path) as i64 } }
fn do_rename(from: str, to: str): i64 { unsafe { return rename(from, to) as i64 } }
fn do_link(from: str, to: str): i64 { unsafe { return link(from, to) as i64 } }
fn do_symlink(target: str, linkpath: str): i64 { unsafe { return symlink(target, linkpath) as i64 } }
fn do_chown(path: str, owner: i64, group: i64): i64 { unsafe { return chown(path, owner, group) as i64 } }
fn do_lchown(path: str, owner: i64, group: i64): i64 { unsafe { return lchown(path, owner, group) as i64 } }
fn do_mkfifo(path: str, mode: i64): i64 { unsafe { return mkfifo(path, mode) as i64 } }
fn do_sync() { unsafe { sync() } }

fn join_path(dir: str, name: str): str {
    if sys.length(dir) == 0 { return name }
    if sys.ends(dir, "/") { return sys.join2(dir, name) }
    return sys.join2(sys.join2(dir, "/"), name)
}
fn compare_str(a: str, b: str): i32 { unsafe { return sys.strcmp(a, b) } }
fn sort_strings(items: Vec<str>): Vec<str> {
    let n = items.len() as i64
    if n < 2 { return items }
    let mid = n / 2
    let left = Vec<str>(); let right = Vec<str>()
    for i in 0..mid { left.push(items[i]) }
    for i in mid..n { right.push(items[i]) }
    left = sort_strings(left); right = sort_strings(right)
    let out = Vec<str>(); let a = 0; let b = 0
    let ln = left.len() as i64; let rn = right.len() as i64
    while a < ln && b < rn { if compare_str(left[a], right[b]) <= 0 { out.push(left[a]); a = a + 1 } else { out.push(right[b]); b = b + 1 } }
    while a < ln { out.push(left[a]); a = a + 1 }
    while b < rn { out.push(right[b]); b = b + 1 }
    return out
}
# The names in a directory (without . and ..), in byte order; ok is false when it cannot be read.
struct Listing { ok: bool, names: Vec<str> }
fn list_dir(path: str): Listing { unsafe {
    let names = Vec<str>()
    let d = opendir(path)
    if d == null { return Listing(false, names) }
    while true {
        let entry = readdir(d)
        if entry == null { break }
        let name = &(entry as *u8)[19] as str            # struct dirent: d_name starts at byte 19 (glibc, x86_64 and aarch64)
        if !sys.same(name, ".") && !sys.same(name, "..") { names.push(sys.join2(name, "")) }
    }
    closedir(d)
    return Listing(true, sort_strings(names))
} }
# The target of a symlink ("" when path is not one).
fn read_link(path: str): str { unsafe {
    let buffer = sys.calloc(4097, 1) as *u8
    let n = readlink(path, buffer as *void, 4096)
    if n < 0 { sys.free(buffer as *void); return "" }
    return buffer as str
} }
fn make_dir(path: str, mode: i64): bool { unsafe { return mkdir(path, mode) == 0 } }
# mkdir -p: every missing parent, then the directory; true when it exists afterwards.
fn make_dirs(path: str, mode: i64): bool {
    if sys.is_dir(path) { return true }
    let cut = sys.last_char(path, 47)
    while cut > 0 && sys.at(path, cut - 1) == 47 { cut = cut - 1 }
    if cut > 0 { if !make_dirs(sys.slice(path, 0, cut), mode) { return false } }
    return make_dir(path, mode) || sys.is_dir(path)
}
# Copies the content of one file to another (created or truncated with `mode`).
fn copy_file(source: str, target: str, mode: i64): bool { unsafe {
    let in_fd = sys.open(source, 0, 0)
    if in_fd < 0 { return false }
    let out_fd = sys.open(target, 577, mode)         # O_WRONLY | O_CREAT | O_TRUNC
    if out_fd < 0 { sys.close(in_fd); return false }
    let chunk = sys.calloc(65536, 1) as *u8
    let ok = true
    while true {
        let n = sys.read(in_fd, chunk as *void, 65536)
        if n < 0 { ok = false; break }
        if n == 0 { break }
        let done = 0
        while done < (n as i64) {
            let w = sys.write(out_fd, &chunk[done] as str, ((n as i64) - done) as usize)
            if w <= 0 { ok = false; break }
            done = done + (w as i64)
        }
        if !ok { break }
    }
    sys.free(chunk as *void); sys.close(in_fd); sys.close(out_fd)
    return ok
} }
# Removes a file, or a directory with everything in it; false if anything could not be removed.
fn remove_tree(path: str): bool { unsafe {
    let info = sys.file_info(path, false)
    if !info.ok { return false }
    if sys.is_dir_mode(info.mode) {
        let listing = list_dir(path); let ok = true
        for i in 0..(listing.names.len() as i64) { if !remove_tree(join_path(path, listing.names[i])) { ok = false } }
        return rmdir(path) == 0 && ok
    }
    return unlink(path) == 0
} }

# ---- users and groups (read from /etc/passwd and /etc/group) --------------------------------------------------------------------------
# The field `want` (0 = name, 2 = id) of every line, as text, for the file; used by the two lookups below.
fn field_of(b: *sys.Bytes, start: i64, end: i64, index: i64): str {
    let out = sys.bytes_new(); let field = 0
    for k in start..end {
        let c = sys.bat(b, k)
        if c == 58 { field = field + 1; continue }
        if field == index { sys.bytes_push(out, c) }
    }
    return sys.join2(sys.bytes_cstr(out), "")
}
fn id_name(file: str, id: i64): str {
    let input = sys.read_path(file)
    if !input.ok { return "" }
    let b = input.bytes; let n = sys.blen(b); let start = 0
    for i in 0..(n + 1) {
        if i == n || sys.bat(b, i) == 10 {
            let number = sys.parse_number(field_of(b, start, i, 2))
            if number.ok && number.value == id { return field_of(b, start, i, 0) }
            start = i + 1
        }
    }
    return ""
}
fn user_name(uid: i64): str { return id_name("/etc/passwd", uid) }
fn group_name(gid: i64): str { return id_name("/etc/group", gid) }
# The numeric id of a user/group name (or of a plain number); -1 when unknown.
fn lookup_id(file: str, name: str): i64 {
    let number = sys.parse_number(name)
    if number.ok { return number.value }
    let input = sys.read_path(file)
    if !input.ok { return 0 - 1 }
    let b = input.bytes; let n = sys.blen(b); let start = 0
    for i in 0..(n + 1) {
        if i == n || sys.bat(b, i) == 10 {
            if sys.same(field_of(b, start, i, 0), name) { let id = sys.parse_number(field_of(b, start, i, 2)); if id.ok { return id.value } }
            start = i + 1
        }
    }
    return 0 - 1
}

# ---- chmod modes --------------------------------------------------------------------------------------------------------------------------------------
fn pow2(k: i64): i64 { let r = 1; for i in 0..k { r = r * 2 }; return r }
# Applies a MODE ("755", "u+x,go-w", "a=rx", "+X", "u=g") to the permission bits `old`; -1 when the mode text is invalid.
fn apply_mode(text: str, old: i64, is_dir: bool): i64 {
    let n = sys.length(text)
    if n == 0 { return 0 - 1 }
    if sys.is_digit(sys.at(text, 0)) {
        let v = 0
        for i in 0..n { let c = sys.at(text, i); if c < 48 || c > 55 { return 0 - 1 }; v = v * 8 + (c - 48) as i64 }
        return v
    }
    let mode = old % 4096; let i = 0
    while i < n {
        let who = 0
        while i < n && (sys.at(text, i) == 117 || sys.at(text, i) == 103 || sys.at(text, i) == 111 || sys.at(text, i) == 97) {
            let c = sys.at(text, i)
            if c == 117 { who = who | 1 } else if c == 103 { who = who | 2 } else if c == 111 { who = who | 4 } else { who = who | 7 }
            i = i + 1
        }
        if who == 0 { who = 7 }
        if i >= n { return 0 - 1 }
        let op = sys.at(text, i)
        if op != 43 && op != 45 && op != 61 { return 0 - 1 }
        i = i + 1
        let bits = 0
        if i < n && (sys.at(text, i) == 117 || sys.at(text, i) == 103 || sys.at(text, i) == 111) {
            # a single u / g / o copies that class' bits
            let c = sys.at(text, i); let shift = c == 117 ? 6 : (c == 103 ? 3 : 0)
            bits = (mode / pow2(shift)) % 8; i = i + 1
        } else {
            let permission = 0; let special = 0
            while i < n && sys.at(text, i) != 44 {
                let c = sys.at(text, i)
                if c == 114 { permission = permission | 4 } else if c == 119 { permission = permission | 2 } else if c == 120 { permission = permission | 1 }
                else if c == 88 { if is_dir || mode % 2 != 0 || (mode / 8) % 2 != 0 || (mode / 64) % 2 != 0 { permission = permission | 1 } }
                else if c == 115 { special = special | 1 } else if c == 116 { special = special | 2 } else { return 0 - 1 }
                i = i + 1
            }
            bits = permission
            if (special & 1) != 0 {
                if (who & 1) != 0 { if op == 45 { mode = mode - (mode & 2048) } else { mode = mode | 2048 } }
                if (who & 2) != 0 { if op == 45 { mode = mode - (mode & 1024) } else { mode = mode | 1024 } }
            }
            if (special & 2) != 0 { if op == 45 { mode = mode - (mode & 512) } else { mode = mode | 512 } }
        }
        let mask = 0; let set = 0
        if (who & 1) != 0 { mask = mask | 448; set = set | (bits * 64) }
        if (who & 2) != 0 { mask = mask | 56; set = set | (bits * 8) }
        if (who & 4) != 0 { mask = mask | 7; set = set | bits }
        if op == 43 { mode = mode | set } else if op == 45 { mode = mode - (mode & set) } else { mode = (mode - (mode & mask)) | set }
        if i < n && sys.at(text, i) == 44 { i = i + 1 }
    }
    return mode
}

# "rwxr-xr-x" for the permission bits (s, S, t, T for the special bits).
fn mode_string(mode: i64): str {
    let out = sys.bytes_new()
    let classes = 3
    for k in 0..3 {
        let bits = (mode / pow2((2 - k) * 3)) % 8
        sys.bytes_push(out, (bits / 4) % 2 == 1 ? 114 : 45)
        sys.bytes_push(out, (bits / 2) % 2 == 1 ? 119 : 45)
        let exec = bits % 2 == 1
        let special = false
        if k == 0 { special = (mode / 2048) % 2 == 1 } else if k == 1 { special = (mode / 1024) % 2 == 1 } else { special = (mode / 512) % 2 == 1 }
        if special { sys.bytes_push(out, k == 2 ? (exec ? 116 : 84) : (exec ? 115 : 83)) } else { sys.bytes_push(out, exec ? 120 : 45) }
    }
    return sys.join2(sys.bytes_cstr(out), "")
}
