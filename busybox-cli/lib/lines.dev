# Line-oriented helpers over a whole input: splitting into lines, comparing byte ranges, numbers in text.
use "./sys.dev" as sys

# The lines of a buffer as [start, end) byte ranges (the newline is not part of a line); `terminator` is 10, or 0 for -z.
struct Lines { starts: Vec<i64>, ends: Vec<i64>, final_newline: bool }
fn split_lines(b: *sys.Bytes, terminator: u8): Lines {
    let starts = Vec<i64>(); let ends = Vec<i64>(); let n = sys.blen(b); let start = 0
    for i in 0..n {
        if sys.bat(b, i) == terminator { starts.push(start); ends.push(i); start = i + 1 }
    }
    let final_newline = true
    if start < n { starts.push(start); ends.push(n); final_newline = false }
    return Lines(starts, ends, final_newline)
}
# The bytes [from, to) of a buffer as a str.
fn text_of(b: *sys.Bytes, from: i64, to: i64): str {
    let out = sys.bytes_new()
    for i in from..to { sys.bytes_push(out, sys.bat(b, i)) }
    return sys.join2(sys.bytes_cstr(out), "")
}
fn fold_byte(c: u8): u8 { return c >= 97 && c <= 122 ? c - 32 : c }
fn is_blank(c: u8): bool { return c == 32 || c == 9 }
fn is_space(c: u8): bool { return c == 32 || (c >= 9 && c <= 13) }
fn is_alnum(c: u8): bool { return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) }
fn is_print(c: u8): bool { return c >= 32 && c < 127 }
# Plain byte comparison of two ranges (-1, 0, 1).
fn compare_ranges(a: *sys.Bytes, a0: i64, a1: i64, b: *sys.Bytes, b0: i64, b1: i64): i64 {
    let i = a0; let j = b0
    while i < a1 && j < b1 {
        let x = sys.bat(a, i); let y = sys.bat(b, j)
        if x != y { return x < y ? 0 - 1 : 1 }
        i = i + 1; j = j + 1
    }
    if i < a1 { return 1 }
    if j < b1 { return 0 - 1 }
    return 0
}
# The numeric value of the number at the start of a range (blanks skipped), as a float; 0 when there is none.
struct Num { value: f64, ok: bool }
fn power10(k: i64): f64 { let r = 1.0; let n = k < 0 ? 0 - k : k; for i in 0..n { r = r * 10.0 }; return k < 0 ? 1.0 / r : r }
fn parse_float(b: *sys.Bytes, from: i64, to: i64, general: bool): Num {
    let i = from
    while i < to && is_blank(sys.bat(b, i)) { i = i + 1 }
    let sign = 1.0
    if i < to && sys.bat(b, i) == 45 { sign = 0.0 - 1.0; i = i + 1 } else if i < to && sys.bat(b, i) == 43 { i = i + 1 }
    let value = 0.0; let any = false
    while i < to && sys.is_digit(sys.bat(b, i)) { value = value * 10.0 + ((sys.bat(b, i) - 48) as f64); i = i + 1; any = true }
    if i < to && sys.bat(b, i) == 46 {
        i = i + 1; let scale = 0.1
        while i < to && sys.is_digit(sys.bat(b, i)) { value = value + ((sys.bat(b, i) - 48) as f64) * scale; scale = scale / 10.0; i = i + 1; any = true }
    }
    if general && any && i < to && (sys.bat(b, i) == 101 || sys.bat(b, i) == 69) {
        let j = i + 1; let esign = 1
        if j < to && sys.bat(b, j) == 45 { esign = 0 - 1; j = j + 1 } else if j < to && sys.bat(b, j) == 43 { j = j + 1 }
        if j < to && sys.is_digit(sys.bat(b, j)) {
            let e = 0
            while j < to && sys.is_digit(sys.bat(b, j)) { e = e * 10 + (sys.bat(b, j) - 48) as i64; j = j + 1 }
            value = value * power10(esign * e)
        }
    }
    return Num(sign * value, any)
}
