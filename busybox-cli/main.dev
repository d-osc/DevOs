# Every applet this build has, in alphabetical order (busybox --list, busybox --install and the coverage test read it).
fn applet_names(): Vec<str> {
    return Vec<str>("[", "[[", "addgroup", "adduser", "ar", "arp", "awk", "basename", "blkid", "bunzip2", "bzcat", "bzip2", "cal", "cat", "catv", "chgrp", "chmod", "chown", "chpasswd", "chpst", "chroot", "cksum", "clear", "cmp", "comm", "cp", "cpio", "crond", "crontab", "cryptpw", "cut", "date", "dc", "dd", "delgroup", "deluser", "df", "diff", "dirname", "dmesg", "dos2unix", "du", "echo", "ed", "egrep", "env", "envdir", "envuidgid", "expand", "expr", "false", "fgrep", "find", "findfs", "fold", "free", "fsync", "ftpget", "ftpput", "fuser", "getopt", "grep", "gunzip", "gzip", "hd", "head", "hexdump", "hostid", "hostname", "httpd", "id", "ifconfig", "ifdown", "ifup", "inotifyd", "insmod", "install", "ionice", "ipcalc", "ipcrm", "ipcs", "kill", "killall", "killall5", "klogd", "length", "less", "ln", "logger", "login", "logname", "ls", "lsattr", "lsmod", "md5sum", "mesg", "mkdir", "mkfifo", "mknod", "mkpasswd", "mkswap", "mktemp", "more", "mount", "mountpoint", "mv", "nc", "netstat", "nice", "nohup", "nslookup", "od", "passwd", "patch", "pgrep", "pidof", "ping", "pivot_root", "pkill", "printenv", "printf", "ps", "pscan", "pwd", "rdev", "readlink", "realpath", "renice", "reset", "rm", "rmdir", "rmmod", "route", "rpm2cpio", "run-parts", "runlevel", "sed", "seq", "setarch", "setsid", "setuidgid", "sha1sum", "sha256sum", "sha512sum", "sleep", "softlimit", "sort", "split", "start-stop-daemon", "stat", "strings", "su", "sum", "swapoff", "swapon", "sync", "sysctl", "syslogd", "tac", "tail", "tar", "taskset", "tee", "telnet", "test", "time", "timeout", "top", "touch", "tr", "true", "tty", "ttysize", "umount", "uname", "uncompress", "unexpand", "uniq", "unix2dos", "unzip", "uptime", "usleep", "uudecode", "uuencode", "watch", "wc", "wget", "which", "who", "whoami", "xargs", "yes", "zcat")
}

fn applet(name: str, args: Vec<str>): i64 {
    if sys.same(name, "true") { return basic.run_true(args) }
    if sys.same(name, "false") { return basic.run_false(args) }
    if sys.same(name, "echo") { return basic.run_echo(args) }
    if sys.same(name, "pwd") { return basic.run_pwd(args) }
    if sys.same(name, "yes") { return basic.run_yes(args) }
