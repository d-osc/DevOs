# busybox: the multi-call program. `busybox APPLET [ARGS]` or, through a link named after the applet, `APPLET [ARGS]`.
use "./lib/sys.dev" as sys
use "./applets/basic.dev" as basic
use "./applets/text.dev" as text
use "./applets/files.dev" as files
use "./applets/sort.dev" as sorts
use "./applets/filters.dev" as filt
use "./applets/sysinfo.dev" as si
use "./applets/procs.dev" as pr
use "./applets/expr.dev" as xp
use "./applets/printf.dev" as pf
use "./applets/grep.dev" as gr
use "./applets/sed.dev" as sd
use "./applets/hash.dev" as hs
use "./applets/find.dev" as fd
use "./applets/date.dev" as dt
use "./applets/ls.dev" as ls
use "./applets/diskinfo.dev" as di
use "./applets/gzip.dev" as gz
use "./applets/tar.dev" as tr
use "./applets/misc.dev" as ms

# Every applet this build has, in alphabetical order (busybox --list, busybox --install and the coverage test read it).
fn applet_names(): Vec<str> {
    return Vec<str>("[", "[[", "basename", "cal", "cat", "chgrp", "chmod", "chown", "chroot", "cksum", "clear", "cmp", "comm", "cp", "cut", "date", "dd", "df", "dirname", "dos2unix", "du", "echo", "egrep", "env", "expand", "expr", "false", "fgrep", "find", "fold", "free", "fsync", "grep", "gunzip", "gzip", "hd", "head", "hexdump", "hostid", "hostname", "id", "install", "ionice", "kill", "killall", "length", "less", "ln", "logname", "ls", "lsmod", "md5sum", "mesg", "mkdir", "mkfifo", "mknod", "mktemp", "more", "mountpoint", "mv", "nice", "nohup", "od", "pgrep", "pidof", "pkill", "printenv", "printf", "ps", "pwd", "readlink", "realpath", "renice", "reset", "rm", "rmdir", "runlevel", "sed", "seq", "setsid", "sha1sum", "sha256sum", "sha512sum", "sleep", "sort", "split", "stat", "strings", "sum", "sync", "sysctl", "tac", "tail", "tar", "tee", "test", "time", "timeout", "touch", "tr", "true", "tty", "uname", "unexpand", "uniq", "unix2dos", "uptime", "usleep", "uudecode", "uuencode", "watch", "wc", "which", "whoami", "xargs", "yes", "zcat")
}

fn applet(name: str, args: Vec<str>): i64 {
    if sys.same(name, "true") { return basic.run_true(args) }
    if sys.same(name, "false") { return basic.run_false(args) }
    if sys.same(name, "echo") { return basic.run_echo(args) }
    if sys.same(name, "pwd") { return basic.run_pwd(args) }
    if sys.same(name, "yes") { return basic.run_yes(args) }
    if sys.same(name, "basename") { return basic.run_basename(args) }
    if sys.same(name, "dirname") { return basic.run_dirname(args) }
    if sys.same(name, "sleep") { return basic.run_sleep(args) }
    if sys.same(name, "cat") { return text.run_cat(args) }
    if sys.same(name, "tee") { return text.run_tee(args) }
    if sys.same(name, "head") { return text.run_head(args) }
    if sys.same(name, "tail") { return text.run_tail(args) }
    if sys.same(name, "wc") { return text.run_wc(args) }
    if sys.same(name, "seq") { return text.run_seq(args) }
    if sys.same(name, "mkdir") { return files.run_mkdir(args) }
    if sys.same(name, "rmdir") { return files.run_rmdir(args) }
    if sys.same(name, "rm") { return files.run_rm(args) }
    if sys.same(name, "touch") { return files.run_touch(args) }
    if sys.same(name, "ln") { return files.run_ln(args) }
    if sys.same(name, "readlink") { return files.run_readlink(args) }
    if sys.same(name, "realpath") { return files.run_realpath(args) }
    if sys.same(name, "cp") { return files.run_cp(args) }
    if sys.same(name, "mv") { return files.run_mv(args) }
    if sys.same(name, "install") { return files.run_install(args) }
    if sys.same(name, "chmod") { return files.run_chmod(args) }
    if sys.same(name, "chown") { return files.run_chown(args) }
    if sys.same(name, "chgrp") { return files.run_chgrp(args) }
    if sys.same(name, "mktemp") { return files.run_mktemp(args) }
    if sys.same(name, "mkfifo") { return files.run_mkfifo(args) }
    if sys.same(name, "sync") { return files.run_sync(args) }
    if sys.same(name, "sort") { return sorts.run_sort(args) }
    if sys.same(name, "uniq") { return sorts.run_uniq(args) }
    if sys.same(name, "cut") { return sorts.run_cut(args) }
    if sys.same(name, "tac") { return sorts.run_tac(args) }
    if sys.same(name, "tr") { return sorts.run_tr(args) }
    if sys.same(name, "fold") { return filt.run_fold(args) }
    if sys.same(name, "expand") { return filt.run_expand(args) }
    if sys.same(name, "unexpand") { return filt.run_unexpand(args) }
    if sys.same(name, "comm") { return filt.run_comm(args) }
    if sys.same(name, "cmp") { return filt.run_cmp(args) }
    if sys.same(name, "split") { return filt.run_split(args) }
    if sys.same(name, "dos2unix") { return filt.run_dos2unix(args) }
    if sys.same(name, "unix2dos") { return filt.run_unix2dos(args) }
    if sys.same(name, "length") { return filt.run_length(args) }
    if sys.same(name, "strings") { return filt.run_strings(args) }
    if sys.same(name, "od") { return filt.run_od(args) }
    if sys.same(name, "hexdump") { return filt.run_hexdump(args) }
    if sys.same(name, "hd") { return filt.run_hd(args) }
    if sys.same(name, "id") { return si.run_id(args) }
    if sys.same(name, "whoami") { return si.run_whoami(args) }
    if sys.same(name, "logname") { return si.run_logname(args) }
    if sys.same(name, "hostname") { return si.run_hostname(args) }
    if sys.same(name, "uname") { return si.run_uname(args) }
    if sys.same(name, "env") { return si.run_env(args) }
    if sys.same(name, "printenv") { return si.run_printenv(args) }
    if sys.same(name, "which") { return si.run_which(args) }
    if sys.same(name, "tty") { return si.run_tty(args) }
    if sys.same(name, "usleep") { return si.run_usleep(args) }
    if sys.same(name, "nice") { return si.run_nice(args) }
    if sys.same(name, "nohup") { return si.run_nohup(args) }
    if sys.same(name, "setsid") { return si.run_setsid(args) }
    if sys.same(name, "time") { return si.run_time(args) }
    if sys.same(name, "timeout") { return si.run_timeout(args) }
    if sys.same(name, "xargs") { return pr.run_xargs(args) }
    if sys.same(name, "kill") { return pr.run_kill(args) }
    if sys.same(name, "killall") { return pr.run_killall(args) }
    if sys.same(name, "pidof") { return pr.run_pidof(args) }
    if sys.same(name, "pgrep") { return pr.run_pgrep(args) }
    if sys.same(name, "pkill") { return pr.run_pkill(args) }
    if sys.same(name, "ps") { return pr.run_ps(args) }
    if sys.same(name, "free") { return pr.run_free(args) }
    if sys.same(name, "uptime") { return pr.run_uptime(args) }
    if sys.same(name, "watch") { return pr.run_watch(args) }
    if sys.same(name, "mountpoint") { return pr.run_mountpoint(args) }
    if sys.same(name, "test") { return xp.run_test(args) }
    if sys.same(name, "[") { return xp.run__(args) }
    if sys.same(name, "[[") { return xp.run___(args) }
    if sys.same(name, "expr") { return xp.run_expr(args) }
    if sys.same(name, "printf") { return pf.run_printf(args) }
    if sys.same(name, "grep") { return gr.run_grep(args) }
    if sys.same(name, "egrep") { return gr.run_egrep(args) }
    if sys.same(name, "fgrep") { return gr.run_fgrep(args) }
    if sys.same(name, "sed") { return sd.run_sed(args) }
    if sys.same(name, "md5sum") { return hs.run_md5sum(args) }
    if sys.same(name, "sha1sum") { return hs.run_sha1sum(args) }
    if sys.same(name, "sha256sum") { return hs.run_sha256sum(args) }
    if sys.same(name, "sha512sum") { return hs.run_sha512sum(args) }
    if sys.same(name, "cksum") { return hs.run_cksum(args) }
    if sys.same(name, "sum") { return hs.run_sum(args) }
    if sys.same(name, "find") { return fd.run_find(args) }
    if sys.same(name, "date") { return dt.run_date(args) }
    if sys.same(name, "ls") { return ls.run_ls(args) }
    if sys.same(name, "stat") { return di.run_stat(args) }
    if sys.same(name, "du") { return di.run_du(args) }
    if sys.same(name, "df") { return di.run_df(args) }
    if sys.same(name, "gzip") { return gz.run_gzip(args) }
    if sys.same(name, "gunzip") { return gz.run_gunzip(args) }
    if sys.same(name, "zcat") { return gz.run_zcat(args) }
    if sys.same(name, "tar") { return tr.run_tar(args) }
    if sys.same(name, "dd") { return ms.run_dd(args) }
    if sys.same(name, "cal") { return ms.run_cal(args) }
    if sys.same(name, "clear") { return ms.run_clear(args) }
    if sys.same(name, "reset") { return ms.run_reset(args) }
    if sys.same(name, "hostid") { return ms.run_hostid(args) }
    if sys.same(name, "mknod") { return ms.run_mknod(args) }
    if sys.same(name, "renice") { return ms.run_renice(args) }
    if sys.same(name, "fsync") { return ms.run_fsync(args) }
    if sys.same(name, "uuencode") { return ms.run_uuencode(args) }
    if sys.same(name, "uudecode") { return ms.run_uudecode(args) }
    if sys.same(name, "more") { return ms.run_more(args) }
    if sys.same(name, "less") { return ms.run_less(args) }
    if sys.same(name, "mesg") { return ms.run_mesg(args) }
    if sys.same(name, "runlevel") { return ms.run_runlevel(args) }
    if sys.same(name, "lsmod") { return ms.run_lsmod(args) }
    if sys.same(name, "sysctl") { return ms.run_sysctl(args) }
    if sys.same(name, "chroot") { return ms.run_chroot(args) }
    if sys.same(name, "ionice") { return ms.run_ionice(args) }
    sys.warn(name, "applet not found")
    return 127
}

fn busybox(args: Vec<str>): i64 {
    let o = sys.out_new(1)
    if args.len() == 0 || sys.same(args[0], "--help") {
        sys.out_str(o, "BusyBox (DevLang) multi-call binary.\nUsage: busybox [function [arguments]...]\n   or: function [arguments]...\n\nCurrently defined functions:\n")
        let names = applet_names()
        for i in 0..(names.len() as i64) { sys.out_str(o, i % 8 == 0 ? "\t" : " "); sys.out_str(o, names[i]); if i + 1 < (names.len() as i64) { sys.out_str(o, ",") }; if i % 8 == 7 { sys.out_str(o, "\n") } }
        sys.out_str(o, "\n"); sys.out_flush(o)
        return args.len() == 0 ? 0 : 0
    }
    if sys.same(args[0], "--list") {
        let names = applet_names()
        for i in 0..(names.len() as i64) { sys.out_str(o, names[i]); sys.out_byte(o, 10) }
        sys.out_flush(o)
        return 0
    }
    let rest = Vec<str>()
    for i in 1..(args.len() as i64) { rest.push(args[i]) }
    return applet(args[0], rest)
}

fn main(): i32 {
    let a = sys.argv()
    if a.len() == 0 { return 1 }
    let name = sys.base_name(a[0])
    let rest = Vec<str>()
    for i in 1..(a.len() as i64) { rest.push(a[i]) }
    if sys.same(name, "busybox") { return busybox(rest) as i32 }
    return applet(name, rest) as i32
}
return main()
