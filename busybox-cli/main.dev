fn busybox(args: Vec<str>): i64 {
    let o = sys.out_new(1)
    if args.len() == 0 || sys.same(args[0], "--help") {
        sys.out_str(o, "BusyBox (DevLang) multi-call binary.\nUsage: busybox [function [arguments]...]\n   or: function [arguments]...\n\nCurrently defined functions:\n")
        let names = applet_names()
        for i in 0..(names.len() as i64) { sys.out_str(o, i % 8 == 0 ? "\t" : " "); sys.out_str(o, names[i]); if i + 1 < (names.len() as i64) { sys.out_str(o, ",") }; if i % 8 == 7 { sys.out_str(o, "\n") } }
        sys.out_str(o, "\n"); sys.out_flush(o)
        return args.len() == 0 ? 0 : 0
    }
    if sys.same(args[0], "--list") {
        let names = applet_names()
        for i in 0..(names.len() as i64) { sys.out_str(o, names[i]); sys.out_byte(o, 10) }
        sys.out_flush(o)
        return 0
    }
    let rest = Vec<str>()
    for i in 1..(args.len() as i64) { rest.push(args[i]) }
    return applet(args[0], rest)
}

fn main(): i32 {
    let a = sys.argv()
    if a.len() == 0 { return 1 }
    let name = sys.base_name(a[0])
    let rest = Vec<str>()
    for i in 1..(a.len() as i64) { rest.push(a[i]) }
    if sys.same(name, "busybox") { return busybox(rest) as i32 }
    return applet(name, rest) as i32
}
return main()
