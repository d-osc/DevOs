# busybox: the multi-call program. `busybox APPLET [ARGS]` or, through a link named after the applet, `APPLET [ARGS]`.
use "./lib/sys.dev" as sys
use "./applets/basic.dev" as basic
use "./applets/text.dev" as text
use "./applets/files.dev" as files
use "./applets/sort.dev" as sorts
use "./applets/filters.dev" as filt
use "./applets/sysinfo.dev" as si
use "./applets/procs.dev" as pr
