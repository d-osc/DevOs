fn applet(name: str, args: Vec<str>): i64 {
    if sys.same(name, "true") { return basic.run_true(args) }
    if sys.same(name, "false") { return basic.run_false(args) }
    if sys.same(name, "echo") { return basic.run_echo(args) }
    if sys.same(name, "pwd") { return basic.run_pwd(args) }
    if sys.same(name, "yes") { return basic.run_yes(args) }
    if sys.same(name, "basename") { return basic.run_basename(args) }
    if sys.same(name, "dirname") { return basic.run_dirname(args) }
    if sys.same(name, "sleep") { return basic.run_sleep(args) }
    if sys.same(name, "cat") { return text.run_cat(args) }
    if sys.same(name, "tee") { return text.run_tee(args) }
    if sys.same(name, "head") { return text.run_head(args) }
    if sys.same(name, "tail") { return text.run_tail(args) }
    if sys.same(name, "wc") { return text.run_wc(args) }
    if sys.same(name, "seq") { return text.run_seq(args) }
    if sys.same(name, "mkdir") { return files.run_mkdir(args) }
    if sys.same(name, "rmdir") { return files.run_rmdir(args) }
    if sys.same(name, "rm") { return files.run_rm(args) }
    if sys.same(name, "touch") { return files.run_touch(args) }
    if sys.same(name, "ln") { return files.run_ln(args) }
    if sys.same(name, "readlink") { return files.run_readlink(args) }
    if sys.same(name, "realpath") { return files.run_realpath(args) }
    if sys.same(name, "cp") { return files.run_cp(args) }
    if sys.same(name, "mv") { return files.run_mv(args) }
    if sys.same(name, "install") { return files.run_install(args) }
    if sys.same(name, "chmod") { return files.run_chmod(args) }
    if sys.same(name, "chown") { return files.run_chown(args) }
    if sys.same(name, "chgrp") { return files.run_chgrp(args) }
    if sys.same(name, "mktemp") { return files.run_mktemp(args) }
    if sys.same(name, "mkfifo") { return files.run_mkfifo(args) }
    if sys.same(name, "sync") { return files.run_sync(args) }
    if sys.same(name, "sort") { return sorts.run_sort(args) }
