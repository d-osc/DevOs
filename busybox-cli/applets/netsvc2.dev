# tcpsvd, inetd, telnetd, tftp, tftpd: connection servers and the TFTP client. Programs started for a connection get the socket as standard input and output.
use "../lib/sys.dev" as sys
use "../lib/fsx.dev" as fsx
use "../lib/lines.dev" as lines
use "../lib/proc.dev" as proc
use "../lib/net.dev" as net
use "./gzip.dev" as gz

fn decimal(v: i64): str { let b = sys.bytes_new(); sys.bytes_num(b, v); return sys.join2(sys.bytes_cstr(b), "") }
fn fields_of(line: str): Vec<str> {
    let out = Vec<str>(); let start = 0 - 1; let n = sys.length(line)
    for i in 0..(n + 1) {
        let blank = i == n || sys.at(line, i) == 32 || sys.at(line, i) == 9
        if blank { if start >= 0 { out.push(sys.join2(sys.slice(line, start, i), "")); start = 0 - 1 } } else if start < 0 { start = i }
    }
    return out
}
// Starts `cmd` on a connection and reaps finished children; the parent closes its copy of the socket.
fn serve_connection(client: i64, cmd: Vec<str>, env: Vec<str>) {
    let pid = proc.launch_fds(cmd, env, client, client)
    sys.close_fd(client)
    if pid < 0 { sys.warn("server", "can't start the program") }
    proc.poll_exit(0 - 1)
}
fn reap() { proc.poll_exit(0 - 1) }

// ---- tcpsvd [-v] [-c N] IP PORT PROG [ARGS] ----------------------------------------------------------------------------------------------------------------------------------
fn run_tcpsvd(args: Vec<str>): i64 {
    let words = Vec<str>(); let i = 0; let n = args.len() as i64; let verbose = false; let limit = 30
    while i < n {
        let a = args[i]
        if words.len() == 0 && sys.length(a) > 1 && sys.at(a, 0) == 45 {
            if sys.same(a, "-v") { verbose = true } else if (sys.same(a, "-c") || sys.same(a, "-C") || sys.same(a, "-u") || sys.same(a, "-l") || sys.same(a, "-b") || sys.same(a, "-i") || sys.same(a, "-x") || sys.same(a, "-t")) && i + 1 < n { if sys.same(a, "-c") { limit = sys.parse_number(args[i + 1]).value }; i = i + 1 }
            i = i + 1; continue
        }
        words.push(a); i = i + 1
    }
    if words.len() < 3 { sys.warn("tcpsvd", "invalid usage: tcpsvd [-v] [-c N] IP PORT PROG [ARGS]"); return 1 }
    let port = sys.parse_number(words[1]); if !port.ok { sys.warn("tcpsvd", "bad port"); return 1 }
    let bind_ip = net.resolve(words[0]); let server = net.listen_on(port.value)
    if server < 0 { sys.warn("tcpsvd", "can't bind the port"); return 1 }
    let cmd = Vec<str>(); for k in 2..(words.len() as i64) { cmd.push(words[k]) }
    if verbose { sys.put_fd(2, sys.join2(sys.join2("tcpsvd: listening on ", words[0]), sys.join2(":", sys.join2(decimal(port.value), "\n")))) }
    while true {
        let peer = net.make_address(0, 0)
        let client = net.accept_peer(server, peer)
        if client < 0 { reap(); continue }
        let env = proc.environment()
        env = proc.set_variable(env, "PROTO", "TCP"); env = proc.set_variable(env, "TCPREMOTEIP", net.ip_text(net.peer_ip(peer))); env = proc.set_variable(env, "TCPREMOTEPORT", decimal(net.peer_port(peer)))
        env = proc.set_variable(env, "TCPLOCALIP", words[0]); env = proc.set_variable(env, "TCPLOCALPORT", decimal(port.value))
        if verbose { sys.put_fd(2, sys.join2(sys.join2("tcpsvd: connection from ", net.ip_text(net.peer_ip(peer))), sys.join2(":", sys.join2(decimal(net.peer_port(peer)), "\n")))) }
        serve_connection(client, cmd, env)
    }
    return 0
}

// ---- inetd [-f] [CONFFILE]: "service stream tcp nowait user program args..." (the built-in echo, discard and daytime services too) ------------------------------------------------
fn service_port(name: str): i64 {
    let n = sys.parse_number(name); if n.ok { return n.value }
    let input = sys.read_path("/etc/services"); if !input.ok { return 0 - 1 }
    let ls = lines.split_lines(input.bytes, 10); let want = sys.join2(name, "")
    for k in 0..(ls.starts.len() as i64) {
        let parts = fields_of(lines.text_of(input.bytes, ls.starts[k], ls.ends[k]))
        if parts.len() >= 2 && !sys.starts(parts[0], "#") && sys.same(parts[0], want) { let slash = sys.find_char(parts[1], 47); return sys.parse_number(sys.join2(sys.slice(parts[1], 0, slash < 0 ? sys.length(parts[1]) : slash), "")).value }
    }
    return 0 - 1
}
struct Service { fd: i64, program: Vec<str>, internal: str }
fn run_inetd(args: Vec<str>): i64 {
    let conf = "/etc/inetd.conf"; for k in 0..(args.len() as i64) { if !sys.starts(args[k], "-") { conf = args[k] } }
    let input = sys.read_path(conf); if !input.ok { sys.warn_path("inetd", conf); return 1 }
    let ls = lines.split_lines(input.bytes, 10); let services = Vec<Service>()
    for k in 0..(ls.starts.len() as i64) {
        let parts = fields_of(lines.text_of(input.bytes, ls.starts[k], ls.ends[k]))
        if parts.len() < 6 || sys.starts(parts[0], "#") { continue }
        if !sys.same(parts[1], "stream") || !sys.starts(parts[2], "tcp") { continue }
        let port = service_port(parts[0]); if port < 0 { sys.warn("inetd", sys.join2("unknown service ", parts[0])); continue }
        let fd = net.listen_on(port); if fd < 0 { sys.warn("inetd", sys.join2("can't bind port ", decimal(port))); continue }
        let program = Vec<str>(); let internal = ""
        if sys.same(parts[5], "internal") { internal = parts.len() > 6 ? parts[6] : parts[0] } else { program.push(parts[5]); for q in 7..(parts.len() as i64) { program.push(parts[q]) } }
        services.push(Service(fd, program, internal))
    }
    if services.len() == 0 { sys.warn("inetd", "no usable services"); return 1 }
    while true {
        # wait for a connection on any listener by polling them in turn
        let accepted = false
        for s in 0..(services.len() as i64) {
            let client = net.accept_ready(services[s].fd)
            if client < 0 { continue }
            accepted = true
            let service = services[s]
            if sys.length(service.internal) > 0 { internal_service(service.internal, client) } else { serve_connection(client, service.program, proc.environment()) }
        }
        if !accepted { proc.pause_us(50000) }
        reap()
    }
    return 0
}
fn internal_service(name: str, client: i64) {
    if sys.same(name, "daytime") { let b = sys.bytes_new(); sys.bytes_str(b, "daytime\r\n"); net.send_all(client, sys.bdata(b), sys.blen(b)) }
    else if sys.same(name, "echo") {
        let chunk = sys.bytes_new(); for i in 0..4096 { sys.bytes_push(chunk, 0) }
        while true { let n = sys.read_into(client, sys.bdata(chunk), 4096); if n <= 0 { break }; net.send_all(client, sys.bdata(chunk), n) }
    }
    sys.close_fd(client)
}

// ---- telnetd [-p PORT] [-l LOGIN_PROGRAM] [-F] ----------------------------------------------------------------------------------------------------------------------------------
fn run_telnetd(args: Vec<str>): i64 {
    let o = sys.parse_opts(args, "p:l:f:FSKi")
    if o.bad != 0 || o.missing != 0 { sys.warn("telnetd", "invalid usage: telnetd [-p PORT] [-l LOGIN_PROGRAM] [-F]"); return 1 }
    let port = sys.has(o, 112) ? sys.parse_number(sys.val(o, 112)).value : 23
    let login = sys.has(o, 108) ? sys.val(o, 108) : "/bin/login"
    let server = net.listen_on(port); if server < 0 { sys.warn("telnetd", "can't bind the port"); return 1 }
    while true {
        let client = net.accept_one(server)
        if client < 0 { reap(); continue }
        serve_connection(client, Vec<str>(login), proc.environment())
    }
    return 0
}

// ---- tftp [-g|-p] [-l LOCAL] [-r REMOTE] HOST [PORT] -------------------------------------------------------------------------------------------------------------------------------
fn put16(b: *sys.Bytes, v: i64) { sys.bytes_push(b, ((v / 256) % 256) as u8); sys.bytes_push(b, (v % 256) as u8) }
fn run_tftp(args: Vec<str>): i64 {
    let o = sys.parse_opts(args, "gpl:r:b:")
    if o.bad != 0 || o.missing != 0 || o.rest.len() < 1 || o.rest.len() > 2 || (!sys.has(o, 103) && !sys.has(o, 112)) || !sys.has(o, 114) { sys.warn("tftp", "invalid usage: tftp -g|-p [-l LOCAL] -r REMOTE HOST [PORT]"); return 1 }
    let remote = sys.val(o, 114); let local = sys.has(o, 108) ? sys.val(o, 108) : sys.base_name(remote)
    let ip = net.resolve(o.rest[0]); if ip < 0 { sys.warn("tftp", sys.join2(sys.join2("bad address '", o.rest[0]), "'")); return 1 }
    let port = o.rest.len() == 2 ? sys.parse_number(o.rest[1]).value : 69
    let fd = net.open_socket(2, 0); if fd < 0 { sys.warn("tftp", "can't create a socket"); return 1 }
    net.set_timeout(fd, 5)
    let server = net.make_address(ip, port); let peer = net.make_address(0, 0)
    let request = sys.bytes_new(); put16(request, sys.has(o, 103) ? 1 : 2); sys.bytes_str(request, remote); sys.bytes_push(request, 0); sys.bytes_str(request, "octet"); sys.bytes_push(request, 0)
    net.send_to(fd, sys.bdata(request), sys.blen(request), server)
    let buffer = sys.bytes_new(); for i in 0..1024 { sys.bytes_push(buffer, 0) }
    if sys.has(o, 103) {
        let data = sys.bytes_new(); let expected = 1; let target = peer
        while true {
            let n = net.receive_from(fd, sys.bdata(buffer), 1024, peer)
            if n < 4 { sys.warn("tftp", "timeout"); return 1 }
            let opcode = (sys.bat(buffer, 0) as i64) * 256 + (sys.bat(buffer, 1) as i64)
            if opcode == 5 { sys.warn("tftp", sys.join2("server error: ", lines.text_of(buffer, 4, n - 1))); return 1 }
            if opcode != 3 { continue }
            let block = (sys.bat(buffer, 2) as i64) * 256 + (sys.bat(buffer, 3) as i64)
            let ack = sys.bytes_new(); put16(ack, 4); put16(ack, block); net.send_peer(fd, sys.bdata(ack), 4, peer)
            if block == expected { sys.bytes_append(data, sys.bptr(buffer, 4), n - 4); expected = expected + 1; if n - 4 < 512 { break } }
        }
        if !gz.write_file(local, data, 420) { sys.warn_write("tftp", local); return 1 }
        return 0
    }
    let input = sys.read_path(local); if !input.ok { sys.warn_path("tftp", local); return 1 }
    let n = net.receive_from(fd, sys.bdata(buffer), 1024, peer)
    if n < 4 || sys.bat(buffer, 1) != 4 { sys.warn("tftp", "no acknowledgement from the server"); return 1 }
    let total = sys.blen(input.bytes); let block = 1; let pos = 0
    while true {
        let size = total - pos > 512 ? 512 : total - pos
        let packet = sys.bytes_new(); put16(packet, 3); put16(packet, block); sys.bytes_append(packet, sys.bptr(input.bytes, pos), size)
        net.send_peer(fd, sys.bdata(packet), sys.blen(packet), peer)
        let got = net.receive_from(fd, sys.bdata(buffer), 1024, peer)
        if got < 4 { sys.warn("tftp", "timeout"); return 1 }
        pos = pos + size; block = block + 1
        if size < 512 { break }
    }
    return 0
}

// ---- tftpd [-r] [-c] [DIRECTORY] (port 69, or -p PORT; serves one request at a time) -------------------------------------------------------------------------------------
fn run_tftpd(args: Vec<str>): i64 {
    let o = sys.parse_opts(args, "rcup:")
    let dir = o.rest.len() > 0 ? o.rest[0] : "."; let port = sys.has(o, 112) ? sys.parse_number(sys.val(o, 112)).value : 69
    let fd = net.udp_bind(port); if fd < 0 { sys.warn("tftpd", "can't bind the port"); return 1 }
    let buffer = sys.bytes_new(); for i in 0..1024 { sys.bytes_push(buffer, 0) }
    while true {
        let peer = net.make_address(0, 0)
        let n = net.receive_from(fd, sys.bdata(buffer), 1024, peer)
        if n < 4 { continue }
        let opcode = (sys.bat(buffer, 0) as i64) * 256 + (sys.bat(buffer, 1) as i64)
        let name = ""; let k = 2; while k < n && sys.bat(buffer, k) != 0 { name = sys.join2(name, lines.text_of(buffer, k, k + 1)); k = k + 1 }
        let sock = net.open_socket(2, 0); net.set_timeout(sock, 3)
        let path = fsx.join_path(dir, name)
        if opcode == 1 {
            let input = sys.read_path(path)
            if !input.ok || sys.find_char(name, 47) == 0 || has_dotdot(name) { let e = sys.bytes_new(); put16(e, 5); put16(e, 1); sys.bytes_str(e, "File not found"); sys.bytes_push(e, 0); net.send_peer(sock, sys.bdata(e), sys.blen(e), peer); sys.close_fd(sock); continue }
            let total = sys.blen(input.bytes); let block = 1; let pos = 0; let reply = sys.bytes_new(); for i in 0..16 { sys.bytes_push(reply, 0) }
            while true {
                let size = total - pos > 512 ? 512 : total - pos
                let packet = sys.bytes_new(); put16(packet, 3); put16(packet, block); sys.bytes_append(packet, sys.bptr(input.bytes, pos), size)
                net.send_peer(sock, sys.bdata(packet), sys.blen(packet), peer)
                let ack_peer = net.make_address(0, 0)
                let got = net.receive_from(sock, sys.bdata(reply), 16, ack_peer)
                if got < 4 { break }
                pos = pos + size; block = block + 1
                if size < 512 { break }
            }
        }
        sys.close_fd(sock)
    }
    return 0
}
fn has_dotdot(name: str): bool { for i in 0..(sys.length(name) - 1) { if sys.at(name, i) == 46 && sys.at(name, i + 1) == 46 { return true } }; return false }
