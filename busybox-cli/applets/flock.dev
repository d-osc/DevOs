# Linux advisory locks, including the file+command form used by pm-cli.
use "../lib/sys.dev" as sys
use "../lib/proc.dev" as proc
extern fn flock(fd: i32, operation: i32): i32
fn run_flock(args: Vec<str>): i64 {
    let mode = 2; let nonblock = false; let i = 0
    while i < (args.len() as i64) {
        let arg = args[i]; if sys.same(arg,"--") { i = i + 1; break }; if !sys.starts(arg,"-") { break }
        if sys.same(arg,"--exclusive") { mode = 2 } else if sys.same(arg,"--shared") { mode = 1 } else if sys.same(arg,"--unlock") { mode = 8 } else if sys.same(arg,"--nonblock") || sys.same(arg,"--nonblocking") { nonblock = true }
        else { for k in 1..sys.length(arg) { let c = sys.at(arg,k); if c == 120 { mode = 2 } else if c == 115 { mode = 1 } else if c == 117 { mode = 8 } else if c == 110 { nonblock = true } else { sys.warn("flock","usage: flock [-xsn u] FD | FILE COMMAND [ARG...]"); return 2 } } }; i = i + 1
    }
    if i >= (args.len() as i64) { return 2 }; let file = args[i]; i = i + 1; let command = Vec<str>(); while i < (args.len() as i64) { command.push(args[i]); i = i + 1 }
    let owned = command.len() > 0; let number = sys.parse_number(file); let fd = owned ? sys.open_fd(file,131138,384) : (number.ok && number.value >= 0 && number.value <= 2147483647 ? number.value : 0 - 1)
    if fd < 0 { sys.warn("flock","cannot open lock target"); return 2 }; let ok = false; unsafe { ok = flock(fd as i32,(mode | (nonblock ? 4 : 0)) as i32) == 0 }
    if !ok { if owned { sys.close_fd(fd) }; return nonblock ? 1 : 2 }; if !owned { return 0 }
    let status = proc.run_wait(command,proc.environment()); sys.close_fd(fd); return status
}
