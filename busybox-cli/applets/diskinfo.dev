# stat, du, df: file status and disk usage.
use "../lib/sys.dev" as sys
use "../lib/fsx.dev" as fsx
use "../lib/clock.dev" as clock
use "./files.dev" as files

extern fn statvfs(path: str, buffer: *void): i32

fn decimal(v: i64): str { let b = sys.bytes_new(); sys.bytes_num(b, v); return sys.join2(sys.bytes_cstr(b), "") }
fn cells(count: i64): *i64 { unsafe { return sys.calloc(count as usize, 8) as *i64 } }
fn cget(c: *i64, i: i64): i64 { unsafe { return c[i] } }
fn cset(c: *i64, i: i64, v: i64) { unsafe { c[i] = v } }
fn octal(v: i64): str {
    if v == 0 { return "0" }
    let digits = Vec<u8>(); let rest = v
    while rest > 0 { digits.push((48 + rest % 8) as u8); rest = rest / 8 }
    let b = sys.bytes_new(); let i = (digits.len() as i64) - 1
    while i >= 0 { sys.bytes_push(b, digits[i]); i = i - 1 }
    return sys.join2(sys.bytes_cstr(b), "")
}
fn hex(v: i64): str {
    if v == 0 { return "0" }
    let digits = Vec<u8>(); let rest = v; let table = "0123456789abcdef"
    while rest > 0 { digits.push(sys.at(table, rest % 16)); rest = rest / 16 }
    let b = sys.bytes_new(); let i = (digits.len() as i64) - 1
    while i >= 0 { sys.bytes_push(b, digits[i]); i = i - 1 }
    return sys.join2(sys.bytes_cstr(b), "")
}
fn type_char(mode: i64): u8 {
    let kind = (mode / 4096) % 16
    if kind == 4 { return 100 } if kind == 10 { return 108 } if kind == 6 { return 98 } if kind == 2 { return 99 } if kind == 1 { return 112 } if kind == 12 { return 115 }
    return 45
}
fn type_name(info: sys.Info): str {
    let kind = (info.mode / 4096) % 16
    if kind == 8 { return info.size == 0 ? "regular empty file" : "regular file" }
    if kind == 4 { return "directory" } if kind == 10 { return "symbolic link" } if kind == 6 { return "block special file" } if kind == 2 { return "character special file" }
    if kind == 1 { return "fifo" } if kind == 12 { return "socket" }
    return "weird file"
}
fn stamp(t: i64): str { return clock.format("%Y-%m-%d %H:%M:%S.000000000 %z", clock.fields(t, false), t, false) }
fn owner_name(uid: i64): str { let n = fsx.user_name(uid); return sys.length(n) > 0 ? n : "UNKNOWN" }
fn group_name(gid: i64): str { let n = fsx.group_name(gid); return sys.length(n) > 0 ? n : "UNKNOWN" }
fn quoted(path: str, target: str): str {
    let q = sys.join2(sys.join2("'", path), "'")
    if sys.length(target) > 0 { return sys.join2(sys.join2(q, " -> '"), sys.join2(target, "'")) }
    return q
}
fn mode_text(mode: i64): str {
    let t = sys.bytes_new(); sys.bytes_push(t, type_char(mode)); sys.bytes_str(t, fsx.mode_string(mode))
    return sys.join2(sys.bytes_cstr(t), "")
}
fn stat_field(e: u8, path: str, info: sys.Info, target: str): str {
    if e == 110 { return path }
    if e == 78 { return quoted(path, target) }
    if e == 115 { return decimal(info.size) }
    if e == 98 { return decimal(info.blocks) }
    if e == 66 { return "512" }
    if e == 70 { return type_name(info) }
    if e == 102 { return hex(info.mode) }
    if e == 97 { return octal(sys.permission_bits(info.mode)) }
    if e == 65 { return mode_text(info.mode) }
    if e == 117 { return decimal(info.uid) }
    if e == 85 { return owner_name(info.uid) }
    if e == 103 { return decimal(info.gid) }
    if e == 71 { return group_name(info.gid) }
    if e == 104 { return decimal(info.nlink) }
    if e == 105 { return decimal(info.inode) }
    if e == 100 { return decimal(info.dev) }
    if e == 68 { return hex(info.dev) }
    if e == 116 { return hex((info.rdev / 256) % 4096) }
    if e == 84 { return hex((info.rdev % 256) + (info.rdev / 1048576) * 256) }
    if e == 120 { return stamp(info.atime) }
    if e == 121 { return stamp(info.mtime) }
    if e == 122 { return stamp(info.ctime) }
    if e == 88 { return decimal(info.atime) }
    if e == 89 { return decimal(info.mtime) }
    if e == 90 { return decimal(info.ctime) }
    if e == 111 { return "4096" }
    if e == 87 { return "0" }
    if e == 37 { return "%" }
    let t = sys.bytes_new(); sys.bytes_push(t, 37); sys.bytes_push(t, e)
    return sys.join2(sys.bytes_cstr(t), "")
}
fn stat_format(fmt: str, path: str, info: sys.Info): str {
    let b = sys.bytes_new(); let n = sys.length(fmt); let i = 0
    while i < n {
        let c = sys.at(fmt, i)
        if c != 37 || i + 1 >= n { sys.bytes_push(b, c); i = i + 1; continue }
        let e = sys.at(fmt, i + 1); i = i + 2
        let target = sys.is_link_mode(info.mode) ? fsx.read_link(path) : ""
        sys.bytes_str(b, stat_field(e, path, info, target))
    }
    return sys.join2(sys.bytes_cstr(b), "")
}
fn run_stat(args: Vec<str>): i64 {
    let o = sys.parse_opts(args, "c:Lt")
    if o.bad != 0 || o.missing != 0 || o.rest.len() == 0 { sys.warn("stat", "invalid usage: stat [-Lt] [-c FORMAT] FILE..."); return 1 }
    let out = sys.out_new(1); let status = 0
    let terse = "%n %s %b %f %u %g %D %i %h %t %T %X %Y %Z 0 4096"
    for k in 0..(o.rest.len() as i64) {
        let path = o.rest[k]
        let info = sys.file_info(path, sys.has(o, 76))
        if !info.ok { sys.warn("stat", sys.join2(sys.join2("cannot stat '", path), sys.join2("': ", sys.path_error(path, false)))); status = 1; continue }
        if sys.has(o, 99) { sys.out_str(out, stat_format(sys.val(o, 99), path, info)); sys.out_byte(out, 10); continue }
        if sys.has(o, 116) { sys.out_str(out, stat_format(terse, path, info)); sys.out_byte(out, 10); continue }
        sys.out_str(out, stat_format(sys.join2(sys.is_link_mode(info.mode) ? "  File: %N" : "  File: %n", "\n  Size: %s\tBlocks: %b\tIO Block: %o\t%F\nDevice: %Dh/%dd\tInode: %i\tLinks: %h\nAccess: (%a/%A)  Uid: (%u/%U)   Gid: (%g/%G)\nAccess: %x\nModify: %y\nChange: %z\n Birth: -"), path, info)); sys.out_byte(out, 10)
    }
    sys.out_flush(out)
    return status
}

# ---- du ------------------------------------------------------------------------------------------------------------------------------------------------------------
# cells: 0 summary only, 1 all files, 2 block size divisor, 3 max depth (-1), 4 grand total, 5 status, 6 follow, 7 apparent size
fn size_label(c: *i64, blocks: i64, size: i64, human: bool): str {
    let bytes = cget(c, 7) != 0 ? size : blocks * 512
    if human {
        if bytes < 1024 { return decimal(bytes) }
        let units = "KMGTPE"; let unit = 1024; let k = 0
        while bytes >= unit * 1024 && k < 5 { unit = unit * 1024; k = k + 1 }
        let tenths = (bytes * 10 + unit - 1) / unit
        let b = sys.bytes_new()
        if tenths < 100 { sys.bytes_num(b, tenths / 10); sys.bytes_push(b, 46); sys.bytes_num(b, tenths % 10) } else { sys.bytes_num(b, (bytes + unit - 1) / unit) }
        sys.bytes_push(b, sys.at(units, k))
        return sys.join2(sys.bytes_cstr(b), "")
    }
    let divisor = cget(c, 2)
    return decimal((bytes + divisor - 1) / divisor)
}
struct DuEnv { c: *i64, out: *sys.Out, human: bool, seen: *sys.Bytes }
fn seen_before(e: DuEnv, info: sys.Info): bool {
    if info.nlink <= 1 { return false }
    let key = sys.bytes_new(); sys.bytes_num(key, info.dev); sys.bytes_push(key, 58); sys.bytes_num(key, info.inode); sys.bytes_push(key, 10)
    let hay = lines_contains(e.seen, key)
    if !hay { sys.bytes_append(e.seen, sys.bdata(key), sys.blen(key)) }
    return hay
}
fn lines_contains(hay: *sys.Bytes, key: *sys.Bytes): bool {
    let n = sys.blen(hay); let m = sys.blen(key)
    for i in 0..(n - m + 1) {
        if i > 0 && sys.bat(hay, i - 1) != 10 { continue }
        let ok = true
        for k in 0..m { if sys.bat(hay, i + k) != sys.bat(key, k) { ok = false; break } }
        if ok { return true }
    }
    return false
}
# Returns the usage (in blocks of 512 bytes, or bytes with -b) of path and prints lines as it goes.
fn du_walk(e: DuEnv, path: str, depth: i64, top: bool): i64 {
    let c = e.c
    let info = sys.file_info(path, cget(c, 6) != 0 || top && cget(c, 6) == 2)
    if !info.ok { sys.warn("du", sys.join2(sys.join2("cannot access '", path), sys.join2("': ", sys.path_error(path, false)))); cset(c, 5, 1); return 0 }
    let own = cget(c, 7) != 0 ? info.size : info.blocks
    if seen_before(e, info) && !sys.is_dir_mode(info.mode) { return 0 }
    let total = own
    if sys.is_dir_mode(info.mode) {
        let l = fsx.list_dir(path)
        if !l.ok { sys.warn("du", sys.join2(sys.join2("cannot read directory '", path), "': Permission denied")); cset(c, 5, 1) }
        else { for k in 0..(l.names.len() as i64) { total = total + du_walk(e, fsx.join_path(path, l.names[k]), depth + 1, false) } }
    }
    let maxd = cget(c, 3)
    let show = false
    if sys.is_dir_mode(info.mode) { show = cget(c, 0) == 0 ? (maxd < 0 || depth <= maxd) : depth == 0 }
    else { show = depth == 0 || (cget(c, 1) != 0 && cget(c, 0) == 0 && (maxd < 0 || depth <= maxd)) }
    if show {
        let units = cget(c, 7) != 0 ? total : total * 512
        sys.out_str(e.out, size_label(c, cget(c, 7) != 0 ? 0 : total, cget(c, 7) != 0 ? total : 0, e.human)); sys.out_byte(e.out, 9); sys.out_str(e.out, path); sys.out_byte(e.out, 10)
    }
    return total
}
fn run_du(args: Vec<str>): i64 {
    let o = sys.parse_opts(args, "ashkmcxLbld:")
    if o.bad != 0 || o.missing != 0 { sys.warn("du", "invalid usage: du [-aHLdclsxhmk] [FILE]..."); return 1 }
    let c = cells(10)
    cset(c, 0, sys.has(o, 115) ? 1 : 0); cset(c, 1, sys.has(o, 97) ? 1 : 0); cset(c, 2, 1024); cset(c, 3, 0 - 1)
    if sys.has(o, 109) { cset(c, 2, 1048576) }
    if sys.has(o, 98) { cset(c, 7, 1); cset(c, 2, 1) }
    if sys.has(o, 76) { cset(c, 6, 1) }
    if sys.has(o, 100) { let v = sys.parse_number(sys.val(o, 100)); cset(c, 3, v.ok ? v.value : 0) }
    let e = DuEnv(c, sys.out_new(1), sys.has(o, 104), sys.bytes_new())
    let paths = o.rest; if paths.len() == 0 { paths.push(".") }
    let grand = 0
    for k in 0..(paths.len() as i64) { grand = grand + du_walk(e, paths[k], 0, true) }
    if sys.has(o, 99) { sys.out_str(e.out, size_label(c, cget(c, 7) != 0 ? 0 : grand, cget(c, 7) != 0 ? grand : 0, e.human)); sys.out_str(e.out, "\ttotal\n") }
    sys.out_flush(e.out)
    return cget(c, 5)
}

# ---- df ------------------------------------------------------------------------------------------------------------------------------------------------------------
fn percent(used: i64, avail: i64): str {
    let total = used + avail
    if total == 0 { return "-" }
    return sys.join2(decimal((used * 100 + total - 1) / total), "%")
}
fn scaled(v: i64, block: i64, human: bool): str {
    if !human { return decimal(v / block) }
    let bytes = v
    if bytes < 1024 { return decimal(bytes) }
    let units = "KMGTPE"; let unit = 1024; let k = 0
    while bytes >= unit * 1024 && k < 5 { unit = unit * 1024; k = k + 1 }
    let tenths = (bytes * 10 + unit - 1) / unit
    let b = sys.bytes_new()
    if tenths < 100 { sys.bytes_num(b, tenths / 10); sys.bytes_push(b, 46); sys.bytes_num(b, tenths % 10) } else { sys.bytes_num(b, (bytes + unit - 1) / unit) }
    sys.bytes_push(b, sys.at(units, k))
    return sys.join2(sys.bytes_cstr(b), "")
}
struct Fs { ok: bool, blocks: i64, free: i64, avail: i64, files: i64, ffree: i64, frsize: i64 }
fn fs_of(path: str): Fs { unsafe {
    let buffer = sys.calloc(128, 1) as *u8
    if statvfs(path, buffer as *void) != 0 { sys.free(buffer as *void); return Fs(false, 0, 0, 0, 0, 0, 1) }
    let f = Fs(true, sys.le(buffer, 16, 8), sys.le(buffer, 24, 8), sys.le(buffer, 32, 8), sys.le(buffer, 40, 8), sys.le(buffer, 48, 8), sys.le(buffer, 8, 8))
    sys.free(buffer as *void)
    return f
} }
fn pad_right(text: str, width: i64): str { let b = sys.bytes_new(); sys.bytes_str(b, text); for i in 0..(width - sys.length(text)) { sys.bytes_push(b, 32) }; return sys.join2(sys.bytes_cstr(b), "") }
fn pad_left(text: str, width: i64): str { let b = sys.bytes_new(); for i in 0..(width - sys.length(text)) { sys.bytes_push(b, 32) }; sys.bytes_str(b, text); return sys.join2(sys.bytes_cstr(b), "") }
fn run_df(args: Vec<str>): i64 {
    let o = sys.parse_opts(args, "hkPiaTm")
    if o.bad != 0 { sys.warn("df", "invalid usage: df [-PkmhTai] [FILESYSTEM]..."); return 1 }
    let human = sys.has(o, 104); let block = sys.has(o, 109) ? 1048576 : 1024
    let inodes = sys.has(o, 105); let portable = sys.has(o, 80)
    let names = Vec<str>(); let points = Vec<str>(); let types = Vec<str>()
    let mounts = sys.read_path("/proc/mounts")
    if mounts.ok {
        let b = mounts.bytes; let n = sys.blen(b); let start = 0
        for i in 0..(n + 1) {
            if i == n || sys.bat(b, i) == 10 {
                let line = copy_range(b, start, i); start = i + 1
                let parts = words(line)
                if parts.len() >= 3 { names.push(parts[0]); points.push(parts[1]); types.push(parts[2]) }
            }
        }
    }
    let wanted = o.rest; let failed = 0
    let rows_name = Vec<str>(); let rows_point = Vec<str>(); let rows_type = Vec<str>()
    if wanted.len() == 0 {
        for k in 0..(points.len() as i64) {
            let fs = fs_of(points[k])
            if !fs.ok || (fs.blocks == 0 && !sys.has(o, 97)) { continue }
            let dup = false; for q in 0..(rows_name.len() as i64) { if sys.same(rows_name[q], names[k]) && sys.same(rows_point[q], points[k]) { dup = true } }
            if sys.starts(names[k], "/") || sys.has(o, 97) || fs.blocks > 0 { rows_name.push(names[k]); rows_point.push(points[k]); rows_type.push(types[k]) }
        }
    } else {
        for k in 0..(wanted.len() as i64) {
            let best = 0 - 1; let best_len = 0 - 1
            let real = files.canonical(wanted[k], false)
            for q in 0..(points.len() as i64) {
                let p = points[q]; let pl = sys.length(p)
                if (sys.same(p, "/") || sys.same(real, p) || sys.starts(real, sys.join2(p, "/"))) && pl > best_len { best = q; best_len = pl }
            }
            if sys.length(real) == 0 { sys.warn("df", sys.join2(wanted[k], ": No such file or directory")); failed = 1; continue }
            if best < 0 { sys.warn("df", sys.join2(wanted[k], ": No such file or directory")); continue }
            rows_name.push(names[best]); rows_point.push(points[best]); rows_type.push(types[best])
        }
    }
    if rows_name.len() == 0 && wanted.len() > 0 { return 1 }
    let out = sys.out_new(1)
    let head = inodes ? "Inodes" : (human ? "Size" : (sys.has(o, 109) ? "1M-blocks" : (portable ? "1024-blocks" : "1K-blocks")))
    let lines = Vec<Vec<str>>()
    let header = Vec<str>("Filesystem")
    if sys.has(o, 84) { header.push("Type") }
    header.push(head); header.push(inodes ? "IUsed" : "Used"); header.push(inodes ? "IFree" : (human ? "Avail" : "Available")); header.push(inodes ? "IUse%" : (portable ? "Capacity" : "Use%")); header.push("Mounted on")
    lines.push(header)
    for k in 0..(rows_name.len() as i64) {
        let fs = fs_of(rows_point[k])
        let row = Vec<str>(rows_name[k])
        if sys.has(o, 84) { row.push(rows_type[k]) }
        if inodes { row.push(decimal(fs.files)); row.push(decimal(fs.files - fs.ffree)); row.push(decimal(fs.ffree)); row.push(percent(fs.files - fs.ffree, fs.ffree)) }
        else {
            let unit = fs.frsize
            row.push(scaled(fs.blocks * unit, block, human)); row.push(scaled((fs.blocks - fs.free) * unit, block, human)); row.push(scaled(fs.avail * unit, block, human))
            row.push(percent(fs.blocks - fs.free, fs.avail))
        }
        row.push(rows_point[k])
        lines.push(row)
    }
    let cols = (lines[0].len() as i64)
    let widths = cells(cols)
    cset(widths, 0, 14)
    for r in 0..(lines.len() as i64) { for c in 0..cols { if sys.length(lines[r][c]) > cget(widths, c) { cset(widths, c, sys.length(lines[r][c])) } } }
    for r in 0..(lines.len() as i64) {
        for c in 0..cols {
            if c > 0 { sys.out_byte(out, 32) }
            let cell = lines[r][c]
            if c == 0 || c == cols - 1 { sys.out_str(out, c == cols - 1 ? cell : pad_right(cell, cget(widths, c))) } else { sys.out_str(out, pad_left(cell, cget(widths, c))) }
        }
        sys.out_byte(out, 10)
    }
    sys.out_flush(out)
    return failed
}
fn copy_range(b: *sys.Bytes, from: i64, to: i64): str {
    let out = sys.bytes_new()
    for q in from..to { sys.bytes_push(out, sys.bat(b, q)) }
    return sys.join2(sys.bytes_cstr(out), "")
}
fn words(line: str): Vec<str> {
    let out = Vec<str>(); let start = 0 - 1; let n = sys.length(line)
    for i in 0..(n + 1) {
        let blank = i == n || sys.at(line, i) == 32 || sys.at(line, i) == 9
        if blank { if start >= 0 { out.push(sys.join2(sys.slice(line, start, i), "")); start = 0 - 1 } } else if start < 0 { start = i }
    }
    return out
}
