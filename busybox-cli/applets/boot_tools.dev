# Boot integration helpers. The POSIX shell is a separately packaged dash;
# the multi-call binary does not embed an upstream BusyBox shell.
use "../lib/sys.dev" as sys
use "../lib/proc.dev" as proc
use "./hardware.dev" as hw
use "./boot.dev" as boot
extern fn sync()
fn exec(path: str, args: Vec<str>): i64 { let argv = proc.pointer_array(args); let envp = proc.pointer_array(proc.environment()); unsafe { proc.execve(path, argv, envp) }; sys.warn_path(args[0], path); return 126 }
fn run_sh(args: Vec<str>): i64 { let command = Vec<str>("sh"); for arg in args { command.push(arg) }; let path = proc.is_executable_file("/usr/libexec/devos/dash") ? "/usr/libexec/devos/dash" : "/bin/dash"; return exec(path, command) }
fn run_ash(args: Vec<str>): i64 { return run_sh(args) }
fn run_cttyhack(args: Vec<str>): i64 {
    if args.len() == 0 { return 1 }; let fd = sys.open_fd("/dev/tty", 2, 0)
    if fd >= 0 { sys.close_fd(fd) } else {
        if hw.control(0, 0x540e, 0) != 0 {
            let active = sys.read_path("/sys/class/tty/console/active"); let name = sys.bytes_new(); let last = ""
            if active.ok { for i in 0..(sys.blen(active.bytes) + 1) { let c = i < sys.blen(active.bytes) ? sys.bat(active.bytes, i) : (32 as u8); if c == 32 || c == 10 { if sys.blen(name) > 0 { last = sys.join2(sys.bytes_cstr(name), ""); sys.bclear(name) } } else if (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) { sys.bytes_push(name, c) } } }
            let console = sys.length(last) > 0 ? sys.open_fd(sys.join2("/dev/", last), 2, 0) : 0 - 1
            if console < 0 || hw.control(console, 0x540e, 0) != 0 { if console >= 0 { sys.close_fd(console) }; sys.warn("cttyhack", "cannot acquire controlling terminal"); return 1 }
            unsafe { for i in 0..3 { proc.dup2(console as i32, i as i32) } }; if console > 2 { sys.close_fd(console) }
        }
    }
    let program = proc.find_program(args[0], proc.environment()); if sys.length(program) == 0 { return 127 }; return exec(program, args)
}
fn shutdown(args: Vec<str>, signal: i64, command: i64): i64 {
    let o = sys.parse_opts(args, "fnd:"); if o.bad != 0 || o.missing != 0 || o.rest.len() != 0 { return 1 }
    if sys.has(o, 100) { let delay = sys.parse_number(sys.val(o, 100)); if !delay.ok || delay.value < 0 || delay.value > 86400 { return 1 }; for i in 0..delay.value { unsafe { proc.usleep(1000000) } } }
    if !sys.has(o, 110) { unsafe { sync() } }
    if !sys.has(o, 102) { return proc.send_signal(1, signal) ? 0 : 1 }
    unsafe { if boot.reboot(command as i32) == 0 { return 0 } }; sys.warn("shutdown", "reboot syscall failed"); return 1
}
fn run_poweroff(args: Vec<str>): i64 { return shutdown(args, 12, 0x4321fedc) }
fn run_halt(args: Vec<str>): i64 { return shutdown(args, 10, 0xcdef0123) }
fn run_reboot(args: Vec<str>): i64 { return shutdown(args, 15, 0x1234567) }
