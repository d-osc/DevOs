use "../lib/sys.dev" as sys
use "../lib/fsx.dev" as fsx
use "../lib/net.dev" as net
use "../lib/rtnl.dev" as nl
use "./ip.dev" as ip
use "./hardware.dev" as hw
use "./console_extra.dev" as cx
use "./replay.dev" as decimal

fn read_text(path: str): str { let b = sys.read_path(path); if !b.ok { return "?" }; let n = sys.blen(b.bytes); while n > 0 && (sys.bat(b.bytes, n - 1) == 10 || sys.bat(b.bytes, n - 1) == 13) { n = n - 1 }; return sys.slice(sys.bytes_cstr(b.bytes), 0, n) }
fn write_text(path: str, text: str): bool {
    let fd = sys.open_fd(path, 1, 0); if fd < 0 { return false }; let b = sys.bytes_new(); sys.bytes_str(b, text); let n = sys.write_fd(fd, sys.bdata(b), sys.blen(b)); sys.close_fd(fd); return n == sys.blen(b)
}
fn run_brctl(args: Vec<str>): i64 {
    if args.len() == 0 { sys.warn("brctl", "usage: brctl COMMAND [BRIDGE [INTERFACE]]"); return 1 }
    let command = args[0]
    if sys.same(command, "show") {
        let names = args.len() == 2 ? Vec<str>(args[1]) : fsx.list_dir("/sys/class/net").names
        sys.put_fd(1, "bridge name\tbridge id\t\tSTP enabled\tinterfaces\n")
        for name in names {
            let path = sys.join2("/sys/class/net/", sys.join2(name, "/bridge")); if !sys.is_dir(path) { if args.len() == 2 { sys.warn("brctl", "not a bridge"); return 1 }; continue }
            let ports = fsx.list_dir(sys.join2("/sys/class/net/", sys.join2(name, "/brif")))
            sys.put_fd(1, sys.join2(name, sys.join2("\t\t", sys.join2(read_text(sys.join2(path, "/bridge_id")), sys.join2("\t", sys.same(read_text(sys.join2(path, "/stp_state")), "0") ? "no\t\t" : "yes\t\t")))))
            if ports.names.len() == 0 { sys.put_fd(1, "\n") } else { for i in 0..(ports.names.len() as i64) { sys.put_fd(1, sys.join2(i == 0 ? "" : "\t\t\t\t\t\t", sys.join2(ports.names[i], "\n"))) } }
        }; return 0
    }
    if args.len() < 2 { return 1 }
    if sys.same(command, "addbr") && args.len() == 2 { return ip.link(Vec<str>("add", args[1], "type", "bridge")) }
    if sys.same(command, "delbr") && args.len() == 2 { return ip.link(Vec<str>("del", args[1])) }
    if (sys.same(command, "addif") || sys.same(command, "delif")) && args.len() == 3 {
        return ip.link(sys.same(command, "addif") ? Vec<str>("set", args[2], "master", args[1]) : Vec<str>("set", args[2], "nomaster"))
    }
    let field = ""; let ticks = false
    if sys.same(command, "setageing") { field = "ageing_time"; ticks = true }
    else if sys.same(command, "setfd") { field = "forward_delay"; ticks = true }
    else if sys.same(command, "sethello") { field = "hello_time"; ticks = true }
    else if sys.same(command, "setmaxage") { field = "max_age"; ticks = true }
    else if sys.same(command, "setbridgeprio") { field = "priority" }
    else if sys.same(command, "stp") { field = "stp_state" }
    if sys.length(field) > 0 && args.len() == 3 {
        let value = args[2]; let number = sys.Number(false, 0)
        if ticks { let n = decimal.decimal(value); number = sys.Number(n.ok && n.value <= 42949672.0, (n.value * 100.0) as i64) }
        else if sys.same(field, "stp_state") { number = sys.Number(true, sys.same(value, "on") || sys.same(value, "yes") || sys.same(value, "1") ? 1 : 0); if !sys.same(value, "on") && !sys.same(value, "yes") && !sys.same(value, "1") && !sys.same(value, "off") && !sys.same(value, "no") && !sys.same(value, "0") { return 1 } }
        else { number = cx.unsigned(value) }
        if !number.ok { sys.warn("brctl", "invalid value"); return 1 }
        if !write_text(sys.join2("/sys/class/net/", sys.join2(args[1], sys.join2("/bridge/", field))), hw.decimal(number.value)) { sys.warn("brctl", "cannot update bridge setting"); return 1 }; return 0
    }
    if (sys.same(command, "setpathcost") || sys.same(command, "setportprio")) && args.len() == 4 {
        let value = cx.unsigned(args[3]); if !value.ok || !sys.exists(sys.join2("/sys/class/net/", sys.join2(args[1], sys.join2("/brif/", args[2])))) { return 1 }
        let path = sys.join2("/sys/class/net/", sys.join2(args[2], sys.join2("/brport/", sys.same(command, "setpathcost") ? "path_cost" : "priority")))
        if !write_text(path, hw.decimal(value.value)) { sys.warn("brctl", "cannot update bridge port"); return 1 }; return 0
    }
    sys.warn("brctl", "invalid command or arguments"); return 1
}
fn run_vconfig(args: Vec<str>): i64 {
    if args.len() < 2 { sys.warn("vconfig", "usage: vconfig add IFACE VID | rem VLAN | set_* ..."); return 1 }
    let command = args[0]
    if sys.same(command, "add") && args.len() == 3 {
        let idx = nl.index(args[1]); let id = cx.unsigned(args[2]); if idx == 0 || !id.ok || id.value > 4094 { sys.warn("vconfig", "invalid device or VLAN ID"); return 1 }
        if sys.length(args[1]) > 15 { return 1 }; let b = cx.buffer(56)
        for i in 0..sys.length(args[1]) { sys.bptr_set(b, 4 + i, sys.at(args[1], i)) }; cx.store(b, 28, 4, id.value); return vlan_ioctl(b)
    }
    if sys.same(command, "rem") && args.len() == 2 { if sys.length(args[1]) > 15 { return 1 }; let b = cx.buffer(56); cx.store(b, 0, 4, 1); for i in 0..sys.length(args[1]) { sys.bptr_set(b, 4 + i, sys.at(args[1], i)) }; return vlan_ioctl(b) }
    let cmd = sys.same(command, "set_ingress_map") ? 2 : (sys.same(command, "set_egress_map") ? 3 : (sys.same(command, "set_name_type") ? 6 : (sys.same(command, "set_flag") ? 7 : 0 - 1)))
    if cmd < 0 || (cmd == 6 ? args.len() != 2 : args.len() != 4) { sys.warn("vconfig", "invalid command arguments"); return 1 }
    let b = cx.buffer(56); cx.store(b, 0, 4, cmd)
    if cmd == 6 {
        let kinds = Vec<str>("VLAN_PLUS_VID", "DEV_PLUS_VID", "VLAN_PLUS_VID_NO_PAD", "DEV_PLUS_VID_NO_PAD"); let found = false
        for i in 0..4 { if sys.same(args[1], kinds[i]) { cx.store(b, 28, 4, i); found = true } }; if !found { return 1 }
    } else {
        if sys.length(args[1]) > 15 { return 1 }; for i in 0..sys.length(args[1]) { sys.bptr_set(b, 4 + i, sys.at(args[1], i)) }
        let first = cx.unsigned(args[2]); let second = cx.unsigned(args[3]); if !first.ok || !second.ok || second.value > 65535 { return 1 }
        cx.store(b, 28, 4, first.value); cx.store(b, 52, 2, second.value)
    }
    return vlan_ioctl(b)
}
fn vlan_ioctl(b: *sys.Bytes): i64 { let fd = net.open_socket(2, 0); if fd < 0 { return 1 }; if hw.control_buffer(fd, 0x8983, b) != 0 { return cx.fail("vconfig", fd, "SIOCSIFVLAN failed") }; sys.close_fd(fd); return 0 }
fn run_ifenslave(args: Vec<str>): i64 {
    let o = sys.parse_opts(args, "cdfv")
    if o.bad != 0 || o.missing != 0 || o.rest.len() < 2 || (sys.has(o, 99) && o.rest.len() != 2) { sys.warn("ifenslave", "usage: ifenslave [-cdfv] MASTER SLAVE..."); return 1 }
    if sys.length(o.rest[0]) > 15 || nl.index(o.rest[0]) == 0 { sys.warn("ifenslave", "invalid master interface"); return 1 }
    let fd = net.open_socket(2, 0); if fd < 0 { return 1 }
    for k in 1..(o.rest.len() as i64) {
        if sys.length(o.rest[k]) > 15 || nl.index(o.rest[k]) == 0 { return cx.fail("ifenslave", fd, "invalid slave interface") }
        let b = cx.buffer(40); for i in 0..sys.length(o.rest[0]) { sys.bptr_set(b, i, sys.at(o.rest[0], i)) }; for i in 0..sys.length(o.rest[k]) { sys.bptr_set(b, 16 + i, sys.at(o.rest[k], i)) }
        if hw.control_buffer(fd, sys.has(o, 100) ? 0x8991 : (sys.has(o, 99) ? 0x8995 : 0x8990), b) != 0 { return cx.fail("ifenslave", fd, "bonding ioctl failed") }
    }
    sys.close_fd(fd); return 0
}
