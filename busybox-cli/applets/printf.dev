# printf FORMAT [ARG...]: formatted output (integers, strings, characters; %f %e %g are not supported).
use "../lib/sys.dev" as sys

fn digit_value(c: u8, base: i64): i64 {
    let v = 0 - 1
    if c >= 48 && c <= 57 { v = (c - 48) as i64 } else if c >= 97 && c <= 102 { v = (c - 87) as i64 } else if c >= 65 && c <= 70 { v = (c - 55) as i64 }
    return v >= 0 && v < base ? v : 0 - 1
}
# One backslash escape starting after the backslash at text[i]; writes its bytes and returns the index after it (-1 after \c).
fn escape_at(o: *sys.Out, text: str, i: i64, in_b: bool): i64 {
    let n = sys.length(text)
    if i >= n { sys.out_byte(o, 92); return i }
    let e = sys.at(text, i); let k = i + 1
    if e == 97 { sys.out_byte(o, 7) } else if e == 98 { sys.out_byte(o, 8) } else if e == 102 { sys.out_byte(o, 12) } else if e == 110 { sys.out_byte(o, 10) }
    else if e == 114 { sys.out_byte(o, 13) } else if e == 116 { sys.out_byte(o, 9) } else if e == 118 { sys.out_byte(o, 11) } else if e == 92 { sys.out_byte(o, 92) }
    else if e == 99 && in_b { return 0 - 1 }
    else if e >= 48 && e <= 55 || (in_b && e == 48) {
        let v = 0; let count = 0; k = in_b && e == 48 ? i + 1 : i
        while count < 3 && k < n && sys.at(text, k) >= 48 && sys.at(text, k) <= 55 { v = v * 8 + (sys.at(text, k) - 48) as i64; k = k + 1; count = count + 1 }
        sys.out_byte(o, (v % 256) as u8)
    } else if e == 120 {
        let v = 0; let count = 0
        while count < 2 && k < n && digit_value(sys.at(text, k), 16) >= 0 { v = v * 16 + digit_value(sys.at(text, k), 16); k = k + 1; count = count + 1 }
        if count == 0 { sys.out_byte(o, 92); sys.out_byte(o, 120) } else { sys.out_byte(o, v as u8) }
    } else { sys.out_byte(o, 92); sys.out_byte(o, e) }
    return k
}
# Integer argument: decimal, 0x hex, 0 octal, 'c character; sets bad when it is not a number.
struct Arg { value: i64, bad: bool }
fn integer_arg(text: str): Arg {
    let n = sys.length(text)
    if n == 0 { return Arg(0, false) }
    if n >= 2 && (sys.at(text, 0) == 39 || sys.at(text, 0) == 34) { return Arg(sys.at(text, 1) as i64, false) }
    let neg = false; let k = 0
    if sys.at(text, 0) == 45 { neg = true; k = 1 } else if sys.at(text, 0) == 43 { k = 1 }
    let base = 10
    if k + 1 < n && sys.at(text, k) == 48 && (sys.at(text, k + 1) == 120 || sys.at(text, k + 1) == 88) { base = 16; k = k + 2 } else if k + 1 < n && sys.at(text, k) == 48 { base = 8; k = k + 1 }
    if k >= n { return Arg(0, base == 16) }
    let v = 0
    while k < n { let d = digit_value(sys.at(text, k), base); if d < 0 { return Arg(neg ? 0 - v : v, true) }; v = v * base + d; k = k + 1 }
    return Arg(neg ? 0 - v : v, false)
}
fn number_text(v: i64, base: i64, upper: bool, unsigned: bool): str {
    let b = sys.bytes_new()
    if v == 0 { sys.bytes_push(b, 48); return sys.join2(sys.bytes_cstr(b), "") }
    let neg = !unsigned && v < 0
    let digits = Vec<u8>()
    if unsigned && v < 0 {
        let rest = v as u64; let b64 = base as u64
        while rest > 0 { let d = (rest % b64) as i64; digits.push((d < 10 ? 48 + d : (upper ? 55 : 87) + d) as u8); rest = rest / b64 }
    } else {
        let rest = neg ? 0 - v : v
        while rest > 0 { let d = rest % base; digits.push((d < 10 ? 48 + d : (upper ? 55 : 87) + d) as u8); rest = rest / base }
    }
    let i = (digits.len() as i64) - 1
    while i >= 0 { sys.bytes_push(b, digits[i]); i = i - 1 }
    return sys.join2(sys.bytes_cstr(b), "")
}
fn pad(o: *sys.Out, body: str, prefix: str, width: i64, left: bool, zero: bool) {
    let total = sys.length(body) + sys.length(prefix)
    let fill = width > total ? width - total : 0
    if left { sys.out_str(o, prefix); sys.out_str(o, body); for i in 0..fill { sys.out_byte(o, 32) } }
    else if zero { sys.out_str(o, prefix); for i in 0..fill { sys.out_byte(o, 48) }; sys.out_str(o, body) }
    else { for i in 0..fill { sys.out_byte(o, 32) }; sys.out_str(o, prefix); sys.out_str(o, body) }
}
fn run_printf(args: Vec<str>): i64 {
    if args.len() == 0 { sys.warn("printf", "usage: printf FORMAT [ARG...]"); return 1 }
    let fmt = args[0]; let n = sys.length(fmt)
    let o = sys.out_new(1)
    let next = 1; let failed = false; let total = args.len() as i64
    let go = true
    while go {
        let consumed = false; let i = 0
        while i < n {
            let c = sys.at(fmt, i)
            if c == 92 { let r = escape_at(o, fmt, i + 1, false); i = r; continue }
            if c != 37 { sys.out_byte(o, c); i = i + 1; continue }
            i = i + 1
            if i >= n { sys.out_byte(o, 37); break }
            if sys.at(fmt, i) == 37 { sys.out_byte(o, 37); i = i + 1; continue }
            let left = false; let plus = false; let space = false; let zero = false; let alt = false
            while i < n && sys.find_char("-+ 0#", sys.at(fmt, i)) >= 0 { let f = sys.at(fmt, i); if f == 45 { left = true } else if f == 43 { plus = true } else if f == 32 { space = true } else if f == 48 { zero = true } else { alt = true }; i = i + 1 }
            let width = 0; let precision = 0 - 1
            if i < n && sys.at(fmt, i) == 42 { if next < total { width = integer_arg(args[next]).value; next = next + 1 }; if width < 0 { left = true; width = 0 - width }; i = i + 1 }
            else { while i < n && sys.is_digit(sys.at(fmt, i)) { width = width * 10 + (sys.at(fmt, i) - 48) as i64; i = i + 1 } }
            if i < n && sys.at(fmt, i) == 46 {
                i = i + 1; precision = 0
                if i < n && sys.at(fmt, i) == 42 { if next < total { precision = integer_arg(args[next]).value; next = next + 1 }; i = i + 1 }
                else { while i < n && sys.is_digit(sys.at(fmt, i)) { precision = precision * 10 + (sys.at(fmt, i) - 48) as i64; i = i + 1 } }
            }
            while i < n && (sys.at(fmt, i) == 108 || sys.at(fmt, i) == 104 || sys.at(fmt, i) == 106 || sys.at(fmt, i) == 122) { i = i + 1 }
            if i >= n { break }
            let spec = sys.at(fmt, i); i = i + 1
            let arg = ""; let have = next < total
            if have { arg = args[next]; next = next + 1; consumed = true }
            if spec == 115 {
                let body = arg
                if precision >= 0 && precision < sys.length(body) { body = sys.join2(sys.slice(body, 0, precision), "") }
                pad(o, body, "", width, left, false)
            } else if spec == 98 {
                let bytes = sys.bytes_new(); let k = 0; let m = sys.length(arg); let cut = false
                while k < m {
                    let ch = sys.at(arg, k)
                    if ch != 92 { sys.bytes_push(bytes, ch); k = k + 1; continue }
                    let sink = sys.out_new(1); let r = escape_at(sink, arg, k + 1, true)
                    if r < 0 { cut = true; break }
                    unsafe { sys.bytes_append(bytes, sys.bdata((*sink).buf), sys.blen((*sink).buf)) }
                    k = r
                }
                pad(o, sys.bytes_cstr(bytes), "", width, left, false)
                if cut { sys.out_flush(o); return failed ? 1 : 0 }
            } else if spec == 99 {
                pad(o, sys.length(arg) > 0 ? sys.join2(sys.slice(arg, 0, 1), "") : "", "", width, left, false)
            } else if spec == 100 || spec == 105 || spec == 117 || spec == 111 || spec == 120 || spec == 88 {
                let a = integer_arg(arg)
                if a.bad { failed = true; sys.warn("printf", sys.join2("invalid number '", sys.join2(arg, "'"))) }
                let v = a.value
                let signed = spec == 100 || spec == 105
                let base = spec == 111 ? 8 : (spec == 117 || signed ? 10 : 16)
                let body = number_text(v, base, spec == 88, !signed)
                if precision >= 0 { let fill = precision - sys.length(body); if fill > 0 { let z = sys.bytes_new(); for q in 0..fill { sys.bytes_push(z, 48) }; body = sys.join2(sys.bytes_cstr(z), body) } }
                if precision == 0 && v == 0 { body = "" }
                let prefix = ""
                if signed { prefix = v < 0 ? "-" : (plus ? "+" : (space ? " " : "")) }
                else if alt && v != 0 { prefix = spec == 111 ? "0" : (spec == 120 ? "0x" : (spec == 88 ? "0X" : "")) }
                pad(o, body, prefix, width, left, zero && precision < 0)
            } else { sys.out_byte(o, 37); sys.out_byte(o, spec) }
        }
        go = consumed && next < total
    }
    sys.out_flush(o)
    return failed ? 1 : 0
}
