# fdisk [-lu] [-b SECTOR_SIZE] DEVICE_OR_IMAGE: edit or list a DOS (MBR) partition table. Sizes and positions are in sectors; only primary partitions are supported.
use "../lib/sys.dev" as sys
use "../lib/fsx.dev" as fsx
use "../lib/lines.dev" as lines

extern fn ioctl(fd: i32, request: u64, argument: *void): i32

fn decimal(v: i64): str { let b = sys.bytes_new(); sys.bytes_num(b, v); return sys.join2(sys.bytes_cstr(b), "") }
fn le(b: *sys.Bytes, off: i64, width: i64): i64 { let v = 0; let p = 1; for i in 0..width { v = v + (sys.bat(b, off + i) as i64) * p; p = p * 256 }; return v }
fn put_le(b: *sys.Bytes, off: i64, width: i64, v: i64) { let x = v; for i in 0..width { sys.bptr_set(b, off + i, (x % 256) as u8); x = x / 256 } }
fn pad_left(text: str, width: i64): str { let b = sys.bytes_new(); for i in 0..(width - sys.length(text)) { sys.bytes_push(b, 32) }; sys.bytes_str(b, text); return sys.join2(sys.bytes_cstr(b), "") }
fn pad_right(text: str, width: i64): str { let b = sys.bytes_new(); sys.bytes_str(b, text); while sys.blen(b) < width { sys.bytes_push(b, 32) }; return sys.join2(sys.bytes_cstr(b), "") }
fn hex2(v: i64): str { let d = "0123456789abcdef"; let b = sys.bytes_new(); sys.bytes_push(b, sys.at(d, (v / 16) % 16)); sys.bytes_push(b, sys.at(d, v % 16)); return sys.join2(sys.bytes_cstr(b), "") }
fn hex_value(text: str): i64 { let v = 0; for i in 0..sys.length(text) { let c = sys.at(text, i); let d = 0; if c >= 48 && c <= 57 { d = (c - 48) as i64 } else if c >= 97 && c <= 102 { d = (c - 87) as i64 } else if c >= 65 && c <= 70 { d = (c - 55) as i64 } else { return 0 - 1 }; v = v * 16 + d }; return v }
fn type_name(code: i64): str {
    if code == 0 { return "Empty" } if code == 1 { return "FAT12" } if code == 4 { return "FAT16 <32M" } if code == 5 { return "Extended" } if code == 6 { return "FAT16" } if code == 7 { return "HPFS/NTFS" }
    if code == 11 { return "W95 FAT32" } if code == 12 { return "W95 FAT32 (LBA)" } if code == 14 { return "W95 FAT16 (LBA)" } if code == 130 { return "Linux swap" } if code == 131 { return "Linux" } if code == 142 { return "Linux LVM" } if code == 253 { return "Linux raid autodetect" }
    return "Unknown"
}
fn chs(lba: i64, out: *sys.Bytes, off: i64) {
    let cyl = lba / (255 * 63); let rest = lba % (255 * 63); let head = rest / 63; let sector = rest % 63 + 1
    if cyl > 1023 { cyl = 1023; head = 254; sector = 63 }
    sys.bptr_set(out, off, head as u8); sys.bptr_set(out, off + 1, ((sector % 64) + (cyl / 256) * 64) as u8); sys.bptr_set(out, off + 2, (cyl % 256) as u8)
}
fn disk_sectors(path: str, sector: i64): i64 {
    let info = sys.file_info(path, true)
    if info.ok && sys.is_reg_mode(info.mode) { return info.size / sector }
    unsafe {
        let fd = sys.open_fd(path, 0, 0); if fd < 0 { return 0 }
        let b = sys.calloc(8, 1) as *u8; let r = ioctl(fd as i32, 2148012658 as u64, b as *void); let size = r == 0 ? sys.le(b, 0, 8) : 0
        sys.free(b as *void); sys.close_fd(fd)
        return size / sector
    }
}
fn print_table(out: *sys.Out, name: str, mbr: *sys.Bytes, total: i64, sector: i64) {
    let cylinders = total / (255 * 63); if cylinders < 1 { cylinders = 1 }
    sys.out_str(out, sys.join2(sys.join2("Disk ", name), sys.join2(sys.join2(": ", decimal(total * sector / 1048576)), sys.join2(sys.join2(" MB, ", decimal(total * sector)), " bytes\n"))))
    sys.out_str(out, sys.join2("255 heads, 63 sectors/track, ", sys.join2(decimal(cylinders), " cylinders\n")))
    sys.out_str(out, sys.join2("Units: sectors of 1 * ", sys.join2(decimal(sector), sys.join2(" = ", sys.join2(decimal(sector), " bytes\n\n")))))
    sys.out_str(out, "Device       Boot      Start        End     Sectors Id System\n")
    for p in 0..4 {
        let e = 446 + p * 16; let code = sys.bat(mbr, e + 4) as i64; let size = le(mbr, e + 12, 4)
        if code == 0 && size == 0 { continue }
        let first = le(mbr, e + 8, 4)
        sys.out_str(out, pad_right(sys.join2(name, decimal(p + 1)), 12)); sys.out_byte(out, 32); sys.out_str(out, sys.bat(mbr, e) == 128 ? "*" : " "); sys.out_str(out, "  ")
        sys.out_str(out, pad_left(decimal(first), 10)); sys.out_byte(out, 32); sys.out_str(out, pad_left(decimal(first + size - 1), 10)); sys.out_byte(out, 32); sys.out_str(out, pad_left(decimal(size), 11)); sys.out_byte(out, 32)
        sys.out_str(out, pad_left(code < 16 ? sys.join2(sys.slice(hex2(code), 1, 2), "") : hex2(code), 2)); sys.out_byte(out, 32); sys.out_str(out, type_name(code)); sys.out_byte(out, 10)
    }
}
fn read_mbr(path: str): *sys.Bytes {
    let b = sys.bytes_new(); for i in 0..512 { sys.bytes_push(b, 0) }
    let fd = sys.open_fd(path, 0, 0); if fd >= 0 { sys.read_into(fd, sys.bdata(b), 512); sys.close_fd(fd) }
    return b
}
fn run_fdisk(args: Vec<str>): i64 {
    let o = sys.parse_opts(args, "lub:C:H:S:")
    if o.bad != 0 || o.missing != 0 || o.rest.len() != 1 { sys.warn("fdisk", "invalid usage: fdisk [-lu] [-b SECTOR_SIZE] DEVICE"); return 1 }
    let path = o.rest[0]; let sector = sys.has(o, 98) ? sys.parse_number(sys.val(o, 98)).value : 512
    if !sys.exists(path) { sys.warn("fdisk", sys.join2(sys.join2("can't open '", path), "': No such file or directory")); return 1 }
    let total = disk_sectors(path, sector)
    let mbr = read_mbr(path); let out = sys.out_new(1)
    let valid = sys.bat(mbr, 510) == 85 && sys.bat(mbr, 511) == 170
    if !valid { for i in 0..64 { sys.bptr_set(mbr, 446 + i, 0) }; sys.bptr_set(mbr, 510, 85); sys.bptr_set(mbr, 511, 170) }
    if sys.has(o, 108) { if !valid { sys.out_str(out, sys.join2(sys.join2("Disk ", path), ": no valid DOS partition table\n")) } else { print_table(out, path, mbr, total, sector) }; sys.out_flush(out); return 0 }
    let input = sys.read_path("-"); let ls = lines.split_lines(input.bytes, 10); let k = 0; let n = ls.starts.len() as i64
    let dirty = false
    if !valid { sys.out_str(out, "Device contains neither a valid DOS partition table, nor Sun, SGI or OSF disklabel\nBuilding a new DOS disklabel.\n") }
    while k < n {
        sys.out_str(out, "Command (m for help): ")
        let cmd = lines.text_of(input.bytes, ls.starts[k], ls.ends[k]); k = k + 1
        let c = sys.length(cmd) > 0 ? sys.at(cmd, 0) : 0
        if c == 109 { sys.out_str(out, "Command Action\n a toggle a bootable flag\n d delete a partition\n l list known partition types\n n add a new partition\n o create a new empty DOS partition table\n p print the partition table\n q quit without saving changes\n t change a partition's system id\n w write table to disk and exit\n") }
        else if c == 112 { print_table(out, path, mbr, total, sector) }
        else if c == 111 { for i in 0..64 { sys.bptr_set(mbr, 446 + i, 0) }; dirty = true }
        else if c == 108 { sys.out_str(out, " 0 Empty\n 5 Extended\n 6 FAT16\n 7 HPFS/NTFS\n b W95 FAT32\n82 Linux swap\n83 Linux\n8e Linux LVM\n") }
        else if c == 113 { sys.out_flush(out); return 0 }
        else if c == 119 {
            let fd = sys.open_fd(path, 2, 0); if fd < 0 { sys.warn_write("fdisk", path); return 1 }
            sys.seek_fd(fd, 0, 0); sys.write_fd(fd, sys.bdata(mbr), 512); sys.close_fd(fd)
            sys.out_str(out, "The partition table has been altered.\n"); sys.out_flush(out); return 0
        }
        else if c == 100 || c == 116 || c == 97 {
            let number = 0
            if k < n { number = sys.parse_number(lines.text_of(input.bytes, ls.starts[k], ls.ends[k])).value; k = k + 1 }
            if number < 1 || number > 4 { sys.out_str(out, "Partition number out of range\n"); continue }
            let e = 446 + (number - 1) * 16
            if c == 100 { for i in 0..16 { sys.bptr_set(mbr, e + i, 0) } }
            else if c == 97 { sys.bptr_set(mbr, e, sys.bat(mbr, e) == 128 ? (0 as u8) : (128 as u8)) }
            else { let code = 0 - 1; if k < n { code = hex_value(lines.text_of(input.bytes, ls.starts[k], ls.ends[k])); k = k + 1 }; if code < 0 || code > 255 { sys.out_str(out, "Invalid hex code\n"); continue }; sys.bptr_set(mbr, e + 4, code as u8) }
            dirty = true
        }
        else if c == 110 {
            # partition type, number, first sector, last sector
            let kind = k < n ? lines.text_of(input.bytes, ls.starts[k], ls.ends[k]) : "p"; k = k + 1
            let number = k < n ? sys.parse_number(lines.text_of(input.bytes, ls.starts[k], ls.ends[k])).value : 0; k = k + 1
            if number < 1 || number > 4 { sys.out_str(out, "Partition number out of range\n"); continue }
            let e = 446 + (number - 1) * 16
            if sys.bat(mbr, e + 4) != 0 { sys.out_str(out, "Partition already defined\n"); continue }
            let minimum = 2048; for q in 0..4 { let pe = 446 + q * 16; if sys.bat(mbr, pe + 4) != 0 { let end = le(mbr, pe + 8, 4) + le(mbr, pe + 12, 4); if end > minimum { minimum = end } } }
            let first_text = k < n ? lines.text_of(input.bytes, ls.starts[k], ls.ends[k]) : ""; k = k + 1
            let first = sys.length(first_text) == 0 ? minimum : sys.parse_number(first_text).value
            let last_text = k < n ? lines.text_of(input.bytes, ls.starts[k], ls.ends[k]) : ""; k = k + 1
            let last = total - 1
            if sys.length(last_text) > 0 {
                if sys.at(last_text, 0) == 43 {
                    let digits = sys.join2(sys.slice(last_text, 1, sys.length(last_text)), ""); let unit = 1
                    let tail = sys.length(digits) > 0 ? sys.at(digits, sys.length(digits) - 1) : 0
                    if tail == 75 || tail == 107 { unit = 2; digits = sys.join2(sys.slice(digits, 0, sys.length(digits) - 1), "") } else if tail == 77 || tail == 109 { unit = 2048; digits = sys.join2(sys.slice(digits, 0, sys.length(digits) - 1), "") } else if tail == 71 || tail == 103 { unit = 2097152; digits = sys.join2(sys.slice(digits, 0, sys.length(digits) - 1), "") }
                    last = first + sys.parse_number(digits).value * unit - 1
                } else { last = sys.parse_number(last_text).value }
            }
            if first < minimum - 0 && first < 1 || first >= total || last < first || last >= total { sys.out_str(out, "Value out of range\n"); continue }
            for i in 0..16 { sys.bptr_set(mbr, e + i, 0) }
            sys.bptr_set(mbr, e + 4, sys.length(kind) > 0 && sys.at(kind, 0) == 101 ? (5 as u8) : (131 as u8))
            chs(first, mbr, e + 1); chs(last, mbr, e + 5); put_le(mbr, e + 8, 4, first); put_le(mbr, e + 12, 4, last - first + 1)
            dirty = true
        }
        else if sys.length(cmd) > 0 { sys.out_str(out, sys.join2(sys.join2(cmd, ": unknown command\n"), "")) }
    }
    sys.out_flush(out)
    return 0
}
