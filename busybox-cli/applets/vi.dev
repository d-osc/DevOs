# A native byte-oriented visual editor. Terminal state is restored on every exit.
use "../lib/sys.dev" as sys
use "../lib/signal_fd.dev" as signals
use "./console_extra.dev" as cx
use "./terminal_extra.dev" as tx
use "./util6.dev" as tty
use "./hardware.dev" as hw
use "./mime.dev" as text
struct Editor { data: *sys.Bytes, scratch: *sys.Bytes, undo: *sys.Bytes, redo: *sys.Bytes, yank: *sys.Bytes, state: *sys.Bytes }
fn get(e: Editor, field: i64): i64 { return cx.le(e.state, field * 8, 8) }
fn put(e: Editor, field: i64, value: i64) { cx.store(e.state, field * 8, 8, value) }
fn copy(to: *sys.Bytes, from: *sys.Bytes) { sys.bclear(to); sys.bytes_append(to, sys.bdata(from), sys.blen(from)) }
fn snapshot(e: Editor) { copy(e.undo, e.data); put(e, 4, get(e, 0)); put(e, 5, 1); sys.bclear(e.redo); put(e, 8, 0) }
fn clamp(e: Editor) { let n = sys.blen(e.data); if get(e, 0) > n { put(e, 0, n) } }
fn edit(e: Editor, start: i64, end: i64, insert: *sys.Bytes) {
    let n = sys.blen(e.data); if start < 0 || end < start || end > n || n - end + start + sys.blen(insert) > 8388608 { return }
    sys.bclear(e.scratch); sys.bytes_append(e.scratch, sys.bdata(e.data), start); sys.bytes_append(e.scratch, sys.bdata(insert), sys.blen(insert)); sys.bytes_append(e.scratch, sys.bptr(e.data, end), n - end); copy(e.data, e.scratch); put(e, 1, 1); clamp(e)
}
fn bol(e: Editor, pos: i64): i64 { let at = pos; while at > 0 && sys.bat(e.data, at - 1) != 10 { at = at - 1 }; return at }
fn eol(e: Editor, pos: i64): i64 { let at = pos; let n = sys.blen(e.data); while at < n && sys.bat(e.data, at) != 10 { at = at + 1 }; return at }
fn space(c: u8): bool { return c == 32 || c == 9 || c == 10 || c == 13 }
fn word(c: u8): bool { return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c >= 128 }
fn motion(e: Editor, key: i64, count: i64): i64 {
    let pos = get(e, 0); let n = sys.blen(e.data)
    for step in 0..count {
        if key == 104 { if pos > bol(e, pos) { pos = pos - 1 } }
        else if key == 108 || key == 32 { if pos < eol(e, pos) { pos = pos + 1 } }
        else if key == 106 || key == 107 || key == 13 || key == 10 {
            let col = pos - bol(e, pos)
            if key == 107 { let begin = bol(e, pos); if begin > 0 { let previous = bol(e, begin - 1); pos = previous + col; if pos > begin - 1 { pos = begin - 1 } } }
            else { let end = eol(e, pos); if end < n { pos = end + 1 + col; let bound = eol(e, end + 1); if pos > bound { pos = bound } } }
        }
        else if key == 48 { pos = bol(e, pos) }
        else if key == 94 { pos = bol(e, pos); while pos < n && (sys.bat(e.data, pos) == 32 || sys.bat(e.data, pos) == 9) { pos = pos + 1 } }
        else if key == 36 { pos = eol(e, pos); if pos > bol(e, pos) { pos = pos - 1 } }
        else if key == 119 { if pos < n { let kind = word(sys.bat(e.data, pos)); if !space(sys.bat(e.data, pos)) { while pos < n && !space(sys.bat(e.data, pos)) && word(sys.bat(e.data, pos)) == kind { pos = pos + 1 } }; while pos < n && space(sys.bat(e.data, pos)) { pos = pos + 1 } } }
        else if key == 98 { if pos > 0 { pos = pos - 1; while pos > 0 && space(sys.bat(e.data, pos)) { pos = pos - 1 }; let kind = word(sys.bat(e.data, pos)); while pos > 0 && !space(sys.bat(e.data, pos - 1)) && word(sys.bat(e.data, pos - 1)) == kind { pos = pos - 1 } } }
        else if key == 101 { if pos + 1 < n { pos = pos + 1; while pos < n && space(sys.bat(e.data, pos)) { pos = pos + 1 }; let kind = word(sys.bat(e.data, pos)); while pos + 1 < n && !space(sys.bat(e.data, pos + 1)) && word(sys.bat(e.data, pos + 1)) == kind { pos = pos + 1 } } }
    }; return pos
}
fn escape(out: *sys.Out, code: str) { sys.out_byte(out, 27); sys.out_str(out, code) }
fn render(e: Editor, path: str, message: str, rows: i64, columns: i64, insert: bool, number: bool, out: *sys.Out) {
    let cursor = get(e, 0); let top = get(e, 2); let current_line = bol(e, cursor); if current_line < top { top = current_line }
    let scan = top; let visible = false; for row in 0..(rows - 1) { if scan == current_line { visible = true }; let end = eol(e, scan); if end < sys.blen(e.data) { scan = end + 1 } }
    if !visible { top = current_line; for row in 0..(rows - 2) { if top > 0 { top = bol(e, top - 1) } } }; put(e, 2, top)
    escape(out, "[H"); let at = top; let line = 1; for i in 0..top { if sys.bat(e.data, i) == 10 { line = line + 1 } }; let cy = 1; let column = 0
    for row in 0..(rows - 1) {
        escape(out, "[2K"); let end = eol(e, at); let col = 0; if at == current_line { cy = row + 1 }
        if at <= sys.blen(e.data) {
            if number { sys.out_num(out, line); sys.out_str(out, " "); col = sys.length(hw.decimal(line)) + 1 }
            for i in at..end { if i == cursor { column = col }; let c = sys.bat(e.data, i); if c == 9 { let width = 8 - col % 8; for k in 0..width { if col < columns { sys.out_byte(out, 32) }; col = col + 1 } } else { if col < columns { sys.out_byte(out, c < 32 || c == 127 ? (63 as u8) : c) }; col = col + 1 } }
            if cursor == end && at == current_line { column = col }; at = end < sys.blen(e.data) ? end + 1 : sys.blen(e.data) + 1; line = line + 1
        } else { sys.out_byte(out, 126) }; escape(out, "[K"); sys.out_str(out, "\r\n")
    }
    escape(out, "[2K"); escape(out, "[7m"); sys.out_str(out, insert ? "-- INSERT -- " : ""); sys.out_str(out, sys.length(message) > 0 ? message : path); if get(e, 1) != 0 { sys.out_str(out, " [+]") }; escape(out, "[0m"); escape(out, sys.join2("[", sys.join2(hw.decimal(cy), sys.join2(";", sys.join2(hw.decimal(column < columns ? column + 1 : columns), "H"))))); sys.out_flush(out)
}
fn key(e: Editor, guard: signals.Signals): i64 {
    if get(e, 9) != 0 { let pending = get(e, 9) - 1; put(e, 9, 0); return pending }; let b = cx.buffer(1); while !tx.readable(0, 50) { if tx.readable(guard.fd, 0) { signals.received(guard); return 0 - 1 } }; if sys.read_into(0, sys.bdata(b), 1) != 1 { return 0 - 1 }; let value = sys.bat(b, 0) as i64
    if value == 27 && tx.readable(0, 25) {
        if sys.read_into(0, sys.bdata(b), 1) == 1 {
            let second = sys.bat(b, 0)
            if second == 91 || second == 79 {
                if tx.readable(0, 25) && sys.read_into(0, sys.bdata(b), 1) == 1 { let c = sys.bat(b, 0); if c == 65 { return 1107 }; if c == 66 { return 1106 }; if c == 67 { return 1108 }; if c == 68 { return 1104 }; if c == 72 { return 1048 }; if c == 70 { return 1036 } }
            } else { put(e, 9, (second as i64) + 1) }
        }; return 27
    }; return value
}
fn prompt(e: Editor, prefix: str, rows: i64, guard: signals.Signals, out: *sys.Out): str {
    let b = sys.bytes_new(); while true { escape(out, sys.join2("[", sys.join2(hw.decimal(rows), ";1H"))); escape(out, "[2K"); sys.out_str(out, prefix); sys.out_data(out, sys.bdata(b), sys.blen(b)); sys.out_flush(out); let c = key(e, guard); if c < 0 { put(e, 10, 1); return "" }; if c == 27 { return "" }; if c == 13 || c == 10 { return sys.bytes_cstr(b) }; if c == 127 || c == 8 { if sys.blen(b) > 0 { unsafe { (*b).len = (*b).len - 1 } } } else if c >= 32 && c < 256 && sys.blen(b) < 4096 { sys.bytes_push(b, c as u8) } }
    return ""
}
fn save(e: Editor, path: str, readonly: bool): bool { if readonly || sys.length(path) == 0 { return false }; let fd = sys.open_fd(path, 577, 438); if fd < 0 { return false }; let ok = tx.write_all(fd, sys.bdata(e.data), sys.blen(e.data)); sys.close_fd(fd); if ok { put(e, 1, 0) }; return ok }
fn search(e: Editor, needle: str, backward: bool): bool {
    let n = sys.blen(e.data); let width = sys.length(needle); if width == 0 || width > n { return false }; let origin = get(e, 0)
    for step in 1..(n + 1) { let at = backward ? (origin + n - step) % n : (origin + step) % n; if at + width > n { continue }; let equal = true; for i in 0..width { if sys.bat(e.data, at + i) != sys.at(needle, i) { equal = false; break } }; if equal { put(e, 0, at); return true } }; return false
}
fn run_vi(args: Vec<str>): i64 {
    let o = sys.parse_opts(args, "R"); if o.bad != 0 || o.missing != 0 || o.rest.len() > 1 { sys.warn("vi", "usage: vi [-R] [FILE]"); return 1 }; let path = o.rest.len() > 0 ? o.rest[0] : ""; let data = sys.bytes_new()
    if sys.length(path) > 0 { let info = sys.file_info(path, true); if info.ok { if (info.mode & 61440) != 32768 || info.size > 8388608 { sys.warn("vi", "requires a regular file of at most 8 MiB"); return 1 }; let input = sys.read_path(path); if !input.ok { return 1 }; copy(data, input.bytes) } }
    let attrs = tty.get_attrs(0); if sys.blen(attrs) == 0 { sys.warn("vi", "standard input must be a terminal"); return 1 }; let guard = signals.open(); if guard.fd < 0 { return 1 }; if !tty.set_attrs(0, tx.raw(attrs)) { signals.close(guard); return 1 }
    let e = Editor(data, sys.bytes_new(), sys.bytes_new(), sys.bytes_new(), sys.bytes_new(), cx.buffer(88)); let out = sys.out_new(1); let insert = false; let replace = false; let readonly = sys.has(o, 82); let message = ""; let count = 0; let number = false; let last_search = ""; let backwards = false; let status = 0; let quit = false
    escape(out, "[?1049h"); sys.out_flush(out)
    while !quit {
        if get(e, 10) != 0 { status = 1; break }
        let size = cx.buffer(8); hw.control_buffer(0, 21523, size); let rows = cx.le(size, 0, 2); let columns = cx.le(size, 2, 2); if rows < 3 || rows > 200 { rows = 24 }; if columns < 10 || columns > 500 { columns = 80 }
        render(e, path, message, rows, columns, insert, number, out); message = ""; let c = key(e, guard); if c < 0 { status = 1; break }
        if insert {
            let pos = get(e, 0)
            if c >= 1000 { put(e, 0, motion(e, c - 1000, 1)); continue }
            if c == 27 { insert = false; replace = false; if pos > bol(e, pos) { put(e, 0, pos - 1) } }
            else if c == 127 || c == 8 { if pos > 0 { edit(e, pos - 1, pos, sys.bytes_new()); put(e, 0, pos - 1) } }
            else if c < 256 { if sys.blen(e.data) >= 8388608 { message = "File size limit reached"; continue }; let b = cx.buffer(1); let value = c == 13 ? 10 : c; cx.store(b, 0, 1, value); let end = replace && pos < sys.blen(e.data) && sys.bat(e.data, pos) != 10 && value != 10 ? pos + 1 : pos; edit(e, pos, end, b); put(e, 0, pos + 1) }; continue
        }
        if c >= 1000 { c = c - 1000 }
        if c >= 48 && c <= 57 && (c != 48 || count != 0) { count = count * 10 + c - 48; if count > 100000 { count = 100000 }; continue }; let repeat = count > 0 ? count : 1; let had_count = count > 0; count = 0
        if c == 105 || c == 97 || c == 73 || c == 65 || c == 111 || c == 79 || c == 82 {
            if readonly { message = "Read-only"; continue }; snapshot(e); let pos = get(e, 0)
            if c == 97 && pos < eol(e, pos) { pos = pos + 1 }; if c == 73 { pos = bol(e, pos) }; if c == 65 { pos = eol(e, pos) }
            if c == 111 || c == 79 { let b = cx.buffer(1); cx.store(b, 0, 1, 10); if c == 79 { pos = bol(e, pos); edit(e, pos, pos, b) } else { pos = eol(e, pos); if pos < sys.blen(e.data) { pos = pos + 1; edit(e, pos, pos, b) } else { edit(e, pos, pos, b); pos = pos + 1 } } }; put(e, 0, pos); insert = true; replace = c == 82; continue
        }
        if c == 58 {
            let command = text.trim(prompt(e, ":", rows, guard, out)); let words = Vec<str>(); let split = sys.find_char(command, 32); let verb = split < 0 ? command : sys.slice(command, 0, split); let arg = split < 0 ? "" : text.trim(sys.slice(command, split + 1, sys.length(command)))
            if sys.same(verb, "q!") { quit = true }
            else if sys.same(verb, "q") { if get(e, 1) == 0 { quit = true } else { message = "Unsaved changes (use :q!)" } }
            else if sys.same(verb, "w") || sys.same(verb, "wq") || sys.same(verb, "x") || sys.same(verb, "w!") || sys.same(verb, "wq!") { let destination = sys.length(arg) > 0 ? arg : path; let force = sys.find_char(verb, 33) >= 0; if save(e, destination, readonly && !force) { path = destination; message = "Written"; if !sys.same(verb, "w") && !sys.same(verb, "w!") { quit = true } } else { message = "Write failed" } }
            else if sys.same(verb, "set") { if sys.same(arg, "number") || sys.same(arg, "nu") { number = true } else if sys.same(arg, "nonumber") || sys.same(arg, "nonu") { number = false } else if sys.same(arg, "readonly") || sys.same(arg, "ro") { readonly = true } else if sys.same(arg, "noreadonly") || sys.same(arg, "noro") { readonly = false } else { message = "Unsupported setting" } }
            else if sys.same(verb, "e") || sys.same(verb, "e!") { if get(e, 1) != 0 && !sys.same(verb, "e!") { message = "Unsaved changes" } else { let destination = sys.length(arg) > 0 ? arg : path; let input = sys.read_path(destination); if input.ok && sys.blen(input.bytes) <= 8388608 { snapshot(e); copy(e.data, input.bytes); path = destination; put(e, 0, 0); put(e, 1, 0); put(e, 2, 0) } else { message = "Read failed" } } }
            else if sys.same(verb, "r") { let input = sys.read_path(arg); if input.ok && !readonly { snapshot(e); let pos = eol(e, get(e, 0)); if pos < sys.blen(e.data) { pos = pos + 1 }; edit(e, pos, pos, input.bytes) } else { message = "Read failed" } }
            else { let line = sys.parse_number(command); if line.ok && line.value > 0 { let pos = 0; for i in 1..line.value { let end = eol(e, pos); if end >= sys.blen(e.data) { break }; pos = end + 1 }; put(e, 0, pos) } else if sys.length(command) > 0 { message = "Unsupported ex command" } }; continue
        }
        if c == 47 || c == 63 { let query = prompt(e, c == 47 ? "/" : "?", rows, guard, out); if sys.length(query) > 0 { last_search = query; backwards = c == 63 }; if !search(e, last_search, backwards) { message = "Pattern not found" }; continue }
        if c == 110 || c == 78 { if !search(e, last_search, c == 78 ? !backwards : backwards) { message = "Pattern not found" }; continue }
        if c == 71 || c == 103 { if c == 103 && key(e, guard) != 103 { continue }; let pos = c == 71 && !had_count ? bol(e, sys.blen(e.data)) : 0; if had_count { for i in 1..repeat { let end = eol(e, pos); if end >= sys.blen(e.data) { break }; pos = end + 1 } }; put(e, 0, pos); continue }
        if c == 117 || c == 18 { let source = c == 117 ? e.undo : e.redo; let target = c == 117 ? e.redo : e.undo; let flag = c == 117 ? 5 : 8; if get(e, flag) != 0 { let restored_cursor = get(e, c == 117 ? 4 : 7); put(e, c == 117 ? 7 : 4, get(e, 0)); copy(target, e.data); copy(e.data, source); put(e, c == 117 ? 8 : 5, 1); put(e, flag, 0); put(e, 0, restored_cursor); put(e, 1, 1); clamp(e) }; continue }
        if c == 90 { if key(e, guard) == 90 { if get(e, 1) == 0 || save(e, path, readonly) { quit = true } else { message = "Write failed" } }; continue }
        if c == 120 || c == 88 || c == 100 || c == 99 || c == 121 || c == 68 || c == 67 || c == 115 || c == 83 {
            let start = get(e, 0); let end = start; let linewise = false
            if c == 120 || c == 115 { end = start + repeat; if end > eol(e, start) { end = eol(e, start) } }
            else if c == 88 { start = start >= repeat ? start - repeat : 0; if start < bol(e, end) { start = bol(e, end) } }
            else if c == 68 || c == 67 { end = eol(e, start) }
            else { let next = c == 83 ? 99 : key(e, guard); if next == c || (c == 83 && next == 99) { start = bol(e, start); end = start; for i in 0..repeat { end = eol(e, end); if end < sys.blen(e.data) { end = end + 1 } }; linewise = true } else { end = motion(e, c == 99 && next == 119 ? 101 : next, repeat); if next == 36 || next == 101 || (c == 99 && next == 119) { if end < sys.blen(e.data) { end = end + 1 } }; if end < start { let swap = start; start = end; end = swap } } }
            sys.bclear(e.yank); sys.bytes_append(e.yank, sys.bptr(e.data, start), end - start); put(e, 6, linewise ? 1 : 0)
            if c != 121 { if readonly { message = "Read-only"; continue }; snapshot(e); edit(e, start, end, sys.bytes_new()); put(e, 0, start); if c == 99 || c == 67 || c == 115 || c == 83 { insert = true; if linewise { let b = cx.buffer(1); cx.store(b, 0, 1, 10); edit(e, start, start, b) } } }; continue
        }
        if c == 112 || c == 80 { if readonly { message = "Read-only"; continue }; snapshot(e); let pos = get(e, 0); if get(e, 6) != 0 { pos = c == 80 ? bol(e, pos) : eol(e, pos); if c == 112 && pos < sys.blen(e.data) { pos = pos + 1 } } else if c == 112 && pos < sys.blen(e.data) { pos = pos + 1 }; for i in 0..repeat { edit(e, pos, pos, e.yank) }; put(e, 0, pos); continue }
        if c == 114 { let value = key(e, guard); if !readonly && value >= 32 && value < 256 { snapshot(e); let pos = get(e, 0); let end = pos + repeat; if end > eol(e, pos) { end = eol(e, pos) }; let b = sys.bytes_new(); for i in pos..end { sys.bytes_push(b, value as u8) }; edit(e, pos, end, b) }; continue }
        if c == 74 { if !readonly { let end = eol(e, get(e, 0)); if end < sys.blen(e.data) { snapshot(e); let b = cx.buffer(1); cx.store(b, 0, 1, 32); edit(e, end, end + 1, b) } }; continue }
        if c == 6 || c == 2 || c == 4 || c == 21 { put(e, 0, motion(e, c == 6 || c == 4 ? 106 : 107, c == 4 || c == 21 ? (rows - 1) / 2 : rows - 2)); continue }
        put(e, 0, motion(e, c, repeat))
    }
    escape(out, "[?1049l"); sys.out_flush(out); tty.set_attrs(0, attrs); signals.close(guard); return status
}
