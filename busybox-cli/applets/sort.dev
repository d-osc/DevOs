# sort, uniq, cut, tr, tac.
use "../lib/sys.dev" as sys
use "../lib/lines.dev" as ln

# ---- sort ----------------------------------------------------------------------------------------------------------------------------------------
# flag bits of an ordering: 1 numeric, 2 reverse, 4 ignore leading blanks, 8 fold case, 16 dictionary, 32 ignore non-printing, 64 general numeric, 128 month
struct Key { f1: i64, c1: i64, f2: i64, c2: i64, flags: i64 }
struct Config { keys: Vec<Key>, flags: i64, sep: i64, stable: bool, unique: bool }

fn flag_bits(text: str): i64 {
    let v = 0
    for i in 0..sys.length(text) {
        let c = sys.at(text, i)
        if c == 110 { v = v | 1 } else if c == 114 { v = v | 2 } else if c == 98 { v = v | 4 } else if c == 102 { v = v | 8 } else if c == 100 { v = v | 16 }
        else if c == 105 { v = v | 32 } else if c == 103 { v = v | 64 } else if c == 77 { v = v | 128 }
    }
    return v
}
# "F[.C][flags][,F[.C][flags]]"
fn parse_key(spec: str): Key {
    let n = sys.length(spec); let comma = sys.find_char(spec, 44)
    let first = comma < 0 ? spec : sys.slice(spec, 0, comma)
    let second = comma < 0 ? "" : sys.slice(spec, comma + 1, n)
    let key = Key(1, 0, 0, 0, 0)
    key = read_position(first, key, true)
    if comma >= 0 { key = read_position(second, key, false) }
    return key
}
fn read_position(text: str, key: Key, start: bool): Key {
    let n = sys.length(text); let i = 0; let field = 0; let ch = 0
    while i < n && sys.is_digit(sys.at(text, i)) { field = field * 10 + (sys.at(text, i) - 48) as i64; i = i + 1 }
    if i < n && sys.at(text, i) == 46 { i = i + 1; while i < n && sys.is_digit(sys.at(text, i)) { ch = ch * 10 + (sys.at(text, i) - 48) as i64; i = i + 1 } }
    key.flags = key.flags | flag_bits(sys.slice(text, i, n))
    if start { key.f1 = field > 0 ? field : 1; key.c1 = ch } else { key.f2 = field; key.c2 = ch }
    return key
}
# The start offset (in the line [s, e)) of field number `f` (1-based): with a separator the byte after the (f-1)th separator, otherwise after
# the (f-1)th run of blanks that follows non-blanks (the blanks before a field belong to it).
fn field_start(b: *sys.Bytes, s: i64, e: i64, f: i64, sep: i64): i64 {
    let i = s; let field = 1
    if sep >= 0 {
        while field < f && i < e { if sys.bat(b, i) == (sep as u8) { field = field + 1 }; i = i + 1 }
        return field < f ? e : i
    }
    while field < f {
        while i < e && ln.is_blank(sys.bat(b, i)) { i = i + 1 }
        while i < e && !ln.is_blank(sys.bat(b, i)) { i = i + 1 }
        field = field + 1
        if i >= e { return e }
    }
    return i
}
fn field_end(b: *sys.Bytes, s: i64, e: i64, f: i64, sep: i64): i64 {
    # end of field f (inclusive of its last byte): the offset of the separator after it, or the line end
    let i = s; let field = 1
    if sep >= 0 {
        while i < e { if sys.bat(b, i) == (sep as u8) { if field == f { return i }; field = field + 1 }; i = i + 1 }
        return e
    }
    while field <= f {
        while i < e && ln.is_blank(sys.bat(b, i)) { i = i + 1 }
        while i < e && !ln.is_blank(sys.bat(b, i)) { i = i + 1 }
        if field == f { return i }
        field = field + 1
    }
    return e
}
struct Span { from: i64, to: i64 }
fn key_span(b: *sys.Bytes, s: i64, e: i64, key: Key, sep: i64): Span {
    let from = field_start(b, s, e, key.f1, sep)
    if (key.flags & 4) != 0 { while from < e && ln.is_blank(sys.bat(b, from)) { from = from + 1 } }
    if key.c1 > 0 { from = from + key.c1 - 1 }
    if from > e { from = e }
    let to = e
    if key.f2 > 0 { to = field_end(b, s, e, key.f2, sep); if key.c2 > 0 { let begin = field_start(b, s, e, key.f2, sep); to = begin + key.c2 < to ? begin + key.c2 : to } }
    if to < from { to = from }
    return Span(from, to)
}
fn month_number(b: *sys.Bytes, from: i64, to: i64): i64 {
    let i = from
    while i < to && ln.is_blank(sys.bat(b, i)) { i = i + 1 }
    if i + 3 > to { return 0 }
    let name = sys.bytes_new()
    for k in 0..3 { sys.bytes_push(name, ln.fold_byte(sys.bat(b, i + k))) }
    let text = sys.bytes_cstr(name)
    let months = "JANFEBMARAPRMAYJUNJULAUGSEPOCTNOVDEC"
    for m in 0..12 { if sys.same(sys.slice(months, m * 3, m * 3 + 3), text) { return m + 1 } }
    return 0
}
# A copy of the range with the bytes dropped that the -d / -i flags ignore, and case folded for -f.
fn filtered(b: *sys.Bytes, from: i64, to: i64, flags: i64): *sys.Bytes {
    let out = sys.bytes_new()
    for i in from..to {
        let c = sys.bat(b, i)
        if (flags & 16) != 0 && !ln.is_blank(c) && !ln.is_alnum(c) { continue }
        if (flags & 32) != 0 && !ln.is_print(c) { continue }
        sys.bytes_push(out, (flags & 8) != 0 ? ln.fold_byte(c) : c)
    }
    return out
}
fn compare_range_flags(b: *sys.Bytes, a0: i64, a1: i64, c0: i64, c1: i64, flags: i64): i64 {
    let r = 0
    if (flags & 129) == 128 || (flags & 128) != 0 { let x = month_number(b, a0, a1); let y = month_number(b, c0, c1); r = x < y ? 0 - 1 : (x > y ? 1 : 0) }
    else if (flags & 64) != 0 { let x = ln.parse_float(b, a0, a1, true); let y = ln.parse_float(b, c0, c1, true); r = x.value < y.value ? 0 - 1 : (x.value > y.value ? 1 : 0) }
    else if (flags & 1) != 0 { let x = ln.parse_float(b, a0, a1, false); let y = ln.parse_float(b, c0, c1, false); r = x.value < y.value ? 0 - 1 : (x.value > y.value ? 1 : 0) }
    else if (flags & 56) != 0 {
        let x = filtered(b, a0, a1, flags); let y = filtered(b, c0, c1, flags)
        r = ln.compare_ranges(x, 0, sys.blen(x), y, 0, sys.blen(y))
    } else { r = ln.compare_ranges(b, a0, a1, b, c0, c1) }
    return (flags & 2) != 0 ? 0 - r : r
}
# Compares line i and line j of the input by the keys (or the whole line when there are none); `last_resort` adds the whole-line comparison.
fn compare_lines(cfg: Config, b: *sys.Bytes, lines: ln.Lines, i: i64, j: i64, last_resort: bool): i64 {
    let r = 0
    if cfg.keys.len() == 0 { r = compare_range_flags(b, lines.starts[i], lines.ends[i], lines.starts[j], lines.ends[j], cfg.flags) }
    else {
        for k in 0..(cfg.keys.len() as i64) {
            let key = cfg.keys[k]
            let flags = key.flags != 0 ? key.flags : cfg.flags
            let x = key_span(b, lines.starts[i], lines.ends[i], key, cfg.sep); let y = key_span(b, lines.starts[j], lines.ends[j], key, cfg.sep)
            r = compare_range_flags(b, x.from, x.to, y.from, y.to, flags)
            if r != 0 { break }
        }
    }
    if r == 0 && last_resort && !cfg.stable { r = ln.compare_ranges(b, lines.starts[i], lines.ends[i], b, lines.starts[j], lines.ends[j]); if (cfg.flags & 2) != 0 { r = 0 - r } }
    return r
}
fn merge_sort(cfg: Config, b: *sys.Bytes, lines: ln.Lines, items: Vec<i64>): Vec<i64> {
    let n = items.len() as i64
    if n < 2 { return items }
    let mid = n / 2
    let left = Vec<i64>(); let right = Vec<i64>()
    for i in 0..mid { left.push(items[i]) }
    for i in mid..n { right.push(items[i]) }
    left = merge_sort(cfg, b, lines, left); right = merge_sort(cfg, b, lines, right)
    let out = Vec<i64>(); let x = 0; let y = 0; let ln_ = left.len() as i64; let rn = right.len() as i64
    while x < ln_ && y < rn { if compare_lines(cfg, b, lines, left[x], right[y], true) <= 0 { out.push(left[x]); x = x + 1 } else { out.push(right[y]); y = y + 1 } }
    while x < ln_ { out.push(left[x]); x = x + 1 }
    while y < rn { out.push(right[y]); y = y + 1 }
    return out
}
fn run_sort(args: Vec<str>): i64 {
    let fixed = Vec<str>()
    for i in 0..(args.len() as i64) { let a = args[i]; if sys.length(a) > 2 && sys.at(a, 0) == 45 && sys.at(a, 1) == 109 { continue }; fixed.push(a) }   # -mST is ignored
    let o = sys.parse_opts(fixed, "nrugMcszbdfimSTo:k:t:")
    if o.bad != 0 || o.missing != 0 { sys.warn("sort", "invalid option"); return 2 }
    let cfg = Config(Vec<Key>(), 0, 0 - 1, sys.has(o, 115), sys.has(o, 117))
    let letters = "nrbfdigM"; let bits = Vec<i64>(1, 2, 4, 8, 16, 32, 64, 128)
    for k in 0..8 { if sys.has(o, sys.at(letters, k)) { cfg.flags = cfg.flags | bits[k] } }
    if sys.has(o, 116) { let t = sys.val(o, 116); cfg.sep = sys.length(t) > 0 ? (sys.at(t, 0) as i64) : 0 - 1 }
    if sys.has(o, 107) {
        # -k may repeat; parse_opts keeps the last one only, so re-scan the arguments for every -k
        let i = 0; let n = fixed.len() as i64
        while i < n {
            let a = fixed[i]
            if sys.same(a, "-k") && i + 1 < n { i = i + 1; cfg.keys.push(parse_key(fixed[i])) }
            else if sys.length(a) > 2 && sys.starts(a, "-k") { cfg.keys.push(parse_key(sys.slice(a, 2, sys.length(a)))) }
            i = i + 1
        }
    }
    let terminator = (sys.has(o, 122) ? 0 : 10) as u8
    let files = o.rest; if files.len() == 0 { files.push("-") }
    let all = sys.bytes_new()
    for i in 0..(files.len() as i64) {
        let input = sys.read_path(files[i])
        if !input.ok { sys.warn_path("sort", files[i]); return 2 }
        sys.bytes_append(all, sys.bdata(input.bytes), sys.blen(input.bytes))
        # a file whose last line lacks its newline still ends that line
        if sys.blen(input.bytes) > 0 && sys.bat(input.bytes, sys.blen(input.bytes) - 1) != terminator && i + 1 < (files.len() as i64) { sys.bytes_push(all, terminator) }
    }
    let lines = ln.split_lines(all, terminator)
    let count = lines.starts.len() as i64
    if sys.has(o, 99) {
        for i in 1..count {
            let r = compare_lines(cfg, all, lines, i - 1, i, false)
            if r > 0 || (cfg.unique && r == 0) {
                sys.put_fd(2, "sort: "); sys.put_fd(2, files[0]); sys.put_fd(2, ":"); let n = sys.bytes_new(); sys.bytes_num(n, i + 1); sys.put_fd(2, sys.bytes_cstr(n)); sys.put_fd(2, ": disorder: "); sys.put_fd(2, ln.text_of(all, lines.starts[i], lines.ends[i])); sys.put_fd(2, "\n")
                return 1
            }
        }
        return 0
    }
    let order = Vec<i64>(); for i in 0..count { order.push(i) }
    order = merge_sort(cfg, all, lines, order)
    let out = sys.out_new(1)
    let target = 0 - 1
    if sys.has(o, 111) { target = sys.open_fd(sys.val(o, 111), 577, 438); if target < 0 { sys.warn_write("sort", sys.val(o, 111)); return 2 }; out = sys.out_new(target) }
    let previous = 0 - 1
    for k in 0..count {
        let i = order[k]
        if cfg.unique && previous >= 0 && compare_lines(cfg, all, lines, previous, i, false) == 0 { continue }
        sys.out_data(out, sys.bptr(all, lines.starts[i]), lines.ends[i] - lines.starts[i]); sys.out_byte(out, terminator)
        previous = i
    }
    sys.out_flush(out)
    if target >= 0 { sys.close_fd(target) }
    return 0
}

# ---- uniq [-cdu] [-f N] [-s N] [-w N] [INPUT [OUTPUT]] ----------------------------------------------------------------------------------------
# The start of the comparison of a line: after `skip_fields` fields and then `skip_chars` bytes.
fn uniq_start(b: *sys.Bytes, s: i64, e: i64, skip_fields: i64, skip_chars: i64): i64 {
    let i = s
    for f in 0..skip_fields {
        while i < e && ln.is_blank(sys.bat(b, i)) { i = i + 1 }
        while i < e && !ln.is_blank(sys.bat(b, i)) { i = i + 1 }
    }
    i = i + skip_chars
    return i > e ? e : i
}
fn run_uniq(args: Vec<str>): i64 {
    let o = sys.parse_opts(args, "cduf:s:w:")
    if o.bad != 0 || o.missing != 0 || o.rest.len() > 2 { sys.warn("uniq", "invalid usage: uniq [-fscduw]... [INPUT [OUTPUT]]"); return 1 }
    let skip_f = 0; let skip_s = 0; let width = 0 - 1
    if sys.has(o, 102) { let n = sys.parse_number(sys.val(o, 102)); if !n.ok { sys.warn("uniq", sys.join2("invalid number ", sys.val(o, 102))); return 1 }; skip_f = n.value }
    if sys.has(o, 115) { let n = sys.parse_number(sys.val(o, 115)); if !n.ok { sys.warn("uniq", sys.join2("invalid number ", sys.val(o, 115))); return 1 }; skip_s = n.value }
    if sys.has(o, 119) { let n = sys.parse_number(sys.val(o, 119)); if !n.ok { sys.warn("uniq", sys.join2("invalid number ", sys.val(o, 119))); return 1 }; width = n.value }
    let path = o.rest.len() > 0 ? o.rest[0] : "-"
    let input = sys.read_path(path)
    if !input.ok { sys.warn_path("uniq", path); return 1 }
    let b = input.bytes; let lines = ln.split_lines(b, 10); let count = lines.starts.len() as i64
    let target = 0 - 1; let out = sys.out_new(1)
    if o.rest.len() == 2 { target = sys.open_fd(o.rest[1], 577, 438); if target < 0 { sys.warn_write("uniq", o.rest[1]); return 1 }; out = sys.out_new(target) }
    let i = 0
    while i < count {
        let j = i + 1
        let a0 = uniq_start(b, lines.starts[i], lines.ends[i], skip_f, skip_s); let a1 = width >= 0 && a0 + width < lines.ends[i] ? a0 + width : lines.ends[i]
        while j < count {
            let b0 = uniq_start(b, lines.starts[j], lines.ends[j], skip_f, skip_s); let b1 = width >= 0 && b0 + width < lines.ends[j] ? b0 + width : lines.ends[j]
            if ln.compare_ranges(b, a0, a1, b, b0, b1) != 0 { break }
            j = j + 1
        }
        let run = j - i
        let show = (sys.has(o, 100) ? run > 1 : true) && (sys.has(o, 117) ? run == 1 : true)
        if show {
            if sys.has(o, 99) { let n = sys.bytes_new(); sys.bytes_num(n, run); let text = sys.bytes_cstr(n); for pad in sys.length(text)..7 { sys.out_byte(out, 32) }; sys.out_str(out, text); sys.out_byte(out, 32) }
            sys.out_data(out, sys.bptr(b, lines.starts[i]), lines.ends[i] - lines.starts[i]); sys.out_byte(out, 10)
        }
        i = j
    }
    sys.out_flush(out)
    if target >= 0 { sys.close_fd(target) }
    return 0
}

# ---- cut [-b|-c LIST] [-f LIST] [-d CHAR] [-s] [FILE]... ------------------------------------------------------------------------------------
# LIST "1,3-5,7-" as ranges [lo, hi] (hi = -1 for open-ended); ok false when invalid.
struct Ranges { ok: bool, lo: Vec<i64>, hi: Vec<i64> }
fn parse_list(text: str): Ranges {
    let lo = Vec<i64>(); let hi = Vec<i64>(); let n = sys.length(text); let start = 0
    for i in 0..(n + 1) {
        if i == n || sys.at(text, i) == 44 {
            let part = sys.slice(text, start, i); start = i + 1
            if sys.length(part) == 0 { return Ranges(false, lo, hi) }
            let dash = sys.find_char(part, 45)
            if dash < 0 { let v = sys.parse_number(part); if !v.ok || v.value < 1 { return Ranges(false, lo, hi) }; lo.push(v.value); hi.push(v.value) }
            else {
                let a = dash == 0 ? 1 : 0 - 1; let b = 0 - 1
                if dash > 0 { let v = sys.parse_number(sys.slice(part, 0, dash)); if !v.ok || v.value < 1 { return Ranges(false, lo, hi) }; a = v.value }
                if dash + 1 < sys.length(part) { let v = sys.parse_number(sys.slice(part, dash + 1, sys.length(part))); if !v.ok || v.value < 1 { return Ranges(false, lo, hi) }; b = v.value }
                lo.push(a); hi.push(b)
            }
        }
    }
    return Ranges(true, lo, hi)
}
fn selected(r: Ranges, position: i64): bool {
    for i in 0..(r.lo.len() as i64) { if position >= r.lo[i] && (r.hi[i] < 0 || position <= r.hi[i]) { return true } }
    return false
}
fn run_cut(args: Vec<str>): i64 {
    let o = sys.parse_opts(args, "b:c:d:sf:n")
    if o.bad != 0 || o.missing != 0 { sys.warn("cut", "invalid option"); return 1 }
    let by_field = sys.has(o, 102); let list_text = by_field ? sys.val(o, 102) : (sys.has(o, 98) ? sys.val(o, 98) : sys.val(o, 99))
    if !by_field && !sys.has(o, 98) && !sys.has(o, 99) { sys.warn("cut", "you must specify a list of bytes, characters, or fields"); return 1 }
    let ranges = parse_list(list_text)
    if !ranges.ok { sys.warn("cut", "invalid byte, character or field list"); return 1 }
    let delim = sys.has(o, 100) && sys.length(sys.val(o, 100)) > 0 ? sys.at(sys.val(o, 100), 0) : 9
    let files = o.rest; if files.len() == 0 { files.push("-") }
    let out = sys.out_new(1); let status = 0
    for k in 0..(files.len() as i64) {
        let input = sys.read_path(files[k])
        if !input.ok { sys.warn_path("cut", files[k]); status = 1; continue }
        let b = input.bytes; let lines = ln.split_lines(b, 10)
        for li in 0..(lines.starts.len() as i64) {
            let s = lines.starts[li]; let e = lines.ends[li]
            if !by_field {
                for p in s..e { if selected(ranges, p - s + 1) { sys.out_byte(out, sys.bat(b, p)) } }
                sys.out_byte(out, 10); continue
            }
            let has_delim = false
            for p in s..e { if sys.bat(b, p) == delim { has_delim = true } }
            if !has_delim { if !sys.has(o, 115) { sys.out_data(out, sys.bptr(b, s), e - s); sys.out_byte(out, 10) }; continue }
            let field = 1; let begin = s; let first = true
            for p in s..(e + 1) {
                if p == e || sys.bat(b, p) == delim {
                    if selected(ranges, field) { if !first { sys.out_byte(out, delim) }; sys.out_data(out, sys.bptr(b, begin), p - begin); first = false }
                    field = field + 1; begin = p + 1
                }
            }
            sys.out_byte(out, 10)
        }
    }
    sys.out_flush(out)
    return status
}

# ---- tac [FILE]... --------------------------------------------------------------------------------------------------------------------------------
fn run_tac(args: Vec<str>): i64 {
    let files = args; if files.len() == 0 { files.push("-") }
    let out = sys.out_new(1); let status = 0
    for k in 0..(files.len() as i64) {
        let input = sys.read_path(files[k])
        if !input.ok { sys.warn_path("tac", files[k]); status = 1; continue }
        let b = input.bytes; let lines = ln.split_lines(b, 10)
        let i = lines.starts.len() as i64 - 1
        while i >= 0 {
            sys.out_data(out, sys.bptr(b, lines.starts[i]), lines.ends[i] - lines.starts[i])
            if i + 1 < (lines.starts.len() as i64) || lines.final_newline { sys.out_byte(out, 10) }
            i = i - 1
        }
    }
    sys.out_flush(out)
    return status
}

# ---- tr [-cds] STRING1 [STRING2] ----------------------------------------------------------------------------------------------------------------
# Expands a set: ranges (a-z), classes ([:alpha:]), escapes (\n \t \\ \NNN) and the repeat form [c*n] into the list of bytes.
fn class_members(name: str): Vec<u8> {
    let out = Vec<u8>()
    for c in 0..256 {
        let b = c as u8; let in_class = false
        if sys.same(name, "alpha") { in_class = ln.is_alnum(b) && !sys.is_digit(b) }
        else if sys.same(name, "digit") { in_class = sys.is_digit(b) }
        else if sys.same(name, "alnum") { in_class = ln.is_alnum(b) }
        else if sys.same(name, "upper") { in_class = b >= 65 && b <= 90 }
        else if sys.same(name, "lower") { in_class = b >= 97 && b <= 122 }
        else if sys.same(name, "space") { in_class = ln.is_space(b) }
        else if sys.same(name, "blank") { in_class = ln.is_blank(b) }
        else if sys.same(name, "punct") { in_class = ln.is_print(b) && !ln.is_alnum(b) && b != 32 }
        else if sys.same(name, "print") { in_class = ln.is_print(b) }
        else if sys.same(name, "graph") { in_class = ln.is_print(b) && b != 32 }
        else if sys.same(name, "cntrl") { in_class = b < 32 || b == 127 }
        else if sys.same(name, "xdigit") { in_class = sys.is_digit(b) || (b >= 65 && b <= 70) || (b >= 97 && b <= 102) }
        if in_class { out.push(b) }
    }
    return out
}
struct Parsed { value: i64, next: i64 }
fn set_char(text: str, i: i64): Parsed {
    let n = sys.length(text); let c = sys.at(text, i)
    if c != 92 || i + 1 >= n { return Parsed(c as i64, i + 1) }
    let e = sys.at(text, i + 1)
    if e == 110 { return Parsed(10, i + 2) } else if e == 116 { return Parsed(9, i + 2) } else if e == 114 { return Parsed(13, i + 2) } else if e == 92 { return Parsed(92, i + 2) }
    else if e == 97 { return Parsed(7, i + 2) } else if e == 98 { return Parsed(8, i + 2) } else if e == 102 { return Parsed(12, i + 2) } else if e == 118 { return Parsed(11, i + 2) }
    else if e >= 48 && e <= 55 { let v = 0; let k = i + 1; let d = 0; while k < n && d < 3 && sys.at(text, k) >= 48 && sys.at(text, k) <= 55 { v = v * 8 + (sys.at(text, k) - 48) as i64; k = k + 1; d = d + 1 }; return Parsed(v % 256, k) }
    return Parsed(e as i64, i + 2)
}
fn expand_set(text: str, pad_to: i64): Vec<u8> {
    let out = Vec<u8>(); let n = sys.length(text); let i = 0
    while i < n {
        if sys.at(text, i) == 91 && i + 1 < n && sys.at(text, i + 1) == 58 {
            let close = i + 2
            while close + 1 < n && !(sys.at(text, close) == 58 && sys.at(text, close + 1) == 93) { close = close + 1 }
            if close + 1 < n { let members = class_members(sys.slice(text, i + 2, close)); for k in 0..(members.len() as i64) { out.push(members[k]) }; i = close + 2; continue }
        }
        if sys.at(text, i) == 91 && i + 2 < n && sys.at(text, i + 2) == 42 {
            # [c*n] or [c*]: n copies of c (to the length of STRING1 when n is missing)
            let ch = set_char(text, i + 1); let k = ch.next
            if k < n && sys.at(text, k) == 42 {
                let close = k + 1; while close < n && sys.at(text, close) != 93 { close = close + 1 }
                if close < n {
                    let count = sys.parse_number(sys.slice(text, k + 1, close))
                    let times = close == k + 1 ? pad_to - (out.len() as i64) : (count.ok ? count.value : 0)
                    for t in 0..times { out.push(ch.value as u8) }
                    i = close + 1; continue
                }
            }
        }
        let first = set_char(text, i); i = first.next
        if i + 1 < n && sys.at(text, i) == 45 {
            let last = set_char(text, i + 1)
            if last.value >= first.value { for c in first.value..(last.value + 1) { out.push(c as u8) }; i = last.next; continue }
        }
        out.push(first.value as u8)
    }
    return out
}
fn run_tr(args: Vec<str>): i64 {
    let o = sys.parse_opts(args, "cds")
    if o.bad != 0 || o.rest.len() < 1 || o.rest.len() > 2 { sys.warn("tr", "invalid usage: tr [-cds] STRING1 [STRING2]"); return 1 }
    let complement = sys.has(o, 99); let delete = sys.has(o, 100); let squeeze = sys.has(o, 115)
    let set1 = expand_set(o.rest[0], 0)
    let in1 = Vec<bool>(); for c in 0..256 { in1.push(false) }
    for k in 0..(set1.len() as i64) { in1[set1[k] as i64] = true }
    if complement { for c in 0..256 { in1[c] = !in1[c] } }
    let members = Vec<u8>(); for c in 0..256 { if in1[c] { members.push(c as u8) } }
    let set2 = o.rest.len() == 2 ? expand_set(o.rest[1], members.len() as i64) : Vec<u8>()
    if !delete && o.rest.len() == 1 && !squeeze { sys.warn("tr", "invalid usage: tr [-cds] STRING1 [STRING2]"); return 1 }
    if !delete && o.rest.len() == 2 && set2.len() == 0 { sys.warn("tr", "string2 is empty"); return 1 }
    let map = Vec<i64>(); for c in 0..256 { map.push(c) }
    if o.rest.len() == 2 && !delete {
        let source = complement ? members : set1
        for k in 0..(source.len() as i64) { let to = k < (set2.len() as i64) ? set2[k] : set2[set2.len() as i64 - 1]; if !complement || in1[source[k] as i64] { map[source[k] as i64] = to as i64 } }
    }
    let squeezed = Vec<bool>(); for c in 0..256 { squeezed.push(false) }
    if squeeze { let sq = o.rest.len() == 2 && !delete ? set2 : (o.rest.len() == 2 ? expand_set(o.rest[1], 0) : set1); for k in 0..(sq.len() as i64) { squeezed[sq[k] as i64] = true }; if o.rest.len() == 1 && complement { for c in 0..256 { squeezed[c] = in1[c] } } }
    let input = sys.read_fd(0)
    if !input.ok { sys.warn("tr", "read error"); return 1 }
    let b = input.bytes; let out = sys.out_new(1); let last = 0 - 1
    for p in 0..sys.blen(b) {
        let c = sys.bat(b, p) as i64
        if delete && in1[c] { continue }
        let t = (o.rest.len() == 2 && !delete) ? map[c] : c
        if squeeze && squeezed[t] && last == t { continue }
        sys.out_byte(out, t as u8); last = t
    }
    sys.out_flush(out)
    return 0
}
