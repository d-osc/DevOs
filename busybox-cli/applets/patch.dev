# patch [-p N] [-R] [-N] [-i PATCHFILE] [-d DIR] [FILE]: apply a unified diff.
use "../lib/sys.dev" as sys
use "../lib/fsx.dev" as fsx
use "../lib/lines.dev" as lines
use "./gzip.dev" as gz

struct Hunk { old_start: i64, old_lines: Vec<str>, new_lines: Vec<str>, old_noeol: bool, new_noeol: bool }
struct FilePatch { old_name: str, new_name: str, hunks: Vec<Hunk> }

fn strip_path(path: str, strip: i64): str {
    let name = path
    let tab = sys.find_char(name, 9); if tab >= 0 { name = sys.join2(sys.slice(name, 0, tab), "") }
    let n = sys.length(name); let removed = 0; let i = 0
    if strip == 0 { return name }
    while i < n && removed < strip {
        while i < n && sys.at(name, i) == 47 { i = i + 1 }
        while i < n && sys.at(name, i) != 47 { i = i + 1 }
        removed = removed + 1
    }
    while i < n && sys.at(name, i) == 47 { i = i + 1 }
    return sys.join2(sys.slice(name, i, n), "")
}
fn parse_range(text: str, from: i64): Vec<i64> {
    # reads "start[,count]" at text[from]; returns [start, count, next index]
    let n = sys.length(text); let i = from; let start = 0; let count = 1
    while i < n && sys.is_digit(sys.at(text, i)) { start = start * 10 + (sys.at(text, i) - 48) as i64; i = i + 1 }
    if i < n && sys.at(text, i) == 44 { i = i + 1; count = 0; while i < n && sys.is_digit(sys.at(text, i)) { count = count * 10 + (sys.at(text, i) - 48) as i64; i = i + 1 } }
    return Vec<i64>(start, count, i)
}
fn read_lines(path: str): Vec<str> {
    let out = Vec<str>()
    let input = sys.read_path(path)
    if !input.ok { return out }
    let ls = lines.split_lines(input.bytes, 10)
    for k in 0..(ls.starts.len() as i64) { out.push(lines.text_of(input.bytes, ls.starts[k], ls.ends[k])) }
    return out
}
fn ends_without_newline(path: str): bool {
    let input = sys.read_path(path)
    if !input.ok || sys.blen(input.bytes) == 0 { return false }
    return sys.bat(input.bytes, sys.blen(input.bytes) - 1) != 10
}
fn parse_patch(text: *sys.Bytes, reverse: bool, strip: i64): Vec<FilePatch> {
    let ls = lines.split_lines(text, 10); let total = ls.starts.len() as i64
    let out = Vec<FilePatch>(); let k = 0
    while k < total {
        let line = lines.text_of(text, ls.starts[k], ls.ends[k])
        if sys.starts(line, "--- ") && k + 1 < total && sys.starts(lines.text_of(text, ls.starts[k + 1], ls.ends[k + 1]), "+++ ") {
            let old_name = strip_path(sys.join2(sys.slice(line, 4, sys.length(line)), ""), strip)
            let next = lines.text_of(text, ls.starts[k + 1], ls.ends[k + 1])
            let new_name = strip_path(sys.join2(sys.slice(next, 4, sys.length(next)), ""), strip)
            if sys.starts(line, "--- /dev/null") || has_text(line, "1970-01-01 00:00:00") { old_name = "/dev/null" }
            if sys.starts(next, "+++ /dev/null") || has_text(next, "1970-01-01 00:00:00") { new_name = "/dev/null" }
            k = k + 2
            let hunks = Vec<Hunk>()
            while k < total {
                let h = lines.text_of(text, ls.starts[k], ls.ends[k])
                if !sys.starts(h, "@@ -") { if sys.starts(h, "--- ") || sys.starts(h, "diff ") { break }; k = k + 1; continue }
                let a = parse_range(h, 4); let after_minus = a[2]
                let b = parse_range(h, after_minus + 2)
                let old_count = a[1]; let new_count = b[1]
                let old_lines = Vec<str>(); let new_lines = Vec<str>(); let old_noeol = false; let new_noeol = false
                k = k + 1
                let seen_old = 0; let seen_new = 0
                while k < total && (seen_old < old_count || seen_new < new_count) {
                    let l = lines.text_of(text, ls.starts[k], ls.ends[k]); let c = sys.length(l) > 0 ? sys.at(l, 0) : 32
                    let body = sys.length(l) > 0 ? sys.join2(sys.slice(l, 1, sys.length(l)), "") : ""
                    if c == 92 { if old_lines.len() > 0 && seen_old > 0 && seen_new > 0 { } ; k = k + 1; continue }
                    if c == 32 || sys.length(l) == 0 { old_lines.push(body); new_lines.push(body); seen_old = seen_old + 1; seen_new = seen_new + 1 }
                    else if c == 45 { old_lines.push(body); seen_old = seen_old + 1 }
                    else if c == 43 { new_lines.push(body); seen_new = seen_new + 1 }
                    else { break }
                    k = k + 1
                }
                while k < total && sys.length(lines.text_of(text, ls.starts[k], ls.ends[k])) > 0 && sys.at(lines.text_of(text, ls.starts[k], ls.ends[k]), 0) == 92 {
                    # "\ No newline at end of file" refers to the line just before it
                    let prev = lines.text_of(text, ls.starts[k - 1], ls.ends[k - 1]); let pc = sys.length(prev) > 0 ? sys.at(prev, 0) : 32
                    if pc == 45 { old_noeol = true } else if pc == 43 { new_noeol = true } else { old_noeol = true; new_noeol = true }
                    k = k + 1
                }
                if reverse { hunks.push(Hunk(b[0], new_lines, old_lines, new_noeol, old_noeol)) } else { hunks.push(Hunk(a[0], old_lines, new_lines, old_noeol, new_noeol)) }
            }
            if reverse { out.push(FilePatch(new_name, old_name, hunks)) } else { out.push(FilePatch(old_name, new_name, hunks)) }
            continue
        }
        k = k + 1
    }
    return out
}
fn matches_at(file: Vec<str>, at: i64, old: Vec<str>): bool {
    if at < 0 || at + (old.len() as i64) > (file.len() as i64) { return false }
    for k in 0..(old.len() as i64) { if !sys.same(file[at + k], old[k]) { return false } }
    return true
}
fn write_lines(path: str, content: Vec<str>, final_newline: bool): bool {
    let b = sys.bytes_new()
    for k in 0..(content.len() as i64) { sys.bytes_str(b, content[k]); if k + 1 < (content.len() as i64) || final_newline { sys.bytes_push(b, 10) } }
    let info = sys.file_info(path, true)
    return gz.write_file(path, b, info.ok ? sys.permission_bits(info.mode) : 420)
}
fn run_patch(args: Vec<str>): i64 {
    let o = sys.parse_opts(args, "p:Ri:Nd:ufs")
    if o.bad != 0 || o.missing != 0 { sys.warn("patch", "invalid usage: patch [-p N] [-R] [-N] [-i FILE] [-d DIR] [FILE]"); return 2 }
    let strip = 0; if sys.has(o, 112) { strip = sys.parse_number(sys.val(o, 112)).value }
    let reverse = sys.has(o, 82)
    if sys.has(o, 100) && !fsx.change_dir(sys.val(o, 100)) { sys.warn("patch", "can't change directory"); return 2 }
    let source = sys.has(o, 105) ? sys.val(o, 105) : "-"
    let input = sys.read_path(source)
    if !input.ok { sys.warn_path("patch", source); return 2 }
    let files = parse_patch(input.bytes, reverse, strip)
    if files.len() == 0 { sys.warn("patch", "no valid patches found"); return 2 }
    let out = sys.out_new(1); let status = 0
    for f in 0..(files.len() as i64) {
        let fp = files[f]
        let target = o.rest.len() > 0 ? o.rest[0] : fp.new_name
        if !(o.rest.len() > 0) && !sys.exists(target) && sys.exists(fp.old_name) && !sys.same(fp.old_name, "/dev/null") { target = fp.old_name }
        if sys.same(fp.new_name, "/dev/null") && !(o.rest.len() > 0) { target = fp.old_name }
        sys.out_str(out, sys.join2(sys.join2("patching file ", target), "\n"))
        let content = sys.same(fp.old_name, "/dev/null") ? Vec<str>() : read_lines(target)
        let no_newline = sys.same(fp.old_name, "/dev/null") ? false : ends_without_newline(target)
        let offset = 0; let failed = false
        for h in 0..(fp.hunks.len() as i64) {
            let hunk = fp.hunks[h]
            let expect = hunk.old_start - 1 + offset; if hunk.old_lines.len() == 0 { expect = hunk.old_start + offset }
            if hunk.old_start == 0 { expect = 0 }
            let found = 0 - 1
            let limit = (content.len() as i64) + 1
            for d in 0..limit {
                if matches_at(content, expect - d, hunk.old_lines) { found = expect - d; break }
                if matches_at(content, expect + d, hunk.old_lines) { found = expect + d; break }
            }
            if found < 0 {
                failed = true; status = 1
                sys.out_str(out, sys.join2(sys.join2("Hunk #", sys.join2(decimal(h + 1), " FAILED at ")), sys.join2(decimal(hunk.old_start), ".\n")))
                continue
            }
            let next = Vec<str>()
            for k in 0..found { next.push(content[k]) }
            for k in 0..(hunk.new_lines.len() as i64) { next.push(hunk.new_lines[k]) }
            for k in (found + (hunk.old_lines.len() as i64))..(content.len() as i64) { next.push(content[k]) }
            offset = offset + found - expect
            if found + (hunk.old_lines.len() as i64) >= (content.len() as i64) { no_newline = hunk.new_noeol }
            content = next
        }
        if failed { sys.out_str(out, sys.join2(sys.join2((decimal(0)), ""), "")); continue }
        if sys.same(fp.new_name, "/dev/null") || (reverse && sys.same(fp.old_name, "/dev/null")) { if content.len() == 0 { fsx.do_unlink(target); continue } }
        let dir_end = 0 - 1
        for i in 0..sys.length(target) { if sys.at(target, i) == 47 { dir_end = i } }
        if dir_end > 0 { fsx.make_dirs(sys.join2(sys.slice(target, 0, dir_end), ""), 493) }
        if !write_lines(target, content, !no_newline) { sys.warn_write("patch", target); status = 1 }
    }
    sys.out_flush(out)
    return status
}
fn decimal(v: i64): str { let b = sys.bytes_new(); sys.bytes_num(b, v); return sys.join2(sys.bytes_cstr(b), "") }

fn has_text(text: str, pattern: str): bool {
    let n = sys.length(text); let m = sys.length(pattern)
    for i in 0..(n - m + 1) { let ok = true; for k in 0..m { if sys.at(text, i + k) != sys.at(pattern, k) { ok = false; break } }; if ok { return true } }
    return false
}
