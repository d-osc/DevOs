# ls [-1AaCcdFhiklnpRrSstuXx] [FILE]...: list directory contents.
use "../lib/sys.dev" as sys
use "../lib/fsx.dev" as fsx
use "../lib/clock.dev" as clock

struct Entry { name: str, path: str, info: sys.Info, target: str }
struct Style { long: bool, all: i64, one: bool, dir_only: bool, classify: i64, human: bool, inode: bool, blocks: bool, reverse: bool, sort: i64, numeric: bool, follow: bool, time_kind: i64, recurse: bool, kilo: bool, commas: bool }
# sort: 0 name, 1 time, 2 size, 3 extension, 4 none

fn decimal(v: i64): str { let b = sys.bytes_new(); sys.bytes_num(b, v); return sys.join2(sys.bytes_cstr(b), "") }
fn extension_of(name: str): str {
    let cut = 0 - 1
    for i in 0..sys.length(name) { if sys.at(name, i) == 46 { cut = i } }
    if cut <= 0 { return "" }
    return sys.join2(sys.slice(name, cut + 1, sys.length(name)), "")
}
fn time_of(s: Style, e: Entry): i64 { return s.time_kind == 1 ? e.info.atime : (s.time_kind == 2 ? e.info.ctime : e.info.mtime) }
fn name_less(a: str, b: str): bool { return fsx.compare_str(a, b) < 0 }
# true when a sorts before b
fn before(s: Style, a: Entry, b: Entry): bool {
    let r = false
    if s.sort == 1 {
        let ta = time_of(s, a); let tb = time_of(s, b)
        if ta != tb { r = ta > tb } else { r = name_less(a.name, b.name) }
    } else if s.sort == 2 {
        if a.info.size != b.info.size { r = a.info.size > b.info.size } else { r = name_less(a.name, b.name) }
    } else if s.sort == 3 {
        let ea = extension_of(a.name); let eb = extension_of(b.name)
        if !sys.same(ea, eb) { r = name_less(ea, eb) } else { r = name_less(a.name, b.name) }
    } else { r = name_less(a.name, b.name) }
    return s.reverse ? !r && !same_key(s, a, b) : r
}
fn same_key(s: Style, a: Entry, b: Entry): bool { return sys.same(a.name, b.name) }
fn sort_entries(s: Style, items: Vec<Entry>): Vec<Entry> {
    let n = items.len() as i64
    if n < 2 || s.sort == 4 { return items }
    let mid = n / 2
    let left = Vec<Entry>(); let right = Vec<Entry>()
    for i in 0..mid { left.push(items[i]) }
    for i in mid..n { right.push(items[i]) }
    left = sort_entries(s, left); right = sort_entries(s, right)
    let out = Vec<Entry>(); let a = 0; let b = 0
    let ln = left.len() as i64; let rn = right.len() as i64
    while a < ln && b < rn { if before(s, right[b], left[a]) { out.push(right[b]); b = b + 1 } else { out.push(left[a]); a = a + 1 } }
    while a < ln { out.push(left[a]); a = a + 1 }
    while b < rn { out.push(right[b]); b = b + 1 }
    return out
}
fn make_entry(s: Style, name: str, path: str): Entry {
    let info = sys.file_info(path, s.follow)
    let target = ""
    if info.ok && sys.is_link_mode(info.mode) { target = fsx.read_link(path) }
    return Entry(name, path, info, target)
}
fn type_char(mode: i64): u8 {
    let kind = (mode / 4096) % 16
    if kind == 4 { return 100 } if kind == 10 { return 108 } if kind == 6 { return 98 } if kind == 2 { return 99 } if kind == 1 { return 112 } if kind == 12 { return 115 }
    return 45
}
fn suffix_of(s: Style, e: Entry): str {
    if s.classify == 0 { return "" }
    let kind = (e.info.mode / 4096) % 16
    if kind == 4 { return "/" }
    if s.classify == 2 { return "" }
    if kind == 10 { return "@" } if kind == 1 { return "|" } if kind == 12 { return "=" }
    if kind == 8 && (e.info.mode / 1) % 2 + (e.info.mode / 8) % 2 + (e.info.mode / 64) % 2 > 0 { return "*" }
    return ""
}
fn size_text(s: Style, size: i64): str {
    if !s.human { return decimal(size) }
    if size < 1024 { return decimal(size) }
    let units = "KMGTPE"; let unit = 1024; let k = 0
    while size >= unit * 1024 && k < 5 { unit = unit * 1024; k = k + 1 }
    let tenths = (size * 10 + unit - 1) / unit
    let b = sys.bytes_new()
    if tenths < 100 { sys.bytes_num(b, tenths / 10); sys.bytes_push(b, 46); sys.bytes_num(b, tenths % 10) } else { sys.bytes_num(b, (size + unit - 1) / unit) }
    sys.bytes_push(b, sys.at(units, k))
    return sys.join2(sys.bytes_cstr(b), "")
}
fn block_text(s: Style, e: Entry): str {
    let kb = (e.info.blocks + 1) / 2
    if s.human { return size_text(s, e.info.blocks * 512) }
    return decimal(s.kilo ? kb : kb)
}
fn pad_left(text: str, width: i64): str {
    let b = sys.bytes_new()
    for i in 0..(width - sys.length(text)) { sys.bytes_push(b, 32) }
    sys.bytes_str(b, text)
    return sys.join2(sys.bytes_cstr(b), "")
}
fn pad_right(text: str, width: i64): str {
    let b = sys.bytes_new(); sys.bytes_str(b, text)
    for i in 0..(width - sys.length(text)) { sys.bytes_push(b, 32) }
    return sys.join2(sys.bytes_cstr(b), "")
}
fn widest(items: Vec<str>): i64 { let w = 0; for i in 0..(items.len() as i64) { if sys.length(items[i]) > w { w = sys.length(items[i]) } }; return w }
fn print_entries(s: Style, o: *sys.Out, items: Vec<Entry>, total_line: bool) {
    let n = items.len() as i64
    if total_line && (s.long || s.blocks) {
        let total = 0; for i in 0..n { total = total + (items[i].info.blocks + 1) / 2 }
        sys.out_str(o, "total "); sys.out_str(o, s.human ? size_text(s, total * 1024) : decimal(total)); sys.out_byte(o, 10)
    }
    let inodes = Vec<str>(); let blocks = Vec<str>(); let links = Vec<str>(); let owners = Vec<str>(); let groups = Vec<str>(); let sizes = Vec<str>()
    let now = clock.now()
    for i in 0..n {
        let e = items[i]
        inodes.push(decimal(e.info.inode)); blocks.push(block_text(s, e)); links.push(decimal(e.info.nlink))
        let owner = s.numeric ? decimal(e.info.uid) : fsx.user_name(e.info.uid); if sys.length(owner) == 0 { owner = decimal(e.info.uid) }
        let group = s.numeric ? decimal(e.info.gid) : fsx.group_name(e.info.gid); if sys.length(group) == 0 { group = decimal(e.info.gid) }
        owners.push(owner); groups.push(group)
        let kind = (e.info.mode / 4096) % 16
        if kind == 6 || kind == 2 { sizes.push(sys.join2(sys.join2(decimal((e.info.rdev / 256) % 4096), ", "), decimal((e.info.rdev % 256) + (e.info.rdev / 1048576) * 256))) } else { sizes.push(size_text(s, e.info.size)) }
    }
    let wi = widest(inodes); let wb = widest(blocks); let wl = widest(links); let wo = widest(owners); let wg = widest(groups); let ws = widest(sizes)
    for i in 0..n {
        let e = items[i]
        if s.inode { sys.out_str(o, pad_left(inodes[i], wi)); sys.out_byte(o, 32) }
        if s.blocks { sys.out_str(o, pad_left(blocks[i], wb)); sys.out_byte(o, 32) }
        if s.long {
            sys.out_byte(o, type_char(e.info.mode)); sys.out_str(o, fsx.mode_string(e.info.mode)); sys.out_byte(o, 32)
            sys.out_str(o, pad_left(links[i], wl)); sys.out_byte(o, 32)
            sys.out_str(o, pad_right(owners[i], wo)); sys.out_byte(o, 32)
            sys.out_str(o, pad_right(groups[i], wg)); sys.out_byte(o, 32)
            sys.out_str(o, pad_left(sizes[i], ws)); sys.out_byte(o, 32)
            let t = time_of(s, e)
            let recent = t > now - 15778476 && t < now + 3600
            sys.out_str(o, clock.format(recent ? "%b %e %H:%M" : "%b %e  %Y", clock.fields(t, false), t, false)); sys.out_byte(o, 32)
        }
        sys.out_str(o, e.name); sys.out_str(o, suffix_of(s, e))
        if s.long && sys.length(e.target) > 0 { sys.out_str(o, " -> "); sys.out_str(o, e.target) }
        if s.commas && i + 1 < n { sys.out_str(o, ", ") } else { sys.out_byte(o, 10) }
    }
    if s.commas && n > 0 && false { sys.out_byte(o, 10) }
}
fn list_directory(s: Style, o: *sys.Out, path: str, title: bool, first: bool, status: *i64) {
    if !first { sys.out_byte(o, 10) }
    if title { sys.out_str(o, path); sys.out_str(o, ":\n") }
    let l = fsx.list_dir(path)
    if !l.ok { sys.warn("ls", sys.join2(sys.join2("cannot open directory '", path), "': Permission denied")); unsafe { status[0] = 2 }; return }
    let items = Vec<Entry>()
    if s.all == 2 {
        items.push(make_entry(s, ".", fsx.join_path(path, ".")))
        items.push(make_entry(s, "..", fsx.join_path(path, "..")))
    }
    for k in 0..(l.names.len() as i64) {
        let name = l.names[k]
        if s.all == 0 && sys.at(name, 0) == 46 { continue }
        items.push(make_entry(s, name, fsx.join_path(path, name)))
    }
    items = sort_entries(s, items)
    print_entries(s, o, items, true)
    if s.recurse {
        for k in 0..(items.len() as i64) {
            let e = items[k]
            if e.info.ok && sys.is_dir_mode(e.info.mode) && !sys.same(e.name, ".") && !sys.same(e.name, "..") && !sys.is_link_mode(e.info.mode) { list_directory(s, o, e.path, true, false, status) }
        }
    }
}
fn run_ls(args: Vec<str>): i64 {
    let o = sys.parse_opts(args, "1AaCcdFhiklnpRrSstuXxLmqHfgGoUv")
    if o.bad != 0 { sys.warn("ls", "invalid usage: ls [-1AaCcdFhiklnpRrSstuXx] [FILE]..."); return 2 }
    let s = Style(sys.has(o, 108) || sys.has(o, 110) || sys.has(o, 103) || sys.has(o, 111), 0, true, sys.has(o, 100), 0, sys.has(o, 104), sys.has(o, 105), sys.has(o, 115), sys.has(o, 114), 0, sys.has(o, 110), sys.has(o, 76), 0, sys.has(o, 82), sys.has(o, 107), sys.has(o, 109))
    if sys.has(o, 65) { s.all = 1 }
    if sys.has(o, 97) { s.all = 2 }
    if sys.has(o, 70) { s.classify = 1 } else if sys.has(o, 112) { s.classify = 2 }
    if sys.has(o, 116) { s.sort = 1 } else if sys.has(o, 83) { s.sort = 2 } else if sys.has(o, 88) { s.sort = 3 } else if sys.has(o, 102) || sys.has(o, 85) { s.sort = 4 }
    if sys.has(o, 99) { s.time_kind = 2 } else if sys.has(o, 117) { s.time_kind = 1 }
    if sys.has(o, 102) { s.all = 2 }
    let status = cells(1)
    let out = sys.out_new(1)
    let operands = o.rest
    if operands.len() == 0 { operands.push(".") }
    let files = Vec<Entry>(); let dirs = Vec<str>()
    for k in 0..(operands.len() as i64) {
        let path = operands[k]
        let info = sys.file_info(path, s.follow || (!s.dir_only && !s.long))
        if !info.ok {
            sys.warn("ls", sys.join2(sys.join2("cannot access '", path), sys.join2("': ", sys.path_error(path, false)))); unsafe { status[0] = 2 }; continue
        }
        if sys.is_dir_mode(info.mode) && !s.dir_only { dirs.push(path) } else { files.push(make_entry(s, path, path)) }
    }
    files = sort_entries(s, files)
    print_entries(s, out, files, false)
    let sorted_dirs = Vec<Entry>()
    for k in 0..(dirs.len() as i64) { sorted_dirs.push(make_entry(s, dirs[k], dirs[k])) }
    sorted_dirs = sort_entries(s, sorted_dirs)
    let title = (files.len() + dirs.len()) > 1 || s.recurse
    for k in 0..(sorted_dirs.len() as i64) { list_directory(s, out, sorted_dirs[k].path, title, files.len() == 0 && k == 0, status) }
    sys.out_flush(out)
    unsafe { return status[0] }
}
fn cells(count: i64): *i64 { unsafe { return sys.calloc(count as usize, 8) as *i64 } }
