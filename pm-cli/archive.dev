# Hardened archive extraction for everything dev installs. Every member name
# from `tar -tv` is validated (safe_path, types, duplicates, case conflicts,
# size and count limits) BEFORE `tar -x` runs, and the extracted tree is
# cross-checked against the validated listing afterwards. .deb packages are
# unwrapped through ar(1); .rpm payloads stream through their decompressor into cpio(1).
# File records are json.Value objects: { sha256, size, executable }.
use "std/fs"
use "std/json"
use "std/strings"
use "std/result"
use "./util.dev" as util

fn manifest_limit(): i64 {
    return 1024 * 1024
}

# package_stem: accepted archive suffixes ("" when unsupported).
fn package_stem(path str): str {
    let name = util.file_name(path)
    let suffixes = Vec<str>(".dpk", ".dpkx", ".tar.gz", ".deb", ".rpm")
    for i in 0..suffixes.len() as i64 {
        if strings.endsWith(name, suffixes[i as usize]) {
            let cut = (strings.len(name) as i64) - (strings.len(suffixes[i as usize]) as i64)
            return util.slice(name, 0, cut)
        }
    }
    return ""
}

fn is_deb(path str): bool {
    return strings.endsWith(util.file_name(path), ".deb")
}

fn frec(digest str, size i64, executable bool): json.Value {
    let record = json.set(json.object(), "sha256", digest)
    record = json.set(record, "size", size)
    record = json.set(record, "executable", executable)
    return record
}

fn frec_digest(record json.Value): str {
    return json.string(json.get(record, "sha256"))
}

fn frec_size(record json.Value): i64 {
    return json.int(json.get(record, "size"))
}

fn frec_exec(record json.Value): bool {
    return json.bool(json.get(record, "executable"))
}

struct ListingRow { mode str; size i64; kind str; name str }

# A raw listing row parsed from `tar -tv` output.
fn parse_listing_line(line str): ListingRow {
    let fields = strings.split(strings.trim(line), " ")
    let clean = Vec<str>()
    for i in 0..fields.len() as i64 {
        if strings.len(fields[i as usize]) > 0 { clean.push(fields[i as usize]) }
    }
    if clean.len() < 6 { result.raise("Corrupt archive listing: ${line}") }
    let name = ""
    for i in 5..clean.len() as i64 {
        if i > 5 { name = name + " " }
        name = name + clean[i as usize]
    }
    if util.slice(clean[0], 0, 1) == "l" {
        let arrow = util.rfind(name, " -> ")
        if arrow >= 0 { name = util.slice(name, 0, arrow) }
    }
    return ListingRow(clean[0], util.parse_int(clean[2]), util.slice(clean[0], 0, 1), name)
}

# Listing lines for .dpk/.dpkx/.tar.gz (always gzip, like MultiGzDecoder).
fn list_tgz(archive str): Vec<str> {
    let text = util.capture(Vec<str>("tar", "-tvzf", archive), "", "reading ${archive}")
    return strings.split(text, "\n")
}

fn ensure_deb_tools() {
    let found = util.run(Vec<str>("command", "-v", "ar"), "", 30000).success
    if !found {
        result.raise("Installing .deb packages requires the ar(1) tool (binutils)")
    }
}

fn deb_members(archive str): Vec<str> {
    let text = util.capture(Vec<str>("ar", "t", archive), "", "reading ${archive}")
    let members = Vec<str>()
    let lines = strings.split(text, "\n")
    for i in 0..lines.len() as i64 {
        if strings.trim(lines[i as usize]) != "" { members.push(strings.trim(lines[i as usize])) }
    }
    return members
}

fn deb_data_member(archive str): str {
    let members = deb_members(archive)
    for i in 0..members.len() as i64 {
        if strings.startsWith(members[i as usize], "data.tar") { return members[i as usize] }
    }
    result.raise("Debian package needs control.tar and data.tar members")
    return ""
}

fn deb_control_member(archive str): str {
    let members = deb_members(archive)
    for i in 0..members.len() as i64 {
        if strings.startsWith(members[i as usize], "control.tar") { return members[i as usize] }
    }
    result.raise("Debian package needs control.tar and data.tar members")
    return ""
}

struct NativeMeta { present bool; name str; version str; description str }

# Debian control fields, reduced like native.rs parse_control.
fn deb_control(archive str, scratch str): NativeMeta {
    let member = deb_control_member(archive)
    let dir = util.path_join(scratch, "control")
    fs.mkdirSync(dir, true)
    util.must(
        Vec<str>("sh", "-c", "ar p " + util.quote(archive) + " " + util.quote(member) + " | tar -x -C " + util.quote(dir) + " --no-same-owner --numeric-owner"),
        "", "reading Debian control")
    let control = util.path_join(dir, "control")
    if !fs.existsSync(control) {
        result.raise("Debian package has no control file")
    }
    let text = fs.readFileSync(control, "utf8")
    let meta = { name: "", version: "", description: "" }
    let lines = strings.split(text, "\n")
    for i in 0..lines.len() as i64 {
        let line = lines[i as usize]
        if strings.startsWith(line, " ") || strings.startsWith(line, "\t") { continue }
        let colon = strings.indexOf(line, ":")
        if colon < 0 { continue }
        let key = util.slice(line, 0, colon)
        let value = strings.trim(util.slice(line, colon + 1, strings.charLength(line)))
        if key == "Package" { meta.name = deb_package_name(value) }
        if key == "Version" { meta.version = deb_package_version(value) }
        if key == "Description" { meta.description = value }
    }
    return meta
}

fn deb_package_name(raw str): str {
    let out = ""
    let count = 0
    for i in 0..strings.charLength(raw) as i64 {
        if count >= 64 { break }
        let c = strings.toLowerCase(strings.charAt(raw, i))
        if util.is_ascii_lower(c) || util.is_ascii_digit(c) || c == "_" {
            out = out + c
        } else {
            out = out + "-"
        }
        count = count + 1
    }
    return out
}

fn deb_package_version(raw str): str {
    let out = ""
    let count = 0
    for i in 0..strings.charLength(raw) as i64 {
        if count >= 128 { break }
        let c = strings.charAt(raw, i)
        if util.is_alnum(c) || c == "." || c == "_" || c == "+" || c == "-" {
            out = out + c
        } else {
            out = out + "."
        }
        count = count + 1
    }
    return out
}

# --- RPM -----------------------------------------------------------------------------------------------------------------------
# An .rpm is a 96-byte lead, a signature header (padded to 8 bytes), a metadata header and a compressed newc cpio payload. The headers are read
# a few hundred bytes at a time through `tail | head | od` (the runtime caps what it can hold in memory, and a package can be far larger); the
# payload is never held: it streams through the decompressor into cpio(1), once to list it (validated like a tar listing) and once to extract it.
fn is_rpm(path str): bool {
    return strings.endsWith(util.file_name(path), ".rpm")
}

# Bytes [offset, offset + count) of a file as numbers.
fn file_bytes(archive str, offset i64, count i64): Vec<i64> {
    let script = "tail -c +${offset + 1} " + util.quote(archive) + " | head -c ${count} | od -An -v -tu1"
    let text = util.capture(Vec<str>("sh", "-c", script), "", "reading ${archive}")
    let out = Vec<i64>()
    let tokens = strings.split(strings.replaceAll(text, "\n", " "), " ")
    for i in 0..tokens.len() as i64 {
        if strings.len(tokens[i as usize]) > 0 { out.push(util.parse_int(tokens[i as usize])) }
    }
    return out
}

fn be32(bytes Vec<i64>, at i64): i64 {
    return bytes[at as usize] * 16777216 + bytes[(at + 1) as usize] * 65536 + bytes[(at + 2) as usize] * 256 + bytes[(at + 3) as usize]
}

struct RpmHeader { entries i64; data_size i64; total i64 }

fn rpm_header_at(archive str, offset i64): RpmHeader {
    let b = file_bytes(archive, offset, 16)
    if b.len() < 16 || b[0] != 142 || b[1] != 173 || b[2] != 232 { result.raise("Corrupt RPM header") }
    let entries = be32(b, 8)
    let data_size = be32(b, 12)
    if entries > 100000 || data_size > 64 * 1024 * 1024 { result.raise("Unsupported RPM header size") }
    return RpmHeader(entries, data_size, 16 + entries * 16 + data_size)
}

struct RpmInfo { payload i64; compressor str; name str; version str; description str }

# The tag's string value (STRING and I18NSTRING tags only), "" when absent.
fn rpm_string(table Vec<i64>, entries i64, tag i64): str {
    for i in 0..entries {
        let at = i * 16
        if be32(table, at) != tag { continue }
        let kind = be32(table, at + 4)
        if kind != 6 && kind != 9 { return "" }
        let start = entries * 16 + be32(table, at + 8)
        let bytes = Vec<u8>()
        let k = start
        while k < (table.len() as i64) && table[k as usize] != 0 {
            bytes.push(table[k as usize] as u8)
            k = k + 1
        }
        return util.decode(bytes)
    }
    return ""
}

fn rpm_info(archive str): RpmInfo {
    let lead = file_bytes(archive, 0, 4)
    if lead.len() < 4 || lead[0] != 237 || lead[1] != 171 || lead[2] != 238 || lead[3] != 219 { result.raise("Not an RPM package") }
    let signature = rpm_header_at(archive, 96)
    let main_at = 96 + signature.total + (8 - signature.total % 8) % 8
    let main = rpm_header_at(archive, main_at)
    let table = file_bytes(archive, main_at + 16, main.entries * 16 + main.data_size)
    if (table.len() as i64) < main.entries * 16 + main.data_size { result.raise("Truncated RPM header") }
    let payload = main_at + main.total
    let format = rpm_string(table, main.entries, 1124)
    if format != "" && format != "cpio" { result.raise("Unsupported RPM payload format (expected cpio)") }
    let magic = file_bytes(archive, payload, 6)
    let compressor = "cat"
    if magic.len() >= 2 && magic[0] == 31 && magic[1] == 139 { compressor = "gzip -dc" }
    else if magic.len() >= 6 && magic[0] == 253 && magic[1] == 55 && magic[2] == 122 && magic[3] == 88 && magic[4] == 90 { compressor = "xz -dc" }
    else if magic.len() >= 4 && magic[0] == 40 && magic[1] == 181 && magic[2] == 47 && magic[3] == 253 { compressor = "zstd -dc" }
    else if magic.len() >= 3 && magic[0] == 66 && magic[1] == 90 && magic[2] == 104 { compressor = "bzip2 -dc" }
    else if magic.len() >= 5 && magic[0] == 48 && magic[1] == 55 && magic[2] == 48 && magic[3] == 55 && magic[4] == 48 { compressor = "cat" }
    else { result.raise("Unsupported RPM payload compression") }
    let name = deb_package_name(rpm_string(table, main.entries, 1000))
    let version = deb_package_version(rpm_string(table, main.entries, 1001))
    let description = rpm_string(table, main.entries, 1004)
    return RpmInfo(payload, compressor, name, version, description)
}

# The shell fragment that writes the payload as a plain cpio stream.
fn rpm_stream(archive str, info RpmInfo): str {
    return "tail -c +${info.payload + 1} " + util.quote(archive) + " | " + info.compressor
}

fn ensure_rpm_tools(info RpmInfo) {
    let needed = Vec<str>("cpio", "tail", "head")
    if info.compressor != "cat" { needed.push(util.slice(info.compressor, 0, strings.indexOf(info.compressor, " "))) }
    for i in 0..needed.len() as i64 {
        if !util.run(Vec<str>("command", "-v", needed[i as usize]), "", 30000).success {
            result.raise("Installing .rpm packages requires the ${needed[i as usize]}(1) tool")
        }
    }
}

# A row of `cpio -tv`: "-rwxr-xr-x   1 root root 1234 Jan  1 00:00 ./usr/bin/tool" (a link adds " -> target").
fn parse_cpio_line(line str): ListingRow {
    let fields = strings.split(strings.trim(line), " ")
    let clean = Vec<str>()
    for i in 0..fields.len() as i64 {
        if strings.len(fields[i as usize]) > 0 { clean.push(fields[i as usize]) }
    }
    if clean.len() < 9 { result.raise("Corrupt RPM payload listing: ${line}") }
    let name = ""
    for i in 8..clean.len() as i64 {
        if i > 8 { name = name + " " }
        name = name + clean[i as usize]
    }
    if util.slice(clean[0], 0, 1) == "l" {
        let arrow = util.rfind(name, " -> ")
        if arrow >= 0 { name = util.slice(name, 0, arrow) }
    }
    while strings.startsWith(name, "/") { name = util.slice(name, 1, strings.charLength(name)) }
    return ListingRow(clean[0], util.parse_int(clean[4]), util.slice(clean[0], 0, 1), name)
}

# strip_root mirrors manager.rs: entries recorded relative to a stripped root.
fn strip_root(normalized str, prefix str, is_dir bool): str {
    if strings.startsWith(normalized, prefix) {
        return util.slice(normalized, strings.charLength(prefix), strings.charLength(normalized))
    }
    let trimmed = prefix
    if strings.endsWith(trimmed, "/") {
        trimmed = util.slice(trimmed, 0, strings.charLength(trimmed) - 1)
    }
    if is_dir && normalized == trimmed { return "" }
    result.raise("Entry outside the ${prefix} package root: ${normalized}")
    return ""
}

fn limit_name(max_bytes i64): str {
    if max_bytes == 2 * 1024 * 1024 * 1024 { return "2 GiB" }
    if max_bytes == 128 * 1024 * 1024 { return "128 MiB" }
    return "${max_bytes} bytes"
}

# Extract `archive` into `dest` and return { files, bytes, native, skipped }.
# `files` maps package-relative paths to json file records; `native` carries
# .deb header metadata (name/version/description) with present=false otherwise.
struct Extracted { files json.Value; bytes i64; native NativeMeta; skipped i64 }

fn extract_archive(archive str, dest str, strip str, manifest_names Vec<str>, max_files i64, max_bytes i64): Extracted {
    ensure_deb_tools_if_needed(archive)
    let is_deb_archive = is_deb(archive)
    let is_rpm_archive = is_rpm(archive)
    let rpm = RpmInfo(0, "", "", "", "")
    if is_rpm_archive {
        rpm = rpm_info(archive)
        ensure_rpm_tools(rpm)
    }
    let text = ""
    if is_rpm_archive {
        text = util.capture(Vec<str>("sh", "-c", rpm_stream(archive, rpm) + " | cpio -itv --quiet"), "", "reading ${archive}")
    } else if is_deb_archive {
        let data = deb_data_member(archive)
        text = util.capture(
            Vec<str>("sh", "-c", "ar p " + util.quote(archive) + " " + util.quote(data) + " | tar -tv"),
            "", "reading ${archive}")
    } else {
        text = util.capture(Vec<str>("tar", "-tvzf", archive), "", "reading ${archive}")
    }
    let lines = strings.split(text, "\n")

    let seen = Map<str, bool>()
    let path_case = Map<str, str>()
    let bytes = 0
    let skipped = 0
    let count = 0
    let expected = Map<str, bool>()
    # Symlinks of an .rpm are dropped, but extraction must not be able to write through one: no member may sit below a symlink of the same archive.
    let links = Map<str, bool>()
    let paths_seen = Vec<str>()
    for i in 0..lines.len() as i64 {
        let line = strings.trim(lines[i as usize])
        if line == "" { continue }
        let row = ListingRow("", 0, "", "")
        if is_rpm_archive { row = parse_cpio_line(line) } else { row = parse_listing_line(line) }
        if strings.len(row.name) == 0 { continue }
        count = count + 1
        if count > max_files { result.raise("Archive has too many entries") }
        let base = row.name
        if strings.endsWith(base, "/") {
            base = util.slice(base, 0, strings.charLength(base) - 1)
        }
        let normalized = util.safe_path(base)
        let is_dir = row.kind == "d" || strings.endsWith(row.name, "/")
        if row.kind != "-" && row.kind != "d" {
            if is_deb_archive || is_rpm_archive {
                if row.kind == "l" { links.set(normalized, true) }
                skipped = skipped + 1
                continue
            }
            result.raise("Links and special files are not supported: ${row.name}")
        }
        if is_dir && row.size != 0 { result.raise("Directory entries must not contain data") }
        let path = normalized
        if strings.len(strip) > 0 {
            path = strip_root(normalized, strip, is_dir)
        }
        if strings.len(path) == 0 {
            if is_dir { continue }
            result.raise("Empty file path in archive")
        }
        paths_seen.push(path)
        let folded = strings.toLowerCase(path)
        if seen.contains(folded) { result.raise("Duplicate archive path: ${path}") }
        seen.set(folded, true)
        util.check_path_case(path, path_case)
        if !is_dir {
            bytes = bytes + row.size
            if bytes > max_bytes {
                result.raise("Archive exceeds the ${limit_name(max_bytes)} extracted-size limit")
            }
            let is_manifest = false
            for m in manifest_names {
                if m == path { is_manifest = true }
            }
            if is_manifest && row.size > manifest_limit() {
                result.raise("Package manifest exceeds 1 MiB")
            }
            expected.set(path, true)
        }
    }
    if expected.len() == 0 { result.raise("Archive contains no files") }
    if links.len() > 0 {
        for i in 0..paths_seen.len() as i64 {
            let parts = strings.split(paths_seen[i as usize], "/")
            let prefix = ""
            for k in 0..(parts.len() as i64 - 1) {
                prefix = k == 0 ? parts[0] : prefix + "/" + parts[k as usize]
                if links.contains(prefix) { result.raise("Archive entry is below a symlink: ${paths_seen[i as usize]}") }
            }
        }
    }

    # Extraction only runs after every member name passed validation. With a
    # strip prefix the tree is extracted without it, matching the Rust build's
    # destination.join(stripped_path) layout.
    fs.mkdirSync(dest, true)
    if is_rpm_archive {
        util.must(Vec<str>("sh", "-c", rpm_stream(archive, rpm) + " | (cd " + util.quote(dest) + " && cpio -idm --quiet --no-absolute-filenames --no-preserve-owner)"), "", "extracting ${archive}")
        # links and special files are not part of a package (the listing skipped them)
        util.must(Vec<str>("sh", "-c", "find " + util.quote(dest) + " ! -type f ! -type d -exec rm -f {} +"), "", "removing links from ${archive}")
    } else if is_deb_archive {
        let data = deb_data_member(archive)
        util.must(
            Vec<str>("sh", "-c", "ar p " + util.quote(archive) + " " + util.quote(data) + " | tar -x -C " + util.quote(dest) + " -p --no-same-owner --numeric-owner"),
            "", "extracting ${archive}")
    } else {
        let args = Vec<str>("tar", "-xzf", archive, "-C", dest, "-p", "--no-same-owner", "--numeric-owner")
        if strings.len(strip) > 0 {
            args.push("--strip-components=1")
        }
        util.must(args, "", "extracting ${archive}")
    }

    # The extracted tree must match the validated listing exactly.
    let actual = util.collect_files(dest)
    if actual.len() != expected.len() {
        result.raise("Extracted files do not match the archive listing")
    }
    for i in 0..actual.len() as i64 {
        if !expected.contains(actual[i as usize]) {
            result.raise("Extracted files do not match the archive listing: ${actual[i as usize]}")
        }
    }

    let native = NativeMeta(false, "", "", "")
    if is_rpm_archive {
        native.present = true
        native.name = rpm.name
        native.version = rpm.version
        native.description = rpm.description
    } else if is_deb_archive {
        let meta = deb_control(archive, util.parent_dir(dest))
        native.present = true
        native.name = meta.name
        native.version = meta.version
        native.description = meta.description
    }
    return Extracted(hash_tree(dest), bytes, native, skipped)
}

fn ensure_deb_tools_if_needed(archive str) {
    if is_deb(archive) { ensure_deb_tools() }
}

# Walk `root` and map every plain file to a json file record object.
fn hash_tree(root str): json.Value {
    let records = json.object()
    let paths = util.collect_files(root)
    let executables = executable_set(root)
    let hashes = hash_paths(root, paths)
    for i in 0..paths.len() as i64 {
        let path = paths[i as usize]
        let full = util.path_join(root, path)
        records = json.set(records, path, frec(hashes.get(path), (fs.size(full) as i64), executables.contains(path)))
    }
    return records
}

# Relative paths of executable files under root (one find(1) invocation).
fn executable_set(root str): Map<str,bool> {
    let set = Map<str, bool>()
    let text = util.capture(
        Vec<str>("sh", "-c", "cd " + util.quote(root) + " && find . -type f -perm /111 | LC_ALL=C sort"),
        "", "scanning ${root}")
    let lines = strings.split(text, "\n")
    for i in 0..lines.len() as i64 {
        let line = strings.trim(lines[i as usize])
        if line == "" { continue }
        let path = line
        if strings.startsWith(line, "./") { path = util.slice(line, 2, strings.charLength(line)) }
        set.set(path, true)
    }
    return set
}

# Batch sha256sum so large packages stay within argument and buffer limits.
fn hash_paths(root str, paths Vec<str>): Map<str,str> {
    let hashes = Map<str, str>()
    let index = 0
    while index < paths.len() as i64 {
        let args = Vec<str>("sha256sum", "--")
        let end = index + 200
        if end > paths.len() as i64 { end = paths.len() as i64 }
        for i in index..end {
            args.push(paths[i as usize])
        }
        let text = util.capture(args, root, "hashing files in ${root}")
        let lines = strings.split(text, "\n")
        for i in 0..lines.len() as i64 {
            let line = strings.trim(lines[i as usize])
            if strings.len(line) < 66 { continue }
            let digest = strings.toLowerCase(util.slice(line, 0, 64))
            if !valid_digest(digest) { result.raise("Corrupt sha256sum output") }
            hashes.set(util.slice(line, 66, strings.charLength(line)), digest)
        }
        index = end
    }
    return hashes
}

fn valid_digest(digest str): bool {
    if strings.len(digest) != 64 { return false }
    for i in 0..64 {
        if !util.is_hex_digit(strings.charAt(digest, i)) { return false }
    }
    return true
}
