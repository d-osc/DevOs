# dev - Dev OS Package Manager (DevLang).
# Usage: dev [options] <command> [...].
use "std/fs"
use "std/json"
use "std/strings"
use "std/result"
use "std/cli"
use "./util.dev" as util
use "./progress.dev" as progress
use "./store.dev" as store_mod
use "./manifest.dev" as manifest
use "./download.dev" as download
use "./update.dev" as update
use "./catalog.dev" as catalog

struct Options {
    root str
    devos_data str
    applications str
    command str
    positionals Vec<str>
    values Map<str, str>
    flags Map<str, bool>
    run_args Vec<str>
}

fn usage(): str {
    let text = ""
    text = text + "dev ${util.version()} - Dev OS Package Manager\n"
    text = text + "Usage: dev [OPTIONS] <COMMAND>\n"
    text = text + "\n"
    text = text + "Commands:\n"
    text = text + "  install <name|archive> Install a catalog app, local file or HTTP(S) URL (.dpk, .dpkx, .tar.gz, .deb, .rpm, or a Dev OS extension) [aliases: add, i]\n"
    text = text + "  catalog [--json]  Read the shared app-db catalog and installed bindings\n"
    text = text + "  search <query> [--json] Search the same app database as App Store\n"
    text = text + "  list               Show installed packages and Dev OS extensions\n"
    text = text + "  info <name>        Show package or extension metadata and installation path\n"
    text = text + "  verify [name]      Check installed file hashes, sizes and executable permissions\n"
    text = text + "  remove <name>      Remove a package or Dev OS extension and its saved previous version [aliases: uninstall, un, rm]\n"
    text = text + "  rollback <name>    Switch back to the saved previous version\n"
    text = text + "  run <command>      Execute a command exported by an installed package\n"
    text = text + "  pack <directory>   Build a .dpk from a directory containing package.json\n"
    text = text + "  update [names...]  Update packages and extensions from their GitHub latest release\n"
    text = text + "  self-update        Update the dev CLI itself from the d-osc/DevOsPM latest release\n"
    text = text + "\n"
    text = text + "Options:\n"
    text = text + "      --catalog <PATH>             App Store catalog source directory or bundled JSON\n"
    text = text + "      --root <DEV_ROOT>            Package store (default: $DEV_ROOT or ~/.local/share/devos)\n"
    text = text + "      --devos-data <DEV_OS_DATA>   Dev OS data directory for extensions (default: $XDG_DATA_HOME/dev-os)\n"
    text = text + "      --applications <DIR>         Launcher applications directory (default: $XDG_DATA_HOME/applications)\n"
    text = text + "  -h, --help                        Print help\n"
    text = text + "  -V, --version                     Print version"
    return text
}



fn command_flags(command str): Map<str, bool> {
    # option name -> takes a value
    let options = Map<str, bool>()
    options.set("catalog", true)
    if command == "install" || command == "add" || command == "i" {
        options.set("name", true)
        options.set("version", true)
        options.set("sha256", true)
        options.set("replace", false)
        options.set("no-desktop", false)
        options.set("catalog-id", true)
    }
    if command == "list" || command == "catalog" || command == "search" { options.set("json", false) }
    if command == "list" || command == "catalog" { options.set("summary", false) }
    if command == "remove" || command == "uninstall" || command == "un" || command == "rm" {
        options.set("purge", false)
    }
    if command == "pack" {
        options.set("output", true)
        options.set("o", true)
    }
    return options
}

fn canonical_command(command str): str {
    if command == "add" { return "install" }
    if command == "i" { return "install" }
    if command == "uninstall" { return "remove" }
    if command == "un" { return "remove" }
    if command == "rm" { return "remove" }
    return command
}

fn known_command(command str): bool {
    let commands = Vec<str>("install", "add", "i", "list", "info", "verify", "remove", "uninstall",
        "un", "rm", "rollback", "run", "pack", "update", "self-update", "catalog", "search", "catalog-bind")
    for i in 0..commands.len() as i64 {
        if commands[i as usize] == command { return true }
    }
    return false
}

# Parse program arguments: global options, then the subcommand with its own
# options. Everything after `run <command>` is passed through untouched.
fn parse_args(args Vec<str>): Options {
    let options = Options("", "", "", "", Vec<str>(), Map<str, str>(), Map<str, bool>(), Vec<str>())
    let index = 0
    while index < args.len() as i64 {
        let token = args[index as usize]
        if token == "-h" || token == "--help" {
            options.command = "help"
            return options
        }
        if token == "-V" || token == "--version" {
            options.command = "version"
            return options
        }
        if token == "--root" || token == "--devos-data" || token == "--applications" || token == "--catalog" {
            if index + 1 >= args.len() as i64 {
                result.raise("a value is required for '${token}' but none was supplied")
            }
            index = index + 1
            if token == "--root" { options.root = args[index as usize] }
            if token == "--devos-data" { options.devos_data = args[index as usize] }
            if token == "--applications" { options.applications = args[index as usize] }
            if token == "--catalog" { options.values.set("catalog", args[index as usize]) }
            index = index + 1
            continue
        }
        break
    }
    if index >= args.len() as i64 {
        result.raise("Usage: dev [OPTIONS] <COMMAND>. Run dev --help for details.")
    }
    let command = args[index as usize]
    if !known_command(command) {
        result.raise("unrecognized subcommand '${command}'")
    }
    options.command = canonical_command(command)
    index = index + 1

    if options.command == "run" {
        if index >= args.len() as i64 {
            result.raise("Usage: dev run <command> [args...]")
        }
        options.positionals.push(args[index as usize])
        index = index + 1
        while index < args.len() as i64 {
            options.run_args.push(args[index as usize])
            index = index + 1
        }
        return options
    }

    let schema = command_flags(command)
    while index < args.len() as i64 {
        let token = args[index as usize]
        if strings.startsWith(token, "-") && token != "-" {
            let name = token
            let value = ""
            let has_value = false
            let eq = strings.indexOf(token, "=")
            if eq >= 0 {
                name = util.slice(token, 0, eq)
                value = util.slice(token, eq + 1, strings.charLength(token))
                has_value = true
            }
            if strings.startsWith(name, "--") {
                name = util.slice(name, 2, strings.charLength(name))
            } else {
                name = util.slice(name, 1, strings.charLength(name))
            }
            if !schema.contains(name) {
                result.raise("unexpected argument '${token}' for ${options.command}")
            }
            if schema.get(name) {
                if !has_value {
                    if index + 1 >= args.len() as i64 {
                        result.raise("a value is required for '${token}' but none was supplied")
                    }
                    index = index + 1
                    value = args[index as usize]
                }
                options.values.set(name, value)
            } else {
                options.flags.set(name, true)
            }
            index = index + 1
            continue
        }
        options.positionals.push(token)
        index = index + 1
    }
    return options
}

fn value_of(values Map<str, str>, key str): str {
    if values.contains(key) { return values.get(key) }
    return ""
}

fn run_cli(args Vec<str>): i64 {
    let options = parse_args(args)
    if options.command == "help" {
        util.stderr_line(usage())
        return 0
    }
    if options.command == "version" {
        print("dev ${util.version()}")
        return 0
    }
    if options.flags.contains("summary") && !options.flags.contains("json") { result.raise("--summary requires --json") }
    if options.command == "list" && options.flags.contains("summary") {
        let store = store_mod.open_inventory(options.root)
        let summary = json.set(store_mod.inventory(store),"bindings",catalog.bindings(store.registry))
        print(json.stringify(summary)); return 0
    }
    if options.command == "catalog" || options.command == "search" {
        let data = catalog.load(value_of(options.values,"catalog"))
        if options.command == "search" {
            if options.positionals.len() != 1 { result.raise("Usage: dev search QUERY [--json]") }
            let query = strings.toLowerCase(options.positionals[0]); let matches = json.array(); let rows = json.get(data,"apps")
            for i in 0..(json.len(rows) as i64) { let row = json.at(rows,i); let m = json.get(row,"manifest"); if strings.contains(strings.toLowerCase(json.stringify(m)),query) { matches = json.push(matches,row) } }
            if options.flags.contains("json") { print(json.stringify(matches)) } else { for i in 0..(json.len(matches) as i64) { let m = json.get(json.at(matches,i),"manifest"); print(catalog.text(m,"id") + "\t" + catalog.text(m,"name") + "\t" + catalog.text(m,"status")) } }; return 0
        }
        if options.positionals.len() != 0 { result.raise("Usage: dev catalog [--json]") }
        let store = options.flags.contains("summary") ? store_mod.open_inventory(options.root) : store_mod.open_store(options.root,options.devos_data,options.applications,false)
        let inventory = store_mod.inventory(store)
        data = catalog.classify_catalog(data,inventory)
        let out = json.set(data,"bindings",catalog.bindings(store.registry)); out = json.set(out,"store",store.root)
        if options.flags.contains("summary") { out = json.set(out,"inventory",inventory) }
        if options.flags.contains("json") { print(json.stringify(out)) } else { let rows = json.get(data,"apps"); for i in 0..(json.len(rows) as i64) { let m = json.get(json.at(rows,i),"manifest"); print(catalog.text(m,"id") + "\t" + catalog.text(m,"name")) } }; return 0
    }
    if options.command == "catalog-bind" {
        if options.positionals.len() != 2 { result.raise("Usage: dev catalog-bind ID INSTALLED_PACKAGE") }
        let data = catalog.load(value_of(options.values,"catalog")); let row = catalog.find(data,options.positionals[0])
        let store = store_mod.open_store(options.root,options.devos_data,options.applications,true)
        store = store_mod.bind_catalog(store,options.positionals[1],catalog.metadata(data,row)); store_mod.release_lock(store); print("Catalog binding recorded."); return 0
    }
    if options.command == "pack" {
        if options.positionals.len() != 1 { result.raise("Usage: dev pack <directory>") }
        let output = value_of(options.values, "output")
        if output == "" { output = value_of(options.values, "o") }
        if output == "" { output = store_mod.default_package_output(options.positionals[0]) }
        store_mod.pack(options.positionals[0], output)
        print("Created ${output}")
        return 0
    }
    if options.command == "update" {
        let names = options.positionals
        if names.len() > 0 { let store = store_mod.open_store(options.root,options.devos_data,options.applications,false); for i in 0..(names.len() as i64) { names[i] = catalog.installed_name(store.registry,names[i]) } }
        return update.update_run(options.root, options.devos_data, options.applications, names)
    }
    if options.command == "self-update" {
        return update.self_update()
    }

    # Download before the write lock, then commit package and catalog identity together.
    let downloaded = download.Resolved(false, "", "", "")
    let selected = store_mod.JsonBox(json.null_value())
    if options.command == "install" {
        if options.positionals.len() != 1 { result.raise("Usage: dev install <name|archive>") }
        let source = options.positionals[0]; let catalog_id = value_of(options.values,"catalog-id")
        let named = !fs.existsSync(source) && util.identifier(source) && !strings.contains(source,".")
        if named { if catalog_id != "" { result.raise("Use either a catalog name or --catalog-id with a package file") }; catalog_id = source }
        if catalog_id != "" {
            let data = catalog.load(value_of(options.values,"catalog")); let row = catalog.find(data,catalog_id); selected.value = catalog.metadata(data,row)
            let digest = catalog.text(selected.value,"sha256")
            if digest != "" { if value_of(options.values,"sha256") != "" && strings.toLowerCase(value_of(options.values,"sha256")) != strings.toLowerCase(digest) { result.raise("Checksum conflicts with the catalog release") }; options.values.set("sha256",digest) }
            if named { let candidate = catalog.object(row,"candidate"); if json.has(candidate,"prepared") && !json.bool(json.get(candidate,"prepared")) { progress.notice("Upstream catalog download: DevOs compatibility is untested.") }; downloaded = catalog.fetch(row) } else { downloaded = download.resolve(source) }
        } else { downloaded = download.resolve(source) }
    }
    let operation = result.attempt(fn():i64 {
        let write = options.command == "install" || options.command == "remove" || options.command == "rollback"
        let store = store_mod.open_store(options.root, options.devos_data, options.applications, write)
        let ran = result.attempt(fn():i64 { return dispatch(store, options, downloaded, selected.value) })
        store_mod.release_lock(store)
        if result.isErr(ran) { result.raise(result.message(ran)) }; return result.unwrap(ran)
    })
    if downloaded.is_url && downloaded.directory != "" { util.must(Vec<str>("rm","-rf","--",downloaded.directory),"","cleaning the download") }
    if result.isErr(operation) { result.raise(result.message(operation)) }; return result.unwrap(operation)
}

fn dispatch(store store_mod.Store, options Options, downloaded download.Resolved, catalog_metadata json.Value): i64 {
    if options.command == "info" || options.command == "verify" || options.command == "remove" || options.command == "rollback" { for i in 0..(options.positionals.len() as i64) { options.positionals[i] = catalog.installed_name(store.registry,options.positionals[i]) } }
    if options.command == "install" {
        let archive_path = options.positionals[0]
        if downloaded.is_url { archive_path = downloaded.path }
        let source_repository = ""
        if downloaded.is_url && strings.contains(options.positionals[0], "://") { source_repository = update.repository_slug(options.positionals[0]) }
        let pair = store_mod.install_with_catalog(
            store,
            archive_path,
            value_of(options.values, "name"),
            value_of(options.values, "version"),
            value_of(options.values, "sha256"),
            options.flags.contains("replace"),
            options.flags.contains("no-desktop"),
            source_repository, catalog_metadata)
        progress.finish()
        if !pair.outcome.is_extension {
            print("Installed ${pair.outcome.name} ${pair.outcome.version}")
            print("Path: ${pair.outcome.path}")
            let package_node = json.get(json.get(pair.store.registry, "packages"), pair.outcome.name)
            let m = manifest.manifest_from_registry(json.get(json.get(package_node, "active"), "manifest"))
            let commands = manifest.bin_commands(m)
            for i in 0..commands.len() as i64 {
                let command = commands[i as usize]
                if store_mod.shim_path(pair.store, pair.outcome.name, command) != "" {
                    print("Run: ${command}   (or: dev run ${command})")
                } else {
                    print("Run: dev run ${command}")
                }
            }
        } else {
            print("Installed Dev OS extension ${pair.outcome.name} ${pair.outcome.version}")
            print("Path: ${pair.outcome.path}")
            print("Restart the Dev OS session to load the extension.")
        }
        return 0
    }
    if options.command == "list" {
        if options.flags.contains("json") {
            let payload = json.set(json.object(), "packages", json.get(store.registry, "packages"))
            payload = json.set(payload, "extensions", json.get(store.registry, "extensions"))
            payload = json.set(payload,"bindings",catalog.bindings(store.registry))
            print(json.stringify(payload))
            return 0
        }
        let names = store_mod.package_names(store)
        let ids = store_mod.extension_names(store)
        if names.len() == 0 && ids.len() == 0 {
            print("No packages installed. Use: dev install <file.dpk>")
            return 0
        }
        for i in 0..names.len() as i64 {
            let active = store_mod.active_snapshot(store, names[i as usize])
            let m = json.get(active, "manifest")
            let version = json.string(json.get(m, "version"))
            let count = json.len(json.get(active, "files"))
            let bytes = json.int(json.get(active, "bytes"))
            print("${names[i as usize]}	${version}	${count} files	${bytes} bytes")
        }
        for i in 0..ids.len() as i64 {
            let entry = store_mod.extension_entry(store, ids[i as usize])
            let count = json.len(json.get(entry, "files"))
            let bytes = json.int(json.get(entry, "bytes"))
            print("${ids[i as usize]}	${json.string(json.get(entry, "version"))}	${count} files	${bytes} bytes	dev-os extension")
        }
        return 0
    }
    if options.command == "info" {
        if options.positionals.len() != 1 { result.raise("Usage: dev info <name>") }
        let name = options.positionals[0]
        if store_mod.has_package_named(store, name) {
            let package = json.get(json.get(store.registry, "packages"), name)
            print(json.pretty(package))
            let active = json.get(package, "active")
            print("Path: ${store_mod.snapshot_path(store, active)}")
            let m = manifest.manifest_from_registry(json.get(active, "manifest"))
            let resolved = manifest.resolved_release(m)
            if resolved.present {
                let release = json.set(json.object(), "version", resolved.version)
                release = json.set(release, "tag", resolved.tag)
                release = json.set(release, "filename", resolved.filename)
                release = json.set(release, "url", resolved.url)
                print("Release: ${json.pretty(release)}")
            }
            return 0
        }
        if store_mod.has_extension(store, name) {
            let entry = store_mod.extension_entry(store, name)
            print(json.pretty(entry))
            print("Path: ${store_mod.extension_path(store, entry)}")
            return 0
        }
        result.raise("Package is not installed: ${name}")
        return 1
    }
    if options.command == "verify" {
        if options.positionals.len() > 1 { result.raise("Usage: dev verify [name]") }
        let name = ""
        if options.positionals.len() == 1 { name = options.positionals[0] }
        let count = store_mod.verify_store(store, name)
        print("Verified ${count} package(s): all files intact")
        return 0
    }
    if options.command == "remove" {
        if options.positionals.len() != 1 { result.raise("Usage: dev remove <name>") }
        let name = options.positionals[0]
        if options.flags.contains("purge") && store_mod.has_extension(store, name) {
            let purged = store_mod.remove_extension_flow(store, name, true)
        } else {
            let updated = store_mod.remove_package(store, name)
        }
        print("Removed ${name}")
        return 0
    }
    if options.command == "rollback" {
        if options.positionals.len() != 1 { result.raise("Usage: dev rollback <name>") }
        let name = options.positionals[0]
        let rolled = store_mod.rollback_package(store, name)
        print("Rolled back ${name} to ${rolled.version}")
        return 0
    }
    if options.command == "run" {
        return store_mod.run_command(store, options.positionals[0], options.run_args)
    }
    result.raise("unrecognized command '${options.command}'")
    return 1
}

fn main(): i64 {
    let args = cli.args()
    let outcome = result.attempt(fn(): i64 {
        return run_cli(args)
    })
    match outcome {
        Ok(code) => { return code }
        Err(message) => {
            progress.fail()
            util.fail_message(message)
            return 1
        }
    }
}

return (main() as i32)
