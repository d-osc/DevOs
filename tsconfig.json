{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "jsx": "react",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "@girs/gjs",
      "@girs/gjs/console",
      "@girs/gjs/cairo",
      "@girs/gjs/system",
      "@girs/gtk-3.0",
      "@girs/gtklayershell-0.1",
      "@girs/glibunix-2.0",
      "@girs/glib-2.0",
      "@girs/gio-2.0",
      "@girs/pango-1.0",
      "@girs/webkit2-4.1",
      "@girs/soup-3.0"
    ],
    "paths": {
      "@dev-os/core/*": [
        "./packages/core/*.ts"
      ],
      "@dev-os/extensions/*": [
        "./packages/extensions/*.ts"
      ],
      "@dev-os/updates/*": [
        "./packages/updates/*.ts"
      ],
      "@dev-os/config": [
        "./packages/config/index.ts"
      ],
      "@dev-os/config/*": [
        "./packages/config/*"
      ]
    }
  },
  "include": [
    "src/apps/**/*.ts",
    "src/apps/**/*.tsx",
    "src/extensions/**/*.ts",
    "src/extensions/**/*.tsx",
    "packages/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "examples/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "packages/**/*.tsx"
  ],
  "exclude": [
    "src/apps/org.devos.editor/browser"
  ]
}
