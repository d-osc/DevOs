{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "jsx": "react",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "@girs/gjs",
      "@girs/gjs/console",
      "@girs/gjs/cairo",
      "@girs/gjs/system",
      "@girs/gtk-3.0",
      "@girs/gtklayershell-0.1",
      "@girs/glibunix-2.0",
      "@girs/glib-2.0",
      "@girs/gio-2.0",
      "@girs/pango-1.0",
      "@girs/webkit2-4.1",
      "@girs/soup-3.0"
    ],
    "paths": {}
  },
  "include": [
    "packages/core/*.ts",
    "src/apps/org.devos.editor/**/*.ts",
    "src/apps/org.devos.editor/**/*.tsx"
  ],
  "exclude": [
    "src/apps/org.devos.editor/browser"
  ]
}
