{
  "name": "dev-os-de",
  "version": "0.3.7-ux3407na-dev",
  "private": true,
  "type": "module",
  "description": "A native Wayland desktop shell using GJS, GTK and labwc",
  "scripts": {
    "migration:audit": "d tools/maintenance/migration-audit.dev",
    "migration:check": "d tools/maintenance/migration-audit.dev -- --require-complete",
    "migration:no-gjs": "d tools/maintenance/no-gjs-audit.dev",
    "dev": "npm run build && sh bin/dev-os-session --nested",
    "check": "npm run build",
    "doctor": "sh bin/dev-os-shell doctor",
    "smoke": "npm run build && d tools/test/smoke.dev --",
    "build": "node tools/build/build.ts",
    "watch": "node tools/build/build.ts --watch",
    "release:package": "d tools/release/release.dev -- package",
    "typecheck": "tsc --project tsconfig.tools.json",
    "theme:generate": "d tools/theme/generate-palette.dev"
  },
  "devDependencies": {
    "@girs/gio-2.0": "5.5.0",
    "@girs/gjs": "5.5.0",
    "@girs/glib-2.0": "5.5.0",
    "@girs/glibunix-2.0": "5.5.0",
    "@girs/gst-1.0": "^5.5.0",
    "@girs/gtk-3.0": "5.5.0",
    "@girs/gtklayershell-0.1": "5.5.0",
    "@girs/pango-1.0": "5.5.0",
    "@girs/soup-3.0": "5.5.0",
    "@girs/vte-2.91": "^5.5.0",
    "@girs/webkit2-4.1": "5.5.0",
    "@types/node": "22.18.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  }
}
