#!/usr/bin/env d
use "std/fs"
use "std/json"
use "std/strings"
use "../lib/tool.dev" as tool
use "../../lib/theme-palette.dev" as palette
fn main():i32 {
    let root=tool.root();let data=palette.generate(root)
    let destination=tool.option("--output",root+"/packages/core/theme-palette.ts");let output=""
    # Preserve formatting when the existing npm binding has the same data.
    if fs.is_file(destination) {
        let existing=fs.readFileSync(destination,"utf8");let tables=strings.split(existing,"Object.freeze(")
        if tables.len()==4 {
            let same=true;let names=Vec<str>("familyPalettes","paletteSources","syntaxRules")
            for i in 0..3 {let value=json.parse(strings.split(tables[i+1],");")[0]);if !strings.equal(json.stringify(value),json.stringify(json.get(data,names[i]))) {same=false}}
            if same {output=strings.replaceAll(existing,"generate-palette.mjs","generate-palette.dev")}
        }
    }
    if strings.equal(output,"") {
        let names=Vec<str>();for key in json.keys(json.get(json.get(json.get(data,"familyPalettes"),"vscode"),"dark")) {names.push("'"+key+"'")}
        output="// Generated by tools/theme/generate-palette.dev; see src/apps/org.devos.theme/NOTICE.md.\nexport type ThemeName = 'dark' | 'light';\nexport type ThemeFamily = 'vscode' | 'github';\nexport type PaletteToken = "+strings.join(names," | ")+";\nexport type Palette = Readonly<Record<PaletteToken, string>>;\nexport interface TokenRule {readonly scope: string; readonly foreground?: string; readonly fontStyle?: string}\n"
        output=output+"export const familyPalettes: Readonly<Record<ThemeFamily, Readonly<Record<ThemeName, Palette>>>> = Object.freeze("+json.pretty(json.get(data,"familyPalettes"))+");\n"
        output=output+"export const paletteSources: Readonly<Record<ThemeFamily, Readonly<Record<ThemeName, Readonly<Record<string,string>>>>>> = Object.freeze("+json.pretty(json.get(data,"paletteSources"))+");\n"
        output=output+"export const syntaxRules: Readonly<Record<ThemeFamily, Readonly<Record<ThemeName, readonly TokenRule[]>>>> = Object.freeze("+json.stringify(json.get(data,"syntaxRules"))+");\nexport const palettes: Readonly<Record<ThemeName, Palette>> = familyPalettes.vscode;\n"
    }
    tool.write(destination,output);tool.jsonWrite(tool.option("--data-output",root+"/data/themes/palettes.json"),data)
    print("Generated native palette data and npm TypeScript bindings using DevLang")
    return 0
}
return tool.main(main)
