# PAM conversation via C ABI; load libpam explicitly in the calling runtime.
use "std/result"
use "../lib/tool.dev" as tool
struct Message { style: i32, text: *u8 }
struct Response { text: *u8, code: i32 }
struct Conversation { call: callback(i32,**Message,**Response,*void): i32, data: *void }
extern fn calloc(count: usize, size: usize): *void
extern fn free(pointer: *void)
extern fn strdup(text: str): *u8
extern fn pam_start(service: str, username: str, conversation: *Conversation, handle: **void): i32
extern fn pam_authenticate(handle: *void, flags: i32): i32
extern fn pam_acct_mgmt(handle: *void, flags: i32): i32
extern fn pam_end(handle: *void, status: i32): i32
fn authenticate(service: str, username: str, password: str): bool {
    unsafe {
        let callback = callback_context(fn(count: i32, messages: **Message, responses: **Response): i32 {
            unsafe {
                let answers = calloc(count as usize, sizeof(Response(null, 0))) as *Response
                if !(answers as bool) { return 19 }
                for i in 0..(count as i64) {
                    let message = messages[i][0]
                    if message.style == 1 || message.style == 2 { answers[i].text = strdup(password) }
                }
                responses[0] = answers
                return 0
            }
        })
        let conversation = calloc(1, sizeof(Conversation(callback.call, callback.data))) as *Conversation
        let storage = calloc(1, sizeof(null as *void)) as **void
        tool.require(conversation as bool && storage as bool, "Out of memory preparing PAM test.")
        conversation[0] = Conversation(callback.call, callback.data)
        let code = pam_start(service, username, conversation, storage)
        if code != 0 { free(conversation as *void); free(storage as *void); tool.require(false, "Could not initialize isolated PAM test.") }
        let handle = storage[0]
        code = pam_authenticate(handle, 0)
        if code == 0 { code = pam_acct_mgmt(handle, 0) }
        pam_end(handle, code)
        free(conversation as *void); free(storage as *void)
        return code == 0
    }
}
