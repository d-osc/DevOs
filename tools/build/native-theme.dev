# Native theme data is generated by DevLang; npm bindings consume the same values.
use "std/args"
use "std/fs"
use "std/json"
use "std/strings"
use "std/result"
fn snake(value:str):str {
    let out=""; for ch in strings.split(value,"") { let lower=strings.toLowerCase(ch); out=out+(strings.equal(lower,ch) ? ch : "_"+lower) }; return out
}
let root=args.get(0)
let data=json.get(json.parse(fs.readFileSync(root+"/data/themes/palettes.json","utf8")),"familyPalettes")
let css=fs.readFileSync(root+"/src/apps/org.devos.theme/style.css","utf8")
for family in Vec<str>("vscode","github") {
    for mode in Vec<str>("dark","light") {
        let palette=json.get(json.get(data,family),mode); let colors=json.object()
        for key in json.keys(palette) { colors=json.set(colors,snake(key),json.get(palette,key)) }
        let extra={s00:strings.equal(mode,"dark") ? "mix(@dv_s0, #000000, 0.45)" : "@dv_s0",s6:"mix(@dv_s5, @dv_fg, 0.10)",s7:"mix(@dv_s5, @dv_fg, 0.22)",line2:"mix(@dv_line1, @dv_line3, 0.5)",border:strings.equal(mode,"dark") ? "alpha(@dv_fg, 0.12)" : "alpha(@dv_fg, 0.14)",border_soft:strings.equal(mode,"dark") ? "alpha(@dv_fg, 0.08)" : "alpha(@dv_fg, 0.10)",shadow:"#000000",shade:strings.equal(mode,"dark") ? "#000000" : "#9a9aa6"}
        for key in json.keys(extra) { colors=json.set(colors,key,json.get(extra,key)) }
        for color in Vec<str>("accent","error","warning","purple") {
            for index in 1..5 {
                let ratio=index==1 ? "0.14" : index==2 ? "0.22" : index==3 ? "0.34" : "0.5"
                if !strings.equal(color,"accent") { ratio=index==1 ? "0.14" : "0.28" }
                if strings.equal(color,"purple") { ratio=index==1 ? "0.16" : "0.28" }
                colors=json.set(colors,color+"_t${index}","mix(@dv_s2, @dv_${color}, ${ratio})")
            }
        }
        let output="/* devos-theme:${mode} */\n"
        for key in json.keys(colors) { output=output+"@define-color dv_${key} "+json.string(json.get(colors,key))+";\n" }
        if !fs.writeFileSync(root+"/dist/native/theme.${family}.${mode}.css",output+css) { result.raise("Cannot write native theme stylesheet") }
    }
}
