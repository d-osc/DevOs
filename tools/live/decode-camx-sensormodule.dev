#!/usr/bin/env d
# Summarise a Qualcomm CamX sensor module file (com.qti.sensormodule.<sensor>.bin).
#
# Prints what the container reliably holds (identity strings, field names, the
# module/EEPROM names, a 19.2 MHz clock value) with byte offsets so a reviewer can
# check each against `xxd`. It deliberately does NOT print GPIO numbers, regulators
# or CSI lanes: the file stores only sensor register tables and logical power-step
# types; physical pins and rails live in ACPI/the platform driver, not here.
# Usage: d decode-camx-sensormodule.dev -- FILE
use "std/args"
use "std/fs"
use "std/regex"
use "std/strings"
use "std/encoding"
use "../lib/tool.dev" as tool

fn clock(): i64 { return 19200000 }
fn hex(value: i64): str {
    if value == 0 { return "0" }
    let digits = "0123456789abcdef"
    let out = ""
    while value > 0 {
        out = strings.charAt(digits, value % 16) + out
        value = value / 16
    }
    return out
}
fn hex8(value: i64): str {
    let text = hex(value)
    return strings.repeat("0", 8 - strings.charLength(text)) + text
}

fn startsWith(data: Vec<u8>, prefix: str): bool {
    let bytes = encoding.encode(prefix, "utf8")
    if data.len() < bytes.len() { return false }
    for i in 0..(bytes.len() as i64) { if data[i] != bytes[i] { return false } }
    return true
}
fn isStart(b: u8): bool { return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 }
fn isBody(b: u8): bool { return isStart(b) || (b >= 48 && b <= 57) || b == 32 || b == 46 || b == 58 || b == 47 || b == 45 }

struct Found { text: str, offset: i64 }

# Printable identifiers: [A-Za-z_][A-Za-z0-9_ .:/-]{3,}, first occurrence of each text.
fn identifiers(data: Vec<u8>): Vec<Found> {
    let out = Vec<Found>()
    let seen = Vec<str>()
    let i = 0
    let total = data.len() as i64
    while i < total {
        if !isStart(data[i]) { i = i + 1; continue }
        let end = i + 1
        while end < total && isBody(data[end]) { end = end + 1 }
        if end - i >= 4 {
            let bytes = Vec<u8>()
            for k in i..end { bytes.push(data[k]) }
            let text = encoding.decode(bytes, "utf8")
            let known = false
            for s in 0..(seen.len() as i64) { if strings.equal(seen[s], text) { known = true; break } }
            if !known { seen.push(text); out.push(Found(text, i)) }
        }
        i = end
    }
    return out
}

fn run() {
    tool.require(args.len() == 1, "Usage: decode-camx-sensormodule.dev -- FILE")
    let data = fs.read_bytes(args.get(0))
    tool.require(startsWith(data, "QTI Chromatix Header"), "Not a CamX sensor module file (missing \"QTI Chromatix Header\")")
    let found = identifiers(data)
    let names = Vec<str>("sensorDriverData", "cameraModuleData", "EEPROMDriverData", "sensorName", "moduleType", "powerSetting", "slaveAddr",
        "sensorSlaveAddress", "sensorI2CFrequencyMode", "laneAssign", "isComboMode", "cphyDphyComboMode", "moduleName", "eepromName", "flashName")
    let identity = regex.compile("(ov|imx|hi)\\d+[a-z0-9]*|eeprom|luxvision|sunny|ofilm", "i")
    print("size: ${data.len()} bytes")
    print("field names (offset: name):")
    for n in 0..(names.len() as i64) {
        for f in 0..(found.len() as i64) {
            if strings.equal(found[f].text, names[n]) { print("  0x" + hex(found[f].offset) + ": " + names[n]) }
        }
    }
    print("module / sensor identity strings:")
    for f in 0..(found.len() as i64) {
        let isName = false
        for n in 0..(names.len() as i64) { if strings.equal(names[n], found[f].text) { isName = true } }
        if !isName && strings.charLength(found[f].text) < 40 && identity.test(found[f].text) { print("  0x" + hex(found[f].offset) + ": " + found[f].text) }
    }
    let offsets = Vec<str>()
    for o in 0..((data.len() as i64) - 3) {
        let value = (data[o] as i64) | ((data[o + 1] as i64) << 8) | ((data[o + 2] as i64) << 16) | ((data[o + 3] as i64) << 24)
        if value == clock() { offsets.push("0x" + hex(o)) }
    }
    print("19.2 MHz (0x" + hex8(clock()) + ") u32 at offsets: " + (offsets.len() > 0 ? strings.join(offsets, ", ") : "none"))
    print("NOT in this file: physical GPIO numbers, regulator rails, CSI lanes, CCI bus.")
}

fn main(): i32 {
    run()
    return 0
}
return tool.main(main)
