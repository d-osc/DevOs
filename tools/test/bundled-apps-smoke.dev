#!/usr/bin/env d
use "std/fs"
use "std/json"
use "std/strings"
use "std/result"
use "std/time"
use "std/http"
use "std/child_process"
use "../lib/tool.dev" as tool
use "../lib/smoke.dev" as smoke
use "../../lib/desktop.dev" as util
fn main(): i32 {
    if tool.has("--help") { print("Open bundled Chrome and VS Code privately [--web]."); return 0 }
    let extras = Map<str,str>(); extras.set("DONT_PROMPT_WSL_INSTALL", "1")
    smoke.withSession("bundled-apps", extras, fn(session: smoke.Session) {
        let env: Map<str,str> = smoke.environment(session)
        let artifacts: str = session.root + "/build/bundled-apps"
        fs.mkdirSync(artifacts, true)
        let code = "const Gio=imports.gi.Gio;for(const id of ['google-chrome.desktop','com.microsoft.VSCode.desktop']){const app=Gio.DesktopAppInfo.new(id);if(!app||!app.should_show())throw new Error('Application hidden: '+id);print(id+': '+app.get_executable());}if(Gio.DesktopAppInfo.new('code.desktop')?.should_show())throw new Error('Duplicate VS Code entry');"
        tool.write(artifacts + "/catalog.txt", tool.checked(Vec<str>("gjs", "-c", code), env, "", 10000))
        let tracker: smoke.Input = smoke.input(session.root + "/build/native/dev-os-window-tracker", session.base, env)
        tool.write(session.base + "/welcome.txt", "Chrome and Visual Studio Code bundled with DevOs.\n")
        let editor: child_process.Child = smoke.launch(Vec<str>(session.root + "/bin/code", "--user-data-dir", session.base + "/code", "--extensions-dir", session.base + "/extensions", "--disable-extensions", "--skip-welcome", "--skip-release-notes", "--new-window", session.base + "/welcome.txt"), env, session.log)
        let browser: child_process.Child = smoke.launch(Vec<str>("sh", session.root + "/bin/dev-os-browser", "--remote-debugging-port=0", "--user-data-dir=" + session.base + "/chrome", "--no-first-run", "--no-default-browser-check", tool.has("--web") ? "https://github.com/login/device" : "about:blank"), env, session.log)
        let outcome = result.run(fn() {
            if tool.has("--web") {
                tool.waitFor(fn(): bool {
                    let response = result.attempt(fn(): bool {
                        let port = strings.split(tool.read(session.base + "/chrome/DevToolsActivePort"), "\n")[0]
                        let tabs = json.parse(http.get("http://127.0.0.1:" + port + "/json/list").body)
                        for i in 0..(json.len(tabs) as i64) {
                            let tab = json.at(tabs, i)
                            if strings.contains(util.text(util.get(tab, "url")), "github.com/login") && strings.contains(util.text(util.get(tab, "title")), "GitHub") { tool.jsonWrite(artifacts + "/web-load.json", tabs); return true }
                        }
                        return false
                    })
                    return result.unwrapOr(response, false)
                }, 40000, "Chrome did not load GitHub sign-in over HTTPS.")
            }
            tool.waitFor(fn(): bool {
                let chrome = false; let vscode = false
                let events = smoke.events(tracker.log)
                for i in 0..(json.len(events) as i64) {
                    let event = json.at(events, i)
                    if !strings.equal(util.text(util.get(event, "type")), "window") { continue }
                    let id = strings.toLowerCase(util.text(util.get(event, "appId")) + " " + util.text(util.get(event, "title")))
                    if strings.contains(id, "chrome") || strings.contains(id, "chromium") { chrome = true }
                    if strings.contains(id, "code") { vscode = true }
                }
                return chrome && vscode
            }, 45000, "Expected both bundled native application windows.")
            time.sleep_ms(3000)
            let events = smoke.events(tracker.log)
            let seen = Map<str,bool>()
            for i in 0..(json.len(events) as i64) {
                let event = json.at(events, i)
                if !strings.equal(util.text(util.get(event, "type")), "window") { continue }
                let id = strings.toLowerCase(util.text(util.get(event, "appId")) + " " + util.text(util.get(event, "title")))
                let app = strings.contains(id, "code") ? "vscode" : ((strings.contains(id, "chrome") || strings.contains(id, "chromium")) ? "chrome" : "")
                if strings.equal(app, "") || seen.contains(app) { continue }
                let windowId = util.get(event, "id")
                smoke.sendRaw(tracker, "activate " + (strings.equal(json.kind(windowId), "string") ? json.string(windowId) : json.stringify(windowId)))
                time.sleep_ms(1000); smoke.screenshot(env, artifacts + "/" + app + ".png"); seen.set(app, true)
            }
            tool.copy(session.log, artifacts + "/session.log")
        })
        smoke.stop(browser); smoke.stop(editor); smoke.closeInput(tracker); result.unwrap(outcome)
    })
    print("PASS: application entries, duplicate suppression, Chrome and VS Code native Wayland windows")
    return 0
}
return tool.main(main)
