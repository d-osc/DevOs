#!/usr/bin/env d
use "../lib/tool.dev" as tool
use "../lib/smoke.dev" as smoke
fn main(): i32 {
    if tool.has("--help") { print("Check native compositor slide frames in an isolated session."); return 0 }
    smoke.native("desktop-animation-native", "DEV_OS_DESKTOP_ANIMATION_TEST", "<labwc_config><desktops><names><name>One</name><name>Two</name></names></desktops></labwc_config>", 12500)
    print("PASS: native desktop slide frames, settling, rapid reversal and closing a window")
    return 0
}
return tool.main(main)
