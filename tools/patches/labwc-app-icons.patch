+/* Use the application's desktop icon without opening a GTK display connection. */
+static GdkPixbuf *
+load_app_icon(GIcon *icon)
+{
+	static GtkIconTheme *icon_theme;
+	if (!icon_theme) {
+		icon_theme = gtk_icon_theme_new();
+		gtk_icon_theme_set_custom_theme(icon_theme, "Adwaita");
+		gtk_icon_theme_add_resource_path(icon_theme, "/org/gtk/libgtk/icons/");
+	}
+	GtkIconInfo *info = gtk_icon_theme_lookup_by_gicon(icon_theme, icon,
+		16, GTK_ICON_LOOKUP_FORCE_SIZE);
+	if (!info) {
+		return NULL;
+	}
+	GdkPixbuf *image;
+	if (gtk_icon_info_is_symbolic(info)) {
+		GdkRGBA foreground = {0.88, 0.93, 0.94, 1.0};
+		image = gtk_icon_info_load_symbolic(info, &foreground,
+			NULL, NULL, NULL, NULL, NULL);
+	} else {
+		image = gtk_icon_info_load_icon(info, NULL);
+	}
+	g_object_unref(info);
+	return image;
+}
+
+static GDesktopAppInfo *
+find_desktop_app(const char *app_id)
+{
+	if (!app_id || !*app_id) {
+		return NULL;
+	}
+	char *desktop_id = g_str_has_suffix(app_id, ".desktop")
+		? g_strdup(app_id) : g_strconcat(app_id, ".desktop", NULL);
+	GDesktopAppInfo *app = g_desktop_app_info_new(desktop_id);
+	if (!app) {
+		/* Some clients use StartupWMClass or different casing as their app_id. */
+		GList *apps = g_app_info_get_all();
+		for (GList *item = apps; item; item = item->next) {
+			if (!G_IS_DESKTOP_APP_INFO(item->data)) {
+				continue;
+			}
+			GDesktopAppInfo *candidate = item->data;
+			const char *id = g_app_info_get_id(G_APP_INFO(candidate));
+			const char *wm_class = g_desktop_app_info_get_startup_wm_class(candidate);
+			if ((id && !g_ascii_strcasecmp(id, desktop_id))
+					|| (wm_class && !g_ascii_strcasecmp(wm_class, app_id))) {
+				app = g_object_ref(candidate);
+				break;
+			}
+		}
+		g_list_free_full(apps, g_object_unref);
+	}
+	g_free(desktop_id);
+	return app;
+}
+
+static struct lab_data_buffer *
+create_app_icon(struct view *view)
+{
+	const char *app_id = view_get_string_prop(view, "app_id");
+	GDesktopAppInfo *app = find_desktop_app(app_id);
+	GIcon *icon = app ? g_app_info_get_icon(G_APP_INFO(app)) : NULL;
+	GdkPixbuf *image = icon ? load_app_icon(icon) : NULL;
+	if (app) {
+		g_object_unref(app);
+	}
+	if (!image && app_id && *app_id) {
+		icon = g_themed_icon_new(app_id);
+		image = load_app_icon(icon);
+		g_object_unref(icon);
+	}
+	if (!image) {
+		icon = g_themed_icon_new("application-x-executable-symbolic");
+		image = load_app_icon(icon);
+		g_object_unref(icon);
+	}
+	if (!image) {
+		return NULL;
+	}
+	struct lab_data_buffer *buffer = buffer_create_cairo(16, 16, 1.0, true);
+	if (buffer) {
+		gdk_cairo_set_source_pixbuf(buffer->cairo, image,
+			(16 - gdk_pixbuf_get_width(image)) / 2.0,
+			(16 - gdk_pixbuf_get_height(image)) / 2.0);
+		cairo_paint(buffer->cairo);
+	}
+	g_object_unref(image);
+	return buffer;
+}
