# Where the projects that live inside this repository are: pm-cli, packages/devos-linux-kernel and packages/devos-appstore.
# An environment variable, when set, names another checkout instead (DEV_OS_PM_SOURCE, DEVOS_KERNEL_PROJECT, DEVOS_APPSTORE_SOURCE).
use "std/fs"
use "std/module"
use "std/strings"
use "./hw.dev" as hw
use "../distro/usb/hostio.dev" as io

# `relative` is the project's folder under the repository root. The root is DEVOS_REPO_ROOT, else the first folder above the entry script that has it.
fn path(relative: str, overrideVariable: str): str {
    let override = hw.env(overrideVariable)
    if strings.charLength(override) > 0 { return override }
    let root = hw.env("DEVOS_REPO_ROOT")
    if strings.charLength(root) > 0 { return root + "/" + relative }
    let dir = hw.parentDir(io.resolve(module.entry()))
    for level in 0..8 {
        if fs.existsSync(dir + "/" + relative) { return dir + "/" + relative }
        dir = hw.parentDir(dir)
    }
    return ""
}
fn pm(): str { return path("pm-cli","DEV_OS_PM_SOURCE") }
fn kernel(): str { return path("packages/devos-linux-kernel","DEVOS_KERNEL_PROJECT") }
fn appstore(): str { return path("packages/devos-appstore","DEVOS_APPSTORE_SOURCE") }
