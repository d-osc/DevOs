use "std/fs"
use "std/json"
use "std/strings"
use "std/process"
use "std/os"
use "std/regex"
use "../lib/desktop.dev" as util

fn defaults(): json.Value { return {tap: true, drag: true, natural: true, typing: true, leftHanded: false, speed: 50} }
fn configDirectory(): str {
    let directory = process.getenv("XDG_CONFIG_HOME")
    if strings.equal(directory, "") { directory = os.homedir() + "/.config" }
    return directory + "/dev-os"
}
fn preferencesPath(): str { return configDirectory() + "/touchpad.json" }
// The touchpad lock and the smart gestures live in their own file, written by dev-os-touchpad-gestures.
fn gesturesPath(): str { return configDirectory() + "/touchpad-gestures.json" }
fn locked(): bool {
    if !fs.existsSync(gesturesPath()) { return false }
    let raw = fs.readFileSync(gesturesPath(), "utf8")
    if !json.valid(raw) { return false }
    let value = json.parse(raw)
    if !strings.equal(json.kind(value), "object") || !json.has(value, "locked") { return false }
    return strings.equal(json.kind(json.get(value, "locked")), "bool") && json.bool(json.get(value, "locked"))
}
fn validate(value: json.Value): json.Value {
    if !strings.equal(json.kind(value), "object") { return json.null_value() }
    for key in Vec<str>("tap", "drag", "natural", "typing", "leftHanded") {
        if !json.has(value, key) || !strings.equal(json.kind(json.get(value, key)), "bool") { return json.null_value() }
    }
    if !json.has(value, "speed") || !strings.equal(json.kind(json.get(value, "speed")), "number") { return json.null_value() }
    let speed = json.float(json.get(value, "speed"))
    if speed < 0 || speed > 100 || speed != (speed as i64) as f64 { return json.null_value() }
    let settings = defaults()
    for key in Vec<str>("tap", "drag", "natural", "typing", "leftHanded", "speed") { settings = json.set(settings, key, json.get(value, key)) }
    return settings
}
fn load(): json.Value {
    if !fs.existsSync(preferencesPath()) { return defaults() }
    let raw = fs.readFileSync(preferencesPath(), "utf8")
    if !json.valid(raw) { return json.null_value() }
    return validate(json.parse(raw))
}
fn option(value: json.Value, key: str): str { return json.bool(json.get(value, key)) ? "yes" : "no" }
fn applyXml(xml: str, value: json.Value): str {
    let settings = validate(value)
    util.require(!json.is_null(settings), "Invalid touchpad settings.")
    let speed = (json.float(json.get(settings, "speed")) - 50.0) / 50.0
    let block = "<device category=\"touchpad\"><tap>" + option(settings, "tap") + "</tap><tapButtonMap>lrm</tapButtonMap><tapAndDrag>" + option(settings, "drag") + "</tapAndDrag><dragLock>no</dragLock><scrollMethod>twofinger</scrollMethod><naturalScroll>" + option(settings, "natural") + "</naturalScroll><disableWhileTyping>" + option(settings, "typing") + "</disableWhileTyping><leftHanded>" + option(settings, "leftHanded") + "</leftHanded><pointerSpeed>${speed}</pointerSpeed>" + (locked() ? "<sendEventsMode>no</sendEventsMode>" : "") + "</device>"
    let pattern = regex.compile("<device[ \\t\\r\\n]+category=\"touchpad\"[^>]*>[\\s\\S]*?</device>", "")
    let result = pattern.replace(xml, block)
    pattern.close()
    if !strings.equal(result, xml) || strings.contains(xml, block) { return result }
    if strings.contains(xml, "</libinput>") { return strings.replace(xml, "</libinput>", block + "</libinput>") }
    if strings.contains(xml, "<libinput/>") { return strings.replace(xml, "<libinput/>", "<libinput>" + block + "</libinput>") }
    util.require(strings.contains(xml, "</labwc_config>"), "Invalid compositor configuration.")
    return strings.replace(xml, "</labwc_config>", "<libinput>" + block + "</libinput></labwc_config>")
}
