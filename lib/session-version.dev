# Installed-session selection validation, without starting GJS.
use "std/fs"
use "std/json"
use "std/regex"
use "std/strings"
use "./hw.dev" as hw
use "./desktop.dev" as util
fn matches(value:str,pattern:str):bool { let r=regex.compile(pattern,""); let valid=r.test(value); r.close(); return valid }
fn version(raw:json.Value):str {
    util.require(strings.equal(json.kind(raw),"string"),"Invalid release version")
    let value=json.string(raw)
    util.require(matches(value,"^v?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-ux3407na-dev)?$"),"Invalid release version")
    if strings.startsWith(value,"v") { value=strings.substring(value,1,strings.charLength(value)) }
    value=strings.replaceAll(value,"-ux3407na-dev","")
    for part in strings.split(value,".") { util.require(strings.charLength(part)<=16 && hw.toInt(part,9007199254740992)<=9007199254740991,"Invalid release version") }
    return value
}
fn selectedAt(directory:str):str {
    let history=json.parse(fs.readFileSync(directory+"/history.json","utf8"))
    util.require(hw.isObject(history) && json.has(history,"current") && json.has(history,"previous"),"Invalid installed update history")
    for field in Vec<str>("current","previous") {
        let record=json.get(history,field); if json.is_null(record) { continue }
        let platform=util.text(util.get(record,"platform")); let key=util.text(util.get(record,"key")); let repo=util.text(util.get(record,"repository"))
        util.require(strings.equal(platform,"linux-x64") || strings.equal(platform,"linux-arm64"),"Invalid installed update history")
        let number=version(util.get(record,"version"))
        util.require(matches(key,"^[0-9]+\\.[0-9]+\\.[0-9]+-[a-f0-9]{12}$") && strings.startsWith(key,number+"-"),"Invalid installed update history")
        util.require(strings.charLength(repo)<=200 && matches(repo,"^[A-Za-z0-9][A-Za-z0-9_-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"),"Invalid installed repository")
        let metadata=json.parse(fs.readFileSync(directory+"/releases/"+key+"/release.json","utf8"))
        util.require(hw.jnum(metadata,"format",0.0)==1.0 && strings.equal(util.text(util.get(metadata,"version")),util.text(util.get(record,"version"))) && strings.equal(util.text(util.get(metadata,"platform")),platform),"Installed release metadata does not match update history")
    }
    let current=json.get(history,"current"); util.require(!json.is_null(current),"No installed Dev OS version is selected")
    return directory+"/releases/"+json.string(json.get(current,"key"))
}
fn selected():str { return selectedAt(hw.envOr("XDG_DATA_HOME",hw.home()+"/.local/share")+"/dev-os-updates") }
