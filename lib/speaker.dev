# Speaker sound modes and voice-only filtering for Dev OS Settings (the MyASUS "AI Noise-Canceling Speaker" and "Sound Modes" cards).
# Entry point of bin/dev-os-speaker:
#   get | voice on|off | boost on|off | mode <id> | smart on|off | device <node.name> | custom <slot> <bass> <mid> <treble> | apply | serve
# JSON on stdout, exit 1 on failure. Runs as the user; no root and no polkit action.
#
# Backend (PipeWire filter-chain with the built-in biquad filters, nothing else is invented):
#   Sound modes  Dynamic (no processing), Game, Movie, Music, Voice and Custom 1-3 are equalizer curves (low shelf, peaking and high
#                shelf biquads with headroom so they do not clip). This is NOT Dolby Atmos and has no spatial or object audio.
#   Voice only   "AI Noise-Canceling Speaker" is a voice-band filter (high-pass 300 Hz, low-pass 3.4 kHz, 24 dB/octave). It removes sounds
#                outside the human voice range; it is not a trained model and cannot remove noise inside the voice range.
#   Volume Booster  +9.5 dB of gain into a soft saturator (g / (1 + |g|)) with make-up gain so full scale stays full scale.
#   Smart switch with Voice Mode Smart Switch on, the Voice curve is used while an application is recording audio (a call).
# The effect runs as a virtual sink "devos-spk-fx" feeding the chosen real output; `serve` (devos-speaker.service) supervises one
# `pipewire -c` filter process and rebuilds it within a few seconds when the state file changes or a recording starts or stops.
# It shares its PipeWire plumbing (lib/pwaudio.dev) with dev-os-microphone and its DEVOS_MIC_* test hooks.
use "std/args"
use "std/json"
use "std/math"
use "std/strings"
use "std/result"
use "../lib/hw.dev" as hw
use "../lib/pwaudio.dev" as pw

fn unit(): str { return "devos-speaker.service" }
fn transient(): str { return "devos-speaker-session.service" }
fn statePath(): str { return pw.configDir() + "/speaker.json" }
fn confPath(): str { return pw.configDir() + "/speaker-filter.conf" }
fn boostGain(): f64 { return 3.0 }
fn isMode(name: str): bool {
    return strings.equal(name, "dynamic") || strings.equal(name, "game") || strings.equal(name, "movie") || strings.equal(name, "music") || strings.equal(name, "voice") || isCustom(name)
}
fn isCustom(name: str): bool { return strings.equal(name, "custom1") || strings.equal(name, "custom2") || strings.equal(name, "custom3") }
fn slotIndex(name: str): i64 { return hw.toInt(strings.substring(name, 6, 7), 1) - 1 }

# (biquad label, frequency Hz, Q, gain dB)
struct Band { label: str, freq: i64, q: f64, gain: f64 }

fn shelf(bands: Vec<Band>, bass: f64, mid: f64, treble: f64): Vec<Band> {
    bands.push(Band("bq_lowshelf", 100, 0.7, bass))
    bands.push(Band("bq_peaking", 1000, 1.0, mid))
    bands.push(Band("bq_highshelf", 8000, 0.7, treble))
    return bands
}

# ---- state -------------------------------------------------------------------------------------------------------------
struct State { mode: str, voice: bool, boost: bool, smart: bool, device: str, custom: Vec<f64> }

fn gain(value: json.Value): f64 {
    let kind = json.kind(value)
    let number = 0.0
    if strings.equal(kind, "number") { number = json.float(value) }
    else if strings.equal(kind, "string") { number = hw.toFloat(json.string(value), 0.0) }
    return math.max(0.0 - 10.0, math.min(10.0, number))
}

fn loadState(): State {
    let data = hw.loadJson(statePath())
    let custom = Vec<f64>()
    let saved = hw.jget(data, "custom")
    for slot in 1..4 {
        let values = hw.jget(saved, "custom${slot}")
        let ok = strings.equal(json.kind(values), "array") && json.len(values) == 3
        for i in 0..3 { custom.push(ok ? gain(json.at(values, i)) : 0.0) }
    }
    let mode = hw.jstr(data, "mode", "dynamic")
    if !isMode(mode) { mode = "dynamic" }
    let smartItem = hw.jget(data, "smart")
    let smart = !(strings.equal(json.kind(smartItem), "bool") && !json.bool(smartItem))
    return State(mode, hw.jbool(data, "voice", false), hw.jbool(data, "boost", false), smart, hw.jstr(data, "device", ""), custom)
}

fn customJson(state: State): json.Value {
    let out = json.object()
    for slot in 1..4 {
        let values = json.array()
        for i in 0..3 { values = json.push(values, state.custom[(slot - 1) * 3 + i]) }
        out = json.set(out, "custom${slot}", values)
    }
    return out
}

fn saveState(state: State) {
    let out = json.object()
    out = json.set(out, "mode", state.mode)
    out = json.set(out, "voice", state.voice)
    out = json.set(out, "boost", state.boost)
    out = json.set(out, "smart", state.smart)
    out = json.set(out, "device", state.device)
    out = json.set(out, "custom", customJson(state))
    hw.saveJson(statePath(), out)
}

fn effectiveMode(state: State, recorders: i64): str { return state.smart && recorders > 0 ? "voice" : state.mode }

fn bands(state: State, mode: str): Vec<Band> {
    let chain = Vec<Band>()
    if state.voice {
        for i in 0..2 { chain.push(Band("bq_highpass", 300, 0.707, 0.0)) }
        for i in 0..2 { chain.push(Band("bq_lowpass", 3400, 0.707, 0.0)) }
    }
    if strings.equal(mode, "game") {
        chain.push(Band("bq_lowshelf", 120, 0.7, 2.0))
        chain.push(Band("bq_peaking", 3000, 1.0, 3.0))
        chain.push(Band("bq_highshelf", 8000, 0.7, 3.0))
    } else if strings.equal(mode, "movie") { chain = shelf(chain, 5.0, 0.0 - 1.0, 3.0) }
    else if strings.equal(mode, "music") { chain = shelf(chain, 3.0, 0.0 - 1.0, 2.0) }
    else if strings.equal(mode, "voice") {
        chain.push(Band("bq_lowshelf", 150, 0.7, 0.0 - 4.0))
        chain.push(Band("bq_peaking", 2000, 1.0, 4.0))
        chain.push(Band("bq_highshelf", 8000, 0.7, 0.0))
    } else if isCustom(mode) {
        let base = slotIndex(mode) * 3
        let bass = state.custom[base]
        let mid = state.custom[base + 1]
        let treble = state.custom[base + 2]
        if bass != 0.0 || mid != 0.0 || treble != 0.0 { chain = shelf(chain, bass, mid, treble) }
    }
    return chain
}

fn wantsFilter(state: State, mode: str): bool { return state.boost || bands(state, mode).len() > 0 }

fn speakerNames(graph: pw.Graph): Vec<str> {
    let names = Vec<str>()
    for i in 0..(graph.speakers.len() as i64) { names.push(graph.speakers[i].name) }
    return names
}
fn pickDevice(state: State, graph: pw.Graph): str {
    let names = speakerNames(graph)
    if hw.contains(names, state.device) && strings.charLength(state.device) > 0 { return state.device }
    if hw.contains(names, graph.defaultSink) && strings.charLength(graph.defaultSink) > 0 { return graph.defaultSink }
    return names.len() > 0 ? names[0] : ""
}

# ---- filter graph ------------------------------------------------------------------------------------------------------
fn q(text: str): str { return json.stringify(text) }
fn num(value: f64): str { return json.stringify(value) }
fn round4(value: f64): f64 { return math.round(value * 10000.0) / 10000.0 }

struct Stage { name: str, label: str, controls: str }
struct Edge { from: str, fromPort: str, to: str, toPort: str }

fn linear(name: str, mult: f64, add: f64): Stage {
    return Stage(name, "linear", q("Mult") + " = " + num(mult) + " " + q("Add") + " = " + num(add))
}
fn isBoostStage(name: str): bool {
    return strings.equal(name, "abs") || strings.equal(name, "one") || strings.equal(name, "recip") || strings.equal(name, "mix") || strings.equal(name, "makeup")
}

# PipeWire client config: a virtual sink devos-spk-fx whose biquad chain feeds the real output `device`.
fn render(chain: Vec<Band>, device: str, boost: bool): str {
    let peak = 0.0
    for i in 0..(chain.len() as i64) { if chain[i].gain > peak { peak = chain[i].gain } }
    let stages = Vec<Stage>()
    if peak > 0.0 { stages.push(linear("linear", round4(math.pow(10.0, 0.0 - peak / 20.0)), 0.0)) }
    for i in 0..(chain.len() as i64) {
        stages.push(Stage("eq${i}", chain[i].label, q("Freq") + " = ${chain[i].freq} " + q("Q") + " = " + num(chain[i].q) + " " + q("Gain") + " = " + num(chain[i].gain)))
    }
    if boost {
        # g = gain; y = g / (1 + |g|) * makeup, so the output never exceeds full scale and quiet sounds are much louder.
        stages.push(linear("gain", boostGain(), 0.0))
        stages.push(Stage("abs", "abs", ""))
        stages.push(linear("one", 1.0, 1.0))
        stages.push(Stage("recip", "recip", ""))
        stages.push(Stage("mix", "mult", ""))
        stages.push(linear("makeup", round4((1.0 + boostGain()) / boostGain()), 0.0))
    }
    let nodes = Vec<str>()
    let links = Vec<str>()
    let first = Vec<str>()
    let last = Vec<str>()
    for c in 0..2 {
        let channel = c == 0 ? "L" : "R"
        for s in 0..(stages.len() as i64) {
            nodes.push("        { type = builtin name = " + channel + stages[s].name + " label = " + stages[s].label + " control = { " + stages[s].controls + " } }")
        }
        let edges = Vec<Edge>()
        for s in 0..(stages.len() as i64 - 1) {
            let b = stages[s + 1].name
            if !(boost && isBoostStage(b)) { edges.push(Edge(stages[s].name, "Out", b, "In")) }
        }
        if boost {
            edges.push(Edge("gain", "Out", "abs", "In"))
            edges.push(Edge("abs", "Out", "one", "In"))
            edges.push(Edge("one", "Out", "recip", "In"))
            edges.push(Edge("gain", "Out", "mix", "In 1"))
            edges.push(Edge("recip", "Out", "mix", "In 2"))
            edges.push(Edge("mix", "Out", "makeup", "In"))
        }
        for e in 0..(edges.len() as i64) {
            links.push("        { output = \"" + channel + edges[e].from + ":" + edges[e].fromPort + "\" input = \"" + channel + edges[e].to + ":" + edges[e].toPort + "\" }")
        }
        first.push(q(channel + stages[0].name + ":In"))
        last.push(q(channel + stages[stages.len() - 1].name + ":Out"))
    }
    let lines = Vec<str>()
    lines.push("# Generated by dev-os-speaker; changes are overwritten.")
    lines.push("context.properties = {")
    lines.push("    log.level = 0")
    lines.push("}")
    lines.push("context.spa-libs = {")
    lines.push("    audio.convert.* = audioconvert/libspa-audioconvert")
    lines.push("    support.*       = support/libspa-support")
    lines.push("}")
    lines.push("context.modules = [")
    lines.push("    { name = libpipewire-module-rt flags = [ ifexists nofail ] }")
    lines.push("    { name = libpipewire-module-protocol-native }")
    lines.push("    { name = libpipewire-module-client-node }")
    lines.push("    { name = libpipewire-module-adapter }")
    lines.push("    { name = libpipewire-module-filter-chain")
    lines.push("        args = {")
    lines.push("            node.description = \"Sound effects\"")
    lines.push("            media.name = \"Sound effects\"")
    lines.push("            filter.graph = {")
    lines.push("                nodes = [")
    lines.push(strings.join(nodes, "\n"))
    lines.push("                ]")
    lines.push("                links = [")
    lines.push(strings.join(links, "\n"))
    lines.push("                ]")
    lines.push("                inputs = [ " + strings.join(first, " ") + " ]")
    lines.push("                outputs = [ " + strings.join(last, " ") + " ]")
    lines.push("            }")
    lines.push("            audio.channels = 2")
    lines.push("            audio.position = [ FL FR ]")
    lines.push("            capture.props = {")
    lines.push("                node.name = " + q(pw.fxName()))
    lines.push("                node.description = \"Sound effects\"")
    lines.push("                media.class = Audio/Sink")
    lines.push("            }")
    lines.push("            playback.props = {")
    lines.push("                node.name = \"devos-spk-out\"")
    lines.push("                node.passive = true")
    lines.push("                target.object = " + q(device))
    lines.push("                node.dont-fallback = true")
    lines.push("            }")
    lines.push("        }")
    lines.push("    }")
    lines.push("]")
    return strings.join(lines, "\n") + "\n"
}

# ---- reporting ---------------------------------------------------------------------------------------------------------
fn report(): json.Value {
    let state = loadState()
    let graph = pw.snapshot()
    let filters = pw.filtersAvailable()
    let out = json.object()
    out = json.set(out, "ok", true)
    out = json.set(out, "supported", graph.ok)
    out = json.set(out, "reason", "")
    out = json.set(out, "speakers", json.array())
    out = json.set(out, "device", "")
    out = json.set(out, "voice", state.voice)
    out = json.set(out, "boost", state.boost)
    out = json.set(out, "mode", state.mode)
    out = json.set(out, "smart", state.smart)
    out = json.set(out, "custom", customJson(state))
    out = json.set(out, "effective", state.mode)
    out = json.set(out, "running", false)
    out = json.set(out, "active", false)
    out = json.set(out, "filters", json.set(json.set(json.object(), "available", filters.ok), "reason", filters.reason))
    out = json.set(out, "warning", "")
    if !graph.ok {
        return json.set(out, "reason", "The audio server (PipeWire) is not running or pw-dump is not installed.")
    }
    let speakers = json.array()
    for i in 0..(graph.speakers.len() as i64) {
        speakers = json.push(speakers, json.set(json.set(json.object(), "name", graph.speakers[i].name), "title", graph.speakers[i].title))
    }
    out = json.set(out, "speakers", speakers)
    out = json.set(out, "device", pickDevice(state, graph))
    let effective = effectiveMode(state, graph.recorders)
    out = json.set(out, "effective", effective)
    out = json.set(out, "running", graph.hasFx)
    let active = graph.hasFx && strings.equal(graph.defaultSink, pw.fxName())
    out = json.set(out, "active", active)
    let wanted = wantsFilter(state, effective)
    let warning = ""
    if graph.speakers.len() == 0 { warning = "No audio output is available." }
    else if wanted && !filters.ok { warning = filters.reason + " The sound is played without effects." }
    else if wanted && !active { warning = "The sound effects are not active yet. They start with your session; sound is played without effects until then." }
    return json.set(out, "warning", warning)
}

# ---- switching ---------------------------------------------------------------------------------------------------------
fn ensureService() {
    let done = pw.systemctl(Vec<str>("start", unit()))
    if done.code == 0 { return }
    if !pw.unitMissing(done.out) {
        hw.failure("The sound effects service could not start: " + hw.clean(strings.charLength(done.out) > 0 ? done.out : "systemctl failed"))
    }
    let started = pw.startTransient(transient(), hw.selfPath("/usr/bin/dev-os-speaker"))
    if started.code != 0 && !strings.contains(pw.lower(started.out), "already") {
        hw.failure("The sound effects service could not start: " + hw.clean(strings.charLength(started.out) > 0 ? started.out : "systemd-run failed"))
    }
}

# True when the graph already matches the state (nothing to wait for).
fn settled(state: State, graph: pw.Graph): bool {
    let wanted = wantsFilter(state, effectiveMode(state, graph.recorders))
    if wanted { return graph.hasFx && strings.equal(graph.defaultSink, pw.fxName()) }
    return !graph.hasFx && !strings.equal(graph.defaultSink, pw.fxName())
}

fn settle() {
    let state = loadState()
    let filters = pw.filtersAvailable()
    let graph = pw.snapshot()
    if !graph.ok { hw.failure("The audio server (PipeWire) is not running.") }
    if filters.ok || !wantsFilter(state, effectiveMode(state, graph.recorders)) {
        ensureService()
        pw.waitFor(fn(g: pw.Graph): bool { return settled(state, g) }, pw.waitSeconds())
    }
}

# ---- service -----------------------------------------------------------------------------------------------------------
fn pointDefaultAt(name: str, graph: pw.Graph) {
    for i in 0..(graph.speakers.len() as i64) {
        if strings.equal(graph.speakers[i].name, name) { hw.run(hw.concat(hw.tool("DEVOS_MIC_WPCTL", "wpctl"), Vec<str>("set-default", "${graph.speakers[i].id}")), 15000); return }
    }
    if graph.hasFx && strings.equal(graph.fx.name, name) {
        hw.run(hw.concat(hw.tool("DEVOS_MIC_WPCTL", "wpctl"), Vec<str>("set-default", "${graph.fx.id}")), 15000)
    }
}

fn hasFx(g: pw.Graph): bool { return g.hasFx }

# Supervises one `pipewire -c` filter process. The filter lives in its own session (hw.spawnDetached); a SIGTERM to this
# service (systemd stops the whole control group) takes it down with us and WirePlumber falls back to the real output.
fn serve(): i32 {
    let once = strings.charLength(hw.env("DEVOS_SPK_ONCE")) > 0
    let pid = 0 - 1
    let signature = ""
    let seen = 0
    let quiet = 0
    let calls = false
    let started = 0.0
    let retryAt = 0.0
    while true {
        let state = loadState()
        let filters = pw.filtersAvailable()
        # With Smart Switch off, no filter wanted and no filter running there is nothing to watch: skip the pw-dump and only
        # look at the state file again.
        let idle = pid < 0 && !state.smart && !wantsFilter(state, state.mode)
        let graph = filters.ok && !idle ? pw.snapshot() : pw.noGraph()
        if graph.ok {
            # Debounce the call detection: two polls to switch on, three to switch off.
            if graph.recorders > 0 { seen = seen + 1; quiet = 0 } else { seen = 0; quiet = quiet + 1 }
            if seen >= 2 { calls = true } else if quiet >= 3 { calls = false }
            let mode = state.smart && calls ? "voice" : state.mode
            let chain = bands(state, mode)
            let filtered = chain.len() > 0 || state.boost
            let device = pickDevice(state, graph)
            let wanted = filtered && strings.charLength(device) > 0
            let conf = wanted ? device + "\n" + render(chain, device, state.boost) : ""
            let exited = pid >= 0 && !hw.alive(pid)
            if exited && hw.nowSeconds() - started < 10.0 {
                retryAt = hw.nowSeconds() + 30.0  # the filter fails at once (bad graph or plugin): do not respawn it every few seconds
                hw.stderr("dev-os-speaker: the filter process exited at once; retrying in 30 s")
            }
            if !wanted || exited || (pid >= 0 && !strings.equal(conf, signature)) {
                if pid >= 0 {
                    let current = pw.snapshot()
                    if current.ok && strings.equal(current.defaultSink, pw.fxName()) { pointDefaultAt(pickDevice(loadState(), current), current) }
                    hw.terminate(pid, 5.0)
                }
                pid = 0 - 1
                signature = ""
            }
            if wanted && pid < 0 && hw.nowSeconds() >= retryAt {
                hw.saveText(confPath(), render(chain, device, state.boost))
                pid = hw.spawnDetached(hw.concat(pw.pipewireCommand(), Vec<str>("-c", confPath())))
                signature = conf
                started = hw.nowSeconds()
                let after = pw.waitFor(hasFx, pw.waitSeconds())
                if after.ok && after.hasFx { pointDefaultAt(pw.fxName(), after) }
            }
        }
        if once { break }
        # Without Smart Switch nothing needs polling; the state file is read again every tick.
        hw.sleepSeconds(state.smart ? 3.0 : 2.0)
    }
    return 0
}

# ---- command line ------------------------------------------------------------------------------------------------------
fn execute(action: str, rest: Vec<str>) {
    let state = loadState()
    if strings.equal(action, "get") { return }
    if strings.equal(action, "apply") { settle(); return }
    if (strings.equal(action, "voice") || strings.equal(action, "smart") || strings.equal(action, "boost")) && rest.len() == 1 && (strings.equal(rest[0], "on") || strings.equal(rest[0], "off")) {
        let on = strings.equal(rest[0], "on")
        if strings.equal(action, "voice") { state.voice = on } else if strings.equal(action, "smart") { state.smart = on } else { state.boost = on }
        saveState(state)
        settle()
        return
    }
    if strings.equal(action, "mode") && rest.len() == 1 && isMode(rest[0]) {
        state.mode = rest[0]
        saveState(state)
        settle()
        return
    }
    if strings.equal(action, "device") && rest.len() == 1 && strings.charLength(rest[0]) > 0 && !strings.startsWith(rest[0], "devos-") {
        let graph = pw.snapshot()
        if !graph.ok { hw.failure("The audio server (PipeWire) is not running.") }
        if !hw.contains(speakerNames(graph), rest[0]) { hw.failure("That output is not connected.") }
        state.device = rest[0]
        saveState(state)
        settle()
        return
    }
    if strings.equal(action, "custom") && rest.len() == 4 && isCustom(rest[0]) {
        for i in 1..4 { if !hw.isNumber(rest[i]) { hw.failure("Custom sound levels must be numbers.") } }
        let base = slotIndex(rest[0]) * 3
        for i in 0..3 { state.custom[base + i] = gain(json.value(hw.toFloat(rest[i + 1], 0.0))) }
        saveState(state)
        settle()
        return
    }
    hw.failure("Unsupported sound action.")
}

fn main(): i32 {
    let action = args.len() > 0 ? args.get(0) : ""
    let rest = Vec<str>()
    for i in 1..(args.len() as i64) { rest.push(args.get(i)) }
    if strings.equal(action, "serve") {
        let served = result.attempt(fn(): i32 { return serve() })
        if result.isErr(served) { print(json.stringify(hw.errorJson(result.message(served)))); return 1 }
        return result.unwrap(served)
    }
    let outcome = result.run(fn() { execute(action, rest) })
    if result.isErr(outcome) {
        print(json.stringify(hw.errorJson(result.message(outcome))))
        return 1
    }
    let reportOutcome = result.attempt(fn(): json.Value { return report() })
    if result.isErr(reportOutcome) { print(json.stringify(hw.errorJson(result.message(reportOutcome)))); return 1 }
    print(json.stringify(result.unwrap(reportOutcome)))
    return 0
}
return main()
