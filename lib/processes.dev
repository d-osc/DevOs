#!/usr/bin/env d
# Unprivileged /proc sampler and PID-reuse-safe termination of owned processes.
use "std/fs"
use "std/json"
use "std/child_process"
use "std/strings"
use "std/io"
use "std/time"
use "std/os"
use "std/result" as errors
use "./posix.dev" as posix

extern fn pidfd_open(pid: i32, flags: u32): i32
extern fn pidfd_send_signal(fd: i32, signal: i32, info: *void, flags: u32): i32
extern fn close(fd: i32): i32
extern fn getpagesize(): i32
extern fn sysconf(name: i32): i64

fn decodeText(bytes: Vec<u8>): str {
    let out = ""
    for i in 0..(bytes.len() as i64) {
        let ch = bytes[i]
        if ch >= 0x20 && ch < 0x7f { out = out + asciiChar(ch) }
        else { if ch == 0x0a { out = out + "\n" } }
    }
    return out
}

fn asciiChar(code: u8): str {
    let chars = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    return strings.charAt(chars, (code - 0x20) as i64)
}

fn capture(command: str): str {
    let output = child_process.execFileSync("sh", Vec<str>("-c", command), child_process.options())
    return decodeText(output.stdout)
}

fn confValue(name: str): i64 {
    let value = 0
    # getconf is not part of the minimal Live image. Query libc instead of starting a shell.
    if strings.equal(name, "PAGE_SIZE") { unsafe { value = getpagesize() as i64 } }
    # Linux/glibc _SC_CLK_TCK is 2; use the runtime value, not a guessed tick rate.
    else if strings.equal(name, "CLK_TCK") { unsafe { value = sysconf(2) } }
    if value <= 0 { errors.raise("Cannot read process sampling parameter " + name) }
    return value
}

fn safeCharAt(text: str, index: i64): str {
    if index >= strings.charLength(text) { return " " }
    return strings.charAt(text, index)
}

fn digitStart(text: str): bool {
    if strings.charLength(text) == 0 { return false }
    return strings.contains("0123456789", strings.charAt(text, 0))
}

fn digitOf(ch: str): i64 {
    let digits = "0123456789"
    for i in 0..10 {
        if strings.equal(strings.charAt(digits, i), ch) { return i }
    }
    return 0
}

fn intOf(text: str): i64 {
    let value = 0
    let negative = false
    let start = 0
    if strings.startsWith(text, "-") { negative = true; start = 1 }
    for i in start..strings.charLength(text) {
        let ch = strings.charAt(text, i)
        if strings.contains("0123456789", ch) { value = value * 10 + digitOf(ch) }
        else { break }
    }
    return negative ? 0 - value : value
}

fn floatOf(text: str): f64 {
    let whole = 0.0
    let fraction = 0.0
    let divisor = 1.0
    let afterDot = false
    for i in 0..strings.charLength(text) {
        let ch = strings.charAt(text, i)
        if strings.contains("0123456789", ch) {
            let digit = digitOf(ch) as f64
            if afterDot { divisor = divisor * 10.0; fraction = fraction + digit / divisor }
            else { whole = whole * 10.0 + digit }
        } else {
            if strings.equal(ch, ".") && !afterDot { afterDot = true }
            else { break }
        }
    }
    return whole + fraction
}

fn round1(value: f64): f64 {
    return (value * 10.0 + 0.5) as i64 as f64 / 10.0
}

fn statFields(text: str): Vec<str> {
    let close = strings.lastIndexOf(text, ")")
    let rest = strings.substring(text, close + 2, strings.charLength(text))
    return strings.split(rest, " ")
}

fn procName(text: str): str {
    let open = strings.indexOf(text, "(")
    let close = strings.lastIndexOf(text, ")")
    return strings.substring(text, open + 1, close)
}

# Owner uid from /proc/PID/status (one file read, no subprocess).
fn statusUid(folder: str): i64 {
    let text = fs.readFileSync(folder + "/status", "utf8")
    let at = strings.indexOf(text, "\nUid:")
    if at < 0 { return 0 }
    let line = strings.substring(text, at + 5, strings.charLength(text))
    let end = strings.indexOf(line, "\n")
    if end >= 0 { line = strings.substring(line, 0, end) }
    let parts = strings.split(line, "\t")
    for i in 0..(parts.len() as i64) {
        if digitStart(parts[i]) { return intOf(parts[i]) }
    }
    return 0
}

# uids maps "pid:starttime" to the owner uid; it cannot change under the same key, so it is read once.
fn readProcess(pid: i64, pageSize: i64, uids: json.Value): json.Value {
    let folder = "/proc/${pid}"
    let text = fs.readFileSync(folder + "/stat", "utf8")
    let fields = statFields(text)
    let uidKey = "${pid}:${fields[19]}"
    let uidValue = 0
    if json.has(uids, uidKey) { uidValue = json.int(json.get(uids, uidKey)) }
    else { uidValue = statusUid(folder) }
    let item = json.set(json.object(), "pid", pid)
    item = json.set(item, "name", procName(text))
    item = json.set(item, "uid", json.value(uidValue))
    item = json.set(item, "state", fields[0])
    item = json.set(item, "parent", json.value(intOf(fields[1])))
    item = json.set(item, "ticks", json.value(intOf(fields[11]) + intOf(fields[12])))
    item = json.set(item, "start", fields[19])
    let memory = intOf(fields[21]) * pageSize
    if memory < 0 { memory = 0 }
    item = json.set(item, "memory", json.value(memory))
    return item
}

fn protectedSet(pageSize: i64, selfPid: i64): Vec<i64> {
    let result = Vec<i64>(1)
    result.push(selfPid)
    let pid = posix.ppid() as i64
    while pid > 1 {
        let known = false
        for i in 0..(result.len() as i64) {
            if result[i] == pid { known = true }
        }
        if known { break }
        result.push(pid)
        let item = readProcess(pid, pageSize, json.object())
        pid = json.int(json.get(item, "parent"))
    }
    return result
}

fn selfPidValue(): i64 {
    return intOf(strings.split(fs.readFileSync("/proc/self/stat", "utf8"), " ")[0])
}

fn inSet(set: Vec<i64>, value: i64): bool {
    for i in 0..(set.len() as i64) {
        if set[i] == value { return true }
    }
    return false
}

fn stopProcess(request: json.Value, pageSize: i64, selfPid: i64): json.Value {
    let pid = 0
    if json.has(request, "pid") { pid = json.int(json.get(request, "pid")) }
    if pid <= 1 { return json.set(json.object(), "error", "This process is protected by the desktop.") }
    if inSet(protectedSet(pageSize, selfPid), pid) { return json.set(json.object(), "error", "This process is protected by the desktop.") }
    # arm64: pidfd_open = 434, pidfd_send_signal = 424
    let descriptor = -1
    unsafe { descriptor = pidfd_open(pid as i32, 0) as i64 }
    if descriptor < 0 { return json.set(json.object(), "error", "This kernel does not support safe process termination.") }
    let loaded = errors.attempt(fn():json.Value { return readProcess(pid, pageSize, json.object()) })
    if errors.isErr(loaded) {
        unsafe { close(descriptor as i32) }
        return json.set(json.object(), "error", "The process has exited or is no longer accessible. Refresh the list.")
    }
    let item = errors.unwrap(loaded)
    let startWant = ""
    if json.has(request, "start") { startWant = jsonText(json.get(request, "start")) }
    if !strings.equal(jsonText(json.get(item, "start")), startWant) {
        unsafe { close(descriptor as i32) }
        return json.set(json.object(), "error", "This process has exited or its PID was reused. Refresh the list.")
    }
    let uid = json.int(json.get(item, "uid"))
    if uid != posix.uid() as i64 || uid == 0 || strings.equal(jsonText(json.get(item, "name")), "labwc") {
        unsafe { close(descriptor as i32) }
        return json.set(json.object(), "error", "Only your own non-system processes can be stopped.")
    }
    let force = false
    if json.has(request, "force") { force = json.bool(json.get(request, "force")) }
    let signal = force ? posix.SIGKILL() : posix.SIGTERM()
    let sent: i32 = -1
    unsafe { sent = pidfd_send_signal(descriptor as i32, signal, null, 0) }
    unsafe { close(descriptor as i32) }
    if sent != 0 { return json.set(json.object(), "error", "The process exited or could not be stopped. Refresh the list.") }
    return json.set(json.object(), "stopped", true)
}

fn jsonText(value: json.Value): str {
    if strings.equal(json.kind(value), "string") { return json.string(value) }
    return ""
}

fn memoryMap(): json.Value {
    let result = json.object()
    let lines = strings.split(fs.readFileSync("/proc/meminfo", "utf8"), "\n")
    for i in 0..(lines.len() as i64) {
        let colon = strings.indexOf(lines[i], ":")
        if colon < 0 { continue }
        let key = strings.substring(lines[i], 0, colon)
        let value = 0
        let parts = strings.split(strings.substring(lines[i], colon + 1, strings.charLength(lines[i])), " ")
        for p in 0..(parts.len() as i64) {
            if digitStart(parts[p]) { value = intOf(parts[p]) * 1024 }
        }
        result = json.set(result, key, json.value(value))
    }
    return result
}

fn rawSample(pageSize: i64, uids: json.Value): json.Value {
    let statLine = strings.split(fs.readFileSync("/proc/stat", "utf8"), "\n")[0]
    let cpuParts = strings.split(statLine, " ")
    let total = 0
    let idle = 0
    let index = 0
    for i in 1..(cpuParts.len() as i64) {
        if strings.equal(cpuParts[i], "") { continue }
        let value = intOf(cpuParts[i])
        total = total + value
        if index == 3 || index == 4 { idle = idle + value }
        index = index + 1
        if index >= 8 { break }
    }
    let processes = json.array()
    let entries = fs.readdirSync("/proc")
    for i in 0..(entries.len() as i64) {
        let name = entries[i]
        let digits = true
        if strings.equal(name, "") { digits = false }
        for c in 0..strings.charLength(name) {
            if !strings.contains("0123456789", strings.charAt(name, c)) { digits = false }
        }
        if !digits { continue }
        if fs.existsSync("/proc/" + name + "/stat") {
            # Processes may exit or become unreadable between readdir and read.
            let read = errors.attempt(fn():json.Value { return readProcess(intOf(name), pageSize, uids) })
            if errors.isOk(read) { processes = json.push(processes, errors.unwrap(read)) }
        }
    }
    let nowMs = time.now_ms() as i64
    let snapshot = json.set(json.object(), "time", json.value(nowMs))
    snapshot = json.set(snapshot, "total", json.value(total))
    snapshot = json.set(snapshot, "idle", json.value(idle))
    snapshot = json.set(snapshot, "memory", memoryMap())
    return json.set(snapshot, "processes", processes)
}

fn optGet(value: json.Value, key: str): json.Value {
    if json.has(value, key) { return json.get(value, key) }
    return json.null_value()
}

fn sample(previous: json.Value, names: json.Value, pageSize: i64, clkTck: i64, selfPid: i64): json.Value {
    let uids = json.object()
    let prevProcesses = optGet(previous, "processes")
    for i in 0..(json.len(prevProcesses) as i64) {
        let item = json.at(prevProcesses, i)
        uids = json.set(uids, "${json.int(optGet(item, "pid"))}:${jsonText(optGet(item, "start"))}", json.value(json.int(optGet(item, "uid"))))
    }
    let current = rawSample(pageSize, uids)
    let elapsedMs = json.int(optGet(current, "time")) - json.int(optGet(previous, "time"))
    if elapsedMs < 1 { elapsedMs = 1 }
    let elapsed: f64 = 0.0
    elapsed = elapsedMs as f64
    elapsed = elapsed / 1000.0
    let old = json.object()
    let oldProcesses = optGet(previous, "processes")
    for i in 0..(json.len(oldProcesses) as i64) {
        let item = json.at(oldProcesses, i)
        let key = "${json.int(optGet(item, "pid"))}:${jsonText(optGet(item, "start"))}"
        old = json.set(old, key, json.value(json.int(optGet(item, "ticks"))))
    }
    let blocked = protectedSet(pageSize, selfPid)
    let currentProcesses = optGet(current, "processes")
    for i in 0..(json.len(currentProcesses) as i64) {
        let item = json.at(currentProcesses, i)
        let key = "${json.int(optGet(item, "pid"))}:${jsonText(optGet(item, "start"))}"
        let ticksOld = json.int(optGet(item, "ticks"))
        if json.has(old, key) { ticksOld = json.int(json.get(old, key)) }
        let delta = json.int(optGet(item, "ticks")) - ticksOld
        if delta < 0 { delta = 0 }
        item = json.set(item, "cpu", json.value(round1(delta as f64 / clkTck as f64 / elapsed * 100.0)))
        item = json.remove(item, "ticks")
        let uid = json.int(optGet(item, "uid"))
        let uidKey = "${uid}"
        if !json.has(names, uidKey) {
            let entry = strings.trim(capture("getent passwd ${uid} 2>/dev/null | cut -d: -f1"))
            if strings.equal(entry, "") { entry = uidKey }
            names = json.set(names, uidKey, entry)
        }
        item = json.set(item, "user", json.string(json.get(names, uidKey)))
        item = json.set(item, "canStop", uid == posix.uid() as i64 && uid != 0 && !inSet(blocked, json.int(optGet(item, "pid"))) && !strings.equal(jsonText(optGet(item, "name")), "labwc"))
        currentProcesses[i] = item
    }
    let memory = optGet(current, "memory")
    let totalDelta = json.int(optGet(current, "total")) - json.int(optGet(previous, "total"))
    if totalDelta < 1 { totalDelta = 1 }
    let idleDelta = json.int(optGet(current, "idle")) - json.int(optGet(previous, "idle"))
    let cpuPercent = (1.0 - idleDelta as f64 / totalDelta as f64) * 100.0
    if cpuPercent < 0.0 { cpuPercent = 0.0 }
    if cpuPercent > 100.0 { cpuPercent = 100.0 }
    let memTotal = json.int(optGet(memory, "MemTotal"))
    let memAvailable = 0
    if json.has(memory, "MemAvailable") { memAvailable = json.int(optGet(memory, "MemAvailable")) }
    else {
        if json.has(memory, "MemFree") { memAvailable = json.int(optGet(memory, "MemFree")) }
    }
    let swapTotal = json.int(optGet(memory, "SwapTotal"))
    let swapFree = 0
    if json.has(memory, "SwapFree") { swapFree = json.int(optGet(memory, "SwapFree")) }
    let cores = os.availableParallelism()
    let uptimeText = strings.split(fs.readFileSync("/proc/uptime", "utf8"), " ")[0]
    let result = json.set(json.object(), "processes", currentProcesses)
    result = json.set(result, "cpu", json.value(round1(cpuPercent)))
    result = json.set(result, "memoryTotal", json.value(memTotal))
    result = json.set(result, "memoryUsed", json.value(memTotal - memAvailable))
    result = json.set(result, "swapTotal", json.value(swapTotal))
    result = json.set(result, "swapUsed", json.value(swapTotal - swapFree))
    result = json.set(result, "cores", json.value(cores))
    result = json.set(result, "uptime", json.value(floatOf(uptimeText) as i64))
    result = json.set(result, "__previous", current)
    result = json.set(result, "__names", names)
    return result
}

fn main(): i32 {
    let selfPid = selfPidValue()
    let pageSize = confValue("PAGE_SIZE")
    let clkTck = confValue("CLK_TCK")
    let previous = json.null_value()
    let names = json.object()
    while true {
        let line = io.read_line()
        if strings.equal(line, "") { break }
        let request = json.parse(line)
        let action = "get"
        if json.has(request, "action") { action = jsonText(json.get(request, "action")) }
        if strings.equal(action, "get") {
            if json.is_null(previous) {
                previous = rawSample(pageSize, json.object())
                time.sleep_ms(150)
            }
            let result = sample(previous, names, pageSize, clkTck, selfPid)
            previous = json.get(result, "__previous")
            names = json.get(result, "__names")
            result = json.remove(result, "__previous")
            result = json.remove(result, "__names")
            print(json.stringify(json.set(result, "ok", true)))
        } else {
            if strings.equal(action, "stop") {
                let result = stopProcess(request, pageSize, selfPid)
                if json.has(result, "error") { print(json.stringify(json.set(json.object(), "error", json.string(json.get(result, "error"))))) }
                else { print(json.stringify(json.set(result, "ok", true))) }
            } else {
                print(json.stringify(json.set(json.object(), "error", "Unknown process operation.")))
            }
        }
    }
    return 0
}

