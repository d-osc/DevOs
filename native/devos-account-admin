#!/usr/bin/d
# Absolute root-owned imports: never search the caller's working directory.
use "std/json"
use "std/strings"
use "std/module"
use "std/result"
use "/usr/share/dev-os/native/devos_accounts_system.dev" as accounts
use "/usr/share/dev-os/native/privileged.dev" as secure
use "/usr/share/dev-os/lib/desktop.dev" as util
fn main(): i32 {
    let outcome = result.attempt(fn(): json.Value {
        let raw = secure.descriptorText(0, 16384)
        secure.require(json.valid(raw), "Invalid JSON request.")
        return accounts.administer(json.parse(raw), strings.endsWith(module.entry(), "devos-account-setup"))
    })
    if result.isErr(outcome) { print(json.stringify(util.error(result.message(outcome)))); return 1 }
    print(json.stringify(json.set(result.unwrap(outcome), "ok", true)))
    return 0
}
return main()
