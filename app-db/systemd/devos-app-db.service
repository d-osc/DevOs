[Unit]
Description=DevOs application catalog service

[Service]
Type=simple
Environment=DEVLANG_RUN=/usr/bin/devrun
Environment=XDG_RUNTIME_DIR=%t
ExecStart=/bin/sh /usr/share/devos-pm/cli/catalog-data/service.sh run
Restart=on-failure
RestartSec=1
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
