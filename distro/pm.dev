use "std/fs"
use "std/json"
use "std/child_process"
use "std/encoding"
use "std/crypto"
use "std/strings"
use "../lib/sources.dev" as sources

# The DevOsPM CLI (pm-cli) is DevLang, so the image gets its sources, not a binary: a tarball of the program files (the recipe unpacks it under
# /usr/share/devos-pm and puts the `dev` / `devospm` launchers in /usr/bin; the DevLang runtime `d` runs it).
fn hex(bytes: Vec<u8>): str {
    let digits = "0123456789abcdef"
    let out = ""
    for i in 0..(bytes.len() as i64) {
        let value = bytes[i] as i64
        out = out + strings.charAt(digits, value / 16) + strings.charAt(digits, value % 16)
    }
    return out
}

# The version `dev --version` prints ("dev 0.7.0").
fn cliVersion(project: str): str {
    let toolchain = sources.path("packages/react-devlang/tools/toolchain.sh", "DEVOS_DEVLANG_TOOLCHAIN")
    let driver = child_process.execFileSync("sh", Vec<str>(toolchain, "--runtime"), child_process.options())
    if !driver.success { return "" }
    let program = strings.trim(encoding.decode(driver.stdout, "utf8"))
    let ran = child_process.execFileSync(program, Vec<str>(project + "/main.dev", "--", "--version"), child_process.options())
    if !ran.success { return "" }
    let line = strings.trim(encoding.decode(ran.stdout, "utf8"))
    return strings.startsWith(line, "dev ") ? strings.substring(line, 4, strings.charLength(line)) : ""
}

fn snapshot(payload: str): json.Value {
    let project = sources.pm()
    if !fs.existsSync(project + "/main.dev") {
        print("The DevOsPM CLI (pm-cli, or DEV_OS_PM_SOURCE) with its main.dev is required.")
        return json.null_value()
    }
    let version = cliVersion(project)
    if strings.equal(version, "") { print("Cannot read the version of the DevOsPM CLI."); return json.null_value() }
    let archive = payload + "/devospm-cli.tar.gz"
    let stage = payload + "/pm-cli-stage"
    let staged = child_process.execFileSync("sh", Vec<str>(project + "/stage.sh", stage), child_process.options())
    if !staged.success { print("Cannot stage pm-cli with the shared App Store database."); return json.null_value() }
    let packed = child_process.execFileSync("tar", Vec<str>("-czf",archive,"--owner=0","--group=0","--numeric-owner","--sort=name","-C",stage,"."), child_process.options())
    if !packed.success { print("Cannot pack the DevOsPM CLI sources."); return json.null_value() }
    fs.writeFileSync(payload + "/devospm-LICENSE", fs.readFileSync(project + "/LICENSE", "utf8"))
    let record = json.set(json.object(), "format", "devlang-sources")
    record = json.set(record, "version", version)
    record = json.set(record, "project", project)
    record = json.set(record, "catalogSource", sources.appstore())
    record = json.set(record, "archiveSha256", hex(crypto.hash("sha256", fs.read_bytes(archive))))
    fs.writeFileSync(payload + "/devospm-provenance.json", json.pretty(record) + "\n")
    return record
}
