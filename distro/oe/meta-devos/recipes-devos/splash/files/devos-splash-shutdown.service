[Unit]
Description=Dev OS shutdown animation
DefaultDependencies=no
After=greetd.service systemd-logind.service
Before=shutdown.target

[Service]
Type=forking
PIDFile=/run/devos-splash.pid
ExecStartPre=-/bin/rm -f /run/devos-splash.pid /run/devos-splash.ctl
ExecStart=/usr/bin/devos-splash --daemon --message "Shutting down" --timeout 90
TimeoutStartSec=5
TimeoutStopSec=3

[Install]
WantedBy=poweroff.target reboot.target halt.target kexec.target
