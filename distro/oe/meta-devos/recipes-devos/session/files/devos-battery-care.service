[Unit]
Description=DevOs battery charge limit (Battery Care Mode)
After=local-fs.target
ConditionPathExists=/usr/libexec/devos-battery-care
# Only machines whose driver offers a charge limit (the udev rule starts this unit again when a battery appears).
ConditionPathExistsGlob=/sys/class/power_supply/*/charge_control_end_threshold

[Service]
Type=oneshot
ExecStart=/usr/libexec/devos-battery-care apply
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
