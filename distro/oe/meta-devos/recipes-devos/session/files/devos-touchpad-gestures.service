[Unit]
Description=DevOs touchpad Smart Gestures (edge slides for volume, brightness and seek; corner swipe launches an app)
After=graphical-session.target pipewire.service
ConditionPathExists=/usr/bin/dev-os-touchpad-gestures

[Service]
Type=simple
# Read-only observer of the touchpad's evdev node. It stays idle (no device opened) while Smart Gestures are off
# or the touchpad is locked, and picks up changes from the saved settings within a second.
ExecStart=/usr/bin/dev-os-touchpad-gestures serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
