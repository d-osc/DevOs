#%PAM-1.0
# GitHub tokens are freshly verified against a root-owned UID binding.
# Only the fixed devos guest user accepts the explicit guest credential.
auth sufficient pam_exec.so quiet expose_authtok /usr/libexec/devos-pam-auth
auth required pam_unix.so use_first_pass
account required pam_unix.so
password required pam_unix.so sha512 shadow
session required pam_unix.so
session optional pam_systemd.so
