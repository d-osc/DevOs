// Let a signed-in Dev OS user manage Wi-Fi from Settings without a password prompt.
// NetworkManager asks polkit for settings.modify.system/network-control; without an
// active logind seat session (or an agent) the default policy is auth_admin, which
// surfaces as "PermissionDenied: Insufficient privileges".
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.NetworkManager.") !== 0) return polkit.Result.NOT_HANDLED;
    if (!subject.local) return polkit.Result.NOT_HANDLED;
    if (subject.active || subject.isInGroup("wheel") || subject.isInGroup("netdev") || subject.isInGroup("devos")) return polkit.Result.YES;
    return polkit.Result.NOT_HANDLED;
});
