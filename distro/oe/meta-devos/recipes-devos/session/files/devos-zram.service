[Unit]
Description=DevOs swap (compressed RAM swap as large as RAM unless changed in Settings)
After=systemd-modules-load.service local-fs.target
Before=devos-memory.service
ConditionPathExists=/usr/libexec/devos-swap

[Service]
Type=oneshot
ExecStart=/usr/libexec/devos-swap apply
RemainAfterExit=yes
Nice=-5
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
