From: Dev OS <devos@localhost>
Subject: [PATCH] Sleep, Restart and Shutdown buttons on the lock screen

Upstream-Status: Inappropriate [Dev OS lock workflow]

--- a/devos-power.c
+++ b/devos-power.c
@@ -0,0 +1,144 @@
+#include <math.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <wayland-client.h>
+#include "cairo.h"
+#include "log.h"
+#include "swaylock.h"
+
+// Sleep, Restart and Shutdown on the lock screen.
+// devos_power_armed is the armed button index + 1 (0 = none). Sizes are logical pixels; the buttons sit bottom right,
+// like the greeter's. Restart and Shutdown arm on the first click and run on the second.
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+#define BUTTON_W 118
+#define BUTTON_H 40
+#define BUTTON_GAP 10
+#define BUTTON_MARGIN 24
+
+static const char *const labels[DEVOS_POWER_COUNT] = {"Sleep", "Restart", "Shutdown"};
+static const char *const verbs[DEVOS_POWER_COUNT] = {"suspend", "reboot", "poweroff"};
+
+void devos_power_rect(const struct swaylock_surface *surface, int index, double *x, double *y, double *w, double *h) {
+	*w = BUTTON_W;
+	*h = BUTTON_H;
+	*x = (double)surface->width - BUTTON_MARGIN - (DEVOS_POWER_COUNT - index) * BUTTON_W - (DEVOS_POWER_COUNT - 1 - index) * BUTTON_GAP;
+	*y = (double)surface->height - BUTTON_MARGIN - BUTTON_H;
+}
+
+// Returns the button under a logical surface position, or -1.
+int devos_power_hit(const struct swaylock_surface *surface, double px, double py) {
+	for (int i = 0; i < DEVOS_POWER_COUNT; ++i) {
+		double x, y, w, h;
+		devos_power_rect(surface, i, &x, &y, &w, &h);
+		if (px >= x && px < x + w && py >= y && py < y + h) return i;
+	}
+	return -1;
+}
+
+static void rounded(cairo_t *cairo, double x, double y, double w, double h, double r) {
+	cairo_new_sub_path(cairo);
+	cairo_arc(cairo, x + w - r, y + r, r, -M_PI / 2, 0);
+	cairo_arc(cairo, x + w - r, y + h - r, r, 0, M_PI / 2);
+	cairo_arc(cairo, x + r, y + h - r, r, M_PI / 2, M_PI);
+	cairo_arc(cairo, x + r, y + r, r, M_PI, 3 * M_PI / 2);
+	cairo_close_path(cairo);
+}
+
+static void icon(cairo_t *cairo, int index, double cx, double cy) {
+	cairo_set_line_width(cairo, 2);
+	cairo_set_line_cap(cairo, CAIRO_LINE_CAP_ROUND);
+	if (index == 0) { // crescent moon
+		cairo_arc(cairo, cx, cy, 7, 0.55 * M_PI, 1.95 * M_PI);
+		cairo_stroke(cairo);
+	} else if (index == 1) { // restart arrow
+		cairo_arc(cairo, cx, cy, 7, 0.3 * M_PI, 1.75 * M_PI);
+		cairo_stroke(cairo);
+		double ax = cx + 7 * cos(1.75 * M_PI), ay = cy + 7 * sin(1.75 * M_PI);
+		cairo_move_to(cairo, ax - 1, ay - 5);
+		cairo_line_to(cairo, ax, ay + 1);
+		cairo_line_to(cairo, ax + 6, ay - 2);
+		cairo_stroke(cairo);
+	} else { // power symbol
+		cairo_arc(cairo, cx, cy + 1, 7, -0.3 * M_PI, 1.3 * M_PI);
+		cairo_stroke(cairo);
+		cairo_move_to(cairo, cx, cy - 8);
+		cairo_line_to(cairo, cx, cy);
+		cairo_stroke(cairo);
+	}
+}
+
+void devos_power_render(cairo_t *cairo, const struct swaylock_surface *surface) {
+	const struct swaylock_state *state = surface->state;
+	cairo_save(cairo);
+	cairo_set_operator(cairo, CAIRO_OPERATOR_OVER);
+	cairo_scale(cairo, surface->scale, surface->scale);
+	cairo_select_font_face(cairo, state->args.font, CAIRO_FONT_SLANT_NORMAL, CAIRO_FONT_WEIGHT_NORMAL);
+	cairo_set_font_size(cairo, 14);
+	for (int i = 0; i < DEVOS_POWER_COUNT; ++i) {
+		double x, y, w, h;
+		devos_power_rect(surface, i, &x, &y, &w, &h);
+		bool armed = state->devos_power_armed == i + 1;
+		rounded(cairo, x, y, w, h, 10);
+		if (armed) cairo_set_source_rgba(cairo, 0.75, 0.15, 0.15, 0.85);
+		else cairo_set_source_rgba(cairo, 0, 0, 0, 0.45);
+		cairo_fill_preserve(cairo);
+		cairo_set_source_rgba(cairo, 1, 1, 1, 0.28);
+		cairo_set_line_width(cairo, 1);
+		cairo_stroke(cairo);
+		cairo_set_source_rgba(cairo, 1, 1, 1, 0.92);
+		icon(cairo, i, x + 20, y + h / 2);
+		const char *text = armed ? "Confirm" : labels[i];
+		cairo_text_extents_t extents;
+		cairo_text_extents(cairo, text, &extents);
+		cairo_move_to(cairo, x + 38, y + h / 2 - extents.y_bearing - extents.height / 2);
+		cairo_show_text(cairo, text);
+	}
+	cairo_restore(cairo);
+}
+
+static void redraw(struct swaylock_state *state) {
+	struct swaylock_surface *surface;
+	wl_list_for_each(surface, &state->surfaces, link) surface->last_buffer_width = 0;
+	damage_state(state);
+}
+
+void devos_power_disarm(struct swaylock_state *state) {
+	if (state->devos_power_armed == 0) return;
+	state->devos_power_armed = 0;
+	redraw(state);
+}
+
+// Runs `systemctl <verb>` detached. logind decides: other signed-in sessions can make Restart/Shutdown
+// need administrator authentication, which cannot be asked here, so systemctl fails and the lock stays.
+static void run(int index) {
+	pid_t child = fork();
+	if (child < 0) return;
+	if (child == 0) {
+		if (fork() != 0) _exit(0);
+		execl("/usr/bin/systemctl", "systemctl", "--no-ask-password", verbs[index], (char *)NULL);
+		execlp("systemctl", "systemctl", "--no-ask-password", verbs[index], (char *)NULL);
+		_exit(127);
+	}
+	waitpid(child, NULL, 0);
+}
+
+void devos_power_click(struct swaylock_state *state, const struct swaylock_surface *surface, double px, double py) {
+	int index = surface ? devos_power_hit(surface, px, py) : -1;
+	if (index < 0) {
+		devos_power_disarm(state);
+		return;
+	}
+	if (index == 0 || state->devos_power_armed == index + 1) {
+		state->devos_power_armed = 0;
+		redraw(state);
+		swaylock_log(LOG_INFO, "Dev OS power action: %s", verbs[index]);
+		run(index);
+		return;
+	}
+	state->devos_power_armed = index + 1;
+	redraw(state);
+}
