 void render(struct swaylock_surface *surface);
 void damage_state(struct swaylock_state *state);
 void clear_password_buffer(struct swaylock_password *pw);
--- a/main.c
+++ b/main.c
@@ -181,6 +181,29 @@ void damage_state(struct swaylock_state *state) {
 	}
 }
 
+
+static void devos_cover_signal(int sig);
+
+static void devos_show_cover(struct swaylock_state *state) {
+    if (state->auth_state == AUTH_STATE_VALIDATING) return;
+    state->devos_cover = true;
+    clear_password_buffer(&state->password);
+    state->input_state = INPUT_STATE_IDLE;
+    state->auth_state = AUTH_STATE_IDLE;
+    struct swaylock_surface *surface;
+    wl_list_for_each(surface, &state->surfaces, link) surface->last_buffer_width = 0;
+    damage_state(state);
+}
+
+bool devos_dismiss_cover(struct swaylock_state *state) {
+    if (!state->devos_cover) return false;
+    state->devos_cover = false;
+    struct swaylock_surface *surface;
+    wl_list_for_each(surface, &state->surfaces, link) surface->last_buffer_width = 0;
+    damage_state(state);
+    return true;
+}
+
 // Refresh the background without replacing the secure lock surface.
 static void devos_clock_tick(void *data) {
 	static time_t last_minute = 0;
@@ -321,6 +344,10 @@ static const struct wl_registry_listener registry_listener = {
 };
 
 static int sigusr_fds[2] = {-1, -1};
+static void devos_cover_signal(int sig) {
+    (void)sig;
+    (void)write(sigusr_fds[1], "2", 1);
+}
 
 void do_sigusr(int sig) {
 	(void)write(sigusr_fds[1], "1", 1);
@@ -562,6 +589,7 @@ static int parse_options(int argc, char **argv, struct swaylock_state *state,
 	};
 
