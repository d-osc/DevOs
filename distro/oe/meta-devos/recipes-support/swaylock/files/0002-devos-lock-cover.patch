From: Dev OS <devos@localhost>
Subject: [PATCH] Secure black clock cover before authentication

Upstream-Status: Inappropriate [Dev OS lock workflow]

--- a/include/swaylock.h
+++ b/include/swaylock.h
@@ -98,6 +98,7 @@ struct swaylock_state {
 	uint32_t highlight_start; // position of highlight; 2048 = 1 full turn
 	int failed_attempts;
 	bool run_display, locked;
+	bool devos_cover;
 	struct ext_session_lock_manager_v1 *ext_session_lock_manager_v1;
 	struct ext_session_lock_v1 *ext_session_lock_v1;
 };
@@ -135,6 +136,7 @@ struct swaylock_image {
