 	}
 
+	state.devos_cover = getenv("DEV_OS_LOCK_COVER") && strcmp(getenv("DEV_OS_LOCK_COVER"), "1") == 0;
 	state.password.len = 0;
 	state.password.buffer_len = 1024;
 	state.password.buffer = password_buffer_create(state.password.buffer_len);
@@ -1250,7 +1284,13 @@ int main(int argc, char **argv) {
 		}
 	}
 
-	if (state.args.ready_fd >= 0) {
+    // Install the cover handler before readiness can trigger another request.
+    struct sigaction cover_sa;
+    cover_sa.sa_handler = devos_cover_signal;
+    sigemptyset(&cover_sa.sa_mask);
+    cover_sa.sa_flags = SA_RESTART;
+    sigaction(SIGUSR2, &cover_sa, NULL);
+    if (state.args.ready_fd >= 0) {
 		if (write(state.args.ready_fd, "\n", 1) != 1) {
 			swaylock_log(LOG_ERROR, "Failed to send readiness notification");
 			return 2;
