From: Dev OS <devos@localhost>
Subject: [PATCH] Render an opt-in date and time on the secure lock background

Upstream-Status: Inappropriate [Dev OS wallpaper integration]

--- a/main.c
+++ b/main.c
@@ -181,6 +181,24 @@ void damage_state(struct swaylock_state *state) {
 	}
 }
 
+// Refresh the background without replacing the secure lock surface.
+static void devos_clock_tick(void *data) {
+	static time_t last_minute = 0;
+	time_t minute = time(NULL) / 60;
+	struct swaylock_state *state = data;
+	if (minute == last_minute) {
+		loop_add_timer(state->eventloop, 1000, devos_clock_tick, state);
+		return;
+	}
+	last_minute = minute;
+	struct swaylock_surface *surface;
+	wl_list_for_each(surface, &state->surfaces, link) {
+		surface->last_buffer_width = 0;
+	}
+	damage_state(state);
+	loop_add_timer(state->eventloop, 1000, devos_clock_tick, state);
+}
+
 static void handle_wl_output_geometry(void *data, struct wl_output *wl_output,
 		int32_t x, int32_t y, int32_t width_mm, int32_t height_mm,
 		int32_t subpixel, const char *make, const char *model,
@@ -1257,6 +1275,9 @@ int main(int argc, char **argv) {
 	sa.sa_flags = SA_RESTART;
 	sigaction(SIGUSR1, &sa, NULL);
 
+	if (getenv("DEV_OS_LOCK_CLOCK") && strcmp(getenv("DEV_OS_LOCK_CLOCK"), "1") == 0) {
+		loop_add_timer(state.eventloop, 1000, devos_clock_tick, &state);
+	}
 	state.run_display = true;
 	while (state.run_display) {
 		errno = 0;
--- a/render.c
