[Desktop Entry]
Type=Application
Name=Install Package
Comment=Install a .dpk, .deb, .rpm or .tar.gz package for your user
Exec=dev-os-shell package-install %F
TryExec=dev-os-shell
Icon=dev-os-app-store
Categories=System;PackageManager;
MimeType=application/x-devos-package;application/vnd.debian.binary-package;application/x-deb;application/x-rpm;application/x-redhat-package-manager;
NoDisplay=true
Terminal=false
StartupNotify=false
