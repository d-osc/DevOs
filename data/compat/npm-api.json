{
  "format": 1,
  "packages": [
    {
      "directory": "packages/config",
      "name": "@dev-os/config",
      "exports": {
        ".": {
          "types": "./dist/index.d.ts",
          "import": "./dist/index.js"
        }
      }
    },
    {
      "directory": "packages/core",
      "name": "@dev-os/core",
      "exports": {
        "./base": {
          "types": "./dist/base.d.ts",
          "import": "./dist/base.js"
        }
      }
    },
    {
      "directory": "packages/extensions",
      "name": "@dev-os/extensions",
      "exports": {
        "./schema": {
          "types": "./dist/schema.d.ts",
          "import": "./dist/schema.js"
        }
      }
    },
    {
      "directory": "packages/updates",
      "name": "@dev-os/updates",
      "exports": {
        "./protocol": {
          "types": "./dist/protocol.d.ts",
          "import": "./dist/protocol.js"
        },
        "./installed": {
          "types": "./dist/installed.d.ts",
          "import": "./dist/installed.js"
        },
        "./manifest": {
          "types": "./dist/manifest.d.ts",
          "import": "./dist/manifest.js"
        },
        "./package": {
          "types": "./dist/package.d.ts",
          "import": "./dist/package.js"
        },
        "./system": {
          "types": "./dist/system.d.ts",
          "import": "./dist/system.js"
        },
        "./system-bundle": {
          "types": "./dist/system-bundle.d.ts",
          "import": "./dist/system-bundle.js"
        }
      }
    }
  ]
}
