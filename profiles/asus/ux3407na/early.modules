# USB-A host regulator/PHY chain needed before the Live USB root can appear.
# The generic xHCI/storage modules are re-added after it to keep the proven order.
-xhci_pci
-xhci_plat_hcd
-usb_storage
-uas
# Load the protocol family before USB discovery can stop the background loader.
# QMI's AF_QIPCRTR family has no DT modalias for the later device scan.
qrtr
qrtr_smd
qcom_rpmh_regulator
qcom_refgen_regulator
phy_qcom_m31_eusb2
phy_qcom_qmp_usb
dwc3_qcom
xhci_plat_hcd
usb_storage
uas
